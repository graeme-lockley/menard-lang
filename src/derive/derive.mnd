; Derive engine — slice 2.5 stub, planning added in slice 2F.
;
; The real derive engine (a later slice) synthesizes `show`, `=`,
; `compare` and `dump` per type instantiation (spec §2.8.1, §2.8.4): it
; is the one place in the compiler that generates code per instantiation,
; and it is what the interpreter's oracle (host/src/interp/derive.ts)
; already does for the reference semantics. `plan-derives` itself is
; still the identity on the form list — no code is generated yet, so the
; pipeline's shape exists end to end without committing to a derive-plan
; representation before instantiation sites are known — but slice 2F adds
; the "which types are ever shown/compared" traversal itself, in
; `derive/plan.mnd`'s `describe-derives`: it walks a program's forms and
; reports every type its `show`/`=`/`compare`/`dump` use sites need,
; wired into `src/mn.mnd`'s `--dump-after=derive` alongside the raw
; forms dump. That traversal is exactly the "which types are ever shown/
; compared" question a real derive engine's instantiation-site scan
; (§2.8.4) will also have to answer.
;
; `plan-derives` prepends a `defn` for `show`, `=`, `compare`, and `dump`
; for each user record or variant that a classifiable use site mentions,
; and rewrites that use site onto the generated name. Builtin `Int` /
; `Bool` / `Str` stay on the runtime intrinsics. `Ref`, `StringBuffer`,
; and `Fn` are not given bodies here — the typer already rejects `show`
; of those. Field payloads are printed with the builtin `show`, which
; matches the interpreter for `Int`.

import "../reader/ast.mnd"
import std/list

; Re-export shim: a `pub` signature may not mention a private nominal
; type (ADR 27), even one imported `pub` from elsewhere — see
; src/reader/read.mnd's header comment for why.
pub alias Ast = Ast

let sp0() -> Span =
  Span(0, 0, 0, 1)

let sy(name: Str) -> Ast =
  SymNode(name, sp0())

let int-lit(n: Int) -> Ast =
  IntNode(n, sp0())

let bool-lit(flag: Bool) -> Ast =
  BoolNode(flag, sp0())

let st(s: Str) -> Ast =
  StrNode(s, sp0())

let paren(xs: List Ast) -> Ast =
  ParenNode(xs, sp0())

let sym-str(ast: Ast) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> Some(n)
    | _ -> None()

let is-sym(ast: Ast, name: Str) -> Bool =
  match (sym-str(ast))
    | Some(n) -> n == name
    | None -> false

let append-ast(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-ast(rest, ys)

let strip-colon(s: Str) -> Str {
  let n = str-byte-length(s)
  if (n > 0 && str-byte(s, n - 1) == 58) -> str-slice(s, 0, n - 1) | s
}

let unwrap-pub(ast: Ast) -> Ast =
  match (ast)
    | ParenNode(head :: rest, sp) ->
      if (is-sym(head, "pub")) -> unwrap-pub(ParenNode(rest, sp)) | ast
    | _ -> ast

record DeriveCtor {
  name: Str
  arity: Int
}

let dc-name(c: DeriveCtor) -> Str =
  match (c)
    | DeriveCtor(n, _) -> n

let dc-arity(c: DeriveCtor) -> Int =
  match (c)
    | DeriveCtor(_, a) -> a

let binders(prefix: Str, n: Int, i: Int) -> List Str =
  if (i >= n) -> [] | str-concat(prefix, show(i)) :: binders(prefix, n, i + 1)

let syms-of(xs: List Str) -> List Ast =
  match (xs)
    | [] -> []
    | h :: rest -> sy(h) :: syms-of(rest)

let ctor-pat(c: DeriveCtor, prefix: Str) -> Ast =
  paren(sy(dc-name(c)) :: syms-of(binders(prefix, dc-arity(c), 0)))

; Flatten renames a private constructor to `__mN_Name` before derive runs.
; The match pattern keeps that name so it still matches the value. Only the
; characters inside `show` and `dump` use the name the source wrote.
let source-ctor-name-digits(n: Str, i: Int, len: Int) -> Str =
  cond
    | i >= len -> n
    | else ->
      {
        let b = str-byte(n, i)
        cond
          | b >= 48 && b <= 57 -> source-ctor-name-digits(n, i + 1, len)
          | b == 95 -> str-slice(n, i + 1, len - (i + 1))
          | else -> n
      }

let source-ctor-name(n: Str) -> Str {
  let len = str-byte-length(n)
  if (len >= 4 && str-byte(n, 0) == 95 && str-byte(n, 1) == 95 && str-byte(n, 2) == 109) -> source-ctor-name-digits(n, 3, len) | n
}

let concat2(a: Ast, b: Ast) -> Ast =
  paren([sy("str-concat"), a, b])

let show-call(name: Str) -> Ast =
  paren([sy("show"), sy(name)])

let join-shown(fields: List Str) -> Ast =
  match (fields)
    | [] -> st("")
    | [f] -> show-call(f)
    | f :: rest -> concat2(show-call(f), concat2(st(" "), join-shown(rest)))

let show-of-ctor(c: DeriveCtor, prefix: Str) -> Ast {
  let spelled = source-ctor-name(dc-name(c))
  if (dc-arity(c) == 0) -> st(str-concat("(", spelled, ")")) | concat2(st(str-concat("(", spelled, " ")), concat2(join-shown(binders(prefix, dc-arity(c), 0)), st(")")))
}

let show-clauses(ctors: List DeriveCtor) -> List Ast =
  match (ctors)
    | [] -> []
    | c :: rest -> append-ast([ctor-pat(c, "a"), show-of-ctor(c, "a")], show-clauses(rest))

let eq-fields(as: List Str, bs: List Str) -> Ast =
  match (as)
    | [] -> bool-lit(true)
    | a :: ar ->
      match (bs)
        | [] -> bool-lit(false)
        | b :: br -> paren([sy("if"), paren([sy("="), sy(a), sy(b)]), eq-fields(ar, br), bool-lit(false)])

let cmp-fields(as: List Str, bs: List Str) -> Ast =
  match (as)
    | [] -> int-lit(0)
    | a :: ar ->
      match (bs)
        | [] -> int-lit(0)
        | b :: br -> paren([sy("let"), sy("c"), paren([sy("compare"), sy(a), sy(b)]), paren([sy("if"), paren([sy("="), sy("c"), int-lit(0)]), cmp-fields(ar, br), sy("c")])])

let eq-one(c: DeriveCtor) -> Ast =
  paren([sy("match"), sy("b"), ctor-pat(c, "b"), eq-fields(binders("a", dc-arity(c), 0), binders("b", dc-arity(c), 0)), sy("_"), bool-lit(false)])

let eq-clauses(ctors: List DeriveCtor) -> List Ast =
  match (ctors)
    | [] -> []
    | c :: rest -> append-ast([ctor-pat(c, "a"), eq-one(c)], eq-clauses(rest))

let cmp-one(c: DeriveCtor) -> Ast =
  paren([sy("match"), sy("b"), ctor-pat(c, "b"), cmp-fields(binders("a", dc-arity(c), 0), binders("b", dc-arity(c), 0)), sy("_"), int-lit(1)])

let cmp-clauses(ctors: List DeriveCtor) -> List Ast =
  match (ctors)
    | [] -> []
    | c :: rest -> append-ast([ctor-pat(c, "a"), cmp-one(c)], cmp-clauses(rest))

let defn-1(name: Str, ty: Str, ret: Str, body: Ast) -> Ast =
  paren([sy("defn"), sy(name), paren([sy("v:"), sy(ty)]), sy("->"), sy(ret), body])

let defn-2(name: Str, ty: Str, ret: Str, body: Ast) -> Ast =
  paren([sy("defn"), sy(name), paren([sy("a:"), sy(ty)]), paren([sy("b:"), sy(ty)]), sy("->"), sy(ret), body])

let match-v(clauses: List Ast) -> Ast =
  paren(sy("match") :: sy("v") :: clauses)

let match-a(clauses: List Ast) -> Ast =
  paren(sy("match") :: sy("a") :: clauses)

let gen-type(ty: Str, ctors: List DeriveCtor) -> List Ast =
  [defn-1(str-concat("show_", ty), ty, "Str", match-v(show-clauses(ctors))), defn-2(str-concat("eq_", ty), ty, "Bool", match-a(eq-clauses(ctors))), defn-2(str-concat("compare_", ty), ty, "Int", match-a(cmp-clauses(ctors))), defn-1(str-concat("dump_", ty), ty, "Str", match-v(show-clauses(ctors)))]

let gen-used(names: List Str, types: Map Str (List DeriveCtor)) -> List Ast =
  match (names)
    | [] -> []
    | n :: rest ->
      match (map-get(types, n))
        | None -> gen-used(rest, types)
        | Some(ctors) -> append-ast(gen-type(n, ctors), gen-used(rest, types))

let insert-name(x: Str, xs: List Str) -> List Str =
  match (xs)
    | [] -> [x]
    | h :: rest ->
      cond
        | h == x -> xs
        | compare(x, h) <= 0 -> x :: xs
        | else -> h :: insert-name(x, rest)

let ctor-type-of(name: Str, ctors: Map Str Str) -> Maybe Str =
  map-get(ctors, name)

let classify-user(ast: Ast, ctors: Map Str Str) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> ctor-type-of(n, ctors)
    | ParenNode(head :: args, _) ->
      match (sym-str(head))
        | None -> None()
        | Some(hn) -> ctor-type-of(hn, ctors)
    | _ -> None()

let is-derive-op(name: Str) -> Bool =
  name == "show" || name == "=" || name == "compare" || name == "dump"

let op-prefix(name: Str) -> Str =
  cond
    | name == "show" -> "show_"
    | name == "=" -> "eq_"
    | name == "compare" -> "compare_"
    | else -> "dump_"

let note-used(ast: Ast, ctors: Map Str Str, acc: List Str) -> List Str =
  match (ast)
    | ParenNode(elems, _) -> note-used-paren(elems, ctors, acc)
    | BracketNode(elems, _) -> note-used-list(elems, ctors, acc)
    | _ -> acc

let note-used-list(xs: List Ast, ctors: Map Str Str, acc: List Str) -> List Str =
  match (xs)
    | [] -> acc
    | x :: rest -> note-used-list(rest, ctors, note-used(x, ctors, acc))

let note-used-paren(elems: List Ast, ctors: Map Str Str, acc: List Str) -> List Str =
  match (elems)
    | head :: rest -> note-used-list(rest, ctors, note-used-head(head, rest, ctors, acc))
    | [] -> acc

let note-used-head(head: Ast, rest: List Ast, ctors: Map Str Str, acc: List Str) -> List Str =
  match (sym-str(head))
    | None -> acc
    | Some(hn) ->
      cond
        | is-derive-op(hn) ->
          match (rest)
            | a :: _ ->
              match (classify-user(a, ctors))
                | None -> acc
                | Some(ty) -> insert-name(ty, acc)
            | [] -> acc
        | else -> acc

let used-in(forms: List Ast, ctors: Map Str Str) -> List Str =
  used-in-list(forms, ctors, [])

let used-in-list(forms: List Ast, ctors: Map Str Str, acc: List Str) -> List Str =
  match (forms)
    | [] -> acc
    | f :: rest -> used-in-list(rest, ctors, note-used(f, ctors, acc))

let rewrite-name(op: Str, ty: Str) -> Str =
  str-concat(op-prefix(op), ty)

let rewrite(ast: Ast, ctors: Map Str Str) -> Ast =
  match (ast)
    | ParenNode(elems, sp) -> ParenNode(rewrite-paren(elems, ctors), sp)
    | BracketNode(elems, sp) -> BracketNode(rewrite-list(elems, ctors), sp)
    | _ -> ast

let rewrite-list(xs: List Ast, ctors: Map Str Str) -> List Ast =
  match (xs)
    | [] -> []
    | x :: rest -> rewrite(x, ctors) :: rewrite-list(rest, ctors)

let rewrite-paren(elems: List Ast, ctors: Map Str Str) -> List Ast =
  match (elems)
    | head :: rest -> rewrite-paren-head(head, rest, ctors)
    | [] -> []

let rewrite-paren-head(head: Ast, rest: List Ast, ctors: Map Str Str) -> List Ast =
  match (sym-str(head))
    | None -> rewrite(head, ctors) :: rewrite-list(rest, ctors)
    | Some(hn) ->
      if (is-derive-op(hn)) -> rewrite-derive(hn, head, rest, ctors) | head :: rewrite-list(rest, ctors)

let rewrite-derive(hn: Str, head: Ast, rest: List Ast, ctors: Map Str Str) -> List Ast =
  match (rest)
    | a :: more ->
      match (classify-user(a, ctors))
        | None -> head :: rewrite-list(rest, ctors)
        | Some(ty) -> sy(rewrite-name(hn, ty)) :: rewrite-list(rest, ctors)
    | [] -> head :: []

let rewrite-forms(forms: List Ast, ctors: Map Str Str) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> rewrite(f, ctors) :: rewrite-forms(rest, ctors)

let add-ctor(ctors: Map Str Str, cname: Str, ty: Str) -> Map Str Str =
  map-set(ctors, cname, ty)

let variant-ctors(cs: List Ast, ty: Str, ctors: Map Str Str, acc: List DeriveCtor) -> List DeriveCtor =
  match (cs)
    | [] -> acc
    | c :: rest ->
      match (c)
        | ParenNode(name-ast :: payloads, _) ->
          match (sym-str(name-ast))
            | None -> variant-ctors(rest, ty, ctors, acc)
            | Some(cname) -> DeriveCtor(cname, length(payloads)) :: variant-ctors(rest, ty, ctors, acc)
        | _ -> variant-ctors(rest, ty, ctors, acc)

let remember-variant(cs: List Ast, ty: Str, ctors: Map Str Str) -> Map Str Str =
  match (cs)
    | [] -> ctors
    | c :: rest ->
      match (c)
        | ParenNode(name-ast :: _, _) ->
          match (sym-str(name-ast))
            | None -> remember-variant(rest, ty, ctors)
            | Some(cname) -> remember-variant(rest, ty, add-ctor(ctors, cname, ty))
        | _ -> remember-variant(rest, ty, ctors)

record TypeAcc {
  types: Map Str (List DeriveCtor)
  ctors: Map Str Str
}

let acc-add-defrec(acc: TypeAcc, name: Str, arity: Int) -> TypeAcc =
  match (acc)
    | TypeAcc(types, ctors) -> TypeAcc(map-set(types, name, [DeriveCtor(name, arity)]), add-ctor(ctors, name, name))

let acc-add-variant(acc: TypeAcc, name: Str, cs: List Ast) -> TypeAcc =
  match (acc)
    | TypeAcc(types, ctors) -> TypeAcc(map-set(types, name, variant-ctors(cs, name, ctors, [])), remember-variant(cs, name, ctors))

let take-name(ast: Ast) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> Some(strip-colon(n))
    | ParenNode(n :: _, _) ->
      match (sym-str(n))
        | Some(s) -> Some(strip-colon(s))
        | None -> None()
    | _ -> None()

let consider-named(hn: Str, rest: List Ast, acc: TypeAcc) -> TypeAcc =
  cond
    | hn == "defrec" ->
      match (rest)
        | name-ast :: fields ->
          match (take-name(name-ast))
            | None -> acc
            | Some(name) -> acc-add-defrec(acc, name, length(fields))
        | [] -> acc
    | hn == "variant" ->
      match (rest)
        | name-ast :: cs ->
          match (take-name(name-ast))
            | None -> acc
            | Some(name) -> acc-add-variant(acc, name, cs)
        | [] -> acc
    | else -> acc

let consider(ast: Ast, acc: TypeAcc) -> TypeAcc =
  match (unwrap-pub(ast))
    | ParenNode(head :: rest, _) ->
      match (sym-str(head))
        | None -> acc
        | Some(hn) -> consider-named(hn, rest, acc)
    | _ -> acc

let consider-all(forms: List Ast, acc: TypeAcc) -> TypeAcc =
  match (forms)
    | [] -> acc
    | f :: rest -> consider-all(rest, consider(f, acc))

pub let plan-derives(forms: List Ast) -> List Ast =
  match (consider-all(forms, TypeAcc(map-new(), map-new())))
    | TypeAcc(types, ctors) -> append-ast(gen-used(used-in(forms, ctors), types), rewrite-forms(forms, ctors))

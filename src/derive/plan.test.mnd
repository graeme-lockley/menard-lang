; Derive plan. Fixture paths are from the repo root, and are also found
; when `./mn test` is run from a subdirectory. `--dump-after=derive`
; stays in tests/phase2/derive.test.ts.
import "../reader/read.mnd"
import "../test/paths.mnd"
import "./plan.mnd"
import std/io

let plan-of(path: Str) -> Maybe Str =
  match (read-file(project-file(path)))
    | Err(_) -> None
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> None
        | Ok(forms) -> Some(describe-derives(forms))

test "(show 1) plans show for Int" =
  match (plan-of("tests/phase2/fixtures/derive-show-int.mnd"))
    | Some(p) -> p == "Int: show"
    | None -> false

test "(show (Red)) plans show for the declared type, not the constructor" =
  match (plan-of("tests/phase2/fixtures/derive-show-variant.mnd"))
    | Some(p) -> p == "Color: show"
    | None -> false

test "show([1, 2, 3]) plans (List Int)" =
  match (plan-of("tests/phase2/fixtures/derive-show-list.mnd"))
    | Some(p) -> p == "(List Int): show"
    | None -> false

test "show(Some(1)) plans (Maybe Int)" =
  match (plan-of("tests/phase2/fixtures/derive-show-maybe.mnd"))
    | Some(p) -> p == "(Maybe Int): show"
    | None -> false

test "show({\"a\" => Some(1)}) plans (Map Str (Maybe Int))" =
  match (plan-of("tests/phase2/fixtures/derive-show-map.mnd"))
    | Some(p) -> p == "(Map Str (Maybe Int)): show"
    | None -> false

test "show((1, \"a\")) plans Int * Str" =
  match (plan-of("tests/phase2/fixtures/derive-show-product.mnd"))
    | Some(p) -> p == "Int * Str: show"
    | None -> false

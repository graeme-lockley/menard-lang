; Canonical `help:` strings for every actionable catalogue code (DOC-05).
; Keep in sync with `host/src/diagnostic/helps.ts` and `docs/errors.md`.
pub let catalogue-help(code: Str) -> Maybe Str =
  if (code == "E_PARSE") -> Some("check the syntax near this character") | if (code == "E_PARSE_UNCLOSED") -> Some("close the opening delimiter") | if (code == "E_PARSE_BANG") -> Some("'!' may appear only as the final character of an identifier") | if (code == "E_PARSE_STRING") -> Some("close the string with a matching quote") | if (code == "E_CASING") -> Some("rename the constructor so it starts with an uppercase letter") | if (code == "E_DESUGAR_ARITY") -> Some("give the operator the arguments it expects") | if (code == "E_DESUGAR_COND_CLAUSE") -> Some("write each cond clause as a guard/body pair") | if (code == "E_DESUGAR_COND_ELSE") -> Some("move else to the last cond clause") | if (code == "E_DESUGAR_COND_EMPTY") -> Some("add at least one cond clause") | if (code == "E_DESUGAR_MAP") -> Some("write the map as { key => value, ... }") | if (code == "E_DESUGAR_MATCH") -> Some("write match with a scrutinee and | pattern -> body arms") | if (code == "E_DESUGAR_PIPE") -> Some("pipe requires a call on the right; write value |> f(args)") | if (code == "E_DESUGAR_WHEN") -> Some("write when as when (cond) body") | if (code == "E_DESUGAR_WHILE") -> Some("write while as while (cond) body") | if (code == "E_TYPE_REST") -> Some("put ... only on the last parameter, typed as (List T)") | if (code == "E_TYPE_SPREAD") -> Some("use ... only as the last argument of a rest-parameter call") | if (code == "E_TYPE_ARITY") -> Some("check the call: expected and found argument counts must match") | if (code == "E_TYPE_DEFN") -> Some("write defn as name(params) -> Ret = body") | if (code == "E_TYPE_DUPLICATE") -> Some("rename or remove the duplicate definition") | if (code == "E_TYPE_EXHAUSTIVE") -> Some("cover every constructor, or add a wildcard arm") | if (code == "E_TYPE_EXPR") -> Some("fix the type expression") | if (code == "E_TYPE_FN") -> Some("write the function type as Fn(Args) -> Ret") | if (code == "E_TYPE_LET") -> Some("write let as let name = expr") | if (code == "E_TYPE_LOOP") -> Some("write loop as loop (bindings) body") | if (code == "E_TYPE_MATCH") -> Some("write match with a scrutinee and pattern/body pairs") | if (code == "E_TYPE_MISMATCH") -> Some("change the expression to match the expected type") | if (code == "E_TYPE_NULLARY_CALL") -> Some("remove the parentheses; None is a value") | if (code == "E_TYPE_OCCURS") -> Some("break the cycle that makes this type infinite") | if (code == "E_TYPE_ORDERABLE") -> Some("only Int, Float, Str, Char, Bool, and variants of those are orderable") | if (code == "E_TYPE_RECUR") -> Some("use recur only inside a loop") | if (code == "E_TYPE_SHOWABLE") -> Some("use a showable type, or print via a custom function") | if (code == "E_TYPE_UNBOUND") -> Some("bind the name, or check the spelling") | if (code == "E_TYPE_UNKNOWN") -> Some("use a known type name, or define the type first") | if (code == "E_PUB_PRIVATE_TYPE") -> Some("make the type pub, or stop mentioning it in a pub signature") | if (code == "E_IMPORT") -> Some("fix the import form") | if (code == "E_IMPORT_CYCLE") -> Some("break the import cycle") | if (code == "E_IMPORT_MISSING") -> Some("create the module or fix the import path") | if (code == "E_IMPORT_VERSION") -> Some("use one version of the package across imports") | if (code == "E_EXTERN_FFI_PREFIX") -> Some("use the mn_ prefix only in seam modules") | if (code == "E_EXTERN_SEAM") -> Some("move the extern into a seam or /ffi/ module") | if (code == "E_RUNTIME_MODULE") -> Some("move the runtime form into an allowed stdlib module") | if (code == "E_TEST") -> Some("fix the failing assertion") | None

; Variant helps under one code (sync-test greppable example literals).
pub let catalogue-help-glued-eq = "did you mean a == b?"

pub let catalogue-help-unbound-ctor = "check the spelling, or qualify the constructor with its import alias"

pub let catalogue-help-op-spacing = "operators need a space on both sides; did you mean `n + 1`?"

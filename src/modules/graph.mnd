; Import-graph flatten for emit/check (Phase 3 slice G/H).
;
; Loads the entry module and its transitive `(import "…")` closure through
; `read-file`, desugars each module, strips import forms, unwraps `pub`, and
; concatenates bodies in dependency-first order into one flat `(List Ast)`
; suitable for the single-module typecheck/lower path.
;
; Private top-level bindings (`defn` / `defrec` / `variant` / `alias`, plus
; constructors of private variants) are renamed per module to `__mN_name` so
; helpers that collide across `src/` (e.g. `is-sym`) do not smash each other
; after flatten. Pub names stay as exported; a second non-alias pub binding of
; the same name is an error. Pub `alias` re-exports (common for `Ast`/`Span`)
; are allowed to repeat.
;
; Every module's `main` is renamed to `mn_<hash>_main`, a stable hash of that
; module's path, so two modules can each define `main` and a later separate
; compile can name the symbol without knowing who imported it. Top-level
; expressions become `mn_<hash>_init`. Flatten then appends one bootstrap
; `(defn main -> Int …)` that calls those inits in dependency order and then
; the entry module's mangled main. That bootstrap is the only C `main`.

import "../reader/ast.mnd"
import "../reader/read.mnd"
import "../reader/casing.mnd"
import "../desugar/desugar.mnd"
import std/fs
import std/io
import std/list
import std/proc
import std/result as Result
import std/string as String
import std/sys
import std/map as Map

; Re-export shim — see `emit/bitcode.mnd` / `reader/casing.mnd`.
pub alias Ast = Ast

; Zero-width on purpose. `lower.mnd` skips panic frames for a call with no
; source extent, so these bootstrap calls do not show up as `file:1`.
let dummy-span() -> Span =
  Span(0, 0, 0, 1)

pub record Flat {
  forms: List Ast
  paths: List Str
}

; Paths imported through `as` in the graph currently being flattened.
let qualified-imports = ref(Map.empty())

; `present` is false when the entry module has no `main`. `unit-ret` means
; that `main` is declared `-> Unit`, so the bootstrap returns 0 after calling it.
record EntryMain {
  sym: Str
  unit-ret: Bool
  present: Bool
}

let snoc-str(xs: List Str, s: Str) -> List Str =
  match (xs)
    | [] -> [s]
    | h :: t -> h :: snoc-str(t, s)

let reverse-ints(xs: List Int, acc: List Int) -> List Int =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-ints(rest, x :: acc)

; Byte offset of each line, line 1 at 0. Newline is byte 10.
; A call per byte overflows the C stack on `lower.mnd` (~140KB). `recur`
; is a jump, so the scan stays one frame.
let collect-line-starts(src: Str, i: Int, n: Int, acc: List Int) -> List Int =
  loop (j = i, out = acc)
    cond
      | j >= n -> out
      | String.byte(j, src) == 10 -> recur(j + 1, (j + 1) :: out)
      | else -> recur(j + 1, out)

let line-starts(src: Str) -> List Int =
  reverse-ints(collect-line-starts(src, 0, String.length(src), [0]), [])

; Index → offset, so a span's line is a binary search instead of a scan
; from the first line. One scan per AST node was quadratic in a file
; the size of `lower.mnd`.
let index-line-starts(starts: List Int, i: Int, m: Map Int Int) -> Map Int Int =
  match (starts)
    | [] -> m
    | s :: rest -> index-line-starts(rest, i + 1, Map.set(i, s, m))

let line-start-count(starts: List Int) -> Int =
  match (starts)
    | [] -> 0
    | _ :: rest -> 1 + line-start-count(rest)

; Smallest index whose start is past `offset`: the count of starts at or
; before it. That is the 1-based line, since index 0 is byte 0.
let line-search(m: Map Int Int, lo: Int, hi: Int, offset: Int) -> Int =
  if (lo >= hi) -> lo | line-search-mid(m, lo, hi, offset, (lo + hi) / 2)

let line-search-mid(m: Map Int Int, lo: Int, hi: Int, offset: Int, mid: Int) -> Int =
  match (Map.lookup(mid, m))
    | None -> lo
    | Some(s) ->
      if (s > offset) -> line-search(m, lo, mid, offset) | line-search(m, mid + 1, hi, offset)

; A span whose origin is already set names another file (`#source`).
; Its offsets and line are in that file, so they must not be recomputed
; from the buffer being stamped.
let span-at(sp: Span, origin: Int, m: Map Int Int, n: Int) -> Span =
  if (span-origin(sp) != 0) -> sp | {
    let line = line-search(m, 0, n, span-start(sp))
    Span(
      span-start(sp),
      span-end(sp),
      origin,
      if (line < 1) -> 1 | line
    )
  }

let stamp-forms(forms: List Ast, src: Str, origin: Int) -> List Ast {
  let starts = line-starts(src)
  stamp-form-list(forms, origin, index-line-starts(starts, 0, Map.empty()), line-start-count(starts))
}

let stamp-form-list(forms: List Ast, origin: Int, m: Map Int Int, n: Int) -> List Ast =
  match (forms)
    | [] -> []
    | a :: rest -> stamp-ast(a, origin, m, n) :: stamp-form-list(rest, origin, m, n)

let stamp-ast(a: Ast, origin: Int, m: Map Int Int, n: Int) -> Ast =
  match (a)
    | ParenNode(xs, sp) -> ParenNode(stamp-form-list(xs, origin, m, n), span-at(sp, origin, m, n))
    | BracketNode(xs, sp) -> BracketNode(stamp-form-list(xs, origin, m, n), span-at(sp, origin, m, n))
    | SymNode(nsp, sp) -> SymNode(nsp, span-at(sp, origin, m, n))
    | IntNode(k, sp) -> IntNode(k, span-at(sp, origin, m, n))
    | FloatNode(f, sp) -> FloatNode(f, span-at(sp, origin, m, n))
    | StrNode(s, sp) -> StrNode(s, span-at(sp, origin, m, n))
    | BoolNode(b, sp) -> BoolNode(b, span-at(sp, origin, m, n))

pub let stamp-spans(forms: List Ast, src: Str, origin: Int) -> List Ast =
  stamp-forms(forms, src, origin)

let sym-str(a: Ast) -> Maybe Str =
  match (a)
    | SymNode(n, _) -> Some(n)
    | _ -> None()

let is-sym(a: Ast, name: Str) -> Bool =
  match (sym-str(a))
    | Some(n) -> n == name
    | None -> false

let append-asts(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-asts(rest, ys)

let str-byte-at(s: Str, i: Int) -> Int =
  String.byte(i, s)

; Last `/` index, or -1 if none.
let last-slash-from(s: Str, i: Int, acc: Int) -> Int =
  cond
    | i < 0 -> acc
    | str-byte-at(s, i) == 47 -> i
    | else -> last-slash-from(s, i - 1, acc)

let path-dirname(path: Str) -> Str {
  let n = String.length(path)
  let slash = last-slash-from(path, n - 1, -1)
  cond
    | slash < 0 -> "."
    | slash == 0 -> "/"
    | else -> String.slice(0, slash, path)
}

let path-is-abs(spec: Str) -> Bool =
  String.length(spec) > 0 && str-byte-at(spec, 0) == 47

let path-join(dir: Str, spec: Str) -> Str =
  cond
    | path-is-abs(spec) -> spec
    | dir == "." || dir == "" -> spec
    | else -> String.concat(dir, "/", spec)

; Normalize `.` / `..` segments (no symlink resolution).
let normalize-push(acc: List Str, seg: Str) -> List Str =
  cond
    | seg == "." -> acc
    | seg == ".." ->
      match (acc)
        | [] -> []
        | _ :: rest -> rest
    | else -> seg :: acc

let split-segments-from(s: Str, i: Int, n: Int, start: Int, acc: List Str) -> List Str =
  cond
    | i >= n ->
      if (start == n) -> acc | String.slice(start, n - start, s) :: acc
    | str-byte-at(s, i) == 47 ->
      split-segments-from(
        s,
        i + 1,
        n,
        i + 1,
        if (start == i) -> acc | normalize-push(acc, String.slice(start, i - start, s))
      )
    | else -> split-segments-from(s, i + 1, n, start, acc)

let join-segments(xs: List Str, abs: Bool) -> Str =
  match (xs)
    | [] ->
      if (abs) -> "/" | "."
    | h :: rest -> join-segments-cons(h, rest, abs)

let join-segments-cons(h: Str, rest: List Str, abs: Bool) -> Str =
  match (rest)
    | [] ->
      if (abs) -> String.concat("/", h) | h
    | n :: more ->
      String.concat(if (abs) -> String.concat("/", h) | h, "/", join-segments-cons(n, more, false))

let path-normalize(path: Str) -> Str {
  let abs = path-is-abs(path)
  let n = String.length(path)
  let segs-rev = split-segments-from(path, 0, n, 0, [])
  let segs = reverse(segs-rev)
  join-segments(segs, abs)
}

; s without a leading prefix. The caller has already checked the prefix.
let drop-prefix(s: Str, n: Int) -> Str =
  String.slice(n, String.length(s) - n, s)

; Index of byte b at or after i, or -1.
let index-of-byte(s: Str, b: Int, i: Int) -> Int =
  cond
    | i >= String.length(s) -> -1
    | String.byte(i, s) == b -> i
    | else -> index-of-byte(s, b, i + 1)

; name.mnd when name does not already end in .mnd.
let ensure-mnd(name: Str) -> Str =
  if (String.ends-with(".mnd", name)) -> name | String.concat(name, ".mnd")

let join-dir(dir: Str, rel: Str) -> Str =
  if (dir == "/") -> String.concat("/", rel) | String.concat(dir, "/", rel)

; `std/list` → `stdlib/list.mnd`, independent of the importing file.
; The working directory is tried first. Each parent is tried after that,
; so a command run inside `stdlib/` still finds `stdlib/list.mnd`.
let std-path(spec: Str) -> Str = {
  let rel = String.concat("stdlib/", ensure-mnd(drop-prefix(spec, 4)))
  if (exists(rel)) -> rel | std-path-from(rel, path-dirname(cwd()))
}

let std-path-from(rel: Str, dir: Str) -> Str = {
  let candidate = join-dir(dir, rel)
  cond
    | exists(candidate) -> candidate
    | dir == "/" -> rel
    | else ->
      {
        let up = path-dirname(dir)
        if (up == dir) -> rel | std-path-from(rel, up)
      }
}

; Cache root for github: imports. HOME/.menard/deps, or .menard/deps.
let deps-root() -> Str =
  match (getenv("HOME"))
    | Some(h) ->
      if (String.length(h) > 0) -> String.concat(h, "/.menard/deps") | ".menard/deps"
    | None -> ".menard/deps"

; `github:owner/repo@version/module` → the cached file, or spec when it
; does not parse. module may contain slashes.
let github-cache-path(spec: Str) -> Str {
  let rest = drop-prefix(spec, 7)
  let at = index-of-byte(rest, 64, 0)
  cond
    | at < 1 -> spec
    | else ->
      {
        let owner-repo = String.slice(0, at, rest)
        let slash = index-of-byte(owner-repo, 47, 0)
        let after = drop-prefix(rest, at + 1)
        let vslash = index-of-byte(after, 47, 0)
        cond
          | slash < 1 || vslash < 1 -> spec
          | else ->
            {
              let owner = String.slice(0, slash, owner-repo)
              let repo = drop-prefix(owner-repo, slash + 1)
              let version = String.slice(0, vslash, after)
              let module = drop-prefix(after, vslash + 1)
              String.concat(deps-root(), "/", owner, "/", repo, "/", version, "/", ensure-mnd(module))
            }
      }
}

let resolve-import-path(from-path: Str, spec: Str) -> Str =
  cond
    | String.starts-with("std/", spec) -> std-path(spec)
    | String.starts-with("github:", spec) -> github-cache-path(spec)
    | else -> path-normalize(path-join(path-dirname(from-path), spec))

; True when path is inside the github dependency cache.
let in-deps(path: Str) -> Bool =
  String.starts-with(".menard/deps", path) || String.starts-with("/.menard/deps", path) || index-of-from(path, "/.menard/deps/") >= 0

let index-of-from(s: Str, needle: Str) -> Int =
  index-of-from-at(s, needle, 0)

let index-of-from-at(s: Str, needle: Str, i: Int) -> Int {
  let n = String.length(needle)
  let sn = String.length(s)
  cond
    | i + n > sn -> -1
    | String.slice(i, n, s) == needle -> i
    | else -> index-of-from-at(s, needle, i + 1)
}

let spawn-ok(st: SpawnStatus) -> Bool =
  match (st)
    | Exited(n) -> n == 0
    | Signalled(_) -> false

; owner, repo, and version parsed out of a cache path.
record DepSpec {
  owner: Str
  repo: Str
  version: Str
}

; The three segments after `/.menard/deps/` or `.menard/deps/`.
let dep-spec-of(path: Str) -> Maybe DepSpec {
  let mark = "/.menard/deps/"
  let rel =
    cond
      | String.starts-with(".menard/deps/", path) -> drop-prefix(path, 13)
      | else ->
        {
          let i = index-of-from(path, mark)
          if (i < 0) -> "" | drop-prefix(path, i + String.length(mark))
        }
  let s1 = index-of-byte(rel, 47, 0)
  cond
    | s1 < 1 -> None()
    | else ->
      {
        let s2 = index-of-byte(rel, 47, s1 + 1)
        cond
          | s2 < 0 -> None()
          | else ->
            {
              let s3 = index-of-byte(rel, 47, s2 + 1)
              if (s3 < 0) -> None() | Some(DepSpec(String.slice(0, s1, rel), String.slice(s1 + 1, s2 - s1 - 1, rel), String.slice(s2 + 1, s3 - s2 - 1, rel)))
            }
      }
}

; Download the tag archive into the cache directory when the module file
; is not already there. Tests seed the cache and do not reach this.
let fetch-dep(spec: DepSpec) -> Result Unit Str =
  match (spec)
    | DepSpec(owner, repo, version) ->
      {
        let dir = String.concat(deps-root(), "/", owner, "/", repo, "/", version)
        cond
          | ensure-dir(dir) ->
            {
              let tgz = String.concat(dir, "/.src.tgz")
              let url = String.concat("https://codeload.github.com/", owner, "/", repo, "/tar.gz/refs/tags/", version)
              match (spawn(["/usr/bin/curl", "-fsSL", "-o", tgz, url]))
                | Err(_) -> Err(String.concat("cannot fetch ", url))
                | Ok(st) ->
                  cond
                    | spawn-ok(st) ->
                      match (spawn(["/usr/bin/tar", "-xzf", tgz, "-C", dir, "--strip-components=1"]))
                        | Err(_) -> Err(String.concat("cannot extract ", url))
                        | Ok(st2) ->
                          cond
                            | spawn-ok(st2) ->
                              {
                                remove(tgz)
                                Ok(())
                              }
                            | else -> Err(String.concat("cannot extract ", url))
                    | else -> Err(String.concat("cannot fetch ", url))
            }
          | else -> Err(String.concat("cannot create ", dir))
      }

; Make a github cache path exist. Other paths are left for read-file.
pub let ensure-module-file(path: Str) -> Result Unit Str =
  cond
    | exists(path) -> Ok(())
    | in-deps(path) ->
      match (dep-spec-of(path))
        | None -> Err(String.concat("bad dependency path: ", path))
        | Some(spec) -> fetch-dep(spec)
    | else -> Ok(())

; `owner/repo` and the version, from a github: specifier.
record GithubVer {
  key: Str
  version: Str
}

let github-ver(spec: Str) -> Maybe GithubVer =
  cond
    | String.starts-with("github:", spec) ->
      {
        let rest = drop-prefix(spec, 7)
        let at = index-of-byte(rest, 64, 0)
        cond
          | at < 1 -> None()
          | else ->
            {
              let owner-repo = String.slice(0, at, rest)
              let after = drop-prefix(rest, at + 1)
              let vslash = index-of-byte(after, 47, 0)
              if (vslash < 1) -> None() | Some(GithubVer(owner-repo, String.slice(0, vslash, after)))
            }
      }
    | else -> None()

; Record owner/repo → version. A second version is an error.
let note-version(versions: Ref (Map Str Str), spec: Str) -> Result Unit Str =
  match (github-ver(spec))
    | None -> Ok(())
    | Some(GithubVer(key, version)) ->
      match (Map.lookup(key, deref(versions)))
        | None ->
          {
            set!(versions, Map.set(key, version, deref(versions)))
            Ok(())
          }
        | Some(prev) ->
          if (prev == version) -> Ok(()) | Err(String.concat("two versions of ", key, ": ", prev, " and ", version))

pub let note-versions(versions: Ref (Map Str Str), specs: List Str) -> Result Unit Str =
  match (specs)
    | [] -> Ok(())
    | spec :: rest -> Result.and-then(fn (_) = note-versions(versions, rest), note-version(versions, spec))

let is-basics-path(path: Str) -> Bool =
  path == "stdlib/basics.mnd" || String.ends-with("/stdlib/basics.mnd", path)

let is-basics-spec(spec: Str) -> Bool =
  spec == "std/basics" || spec == "std/basics.mnd"

let specs-have-basics(specs: List Str) -> Bool =
  match (specs)
    | [] -> false
    | s :: rest ->
      if (is-basics-spec(s)) -> true | specs-have-basics(rest)

; Every module except basics itself imports std/basics.
pub let specs-with-basics(path: Str, specs: List Str) -> List Str =
  if (is-basics-path(path) || specs-have-basics(specs)) -> specs | "std/basics" :: specs

let spec-text(spec: Ast) -> Maybe Str =
  match (spec)
    | StrNode(s, _) -> Some(s)
    | SymNode(s, _) -> Some(s)
    | _ -> None()

let parse-import-spec(form: Ast) -> Maybe Str =
  match (form)
    | ParenNode(head :: rest, sp) ->
      cond
        | is-sym(head, "pub") -> parse-import-spec(ParenNode(rest, sp))
        | is-sym(head, "import") ->
          match (rest)
            | spec :: _ -> spec-text(spec)
            | [] -> None()
        | else -> None()
    | _ -> None()

let unwrap-pub-form(form: Ast) -> Ast =
  match (form)
    | ParenNode(head :: rest, sp) ->
      if (is-sym(head, "pub")) -> ParenNode(rest, sp) | form
    | _ -> form

let strip-imports-and-pub(forms: List Ast, acc: List Ast) -> List Ast =
  match (forms)
    | [] -> reverse(acc)
    | f :: rest ->
      match (parse-import-spec(f))
        | Some(_) -> strip-imports-and-pub(rest, acc)
        | None -> strip-imports-and-pub(rest, unwrap-pub-form(f) :: acc)

let collect-import-specs(forms: List Ast, acc: List Str) -> List Str =
  match (forms)
    | [] -> reverse(acc)
    | f :: rest ->
      match (parse-import-spec(f))
        | Some(spec) -> collect-import-specs(rest, spec :: acc)
        | None -> collect-import-specs(rest, acc)

; ---------------------------------------------------------------------------
; Private-symbol uniquification (slice H)

let decl-name-of(name-part: Ast) -> Maybe Str =
  match (name-part)
    | SymNode(n, _) -> Some(n)
    | ParenNode(n-ast :: _, _) -> sym-str(n-ast)
    | _ -> None()

let push-unique(xs: List Str, x: Str) -> List Str =
  match (xs)
    | [] -> [x]
    | h :: rest ->
      if (h == x) -> xs | h :: push-unique(rest, x)

let gather-ctor-names(ctors: List Ast, acc: List Str) -> List Str =
  match (ctors)
    | [] -> acc
    | c :: rest ->
      match (c)
        | ParenNode(cname-ast :: _, _) ->
          match (sym-str(cname-ast))
            | Some(n) -> gather-ctor-names(rest, push-unique(acc, n))
            | None -> gather-ctor-names(rest, acc)
        | _ -> gather-ctor-names(rest, acc)

let gather-variant-names(name-part: Ast, ctors: List Ast, acc: List Str) -> List Str {
  let acc1 =
    match (decl-name-of(name-part))
      | Some(n) -> push-unique(acc, n)
      | None -> acc
  gather-ctor-names(ctors, acc1)
}

let gather-decl-name-list(head: Str, rest: List Ast, acc: List Str) -> List Str =
  cond
    | head == "let" ->
      match (rest)
        | name-part :: _ ->
          match (sym-str(name-part))
            | Some(n) -> push-unique(acc, n)
            | None -> acc
        | [] -> acc
    | head == "defn" || head == "runtime" ->
      match (rest)
        | name-part :: _ ->
          match (decl-name-of(name-part))
            | Some(n) -> push-unique(acc, n)
            | None -> acc
        | [] -> acc
    | head == "alias" ->
      match (rest)
        | name-part :: _ ->
          match (sym-str(name-part))
            | Some(n) -> push-unique(acc, n)
            | None -> acc
        | [] -> acc
    | head == "defrec" ->
      match (rest)
        | name-part :: _ ->
          match (decl-name-of(name-part))
            | Some(n) -> push-unique(acc, n)
            | None -> acc
        | [] -> acc
    | head == "variant" ->
      match (rest)
        | name-part :: ctors -> gather-variant-names(name-part, ctors, acc)
        | [] -> acc
    | else -> acc

let gather-form-names(form: Ast, acc: List Str) -> List Str =
  match (form)
    | ParenNode(head :: rest, sp) ->
      cond
        | is-sym(head, "pub") -> gather-form-names(ParenNode(rest, sp), acc)
        | is-sym(head, "import") -> acc
        | else ->
          match (sym-str(head))
            | None -> acc
            | Some(hn) -> gather-decl-name-list(hn, rest, acc)
    | _ -> acc

let gather-forms-names(forms: List Ast, acc: List Str) -> List Str =
  match (forms)
    | [] -> acc
    | f :: rest -> gather-forms-names(rest, gather-form-names(f, acc))

; Only names introduced by `(pub …)` forms.
let gather-pub-form-names(form: Ast, acc: List Str) -> List Str =
  match (form)
    | ParenNode(head :: rest, sp) ->
      if (is-sym(head, "pub")) -> gather-form-names(ParenNode(rest, sp), acc) | acc
    | _ -> acc

let gather-pub-forms-names(forms: List Ast, acc: List Str) -> List Str =
  match (forms)
    | [] -> acc
    | f :: rest -> gather-pub-forms-names(rest, gather-pub-form-names(f, acc))

let list-to-bool-map(xs: List Str, acc: Map Str Bool) -> Map Str Bool =
  match (xs)
    | [] -> acc
    | n :: rest -> list-to-bool-map(rest, Map.set(n, true, acc))

let name-is-pub(pub-names: Map Str Bool, name: Str) -> Bool =
  match (Map.lookup(name, pub-names))
    | Some(_) -> true
    | None -> false

let module-prefix(mid: Int) -> Str =
  String.concat("__m", show(mid), "_")

let add-rename(renames: Map Str Str, prefix: Str, name: Str) -> Map Str Str =
  Map.set(name, String.concat(prefix, name), renames)

; Polynomial hash of the path bytes. The modulus keeps every step inside a
; 63-bit Int. The same path always yields the same symbol.
let hash-mix(h: Int, b: Int) -> Int =
  (h * 131 + b) % 2147483647

let hash-bytes(s: Str, i: Int, n: Int, h: Int) -> Int =
  loop (j = i, acc = h)
    if (j >= n) -> acc | recur(j + 1, hash-mix(acc, String.byte(j, s)))

let path-hash(path: Str) -> Int =
  hash-bytes(path, 0, String.length(path), 0)

let main-symbol(path: Str) -> Str =
  String.concat("mn_", show(path-hash(path)), "_main")

let init-symbol(path: Str) -> Str =
  String.concat("mn_", show(path-hash(path)), "_init")

let build-renames-from-list(names: List Str, pub-names: Map Str Bool, prefix: Str, main-sym: Str, acc: Map Str Str) -> Map Str Str =
  match (names)
    | [] -> acc
    | n :: rest ->
      cond
        | n == "main" -> build-renames-from-list(rest, pub-names, prefix, main-sym, Map.set(n, main-sym, acc))
        | name-is-pub(pub-names, n) -> build-renames-from-list(rest, pub-names, prefix, main-sym, acc)
        | else -> build-renames-from-list(rest, pub-names, prefix, main-sym, add-rename(acc, prefix, n))

let qualified-prefix(path: Str) -> Str =
  String.concat("__q", show(path-hash(path)), "_")

let build-renames(forms: List Ast, mid: Int, main-sym: Str, qualify: Bool, path: Str) -> Map Str Str {
  let pub-list =
    if (qualify) -> [] | gather-pub-forms-names(forms, [])
  let all-list = gather-forms-names(forms, [])
  let pub-names = list-to-bool-map(pub-list, Map.empty())
  let prefix =
    if (qualify) -> qualified-prefix(path) | module-prefix(mid)
  build-renames-from-list(all-list, pub-names, prefix, main-sym, Map.empty())
}

let rename-lookup(renames: Map Str Str, name: Str) -> Str =
  match (Map.lookup(name, renames))
    | Some(n) -> n
    | None -> name

; Leave `(quote …)` bodies untouched (symbols are data, not refs).
let rename-paren(xs: List Ast, sp: Span, renames: Map Str Str) -> Ast =
  match (xs)
    | head :: rest ->
      if (is-sym(head, "quote") || is-sym(head, "char")) -> ParenNode(xs, sp) | ParenNode(rename-ast-list(xs, renames), sp)
    | [] -> ParenNode(xs, sp)

let rename-ast(a: Ast, renames: Map Str Str) -> Ast =
  match (a)
    | SymNode(n, sp) -> SymNode(rename-lookup(renames, n), sp)
    | ParenNode(xs, sp) -> rename-paren(xs, sp, renames)
    | BracketNode(xs, sp) -> BracketNode(rename-ast-list(xs, renames), sp)
    | _ -> a

let rename-ast-list(xs: List Ast, renames: Map Str Str) -> List Ast =
  match (xs)
    | [] -> []
    | x :: rest -> rename-ast(x, renames) :: rename-ast-list(rest, renames)

let rename-forms(forms: List Ast, renames: Map Str Str) -> List Ast =
  rename-ast-list(forms, renames)

; Decl head of a top-level form after pub unwrap (`alias` / `defn` / …).
let form-decl-kind(form: Ast) -> Str =
  match (unwrap-pub-form(form))
    | ParenNode(head :: _, _) ->
      match (sym-str(head))
        | Some(hn) -> hn
        | None -> ""
    | _ -> ""

; NotFound and Permission are the IoError singletons. SpawnError lists them
; so a match is exhaustive; they are not a second export.
let shared-io-ctor(name: Str) -> Bool =
  name == "NotFound" || name == "Permission"

let register-one-export!(exports: Ref (Map Str Str), path: Str, name: Str, kind: Str) -> Result Unit Str =
  match (Map.lookup(name, deref(exports)))
    | None ->
      {
        set!(exports, Map.set(name, path, deref(exports)))
        Ok(())
      }
    | Some(prev) ->
      cond
        | kind == "alias" || shared-io-ctor(name) -> Ok(())
        | prev == path -> Ok(())
        | else -> Err(String.concat("duplicate pub export `", name, "` from ", path, " (already exported by ", prev, ")"))

let register-export-names!(exports: Ref (Map Str Str), path: Str, names: List Str, kind: Str) -> Result Unit Str =
  match (names)
    | [] -> Ok(())
    | n :: rest ->
      if (n == "main") -> register-export-names!(exports, path, rest, kind) | Result.and-then(fn (_) = register-export-names!(exports, path, rest, kind), register-one-export!(exports, path, n, kind))

let register-form-exports!(exports: Ref (Map Str Str), path: Str, form: Ast) -> Result Unit Str =
  match (form)
    | ParenNode(head :: rest, sp) ->
      cond
        | is-sym(head, "pub") ->
          {
            let inner = ParenNode(rest, sp)
            let kind = form-decl-kind(inner)
            let names = gather-form-names(inner, [])
            register-export-names!(exports, path, names, kind)
          }
        | else -> Ok(())
    | _ -> Ok(())

let register-forms-exports!(exports: Ref (Map Str Str), path: Str, forms: List Ast) -> Result Unit Str =
  match (forms)
    | [] -> Ok(())
    | f :: rest -> Result.and-then(fn (_) = register-forms-exports!(exports, path, rest), register-form-exports!(exports, path, f))

; ---------------------------------------------------------------------------
; Per-module init and the program bootstrap

let sym-node(n: Str) -> Ast =
  SymNode(n, dummy-span())

let call-form(name: Str) -> Ast =
  ParenNode([sym-node(name)], dummy-span())

let int-form(n: Int) -> Ast =
  IntNode(n, dummy-span())

let unit-form() -> Ast =
  ParenNode([], dummy-span())

let defn-form(name: Str, ret: Str, body: List Ast) -> Ast =
  ParenNode(append-asts([sym-node("defn"), sym-node(name), sym-node("->"), sym-node(ret)], body), dummy-span())

let is-kept-decl(form: Ast) -> Bool {
  let k = form-decl-kind(form)
  k == "defn" || k == "defrec" || k == "variant" || k == "alias" || k == "extern" || k == "runtime"
}

; Integer `(let name N)` stays at module scope so constant substitution
; still sees it. A non-integer `(let name expr)` stays there too, so
; typechecking still binds the name for later `defn`s, and is copied into
; the module init so it runs once. Every other top-level expression runs
; from the init only.
let is-int-let(form: Ast) -> Bool =
  match (form)
    | ParenNode([head, _, expr], _) ->
      cond
        | is-sym(head, "let") ->
          match (expr)
            | IntNode(_, _) -> true
            | _ -> false
        | else -> false
    | _ -> false

let is-value-let(form: Ast) -> Bool =
  match (form)
    | ParenNode([head, _, expr], _) ->
      cond
        | is-sym(head, "let") ->
          match (expr)
            | IntNode(_, _) -> false
            | _ -> true
        | else -> false
    | _ -> false

record SplitBody {
  kept: List Ast
  init: List Ast
}

let partition-body(forms: List Ast, kept: List Ast, init: List Ast) -> SplitBody =
  match (forms)
    | [] -> SplitBody(reverse(kept), reverse(init))
    | f :: rest ->
      cond
        | is-kept-decl(f) || is-int-let(f) -> partition-body(rest, f :: kept, init)
        | is-value-let(f) -> partition-body(rest, f :: kept, f :: init)
        | else -> partition-body(rest, kept, f :: init)

let init-defn(name: Str, body: List Ast) -> Ast =
  defn-form(name, "Unit", append-asts(body, [unit-form()]))

let with-module-init(path: Str, forms: List Ast, inits: Ref (List Str)) -> List Ast =
  match (partition-body(forms, [], []))
    | SplitBody(kept, init) ->
      match (init)
        | [] -> kept
        | _ ->
          {
            let sym = init-symbol(path)
            set!(inits, snoc-str(deref(inits), sym))
            append-asts(kept, [init-defn(sym, init)])
          }

let return-after-arrow(xs: List Ast) -> Maybe Str =
  match (xs)
    | [] -> None()
    | x :: rest ->
      cond
        | is-sym(x, "->") ->
          match (rest)
            | ret :: _ ->
              match (sym-str(ret))
                | Some(n) -> Some(n)
                | None -> Some("")
            | [] -> None()
        | else -> return-after-arrow(rest)

let defn-return-rest(rest: List Ast, want: Str) -> Maybe Str =
  match (rest)
    | name-ast :: after ->
      match (sym-str(name-ast))
        | Some(n) ->
          if (n == want) -> return-after-arrow(after) | None()
        | None -> None()
    | [] -> None()

let defn-return-named(form: Ast, want: Str) -> Maybe Str =
  match (form)
    | ParenNode(head :: rest, _) ->
      if (is-sym(head, "defn")) -> defn-return-rest(rest, want) | None()
    | _ -> None()

let find-main-return(forms: List Ast, want: Str) -> Maybe Str =
  match (forms)
    | [] -> None()
    | f :: rest ->
      match (defn-return-named(f, want))
        | Some(r) -> Some(r)
        | None -> find-main-return(rest, want)

let note-entry!(path: Str, entry-path: Str, forms: List Ast, entry: Ref EntryMain) -> Unit =
  cond
    | path == entry-path ->
      match (find-main-return(forms, main-symbol(path)))
        | Some(ret) -> set!(entry, EntryMain(main-symbol(path), ret == "Unit", true))
        | None -> ()

let calls-of(names: List Str) -> List Ast =
  match (names)
    | [] -> []
    | n :: rest -> call-form(n) :: calls-of(rest)

let bootstrap-body(inits: List Str, main-sym: Str, unit-ret: Bool) -> List Ast {
  let calls = append-asts(calls-of(inits), [call-form(main-sym)])
  if (unit-ret) -> append-asts(calls, [int-form(0)]) | calls
}

let bootstrap-defn(inits: List Str, main-sym: Str, unit-ret: Bool) -> Ast =
  defn-form("main", "Int", bootstrap-body(inits, main-sym, unit-ret))

let forms-with-bootstrap(forms: List Ast, inits: List Str, entry: EntryMain) -> List Ast =
  match (entry)
    | EntryMain(sym, unit, present) ->
      if (present) -> append-asts(forms, [bootstrap-defn(inits, sym, unit)]) | forms

; Strip imports/pub, uniquify privates, rename `main`, lift top-level
; expressions into this module's init.
let uniquify-module-body(path: Str, entry-path: Str, mid: Int, forms: List Ast, exports: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain) -> Result (List Ast) Str =
  match (runtime-misplaced(path, forms))
    | Some(msg) -> Err(msg)
    | None ->
      Result.and-then(
        fn (_) {
          let renames = build-renames(forms, mid, main-symbol(path), Map.has(path, deref(qualified-imports)), path)
          note-renamed-runtime!(path, forms, renames)
          let stripped = strip-imports-and-pub(forms, [])
          let renamed = rename-forms(stripped, renames)
          let body = fold-runtime-forms(with-module-init(path, renamed, inits))
          note-entry!(path, entry-path, body, entry)
          Ok(body)
        },
        if (Map.has(path, deref(qualified-imports))) -> Ok(()) | register-forms-exports!(exports, path, forms)
      )

; ---------------------------------------------------------------------------
; Module graph load

let load-module-into(path: Str, entry-path: Str, visited: Ref (Map Str Bool), acc: Ref (List Ast), mid: Ref Int, exports: Ref (Map Str Str), paths: Ref (List Str), sources: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain, versions: Ref (Map Str Str)) -> Result Unit Str =
  match (Map.lookup(path, deref(visited)))
    | Some(_) -> Ok(())
    | None ->
      {
        set!(visited, Map.set(path, true, deref(visited)))
        Result.and-then(
          fn (_) =
            match (read-file(path))
              | Err(_) -> Err(String.concat("module not found: ", path))
              | Ok(src) -> load-module-source(path, entry-path, src, visited, acc, mid, exports, paths, sources, inits, entry, versions),
          ensure-module-file(path)
        )
      }

let load-module-source(path: Str, entry-path: Str, src: Str, visited: Ref (Map Str Bool), acc: Ref (List Ast), mid: Ref Int, exports: Ref (Map Str Str), paths: Ref (List Str), sources: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain, versions: Ref (Map Str Str)) -> Result Unit Str {
  set!(sources, Map.set(path, src, deref(sources)))
  match (read-all(src))
    | Err(e) -> Err(String.concat("parse error in ", path))
    | Ok(forms) -> load-module-casing(path, entry-path, forms, visited, acc, mid, exports, paths, sources, inits, entry, versions)
}

let load-module-casing(path: Str, entry-path: Str, forms: List Ast, visited: Ref (Map Str Bool), acc: Ref (List Ast), mid: Ref Int, exports: Ref (Map Str Str), paths: Ref (List Str), sources: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain, versions: Ref (Map Str Str)) -> Result Unit Str =
  match (check-casing-all(forms))
    | Err(_) -> Err(String.concat("casing error in ", path))
    | Ok(_) -> load-module-desugar(path, entry-path, forms, visited, acc, mid, exports, paths, sources, inits, entry, versions)

let load-module-desugar(path: Str, entry-path: Str, forms: List Ast, visited: Ref (Map Str Bool), acc: Ref (List Ast), mid: Ref Int, exports: Ref (Map Str Str), paths: Ref (List Str), sources: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain, versions: Ref (Map Str Str)) -> Result Unit Str =
  match (desugar-all(forms))
    | Err(_) -> Err(String.concat("desugar error in ", path))
    | Ok(desugared) -> load-module-deps(path, entry-path, desugared, visited, acc, mid, exports, paths, sources, inits, entry, versions)

; The name after `import path as`, if this form has one.
let import-alias-of(form: Ast) -> Maybe Str =
  match (form)
    | ParenNode(head :: rest, sp) ->
      if (is-sym(head, "pub")) -> import-alias-of(ParenNode(rest, sp)) | import-alias-import(head, rest)
    | _ -> None()

; Alias of an import form, ignoring every other head.
let import-alias-import(head: Ast, rest: List Ast) -> Maybe Str =
  if (is-sym(head, "import")) -> import-alias-rest(rest) | None()

; The third element of an import is the alias.
let import-alias-rest(rest: List Ast) -> Maybe Str =
  match (rest)
    | _ :: mod :: _ -> sym-str(mod)
    | _ -> None()

; Map each qualified-import name to its resolved module path.
let qualified-import-paths(from: Str, forms: List Ast, acc: Map Str Str) -> Map Str Str =
  match (forms)
    | [] -> acc
    | f :: rest ->
      match (import-alias-of(f))
        | Some(name) ->
          match (parse-import-spec(f))
            | Some(spec) -> qualified-import-paths(from, rest, Map.set(name, resolve-import-path(from, spec), acc))
            | None -> qualified-import-paths(from, rest, acc)
        | None -> qualified-import-paths(from, rest, acc)

let mark-qualified-imports!(from: Str, forms: List Ast) -> Unit {
  let paths = qualified-import-paths(from, forms, Map.empty())
  let names = Map.keys(paths)
  mark-qualified-names!(names, paths)
}

let mark-qualified-names!(names: List Str, paths: Map Str Str) -> Unit =
  match (names)
    | [] -> ()
    | name :: rest ->
      {
        match (Map.lookup(name, paths))
          | Some(path) -> set!(qualified-imports, Map.set(path, true, deref(qualified-imports)))
          | None -> ()
        mark-qualified-names!(rest, paths)
      }

; Rewrite each child of a form.
let rewrite-qual-list(elems: List Ast, aliases: Map Str Str, qualify: Bool) -> List Ast =
  match (elems)
    | [] -> []
    | e :: rest -> rewrite-qual-ast(e, aliases, qualify) :: rewrite-qual-list(rest, aliases, qualify)

; `Alias.name` becomes the export's own name in the flat program.
let rewrite-qual-project(obj: Ast, field: Ast, sp: Span, aliases: Map Str Str, qualify: Bool) -> Ast {
  let obj2 = rewrite-qual-ast(obj, aliases, qualify)
  let field2 = rewrite-qual-ast(field, aliases, qualify)
  match (sym-str(obj2))
    | Some(name) ->
      match (Map.lookup(name, aliases))
        | Some(path) ->
          match (sym-str(field2))
            | Some(field-name) ->
              if (qualify) -> SymNode(String.concat(qualified-prefix(path), field-name), sp) | SymNode(String.concat(import-alias-prefix(name), field-name), sp)
            | None -> field2
        | None -> ParenNode([SymNode("project", sp), obj2, field2], sp)
    | None -> ParenNode([SymNode("project", sp), obj2, field2], sp)
}

; Qualified projection resolves here; record projection stays.
let rewrite-qual-node(elems: List Ast, sp: Span, aliases: Map Str Str, qualify: Bool) -> Ast =
  match (elems)
    | head :: obj :: field :: _ ->
      if (is-sym(head, "project")) -> rewrite-qual-project(obj, field, sp, aliases, qualify) | ParenNode(rewrite-qual-list(elems, aliases, qualify), sp)
    | _ -> ParenNode(rewrite-qual-list(elems, aliases, qualify), sp)

; Walk one form for qualified names.
let rewrite-qual-ast(ast: Ast, aliases: Map Str Str, qualify: Bool) -> Ast =
  match (ast)
    | ParenNode(elems, sp) -> rewrite-qual-node(elems, sp, aliases, qualify)
    | BracketNode(elems, sp) -> BracketNode(rewrite-qual-list(elems, aliases, qualify), sp)
    | _ -> ast

; Resolve `import … as` projections before typechecking a module.
let rewrite-qual-forms(forms: List Ast, aliases: Map Str Str, qualify: Bool) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> rewrite-qual-ast(f, aliases, qualify) :: rewrite-qual-forms(rest, aliases, qualify)

; Replace qualified import projections with module-local import names.
pub let rewrite-import-aliases(from: Str, forms: List Ast) -> List Ast =
  rewrite-qual-forms(forms, qualified-import-paths(from, forms, Map.empty()), false)

; Separate compilation binds qualified exports under module-local names.
pub let import-alias-prefix(name: Str) -> Str =
  String.concat("__import_", name, "_")

pub let module-import-alias(form: Ast) -> Maybe Str =
  import-alias-of(form)

let rewrite-flat-import-aliases(from: Str, forms: List Ast) -> List Ast =
  rewrite-qual-forms(forms, qualified-import-paths(from, forms, Map.empty()), true)

let load-module-deps(path: Str, entry-path: Str, forms: List Ast, visited: Ref (Map Str Bool), acc: Ref (List Ast), mid: Ref Int, exports: Ref (Map Str Str), paths: Ref (List Str), sources: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain, versions: Ref (Map Str Str)) -> Result Unit Str {
  mark-qualified-imports!(path, forms)
  let specs = specs-with-basics(path, collect-import-specs(forms, []))
  Result.and-then(
    fn (_) =
      Result.and-then(
        fn (_) {
          let id = deref(mid)
          set!(mid, id + 1)
          set!(paths, snoc-str(deref(paths), path))
          let src =
            match (Map.lookup(path, deref(sources)))
              | Some(s) -> s
              | None -> ""
          let stamped = stamp-forms(forms, src, id)
          let qualified = rewrite-flat-import-aliases(path, stamped)
          Result.and-then(
            fn (body) {
              set!(acc, append-asts(deref(acc), body))
              Ok(())
            },
            uniquify-module-body(path, entry-path, id, qualified, exports, inits, entry)
          )
        },
        load-deps-list(path, entry-path, specs, visited, acc, mid, exports, paths, sources, inits, entry, versions)
      ),
    note-versions(versions, specs)
  )
}

let load-deps-list(from: Str, entry-path: Str, specs: List Str, visited: Ref (Map Str Bool), acc: Ref (List Ast), mid: Ref Int, exports: Ref (Map Str Str), paths: Ref (List Str), sources: Ref (Map Str Str), inits: Ref (List Str), entry: Ref EntryMain, versions: Ref (Map Str Str)) -> Result Unit Str =
  match (specs)
    | [] -> Ok(())
    | spec :: rest -> Result.and-then(fn (_) = load-deps-list(from, entry-path, rest, visited, acc, mid, exports, paths, sources, inits, entry, versions), load-module-into(resolve-import-path(from, spec), entry-path, visited, acc, mid, exports, paths, sources, inits, entry, versions))

; Public entry: flatten `entry-path` (already read as `src`) into forms plus
; the path of each module id, dependency-first. When the entry defines
; `main`, the flat list ends with the bootstrap that calls it.
; Declared here, before the flatten that clears it. Later passes read it.
let runtime-ops = ref(Map.empty())

pub let flatten-module-graph(entry-path: Str, src: Str) -> Result Flat Str {
  set!(qualified-imports, Map.empty())
  set!(runtime-ops, Map.empty())
  let visited = ref(Map.empty())
  let acc = ref([])
  let mid = ref(0)
  let exports = ref(Map.empty())
  let paths = ref([])
  let sources = ref(Map.empty())
  let inits = ref([])
  let entry = ref(EntryMain("", false, false))
  let versions = ref(Map.empty())
  set!(visited, Map.set(entry-path, true, deref(visited)))
  Result.and-then(fn (_) = Ok(Flat(forms-with-bootstrap(deref(acc), deref(inits), deref(entry)), deref(paths))), load-module-source(entry-path, entry-path, src, visited, acc, mid, exports, paths, sources, inits, entry, versions))
}

; Separate compilation uses the same path hash and rename walk. The
; hash is of whatever string the caller passes; the driver canonicalizes
; first so `./fred.mnd` and `fred.mnd` are one module.
pub let bytes-hash(s: Str) -> Int =
  path-hash(s)

pub let link-of(path: Str, name: Str) -> Str =
  String.concat("mn_", show(path-hash(path)), "_", name)

pub let rename-module-forms(forms: List Ast, renames: Map Str Str) -> List Ast =
  rename-forms(forms, renames)

pub let strip-module-forms(forms: List Ast) -> List Ast =
  strip-imports-and-pub(forms, [])

pub let import-specs(forms: List Ast) -> List Str =
  collect-import-specs(forms, [])

pub let resolve-import(from-path: Str, spec: Str) -> Str =
  resolve-import-path(from-path, spec)

pub let normalize-path(path: Str) -> Str =
  path-normalize(path)

pub let module-init-forms(path: Str, forms: List Ast, inits: Ref (List Str)) -> List Ast =
  with-module-init(path, forms, inits)

pub let defn-return-type(forms: List Ast, name: Str) -> Maybe Str =
  find-main-return(forms, name)

; Runtime bindings. A published name in std/string, std/map, or
; std/string-buffer lowers to one direct runtime call. The map is filled
; while a module graph is flattened or while one separate-compilation
; unit is prepared, then read by the fold (before typecheck) and the
; rewrite (after typecheck). `runtime-ops` itself is declared above
; `flatten-module-graph`, which clears it.

let path-ends(path: Str, suffix: Str) -> Bool {
  let p = if (String.length(path) > 0 && String.byte(0, path) == 47) -> path | String.concat("/", path)
  let n = String.length(p)
  let m = String.length(suffix)
  n >= m && String.slice(n - m, m, p) == suffix
}

let string-op(name: Str) -> Maybe Str =
  cond
    | name == "length" -> Some("str-byte-length")
    | name == "byte" -> Some("str-byte")
    | name == "slice" -> Some("str-slice")
    | name == "concat" -> Some("str-concat")
    | name == "from-char" -> Some("char->str")
    | else -> None()

let map-op(name: Str) -> Maybe Str =
  cond
    | name == "empty" -> Some("map-new")
    | name == "size" -> Some("map-size")
    | name == "keys" -> Some("map-keys")
    | else -> None()

let buffer-op(name: Str) -> Maybe Str =
  cond
    | name == "new" -> Some("sb-new")
    | name == "append!" -> Some("sb-append!")
    | name == "append-byte!" -> Some("sb-append-byte!")
    | name == "length" -> Some("sb-length")
    | name == "clear!" -> Some("sb-clear!")
    | name == "to-str" -> Some("sb-to-str")
    | name == "take-str!" -> Some("sb-take-str!")
    | else -> None()

let runtime-module(path: Str) -> Bool =
  path-ends(path, "/stdlib/string.mnd") || path-ends(path, "/stdlib/map.mnd") || path-ends(path, "/stdlib/string-buffer.mnd")

let runtime-misplaced-list(forms: List Ast) -> Maybe Str =
  match (forms)
    | [] -> None()
    | f :: rest ->
      if (is-runtime-form(f)) -> Some("runtime is confined to stdlib string, map, and string-buffer") | runtime-misplaced-list(rest)

pub let runtime-misplaced(path: Str, forms: List Ast) -> Maybe Str =
  if (runtime-module(path)) -> None() | runtime-misplaced-list(forms)

let runtime-binding(path: Str, name: Str) -> Maybe Str =
  cond
    | path-ends(path, "/stdlib/string.mnd") -> string-op(name)
    | path-ends(path, "/stdlib/map.mnd") -> map-op(name)
    | path-ends(path, "/stdlib/string-buffer.mnd") -> buffer-op(name)
    | else -> None()

let note-runtime!(symbol: Str, op: Str) -> Unit =
  set!(runtime-ops, Map.set(symbol, op, deref(runtime-ops)))

let runtime-decl-name(form: Ast) -> Maybe Str =
  match (unwrap-pub-form(form))
    | ParenNode(head :: name :: _, _) ->
      if (is-sym(head, "runtime")) -> decl-name-of(name) | None()
    | _ -> None()

let note-renamed-runtime-list!(path: Str, forms: List Ast, renames: Map Str Str) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        match (runtime-decl-name(f))
          | Some(name) ->
            match (runtime-binding(path, name))
              | Some(op) -> note-runtime!(rename-lookup(renames, name), op)
              | None -> ()
          | None -> ()
        note-renamed-runtime-list!(path, rest, renames)
      }

let note-renamed-runtime!(path: Str, forms: List Ast, renames: Map Str Str) -> Unit =
  note-renamed-runtime-list!(path, forms, renames)

let note-local-runtime-list!(path: Str, forms: List Ast) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        match (runtime-decl-name(f))
          | Some(name) ->
            match (runtime-binding(path, name))
              | Some(op) -> note-runtime!(name, op)
              | None -> ()
          | None -> ()
        note-local-runtime-list!(path, rest)
      }

let runtime-names(path: Str) -> List Str =
  cond
    | path-ends(path, "/stdlib/string.mnd") -> ["length", "byte", "slice", "concat", "from-char"]
    | path-ends(path, "/stdlib/map.mnd") -> ["empty", "size", "keys"]
    | path-ends(path, "/stdlib/string-buffer.mnd") -> ["new", "append!", "append-byte!", "length", "clear!", "to-str", "take-str!"]
    | else -> []

let note-names!(path: Str, prefix: Str, names: List Str) -> Unit =
  match (names)
    | [] -> ()
    | n :: rest ->
      {
        match (runtime-binding(path, n))
          | Some(op) -> note-runtime!(String.concat(prefix, n), op)
          | None -> ()
        note-names!(path, prefix, rest)
      }

let note-import-list!(from: Str, forms: List Ast) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        match (parse-import-spec(f))
          | Some(spec) ->
            {
              let path = resolve-import-path(from, spec)
              match (import-alias-of(f))
                | Some(alias-name) -> note-names!(path, import-alias-prefix(alias-name), runtime-names(path))
                | None -> note-names!(path, "", runtime-names(path))
            }
          | None -> ()
        note-import-list!(from, rest)
      }

; Clear, then record this module's runtime calls. Used by separate compilation
; after dependencies have finished with the same ref.
pub let prepare-runtime-forms(from: Str, forms: List Ast) -> List Ast {
  set!(runtime-ops, Map.empty())
  note-local-runtime-list!(from, forms)
  note-import-list!(from, forms)
  fold-runtime-forms(forms)
}

let fold-left(name: Str, acc: Ast, rest: List Ast, sp: Span) -> Ast =
  match (rest)
    | [] -> acc
    | b :: more -> fold-left(name, ParenNode([sym-node-span(name, sp), acc, b], sp), more, sp)

let sym-node-span(name: Str, sp: Span) -> Ast =
  SymNode(name, sp)

let fold-concat-args(name: Str, args: List Ast, sp: Span) -> Ast =
  match (args)
    | [] -> ParenNode([sym-node-span(name, sp)], sp)
    | [a] -> a
    | a :: rest -> fold-left(name, a, rest, sp)

let fold-runtime-list(xs: List Ast) -> List Ast =
  match (xs)
    | [] -> []
    | x :: rest -> fold-runtime-ast(x) :: fold-runtime-list(rest)

let fold-runtime-call(name: Str, args: List Ast, sp: Span, whole: List Ast) -> Ast =
  match (Map.lookup(name, deref(runtime-ops)))
    | Some(op) ->
      if (op == "str-concat") -> fold-concat-args(name, fold-runtime-list(args), sp) | ParenNode(sym-node-span(name, sp) :: fold-runtime-list(args), sp)
    | None -> ParenNode(fold-runtime-list(whole), sp)

let fold-runtime-paren(elems: List Ast, sp: Span) -> Ast =
  match (elems)
    | head :: args ->
      if (is-sym(head, "quote") || is-sym(head, "char")) -> ParenNode(elems, sp) | fold-runtime-paren-call(head, args, elems, sp)
    | [] -> ParenNode(elems, sp)

let fold-runtime-paren-call(head: Ast, args: List Ast, elems: List Ast, sp: Span) -> Ast =
  match (sym-str(head))
    | Some(name) -> fold-runtime-call(name, args, sp, elems)
    | None -> ParenNode(fold-runtime-list(elems), sp)

let fold-runtime-ast(a: Ast) -> Ast =
  match (a)
    | ParenNode(elems, sp) -> fold-runtime-paren(elems, sp)
    | BracketNode(xs, sp) -> BracketNode(fold-runtime-list(xs), sp)
    | _ -> a

let fold-runtime-form-list(forms: List Ast) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> fold-runtime-ast(f) :: fold-runtime-form-list(rest)

let fold-runtime-forms(forms: List Ast) -> List Ast =
  fold-runtime-form-list(forms)

let swap-two(args: List Ast) -> List Ast =
  match (args)
    | a :: b :: rest -> b :: a :: rest
    | _ -> args

let rot-three(args: List Ast) -> List Ast =
  match (args)
    | a :: b :: c :: rest -> c :: a :: b :: rest
    | _ -> args

let permute-args(op: Str, args: List Ast) -> List Ast =
  cond
    | op == "str-byte" -> swap-two(args)
    | op == "str-slice" -> rot-three(args)
    | else -> args

let rewrite-runtime-list(xs: List Ast) -> List Ast =
  match (xs)
    | [] -> []
    | x :: rest -> rewrite-runtime-ast(x) :: rewrite-runtime-list(rest)

let rewrite-runtime-call(name: Str, args: List Ast, sp: Span, whole: List Ast) -> Ast =
  match (Map.lookup(name, deref(runtime-ops)))
    | Some(op) -> ParenNode(sym-node-span(op, sp) :: permute-args(op, rewrite-runtime-list(args)), sp)
    | None -> ParenNode(rewrite-runtime-list(whole), sp)

let rewrite-runtime-paren(elems: List Ast, sp: Span) -> Ast =
  match (elems)
    | head :: args ->
      if (is-sym(head, "quote") || is-sym(head, "char")) -> ParenNode(elems, sp) | rewrite-runtime-paren-call(head, args, elems, sp)
    | [] -> ParenNode(elems, sp)

let rewrite-runtime-paren-call(head: Ast, args: List Ast, elems: List Ast, sp: Span) -> Ast =
  match (sym-str(head))
    | Some(name) -> rewrite-runtime-call(name, args, sp, elems)
    | None -> ParenNode(rewrite-runtime-list(elems), sp)

let rewrite-runtime-ast(a: Ast) -> Ast =
  match (a)
    | ParenNode(elems, sp) -> rewrite-runtime-paren(elems, sp)
    | BracketNode(xs, sp) -> BracketNode(rewrite-runtime-list(xs), sp)
    | _ -> a

let is-runtime-form(form: Ast) -> Bool =
  match (unwrap-pub-form(form))
    | ParenNode(head :: _, _) -> is-sym(head, "runtime")
    | _ -> false

let drop-runtime-forms(forms: List Ast, acc: List Ast) -> List Ast =
  match (forms)
    | [] -> reverse(acc)
    | f :: rest ->
      if (is-runtime-form(f)) -> drop-runtime-forms(rest, acc) | drop-runtime-forms(rest, rewrite-runtime-ast(f) :: acc)

; Replace runtime calls with the direct operation and drop the declarations.
pub let lower-runtime-forms(forms: List Ast) -> List Ast =
  drop-runtime-forms(forms, [])

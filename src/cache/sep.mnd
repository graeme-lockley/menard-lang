; Separate compilation. Each module is lowered to its own object under
; `~/.menard`. Cross-module calls are declarations of `mn_<hash>_<name>`.
; A bootstrap object is the only C `main`: it runs module inits in
; dependency order, then the entry module's main. `build-suite` links
; every test file into that one bootstrap.
;
; `mn emit` does not use this path. It still lowers one flat module so
; the fixed-point gate stays a single deterministic bitcode file.
import "../reader/ast.mnd"
import "../reader/read.mnd"
import "../reader/casing.mnd"
import "../desugar/desugar.mnd"
import "../type/check.mnd"
import "../close/close.mnd"
import "../root/root.mnd"
import "../derive/derive.mnd"
import "../emit/llvm-ir.mnd"
import "../emit/lower.mnd"
import "../modules/graph.mnd"
import "../diag/report.mnd"
import "../diag/helps.mnd"
import "./cache.mnd"
import std/fs
import std/io
import std/list
import std/path as Path
import std/proc
import std/string as String
import std/sys
import std/map as Map
import std/string-buffer as Buf
import std/time

record Ctx {
  entry: Str
  for-test: Bool
  clean: Bool
  triple: Str
  done: Ref (Map Str Iface)
  visiting: Ref (Map Str Bool)
  order: Ref (List Str)
  inits: Ref (List Str)
  quiet: Bool
  versions: Ref (Map Str Str)
  suite: Ref (Map Str Bool)
}

let sym-str(ast: Ast) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> Some(n)
    | _ -> None

let ctx-entry(c: Ctx) -> Str =
  match (c)
    | Ctx(e, _, _, _, _, _, _, _, _, _, _) -> e

let ctx-for-test(c: Ctx) -> Bool =
  match (c)
    | Ctx(_, f, _, _, _, _, _, _, _, _, _) -> f

let ctx-clean(c: Ctx) -> Bool =
  match (c)
    | Ctx(_, _, k, _, _, _, _, _, _, _, _) -> k

let ctx-triple(c: Ctx) -> Str =
  match (c)
    | Ctx(_, _, _, t, _, _, _, _, _, _, _) -> t

let ctx-done(c: Ctx) -> Ref (Map Str Iface) =
  match (c)
    | Ctx(_, _, _, _, d, _, _, _, _, _, _) -> d

let ctx-visiting(c: Ctx) -> Ref (Map Str Bool) =
  match (c)
    | Ctx(_, _, _, _, _, v, _, _, _, _, _) -> v

let ctx-order(c: Ctx) -> Ref (List Str) =
  match (c)
    | Ctx(_, _, _, _, _, _, o, _, _, _, _) -> o

let ctx-inits(c: Ctx) -> Ref (List Str) =
  match (c)
    | Ctx(_, _, _, _, _, _, _, i, _, _, _) -> i

let ctx-quiet(c: Ctx) -> Bool =
  match (c)
    | Ctx(_, _, _, _, _, _, _, _, q, _, _) -> q

let ctx-versions(c: Ctx) -> Ref (Map Str Str) =
  match (c)
    | Ctx(_, _, _, _, _, _, _, _, _, v, _) -> v

let ctx-suite(c: Ctx) -> Ref (Map Str Bool) =
  match (c)
    | Ctx(_, _, _, _, _, _, _, _, _, _, s) -> s

; A suite member gets a generated test `main`. A dependency compiled in
; the same context does not, even when `for-test` is set on the context.
let suite-member(ctx: Ctx, abs: Str) -> Bool =
  match (Map.lookup(abs, deref(ctx-suite(ctx))))
    | Some(_) -> true
    | None -> false

record Surface {
  fns: List FnRec
  ctors: List CtorRec
  stubs: List Ast
}

let blank() -> Span =
  Span(0, 0, 0, 1)

let sym(n: Str) -> Ast =
  SymNode(n, blank())

let str-node(s: Str) -> Ast =
  StrNode(s, blank())

let int-node(n: Int) -> Ast =
  IntNode(n, blank())

let append-asts(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-asts(rest, ys)

let append-strs(xs: List Str, ys: List Str) -> List Str =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-strs(rest, ys)

let snoc-str(xs: List Str, x: Str) -> List Str =
  append-strs(xs, [x])

let drop-n(n: Int, xs: List Ast) -> List Ast =
  if (n <= 0) -> xs |
  match (xs)
    | [] -> []
    | _ :: rest -> drop-n(n - 1, rest)

let is-head(form: Ast, name: Str) -> Bool =
  match (form)
    | ParenNode(h :: _, _) ->
      match (sym-str(h))
        | Some(n) -> n == name
        | None -> false
    | _ -> false

let unwrap-pub(form: Ast) -> Ast =
  match (form)
    | ParenNode(h :: rest, sp) ->
      if (is-head(form, "pub")) -> ParenNode(rest, sp) | form
    | _ -> form

let parse-code(msg: Str) -> Str =
  if (String.contains("unclosed", msg)) -> "E_PARSE_UNCLOSED" | if (String.contains("'!'", msg)) -> "E_PARSE_BANG" | if (String.contains("unterminated", msg)) -> "E_PARSE_STRING" | "E_PARSE"

; Origin 0 is the file being compiled. Origin 1 is the source a
; generated `@test` module was extracted from.
let report-at-help(abs: Str, src: Str, sp: Span, sev: Str, code: Str, msg: Str, help: Maybe Str) -> Unit =
  if (sp.origin == 0) -> report-span-help(display-path(abs), src, sp, sev, code, msg, help) |
  {
    let orig = doctest-origin(abs)
    match (read-file(orig))
      | Ok(text) -> report-span-help(display-path(orig), text, sp, sev, code, msg, help)
      | Err(_) -> report-span-help(display-path(abs), src, sp, sev, code, msg, help)
  }

let report-at(abs: Str, src: Str, sp: Span, sev: Str, code: Str, msg: Str) -> Unit =
  report-at-help(abs, src, sp, sev, code, msg, None)

let resolve-diag-help(code: Str, help: Maybe Str) -> Maybe Str =
  match (help)
    | Some(h) -> Some(h)
    | None -> catalogue-help(code)

let report-parse(abs: Str, src: Str, e: ParseError) -> Unit =
  match (e)
    | ParseError(sp, msg, help) ->
      {
        let code = parse-code(msg)
        report-at-help(abs, src, sp, "error", code, msg, resolve-diag-help(code, help))
      }

let report-casing(abs: Str, src: Str, e: CasingError) -> Unit =
  match (e)
    | CasingError(sp, msg) -> report-at-help(abs, src, sp, "error", "E_CASING", msg, catalogue-help("E_CASING"))

let report-desugar(abs: Str, src: Str, es: List DesugarError) -> Unit =
  match (es)
    | [] -> ()
    | DesugarError(sp, code, msg) :: rest ->
      {
        report-at-help(abs, src, sp, "error", code, msg, catalogue-help(code))
        report-desugar(abs, src, rest)
      }

let report-types(abs: Str, src: Str, es: List TypeError) -> Unit =
  match (es)
    | [] -> ()
    | TypeError(sp, code, msg, help) :: rest ->
      {
        report-at-help(abs, src, sp, "error", code, msg, help)
        report-types(abs, src, rest)
      }

let before-arrow(xs: List Ast, acc: List Ast) -> List Ast =
  match (xs)
    | [] -> reverse(acc)
    | x :: rest ->
      match (sym-str(x))
        | Some(n) ->
          if (n == "->") -> reverse(acc) | before-arrow(rest, x :: acc)
        | None -> before-arrow(rest, x :: acc)

let after-arrow(xs: List Ast) -> Maybe Ast =
  match (xs)
    | [] -> None
    | x :: rest ->
      match (sym-str(x))
        | Some(n) ->
          if (n == "->") ->
            match (rest)
              | r :: _ -> Some(r)
              | [] -> None | after-arrow(rest)
        | None -> after-arrow(rest)

let defn-rest(form: Ast) -> Maybe (List Ast) =
  match (unwrap-pub(form))
    | ParenNode(h :: rest, _) ->
      match (sym-str(h))
        | Some(n) ->
          if (n == "defn") -> Some(rest) | None
        | None -> None
    | _ -> None

; `(defn f …)` or `(defn (f [a]) …)`.
let bare-name(name: Ast) -> Maybe Str =
  match (name)
    | SymNode(n, _) -> Some(n)
    | ParenNode(h :: _, _) -> sym-str(h)
    | _ -> None

let defn-name(form: Ast) -> Maybe Str =
  match (defn-rest(form))
    | None -> None
    | Some(rest) ->
      match (rest)
        | name :: _ -> bare-name(name)
        | [] -> None

let is-test-form(form: Ast) -> Bool =
  is-head(form, "test")

let drop-tests(forms: List Ast, acc: List Ast) -> List Ast =
  match (forms)
    | [] -> reverse(acc)
    | f :: rest ->
      if (is-test-form(f)) -> drop-tests(rest, acc) | drop-tests(rest, f :: acc)

let take-test(form: Ast, acc: List Ast) -> List Ast =
  match (form)
    | ParenNode([_, name, expr], _) -> ParenNode([name, expr], blank()) :: acc
    | _ -> acc

let take-tests(forms: List Ast, acc: List Ast) -> List Ast =
  match (forms)
    | [] -> reverse(acc)
    | f :: rest ->
      if (is-test-form(f)) -> take-tests(rest, take-test(f, acc)) | take-tests(rest, acc)

; `println` writes a string literal as text and an `Int` as digits. A
; computed `str-concat` would be printed as a pointer, so the prefix and
; the name stay two literals.
let test-stmt(name: Ast, expr: Ast) -> Ast =
  ParenNode([sym("if"), expr, ParenNode([sym("println"), str-node("pass "), name], blank()), ParenNode([sym("println"), str-node("fail "), name], blank())], blank())

let test-stmts(tests: List Ast) -> List Ast =
  match (tests)
    | [] -> []
    | ParenNode([name, expr], _) :: rest -> test-stmt(name, expr) :: test-stmts(rest)
    | _ :: rest -> test-stmts(rest)

let test-main(tests: List Ast) -> Ast =
  ParenNode([sym("defn"), sym("main"), sym("->"), sym("Int"), ParenNode(append-asts([sym("do")], append-asts(test-stmts(tests), [int-node(0)])), blank())], blank())

let drop-main(forms: List Ast, acc: List Ast) -> List Ast =
  match (forms)
    | [] -> reverse(acc)
    | f :: rest ->
      match (defn-name(f))
        | Some(n) ->
          if (n == "main") -> drop-main(rest, acc) | drop-main(rest, f :: acc)
        | None -> drop-main(rest, f :: acc)

let prepare-body(forms: List Ast, for-test: Bool) -> List Ast {
  let tests = take-tests(forms, [])
  let body = drop-tests(forms, [])
  if (for-test) -> append-asts(drop-main(body, []), [test-main(tests)]) | body
}

let top-let-name(form: Ast) -> Maybe Str =
  match (unwrap-pub(form))
    | ParenNode(h :: rest, _) ->
      match (sym-str(h))
        | Some(n) ->
          if (n == "let") ->
            match (rest)
              | name :: _ -> bare-name(name)
              | [] -> None | None
        | None -> None
    | _ -> None

let add-rename(forms: List Ast, path: Str, acc: Map Str Str) -> Map Str Str =
  match (forms)
    | [] -> acc
    | f :: rest ->
      match (defn-name(f))
        | Some(n) -> add-rename(rest, path, Map.set(n, link-of(path, n), acc))
        | None ->
          match (top-let-name(f))
            | Some(n) -> add-rename(rest, path, Map.set(n, link-of(path, n), acc))
            | None -> add-rename(rest, path, acc)

; Closure conversion runs after defn renaming, so each module's lifted
; `__lamN` would otherwise link as the same `menard.__lamN`.
let is-lam-name(n: Str) -> Bool =
  String.length(n) >= 5 && String.slice(0, 5, n) == "__lam"

let add-lam-rename(forms: List Ast, path: Str, acc: Map Str Str) -> Map Str Str =
  match (forms)
    | [] -> acc
    | f :: rest ->
      match (defn-name(f))
        | Some(n) ->
          if (is-lam-name(n)) -> add-lam-rename(rest, path, Map.set(n, link-of(path, n), acc)) | add-lam-rename(rest, path, acc)
        | None -> add-lam-rename(rest, path, acc)

let extern-stub(form: Ast) -> Maybe Ast =
  match (defn-rest(form))
    | None -> None
    | Some(rest) ->
      match (after-arrow(rest))
        | None -> None
        | Some(ret) -> Some(ParenNode(append-asts([sym("extern")], append-asts(before-arrow(rest, []), [sym("->"), ret])), blank()))

let fn-arity(rest: List Ast) -> Int =
  length(before-arrow(rest, [])) - 1

let push-fn(fns: List FnRec, name: Str, link: Str, arity: Int) -> List FnRec =
  match (fns)
    | [] -> [FnRec(name, link, arity)]
    | FnRec(n, _, _) :: _ ->
      if (n == name) -> fns |
      match (fns)
        | h :: rest -> h :: push-fn(rest, name, link, arity)
        | [] -> [FnRec(name, link, arity)]

let kind-of(form: Ast) -> Str =
  match (unwrap-pub(form))
    | ParenNode(h :: _, _) ->
      match (sym-str(h))
        | Some(n) -> n
        | None -> ""
    | _ -> ""

let is-pub(form: Ast) -> Bool =
  is-head(form, "pub")

let ctor-names-of(form: Ast, acc: List Str) -> List Str =
  match (unwrap-pub(form))
    | ParenNode(h :: rest, _) ->
      match (sym-str(h))
        | Some(n) ->
          if (n == "variant") ->
            match (rest)
              | _ :: ctors -> variant-ctor-names(ctors, acc)
              | [] -> acc |
          if (n == "defrec") ->
            match (rest)
              | name :: _ ->
                match (bare-name(name))
                  | Some(dn) -> dn :: acc
                  | None -> acc
              | [] -> acc | acc
        | None -> acc
    | _ -> acc

let variant-ctor-names(ctors: List Ast, acc: List Str) -> List Str =
  match (ctors)
    | [] -> acc
    | c :: rest ->
      match (c)
        | ParenNode(name :: _, _) ->
          match (sym-str(name))
            | Some(n) -> variant-ctor-names(rest, n :: acc)
            | None -> variant-ctor-names(rest, acc)
        | _ -> variant-ctor-names(rest, acc)

let has-str(xs: List Str, s: Str) -> Bool =
  match (xs)
    | [] -> false
    | h :: rest ->
      if (h == s) -> true | has-str(rest, s)

let filter-ctors(local: List CtorSeed, names: List Str, acc: List CtorRec) -> List CtorRec =
  match (local)
    | [] -> reverse-ctors(acc, [])
    | CtorSeed(n, t, a) :: rest ->
      if (has-str(names, n)) -> filter-ctors(rest, names, CtorRec(n, t, a) :: acc) | filter-ctors(rest, names, acc)

let reverse-ctors(xs: List CtorRec, acc: List CtorRec) -> List CtorRec =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-ctors(rest, x :: acc)

record Export {
  fns: List FnRec
  ctor-names: List Str
  stubs: List Ast
}

; Primary name of a stub form (`type IoError`, `let stdin`, `extern listen`, …).
let stub-primary-name(stub: Ast) -> Maybe Str =
  match (unwrap-pub(stub))
    | ParenNode(_ :: name :: _, _) -> bare-name(name)
    | _ -> None

let stubs-have-primary(stubs: List Ast, name: Str) -> Bool =
  match (stubs)
    | [] -> false
    | s :: rest ->
      match (stub-primary-name(s))
        | Some(n) ->
          if (n == name) -> true | stubs-have-primary(rest, name)
        | None -> stubs-have-primary(rest, name)

; Keep the first stub for a name when a module both defines and re-exports it
; transitively (deps are walked before the module in surface-of).
let filter-new-stubs(stubs: List Ast, existing: List Ast) -> List Ast =
  match (stubs)
    | [] -> []
    | s :: rest ->
      match (stub-primary-name(s))
        | Some(n) ->
          if (stubs-have-primary(existing, n)) -> filter-new-stubs(rest, existing) | s :: filter-new-stubs(rest, existing)
        | None -> s :: filter-new-stubs(rest, existing)

let import-sym-names(xs: List Ast) -> List Str =
  match (xs)
    | [] -> []
    | h :: t ->
      match (sym-str(h))
        | Some(n) -> n :: import-sym-names(t)
        | None -> import-sym-names(t)

; `None` = whole-module re-export; `Some(names)` = selective list.
let reexport-name-list(form: Ast) -> Maybe (Maybe (List Str)) =
  match (unwrap-pub(form))
    | ParenNode(h :: _ :: rest, _) ->
      match (sym-str(h))
        | Some("import") ->
          match (rest)
            | [] -> Some(None)
            | ParenNode(names, _) :: _ -> Some(Some(import-sym-names(names)))
            | _ -> None
        | _ -> None
    | _ -> None

let all-stub-primaries(stubs: List Ast, acc: List Str) -> List Str =
  match (stubs)
    | [] -> acc
    | s :: rest ->
      match (stub-primary-name(s))
        | Some(n) -> all-stub-primaries(rest, n :: acc)
        | None -> all-stub-primaries(rest, acc)

let all-fn-names(fns: List FnRec, acc: List Str) -> List Str =
  match (fns)
    | [] -> acc
    | FnRec(n, _, _) :: rest -> all-fn-names(rest, n :: acc)

let dep-export-names(stubs: List Ast, fns: List FnRec) -> List Str =
  all-fn-names(fns, all-stub-primaries(stubs, []))

let stub-selected(stub: Ast, names: List Str) -> Bool =
  match (stub-primary-name(stub))
    | Some(n) -> has-str(names, n)
    | None -> false

let pick-reexport-stubs(stubs: List Ast, names: List Str, acc: List Ast) -> List Ast =
  match (stubs)
    | [] -> reverse(acc)
    | s :: rest ->
      if (stub-selected(s, names)) -> pick-reexport-stubs(rest, names, s :: acc) | pick-reexport-stubs(rest, names, acc)

let pick-reexport-fns(fns: List FnRec, names: List Str, acc: List FnRec) -> List FnRec =
  match (fns)
    | [] -> reverse-fns(acc, [])
    | FnRec(n, link, ar) :: rest ->
      if (has-str(names, n)) -> pick-reexport-fns(rest, names, FnRec(n, link, ar) :: acc) | pick-reexport-fns(rest, names, acc)

let reverse-fns(xs: List FnRec, acc: List FnRec) -> List FnRec =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-fns(rest, x :: acc)

let append-fn-recs(xs: List FnRec, ys: List FnRec) -> List FnRec =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-fn-recs(rest, ys)

; Type name plus nested constructors for a re-exported stub.
let reexport-stub-names(stub: Ast, acc: List Str) -> List Str =
  match (stub-primary-name(stub))
    | Some(n) -> ctor-names-of(stub, n :: acc)
    | None -> ctor-names-of(stub, acc)

let reexport-stubs-names(stubs: List Ast, acc: List Str) -> List Str =
  match (stubs)
    | [] -> acc
    | s :: rest -> reexport-stubs-names(rest, reexport-stub-names(s, acc))

let collect-exports(forms: List Ast, path: Str, done: Map Str Iface, fns: List FnRec, names: List Str, stubs: List Ast) -> Export =
  match (forms)
    | [] -> Export(fns, names, stubs)
    | f :: rest ->
      if (is-pub(f)) -> collect-pub(f, rest, path, done, fns, names, stubs) | collect-exports(rest, path, done, fns, names, stubs)

let collect-reexport(form: Ast, rest: List Ast, path: Str, done: Map Str Iface, fns: List FnRec, names: List Str, stubs: List Ast) -> Export =
  match (import-specs([form]))
    | [] -> collect-exports(rest, path, done, fns, names, stubs)
    | spec :: _ ->
      match (reexport-name-list(form))
        | None -> collect-exports(rest, path, done, fns, names, stubs)
        | Some(sel) ->
          match (Map.lookup(canonical-path(resolve-import(path, spec)), done))
            | None -> collect-exports(rest, path, done, fns, names, stubs)
            | Some(Iface(_, _, _, _, _, dep-fns, _, dep-stubs)) ->
              {
                let wanted =
                  match (sel)
                    | None -> dep-export-names(dep-stubs, dep-fns)
                    | Some(ns) -> ns
                let picked = pick-reexport-stubs(dep-stubs, wanted, [])
                let picked-fns = pick-reexport-fns(dep-fns, wanted, [])
                collect-exports(rest, path, done, append-fn-recs(picked-fns, fns), reexport-stubs-names(picked, names), append-asts(picked, stubs))
              }

let collect-pub(form: Ast, rest: List Ast, path: Str, done: Map Str Iface, fns: List FnRec, names: List Str, stubs: List Ast) -> Export {
  let k = kind-of(form)
  if (k == "import") -> collect-reexport(form, rest, path, done, fns, names, stubs) |
  if (k == "defn") ->
    match (defn-rest(form))
      | None -> collect-exports(rest, path, done, fns, names, stubs)
      | Some(r) ->
        match (defn-name(form))
          | None -> collect-exports(rest, path, done, fns, names, stubs)
          | Some(n) ->
            match (extern-stub(form))
              | None -> collect-exports(rest, path, done, fns, names, stubs)
              | Some(stub) -> collect-exports(rest, path, done, push-fn(fns, n, link-of(path, n), fn-arity(r)), names, stub :: stubs) | if (k == "variant") -> collect-exports(rest, path, done, fns, ctor-names-of(form, names), unwrap-pub(form) :: stubs) | if (k == "runtime") -> collect-exports(rest, path, done, fns, names, unwrap-pub(form) :: stubs) | if (k == "defrec" || k == "alias" || k == "extern") -> collect-exports(rest, path, done, fns, ctor-names-of(form, names), unwrap-pub(form) :: stubs) | if (k == "let") -> collect-exports(rest, path, done, fns, names, unwrap-pub(form) :: stubs) | collect-exports(rest, path, done, fns, names, stubs)
}

let empty-surface() -> Surface =
  Surface([], [], [])

let surface-drop-fn(fns: List FnRec, name: Str) -> List FnRec =
  match (fns)
    | [] -> []
    | FnRec(n, link, ar) :: rest ->
      if (n == name) -> surface-drop-fn(rest, name) | FnRec(n, link, ar) :: surface-drop-fn(rest, name)

let surface-add-fns(fns: List FnRec, acc: List FnRec) -> List FnRec =
  match (fns)
    | [] -> acc
    | FnRec(n, link, ar) :: rest -> surface-add-fns(rest, FnRec(n, link, ar) :: surface-drop-fn(acc, n))

; Stubs are typechecked in this order, so a dependency's variant
; has to precede the alias that names it. Skip a stub whose primary
; name is already present (re-export copies of transitive types).
let surface-add(iface: Iface, acc: Surface) -> Surface =
  match (iface)
    | Iface(_, _, _, _, _, fns, ctors, stubs) ->
      match (acc)
        | Surface(af, ac, as) -> Surface(surface-add-fns(fns, af), append-ctors(ctors, ac), append-asts(as, filter-new-stubs(stubs, as)))

let append-ctors(xs: List CtorRec, ys: List CtorRec) -> List CtorRec =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-ctors(rest, ys)

let walk-surface(path: Str, done: Map Str Iface, seen: Ref (Map Str Bool), acc: Surface) -> Surface =
  match (Map.lookup(path, deref(seen)))
    | Some(_) -> acc
    | None ->
      {
        set!(seen, Map.set(path, true, deref(seen)))
        match (Map.lookup(path, done))
          | None -> acc
          | Some(iface) -> surface-add(iface, walk-deps(iface, done, seen, acc))
      }

let walk-deps(iface: Iface, done: Map Str Iface, seen: Ref (Map Str Bool), acc: Surface) -> Surface =
  match (iface)
    | Iface(_, deps, _, _, _, _, _, _) -> walk-dep-list(deps, done, seen, acc)

let walk-dep-list(deps: List DepRec, done: Map Str Iface, seen: Ref (Map Str Bool), acc: Surface) -> Surface =
  match (deps)
    | [] -> acc
    | DepRec(_, path) :: rest -> walk-dep-list(rest, done, seen, walk-surface(path, done, seen, acc))

let surface-of(deps: List DepRec, done: Map Str Iface) -> Surface =
  walk-dep-list(deps, done, ref(Map.empty()), empty-surface())

let bare-import-paths(from: Str, forms: List Ast) -> List Str =
  match (forms)
    | [] -> []
    | form :: rest ->
      match (module-import-alias(form))
        | Some(_) -> bare-import-paths(from, rest)
        | None ->
          match (import-specs([form]))
            | spec :: _ -> canonical-path(resolve-import(from, spec)) :: bare-import-paths(from, rest)
            | [] -> bare-import-paths(from, rest)

; `std/basics` is injected by specs-with-basics and is never written as an
; import form, so bare-import-paths would miss it. Keep its stubs unprefixed.
let with-basics-bare(deps: List DepRec, bare: List Str) -> List Str =
  match (deps)
    | [] -> bare
    | DepRec(_, p) :: rest ->
      if (is-basics-path(p) && not(has-str(bare, p))) -> p :: with-basics-bare(rest, bare) | with-basics-bare(rest, bare)

let module-bare-paths(from: Str, forms: List Ast, deps: List DepRec) -> List Str =
  with-basics-bare(deps, bare-import-paths(from, forms))

; Direct function signatures and links must override transitive names together.
let direct-surfaces(paths: List Str, done: Map Str Iface, acc: Surface) -> Surface =
  match (paths)
    | [] -> acc
    | path :: rest ->
      match (Map.lookup(path, done))
        | None -> direct-surfaces(rest, done, acc)
        | Some(Iface(_, _, _, _, _, fns, _, stubs)) ->
          match (acc)
            | Surface(af, ac, as) ->
              {
                let values = value-stubs(stubs)
                let previous = drop-shadowed-values(as, qualified-renames(values, "", Map.empty()))
                direct-surfaces(rest, done, Surface(surface-add-fns(fns, af), ac, append-asts(previous, values)))
              }

let value-stubs(stubs: List Ast) -> List Ast =
  match (stubs)
    | [] -> []
    | stub :: rest ->
      if (is-head(stub, "extern") || is-head(stub, "let") || is-head(stub, "runtime")) -> stub :: value-stubs(rest) | value-stubs(rest)

let qualified-fns(fns: List FnRec, prefix: Str) -> List FnRec =
  match (fns)
    | [] -> []
    | FnRec(n, link, ar) :: rest -> FnRec(String.concat(prefix, n), link, ar) :: qualified-fns(rest, prefix)

let qualified-renames(stubs: List Ast, prefix: Str, acc: Map Str Str) -> Map Str Str =
  match (stubs)
    | [] -> acc
    | stub :: rest ->
      match (unwrap-pub(stub))
        | ParenNode(_ :: name :: _, _) ->
          match (bare-name(name))
            | Some(n) -> qualified-renames(rest, prefix, Map.set(n, String.concat(prefix, n), acc))
            | None -> qualified-renames(rest, prefix, acc)
        | _ -> qualified-renames(rest, prefix, acc)

let drop-shadowed-values(stubs: List Ast, names: Map Str Str) -> List Ast =
  match (stubs)
    | [] -> []
    | stub :: rest ->
      if ((is-head(stub, "extern") || is-head(stub, "let") || is-head(stub, "runtime")) && stub-name-shadowed(stub, names)) -> drop-shadowed-values(rest, names) | stub :: drop-shadowed-values(rest, names)

let stub-name-shadowed(stub: Ast, names: Map Str Str) -> Bool =
  match (unwrap-pub(stub))
    | ParenNode(_ :: name :: _, _) ->
      match (bare-name(name))
        | Some(n) ->
          match (Map.lookup(n, names))
            | Some(_) -> true
            | None -> false
        | None -> false
    | _ -> false

; Nested variant/record constructor names inside type stubs.
let prefix-name-list(names: List Str, prefix: Str, acc: Map Str Str) -> Map Str Str =
  match (names)
    | [] -> acc
    | n :: rest -> prefix-name-list(rest, prefix, Map.set(n, String.concat(prefix, n), acc))

let stub-nested-renames(stubs: List Ast, prefix: Str, acc: Map Str Str) -> Map Str Str =
  match (stubs)
    | [] -> acc
    | stub :: rest -> stub-nested-renames(rest, prefix, prefix-name-list(ctor-names-of(stub, []), prefix, acc))

; Prefixed names for every export an aliased import exposes: values, types,
; and constructors. Applied to the whole stub AST so signatures stay coherent.
let alias-export-renames(stubs: List Ast, ctors: List CtorRec, prefix: Str, acc: Map Str Str) -> Map Str Str =
  alias-ctor-renames(ctors, prefix, stub-nested-renames(stubs, prefix, qualified-renames(stubs, prefix, acc)))

; When the same module is also bare-imported, types/ctors already use their
; original names. Only value stubs are renamed so `Http.serve` and bare
; `Request` stay one type.
let alias-value-renames(stubs: List Ast, prefix: Str, acc: Map Str Str) -> Map Str Str =
  qualified-renames(value-stubs(stubs), prefix, acc)

let alias-ctor-renames(ctors: List CtorRec, prefix: Str, acc: Map Str Str) -> Map Str Str =
  match (ctors)
    | [] -> acc
    | CtorRec(n, _, _) :: rest -> alias-ctor-renames(rest, prefix, Map.set(n, String.concat(prefix, n), acc))

; Keep the dependency's ctor tags; only the spelling is module-local.
let qualify-ctor-recs(ctors: List CtorRec, prefix: Str) -> List CtorRec =
  match (ctors)
    | [] -> []
    | CtorRec(n, t, a) :: rest -> CtorRec(String.concat(prefix, n), t, a) :: qualify-ctor-recs(rest, prefix)

; Type names in stubs (defrec / variant / alias) for dual-import aliases.
let type-stub-name(stub: Ast) -> Maybe Str =
  match (unwrap-pub(stub))
    | ParenNode(h :: name :: _, _) ->
      match (sym-str(h))
        | Some(k) ->
          if (k == "defrec" || k == "variant" || k == "alias") -> bare-name(name) | None
        | None -> None
    | _ -> None

; `Alias.Type` still rewrites to `__import_Alias_Type` when that name was not
; in the bare selective list. Point it at the bare type so identity is shared.
let dual-type-alias(prefix: Str, name: Str) -> Ast =
  ParenNode([sym("alias"), sym(String.concat(prefix, name)), sym(name)], blank())

let dual-type-aliases(stubs: List Ast, prefix: Str, seen: List Str) -> List Ast =
  match (stubs)
    | [] -> []
    | stub :: rest ->
      match (type-stub-name(stub))
        | None -> dual-type-aliases(rest, prefix, seen)
        | Some(n) ->
          if (has-str(seen, n)) -> dual-type-aliases(rest, prefix, seen) | dual-type-alias(prefix, n) :: dual-type-aliases(rest, prefix, n :: seen)

; Paths whose type stubs already appear unprefixed: direct bare imports and
; every module reachable from them. Aliasing one of these must not rename
; types again (that would fork Pid from __import_Actor_Pid).
let bare-exposed-paths(paths: List Str, done: Map Str Iface) -> List Str =
  bare-exposed-walk(paths, done, ref(Map.empty()), [])

let bare-exposed-walk(paths: List Str, done: Map Str Iface, seen: Ref (Map Str Bool), acc: List Str) -> List Str =
  match (paths)
    | [] -> acc
    | path :: rest ->
      match (Map.lookup(path, deref(seen)))
        | Some(_) -> bare-exposed-walk(rest, done, seen, acc)
        | None ->
          {
            set!(seen, Map.set(path, true, deref(seen)))
            match (Map.lookup(path, done))
              | None -> bare-exposed-walk(rest, done, seen, path :: acc)
              | Some(Iface(_, deps, _, _, _, _, _, _)) -> bare-exposed-walk(append-strs(dep-paths(deps), rest), done, seen, path :: acc)
          }

let dep-paths(deps: List DepRec) -> List Str =
  match (deps)
    | [] -> []
    | DepRec(_, p) :: rest -> p :: dep-paths(rest)

let append-strs(xs: List Str, ys: List Str) -> List Str =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-strs(rest, ys)

; Type stub primary names already on the surface (bare imports).
let surface-type-names(stubs: List Ast, acc: List Str) -> List Str =
  match (stubs)
    | [] -> acc
    | s :: rest ->
      match (type-stub-name(s))
        | Some(n) -> surface-type-names(rest, n :: acc)
        | None -> surface-type-names(rest, acc)

; Re-exported (or other) type names that already appear unprefixed — share
; identity via dual-type-alias instead of forking a renamed nominal.
let shared-type-names(stubs: List Ast, exposed-types: List Str, acc: List Str) -> List Str =
  match (stubs)
    | [] -> acc
    | s :: rest ->
      match (type-stub-name(s))
        | Some(n) ->
          if (has-str(exposed-types, n) && not(has-str(acc, n))) -> shared-type-names(rest, exposed-types, n :: acc) | shared-type-names(rest, exposed-types, acc)
        | None -> shared-type-names(rest, exposed-types, acc)

let unshared-type-stubs(stubs: List Ast, shared: List Str) -> List Ast =
  match (stubs)
    | [] -> []
    | s :: rest ->
      match (type-stub-name(s))
        | None -> unshared-type-stubs(rest, shared)
        | Some(n) ->
          if (has-str(shared, n)) -> unshared-type-stubs(rest, shared) | s :: unshared-type-stubs(rest, shared)

; Drop shared type names (and their nested ctors) from the rename map so
; signatures keep the bare spelling. `dual-type-alias` cannot carry type
; arguments (`__import_Sup_Pid a` is not a valid alias application).
let drop-rename-keys(keys: List Str, renames: Map Str Str) -> Map Str Str =
  match (keys)
    | [] -> renames
    | k :: rest -> drop-rename-keys(rest, Map.remove(k, renames))

let shared-nested-names(stubs: List Ast, shared: List Str, acc: List Str) -> List Str =
  match (stubs)
    | [] -> acc
    | s :: rest ->
      match (type-stub-name(s))
        | Some(n) ->
          if (has-str(shared, n)) -> shared-nested-names(rest, shared, ctor-names-of(s, n :: acc)) | shared-nested-names(rest, shared, acc)
        | None -> shared-nested-names(rest, shared, acc)

let dual-type-aliases-for(names: List Str, prefix: Str, seen: List Str) -> List Ast =
  match (names)
    | [] -> []
    | n :: rest ->
      if (has-str(seen, n)) -> dual-type-aliases-for(rest, prefix, seen) | dual-type-alias(prefix, n) :: dual-type-aliases-for(rest, prefix, n :: seen)

; Alias imports expose `__import_Alias_*` spellings. When the module's types
; are already bare-exposed, only values are renamed and type aliases keep
; `Alias.Type` on the same identity; otherwise every export is renamed.
; Per-name: a re-export whose defining type is already bare (e.g. IoError
; via `pub import std/io` while `import std/net as Net`) keeps the bare
; spelling in signatures so identity is shared without a forked nominal.
let alias-surfaces-for(from: Str, forms: List Ast, done: Map Str Iface, bare: List Str, acc: Surface) -> Surface =
  alias-surfaces-with(from, forms, done, bare-exposed-paths(bare, done), acc)

let alias-surfaces-with(from: Str, forms: List Ast, done: Map Str Iface, exposed: List Str, acc: Surface) -> Surface =
  match (forms)
    | [] -> acc
    | form :: rest ->
      match (module-import-alias(form))
        | None -> alias-surfaces-with(from, rest, done, exposed, acc)
        | Some(name) ->
          match (import-specs([form]))
            | spec :: _ ->
              {
                let path = canonical-path(resolve-import(from, spec))
                match (Map.lookup(path, done))
                  | None -> alias-surfaces-with(from, rest, done, exposed, acc)
                  | Some(Iface(_, _, _, _, _, fns, ctors, stubs)) ->
                    match (acc)
                      | Surface(af, ac, as) ->
                        {
                          let prefix = import-alias-prefix(name)
                          let dual = has-str(exposed, path)
                          let shared =
                            if (dual) -> [] | shared-type-names(stubs, surface-type-names(as, []), [])
                          let full-renames = alias-export-renames(stubs, ctors, prefix, Map.empty())
                          let renames = drop-rename-keys(shared-nested-names(stubs, shared, []), full-renames)
                          let renamed =
                            if (dual) -> rename-module-forms(value-stubs(stubs), alias-value-renames(stubs, prefix, Map.empty())) | append-asts(rename-module-forms(value-stubs(stubs), renames), rename-module-forms(unshared-type-stubs(stubs, shared), renames))
                          ; Shared names stay bare in signatures; dual aliases still
                          ; bind Alias.Name for nullary type annotations / ctors.
                          let aliases =
                            if (dual) -> dual-type-aliases(stubs, prefix, []) | dual-type-aliases-for(shared, prefix, [])
                          let next-ctors = append-ctors(qualify-ctor-recs(ctors, prefix), ac)
                          alias-surfaces-with(from, rest, done, exposed, Surface(append-fns(qualified-fns(fns, prefix), af), next-ctors, append-asts(as, append-asts(renamed, aliases))))
                        }
              }
            | [] -> alias-surfaces-with(from, rest, done, exposed, acc)

let append-fns(xs: List FnRec, ys: List FnRec) -> List FnRec =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-fns(rest, ys)

let fns-to-imps(fns: List FnRec) -> List Imp =
  match (fns)
    | [] -> []
    | FnRec(n, link, ar) :: rest -> Imp(n, link, ar) :: fns-to-imps(rest)

let ctors-to-seeds(ctors: List CtorRec) -> List CtorSeed =
  match (ctors)
    | [] -> []
    | CtorRec(n, t, a) :: rest -> CtorSeed(n, t, a) :: ctors-to-seeds(rest)

let calls-of(names: List Str) -> List Ast =
  match (names)
    | [] -> []
    | n :: rest -> ParenNode([sym(n)], blank()) :: calls-of(rest)

let imps-of-syms(names: List Str) -> List Imp =
  match (names)
    | [] -> []
    | n :: rest -> Imp(n, n, 0) :: imps-of-syms(rest)

let bootstrap-forms(inits: List Str, main-sym: Str, unit-ret: Bool) -> List Ast {
  let calls = append-asts(calls-of(inits), [ParenNode([sym(main-sym)], blank())])
  let body =
    if (unit-ret) -> append-asts(calls, [int-node(0)]) | calls
  [ParenNode(append-asts([sym("defn"), sym("main"), sym("->"), sym("Int")], body), blank())]
}

let write-bytes(path: Str, bytes: Str) -> Bool {
  ensure-parent(path)
  match (write-file(path, bytes))
    | Ok(_) -> true
    | Err(_) -> false
}

let write-if-changed(path: Str, bytes: Str) -> Bool =
  match (read-file(path))
    | Ok(old) ->
      if (old == bytes) -> false | write-bytes(path, bytes)
    | Err(_) -> write-bytes(path, bytes)

let rt(runtime: Str, name: Str) -> Str =
  Path.join(name, Path.join("src", runtime))

; OpenSSL for `tls.c` (Build F). Prefer Homebrew on macOS; otherwise system
; `-lssl -lcrypto`. Override with MENARD_OPENSSL_CFLAGS / MENARD_OPENSSL_LIBS
; (space-separated) when needed.
let openssl-cflags-default() -> List Str =
  if (exists("/opt/homebrew/opt/openssl@3/include")) -> ["-I/opt/homebrew/opt/openssl@3/include"] | if (exists("/usr/local/opt/openssl@3/include")) -> ["-I/usr/local/opt/openssl@3/include"] | []

let openssl-libs-default() -> List Str =
  if (exists("/opt/homebrew/opt/openssl@3/lib")) -> ["-L/opt/homebrew/opt/openssl@3/lib", "-lssl", "-lcrypto"] | if (exists("/usr/local/opt/openssl@3/lib")) -> ["-L/usr/local/opt/openssl@3/lib", "-lssl", "-lcrypto"] | ["-lssl", "-lcrypto"]

let openssl-cflags() -> List Str =
  match (getenv("MENARD_OPENSSL_CFLAGS"))
    | Some(s) ->
      if (String.length(s) == 0) -> [] | String.split(" ", s)
    | None -> openssl-cflags-default()

let openssl-libs() -> List Str =
  match (getenv("MENARD_OPENSSL_LIBS"))
    | Some(s) ->
      if (String.length(s) == 0) -> ["-lssl", "-lcrypto"] | String.split(" ", s)
    | None -> openssl-libs-default()

let rt-third-party(runtime: Str, name: Str) -> Str =
  Path.join(name, Path.join("third_party", runtime))

let link-argv(cc: Str, runtime: Str, objs: List Str, out: Str) -> List Str =
  append-strs(append-strs(append-strs(append-strs([cc, "-std=c11", "-D_DEFAULT_SOURCE", "-Wall", "-Wextra", "-O2", String.concat("-I", Path.join("include", runtime)), String.concat("-I", Path.join("third_party", runtime))], openssl-cflags()), objs), [rt(runtime, "alloc.c"), rt(runtime, "gc.c"), rt(runtime, "panic.c"), rt(runtime, "print.c"), rt(runtime, "shadow.c"), rt(runtime, "variants.c"), rt(runtime, "str.c"), rt(runtime, "float_text.c"), rt(runtime, "char_text.c"), rt-third-party(runtime, "ryu/d2s.c"), rt(runtime, "map.c"), rt(runtime, "closure.c"), rt(runtime, "io.c"), rt(runtime, "equal.c"), rt(runtime, "task.c"), rt(runtime, "net.c"), rt(runtime, "tls.c"), "-lm"]), append-strs(openssl-libs(), ["-o", out]))

let exit-code(st: SpawnStatus) -> Int =
  match (st)
    | Exited(n) -> n
    | Signalled(n) -> 128 + n

let link-objs(cc: Str, runtime: Str, objs: List Str, bin: Str) -> Result Str Str {
  let tmp = String.concat(bin, ".tmp")
  ensure-parent(bin)
  match (spawn-capture(link-argv(cc, runtime, objs, tmp), ""))
    | Err(_) -> Err(String.concat("cannot spawn ", cc))
    | Ok(SpawnOutput(st, _, err)) ->
      if (exit-code(st) == 0) ->
        match (rename(tmp, bin))
          | Ok(_) -> Ok(bin)
          | Err(_) -> Err(String.concat("cannot rename ", bin)) | Err(err)
}

let any-newer(paths: List Str, bin: Str) -> Bool =
  match (paths)
    | [] -> false
    | p :: rest ->
      if (mtime(bin) == 0 || mtime(p) > mtime(bin)) -> true | any-newer(rest, bin)

let finish-fresh(abs: Str, iface: Iface, ctx: Ctx) -> Result Iface Str =
  match (ctx)
    | Ctx(_, _, _, _, done, _, order, inits, _, _, _) ->
      match (iface)
        | Iface(_, _, init, _, _, _, _, _) ->
          {
            set!(done, Map.set(abs, iface, deref(done)))
            set!(order, snoc-str(deref(order), object-path(abs)))
            if (String.length(init) > 0) -> set!(inits, snoc-str(deref(inits), init))
            Ok(iface)
          }

let compile-forms(abs: Str, src: Str, display: Str, forms: List Ast, direct: List DepRec, ctx: Ctx) -> Result Iface Str =
  match (check-pub-private-forms(forms))
    | [] -> compile-forms-open(abs, src, display, forms, direct, ctx)
    | e :: rest ->
      {
        report-types(abs, src, e :: rest)
        Err("")
      }

; Only bare imports (and their transitive deps) contribute unprefixed
; stubs. Aliased deps are handled solely by alias-surfaces.
let bare-dep-recs(from: Str, forms: List Ast, deps: List DepRec) -> List DepRec {
  let bare = module-bare-paths(from, forms, deps)
  filter-deps-in(deps, bare)
}

let filter-deps-in(deps: List DepRec, paths: List Str) -> List DepRec =
  match (deps)
    | [] -> []
    | DepRec(h, p) :: rest ->
      if (has-str(paths, p)) -> DepRec(h, p) :: filter-deps-in(rest, paths) | filter-deps-in(rest, paths)

let compile-forms-open(abs: Str, src: Str, display: Str, forms: List Ast, direct: List DepRec, ctx: Ctx) -> Result Iface Str {
  let started = now-ms()
  let for-test = suite-member(ctx, abs) || ctx-for-test(ctx) && abs == ctx-entry(ctx)
  let done = deref(ctx-done(ctx))
  let exported = collect-exports(forms, abs, done, [], [], [])
  let body0 = prepare-body(strip-module-forms(forms), for-test)
  let bare-paths = module-bare-paths(abs, forms, direct)
  let surface = alias-surfaces-for(abs, forms, done, bare-paths, direct-surfaces(bare-paths, done, surface-of(bare-dep-recs(abs, forms, direct), done)))
  match (surface)
    | Surface(fns, ctors, stubs) ->
      match (compile-checked(abs, src, display, body0, exported, direct, fns, ctors, stubs, for-test, ctx, started))
        | Ok(iface) ->
          {
            note-compiling(abs, ctx, since(started))
            Ok(iface)
          }
        | Err(e) -> Err(e)
}

; A `(pub let stdin 0)` is a value, not a type. It has to stay in the
; importer's body so the lowerer can fold it; the other stubs are types
; and externs, present only while typechecking.
let is-let-form(ast: Ast) -> Bool =
  match (unwrap-pub(ast))
    | ParenNode(h :: _, _) ->
      match (sym-str(h))
        | Some(n) -> n == "let"
        | None -> false
    | _ -> false

let lets-only(xs: List Ast, acc: List Ast) -> List Ast =
  match (xs)
    | [] -> reverse(acc)
    | f :: rest ->
      if (is-let-form(f)) -> lets-only(rest, f :: acc) | lets-only(rest, acc)

let drop-let-forms(xs: List Ast, acc: List Ast) -> List Ast =
  match (xs)
    | [] -> reverse(acc)
    | f :: rest ->
      if (is-let-form(f)) -> drop-let-forms(rest, acc) | drop-let-forms(rest, f :: acc)

; Typecheck prepends `__print-*` helpers ahead of the surface type stubs.
; Drop only those stubs so the printers remain for lowering.
let is-print-defn(form: Ast) -> Bool =
  match (unwrap-pub(form))
    | ParenNode(_ :: name :: _, _) ->
      match (bare-name(name))
        | Some(n) -> String.length(n) >= 8 && String.slice(0, 8, n) == "__print-"
        | None -> false
    | _ -> false

let take-print-defns(forms: List Ast, acc: List Ast) -> List Ast * List Ast =
  match (forms)
    | [] -> (reverse(acc), [])
    | f :: rest ->
      if (is-print-defn(f)) -> take-print-defns(rest, f :: acc) | (reverse(acc), forms)

let drop-surface-types(checked: List Ast, n-types: Int) -> List Ast =
  match (take-print-defns(checked, []))
    | (prints, rest) -> append-asts(prints, drop-n(n-types, rest))

let compile-checked(abs: Str, src: Str, display: Str, body: List Ast, exported: Export, direct: List DepRec, fns: List FnRec, ctors: List CtorRec, stubs: List Ast, for-test: Bool, ctx: Ctx, started: Int) -> Result Iface Str {
  let types = drop-let-forms(stubs, [])
  let body1 = append-asts(lets-only(stubs, []), body)
  match (typecheck-forms(append-asts(types, body1)))
    | Err(es) ->
      {
        note-compiling(abs, ctx, since(started))
        report-types(abs, src, es)
        Err("")
      }
    | Ok(checked) -> compile-lower(abs, src, display, drop-surface-types(checked, length(types)), exported, direct, fns, ctors, for-test, ctx, started)
}

let compile-lower(abs: Str, src: Str, display: Str, body: List Ast, exported: Export, direct: List DepRec, fns: List FnRec, ctors: List CtorRec, for-test: Bool, ctx: Ctx, started: Int) -> Result Iface Str {
  let rewritten = lower-runtime-forms(body)
  let renamed = rename-module-forms(rewritten, add-rename(rewritten, abs, Map.empty()))
  let init-ref = ref([])
  let with-init = module-init-forms(abs, renamed, init-ref)
  let closed = closure-convert(with-init)
  let unique = rename-module-forms(closed, add-lam-rename(closed, abs, Map.empty()))
  let rooted = rooting-analyze(unique)
  let derived = plan-derives(rooted)
  let seeds = ctors-to-seeds(ctors)
  let info = ctor-info(derived, seeds)
  match (lower-program-sep(derived, ctx-triple(ctx), emit-paths(abs), fns-to-imps(fns), seeds))
    | Err(msg) ->
      {
        note-compiling(abs, ctx, since(started))
        report-plain(msg)
        Err("")
      }
    | Ok(bytes) -> compile-store(abs, src, with-init, exported, direct, info, init-ref, bytes, ctx, started)
}

let compile-store(abs: Str, src: Str, with-init: List Ast, exported: Export, direct: List DepRec, info: CtorTable, init-ref: Ref (List Str), bytes: Str, ctx: Ctx, started: Int) -> Result Iface Str =
  match (exported)
    | Export(fns, names, stubs) ->
      match (info)
        | CtorTable(_, local) ->
          {
            let init =
              match (deref(init-ref))
                | [] -> ""
                | s :: _ -> s
            let main-name = link-of(abs, "main")
            let main-ret =
              match (defn-return-type(with-init, main-name))
                | Some(r) -> r
                | None -> ""
            let main-sym =
              if (String.length(main-ret) > 0) -> main-name | ""
            let iface = Iface(bytes-hash(src), direct, init, main-sym, main-ret, fns, filter-ctors(local, names, []), reverse(stubs))
            if (write-bytes(object-path(abs), bytes)) ->
              if (write-iface(abs, iface)) -> finish-fresh(abs, iface, ctx) |
              {
                note-compiling(abs, ctx, since(started))
                Err("cannot write interface")
              } |
            {
              note-compiling(abs, ctx, since(started))
              Err("cannot write object")
            }
          }

let ensure-list(paths: List Str, ctx: Ctx) -> Result Unit Str =
  match (paths)
    | [] -> Ok(())
    | p :: rest ->
      match (ensure-mod(p, ctx))
        | Ok(_) -> ensure-list(rest, ctx)
        | Err(e) -> Err(e)

let dep-recs(paths: List Str) -> List DepRec =
  match (paths)
    | [] -> []
    | p :: rest -> DepRec(hash-file(iface-path(p)), p) :: dep-recs(rest)

let canon-specs(from: Str, specs: List Str) -> List Str =
  match (specs)
    | [] -> []
    | spec :: rest -> canonical-path(resolve-import(from, spec)) :: canon-specs(from, rest)

let has-nl(s: Str) -> Bool =
  has-nl-from(s, 0)

let has-nl-from(s: Str, i: Int) -> Bool =
  if (i >= String.length(s)) -> false | if (String.byte(i, s) == 10) -> true | has-nl-from(s, i + 1)

let since(started: Int) -> Int {
  let d = now-ms() - started
  if (d < 0) -> 0 | d
}

; Same rule as `mn.mnd`'s `note-compiling`: a tty, and not `--quiet` / `--json`.
let note-progress(verb: Str, abs: Str, ctx: Ctx, ms: Int) -> Unit =
  if (ctx-quiet(ctx) || json-mode-on() || not(isatty(2))) -> () |
  {
    write(stderr, progress-line(verb, display-path(abs), ms))
    ()
  }

; `examples/sc.mnd` → `examples/sc.doctest.mnd`. The generated module is not
; the source file; errors in an annotation still use the source path.
pub let doctest-label(shown: Str) -> Str =
  if (String.ends-with(".mnd", shown)) -> String.concat(String.slice(0, String.length(shown) - 4, shown), ".doctest.mnd") | String.concat(shown, ".doctest.mnd")

let note-compiling(abs: Str, ctx: Ctx, ms: Int) -> Unit {
  let orig = doctest-origin(abs)
  let name =
    if (String.length(orig) == 0) -> abs | doctest-label(display-path(orig))
  note-progress("Compiling", name, ctx, ms)
}

; Panic frames for a generated test module name the original source
; at origin 1 and the generated file at origin 0.
let emit-paths(abs: Str) -> List Str {
  let orig = doctest-origin(abs)
  if (String.length(orig) == 0) -> [display-path(abs)] | [display-path(abs), display-path(orig)]
}

let note-linking(abs: Str, ctx: Ctx, ms: Int) -> Unit =
  note-progress("Linking", abs, ctx, ms)

let note-link-label(label: Str, ctx: Ctx, ms: Int) -> Unit =
  if (ctx-quiet(ctx) || json-mode-on() || not(isatty(2))) -> () |
  {
    write(stderr, progress-line("Linking", label, ms))
    ()
  }

let compile-file(abs: Str, ctx: Ctx) -> Result Iface Str =
  compile-file-read(abs, ctx)

let compile-file-read(abs: Str, ctx: Ctx) -> Result Iface Str =
  match (ensure-module-file(abs))
    | Err(e) -> Err(e)
    | Ok(_) ->
      match (read-file(abs))
        | Err(_) -> Err(String.concat("module not found: ", display-path(abs)))
        | Ok(src) -> compile-src(abs, src, ctx)

let compile-src(abs: Str, src: Str, ctx: Ctx) -> Result Iface Str {
  let display = display-path(abs)
  let started = now-ms()
  match (read-all(src))
    | Err(e) ->
      {
        note-compiling(abs, ctx, since(started))
        report-parse(abs, src, e)
        Err("")
      }
    | Ok(forms) -> compile-casing(abs, src, display, forms, ctx, started)
}

let compile-casing(abs: Str, src: Str, display: Str, forms: List Ast, ctx: Ctx, started: Int) -> Result Iface Str =
  match (check-casing-all(forms))
    | Err(e) ->
      {
        note-compiling(abs, ctx, since(started))
        report-casing(abs, src, e)
        Err("")
      }
    | Ok(_) -> compile-desugar(abs, src, display, forms, ctx, started)

let compile-desugar(abs: Str, src: Str, display: Str, forms: List Ast, ctx: Ctx, started: Int) -> Result Iface Str =
  match (desugar-all(forms))
    | Err(es) ->
      {
        note-compiling(abs, ctx, since(started))
        report-desugar(abs, src, es)
        Err("")
      }
    | Ok(desugared) ->
      {
        let stamped = stamp-spans(desugared, src, 0)
        let qualified = rewrite-import-aliases(abs, stamped)
        match (runtime-misplaced(abs, qualified))
          | Some(msg) -> Err(msg)
          | None -> compile-desugared(abs, src, display, qualified, ctx, started)
      }

let compile-desugared(abs: Str, src: Str, display: Str, qualified: List Ast, ctx: Ctx, started: Int) -> Result Iface Str {
  let raw-specs = specs-with-basics(abs, import-specs(qualified))
  match (note-versions(ctx-versions(ctx), raw-specs))
    | Err(e) -> Err(e)
    | Ok(_) ->
      {
        let specs = canon-specs(abs, raw-specs)
        match (ensure-list(specs, ctx))
          | Ok(_) -> compile-forms(abs, src, display, prepare-runtime-forms(abs, qualified), dep-recs(specs), ctx)
          | Err(e) -> Err(e)
      }
}

let ensure-mod(abs: Str, ctx: Ctx) -> Result Iface Str =
  match (ctx)
    | Ctx(_, _, clean, _, done, visiting, _, _, _, _, _) ->
      match (Map.lookup(abs, deref(done)))
        | Some(iface) -> Ok(iface)
        | None ->
          match (Map.lookup(abs, deref(visiting)))
            | Some(_) -> Err(String.concat("import cycle: ", display-path(abs)))
            | None ->
              {
                set!(visiting, Map.set(abs, true, deref(visiting)))
                if (clean) -> remove-cache(abs)
                ensure-body(abs, ctx)
              }

let iface-main(iface: Iface) -> Str =
  match (iface)
    | Iface(_, _, _, main-sym, _, _, _, _) -> main-sym

; A suite member's object has to export `main`. An interface left by a
; non-test compile of the same file does not, so it is not reusable.
let reusable(ctx: Ctx, abs: Str, iface: Iface) -> Bool =
  iface-fresh(abs, iface) && (not(suite-member(ctx, abs)) || String.length(iface-main(iface)) > 0)

let ensure-body(abs: Str, ctx: Ctx) -> Result Iface Str =
  match (read-iface(abs))
    | Some(iface) ->
      match (iface)
        | Iface(_, deps, _, _, _, _, _, _) ->
          match (ensure-list(dep-paths(deps), ctx))
            | Ok(_) ->
              if (reusable(ctx, abs, iface)) -> finish-fresh(abs, iface, ctx) | compile-file(abs, ctx)
            | Err(e) -> Err(e)
    | None -> compile-file(abs, ctx)

let dep-paths(deps: List DepRec) -> List Str =
  match (deps)
    | [] -> []
    | DepRec(_, p) :: rest -> p :: dep-paths(rest)

let boot-path(abs: Str) -> Str =
  String.concat(Path.join(show(bytes-hash(abs)), Path.join("boot", cache-root())), ".bc")

let link-closure(abs: Str, iface: Iface, ctx: Ctx, cc: Str, runtime: Str, bin: Str) -> Result Str Str =
  match (iface)
    | Iface(_, _, _, main-sym, main-ret, _, _, _) ->
      if (String.length(main-sym) == 0) -> Err("program has no top-level `defn main`") |
      match (ctx)
        | Ctx(_, _, _, triple, _, _, order, inits, _, _, _) ->
          {
            let unit = main-ret == "Unit"
            let syms = snoc-str(deref(inits), main-sym)
            let forms = bootstrap-forms(deref(inits), main-sym, unit)
            match (lower-program-sep(forms, triple, ["<bootstrap>"], imps-of-syms(syms), []))
              | Err(msg) -> Err(msg)
              | Ok(bytes) ->
                {
                  let bp = boot-path(abs)
                  write-if-changed(bp, bytes)
                  let objs = snoc-str(deref(order), bp)
                  if (any-newer(objs, bin)) ->
                    {
                      let started = now-ms()
                      match (link-objs(cc, runtime, objs, bin))
                        | Ok(out) ->
                          {
                            note-linking(abs, ctx, since(started))
                            Ok(out)
                          }
                        | Err(msg) ->
                          {
                            note-linking(abs, ctx, since(started))
                            if (has-nl(msg)) ->
                              {
                                write(stderr, msg)
                                Err("link failed")
                              } | Err(msg)
                          }
                    } | Ok(bin)
                }
          }

pub let build-program(entry: Str, clean: Bool, for-test: Bool, cc: Str, runtime: Str, bin: Str, do-link: Bool, quiet: Bool) -> Result Str Str {
  let abs = canonical-path(entry)
  let triple = triple-from-clang(cc)
  let ctx = Ctx(abs, for-test, clean, triple, ref(Map.empty()), ref(Map.empty()), ref([]), ref([]), quiet, ref(Map.empty()), ref(Map.empty()))
  match (ensure-mod(abs, ctx))
    | Ok(iface) ->
      if (do-link) -> link-closure(abs, iface, ctx, cc, runtime, bin) | Ok("")
    | Err(e) -> Err(e)
}

record SuiteSym {
  display: Str
  sym: Str
}

let canon-files(displays: List Str) -> List Str =
  match (displays)
    | [] -> []
    | d :: rest -> canonical-path(d) :: canon-files(rest)

let fill-suite(paths: List Str, acc: Map Str Bool) -> Map Str Bool =
  match (paths)
    | [] -> acc
    | p :: rest -> fill-suite(rest, Map.set(p, true, acc))

let join-key(paths: List Str, sb: StringBuffer, first: Bool) -> Unit =
  match (paths)
    | [] -> ()
    | p :: rest ->
      {
        if (first) -> () | Buf.append-byte!(sb, 10)
        Buf.append!(sb, p)
        join-key(rest, sb, false)
      }

; Canonical paths in discovery order. A newline cannot appear in a path,
; so two different lists never share a key.
let suite-key(paths: List Str) -> Str {
  let sb = Buf.new()
  join-key(paths, sb, true)
  Buf.to-str(sb)
}

let marker-call(display: Str) -> Ast =
  ParenNode([sym("println"), str-node("file "), str-node(display)], blank())

let case-calls(cases: List SuiteSym) -> List Ast =
  match (cases)
    | [] -> []
    | SuiteSym(display, name) :: rest -> marker-call(display) :: ParenNode([sym(name)], blank()) :: case-calls(rest)

let case-syms(cases: List SuiteSym) -> List Str =
  match (cases)
    | [] -> []
    | SuiteSym(_, name) :: rest -> name :: case-syms(rest)

; Inits once, then a `file <path>` marker and that file's `mn_<hash>_main`.
; The marker is two string literals: a computed concat would print as a pointer.
let suite-bootstrap(inits: List Str, cases: List SuiteSym) -> List Ast {
  let calls = append-asts(calls-of(inits), case-calls(cases))
  let body = append-asts(calls, [int-node(0)])
  [ParenNode(append-asts([sym("defn"), sym("main"), sym("->"), sym("Int")], body), blank())]
}

let collect-cases(displays: List Str, paths: List Str, done: Map Str Iface) -> Result (List SuiteSym) Str =
  match (displays)
    | [] ->
      match (paths)
        | [] -> Ok([])
        | _ :: _ -> Err("suite paths diverged")
    | d :: ds ->
      match (paths)
        | [] -> Err("suite paths diverged")
        | a :: as ->
          match (Map.lookup(a, done))
            | None -> Err(String.concat("missing module: ", d))
            | Some(iface) ->
              {
                let main-sym = iface-main(iface)
                if (String.length(main-sym) > 0) ->
                  match (collect-cases(ds, as, done))
                    | Ok(rest) -> Ok(SuiteSym(d, main-sym) :: rest)
                    | Err(e) -> Err(e) | Err(String.concat("no main in ", d))
              }

let link-failed(msg: Str) -> Result Str Str =
  if (has-nl(msg)) ->
    {
      write(stderr, msg)
      Err("link failed")
    } | Err(msg)

let link-suite(key: Str, cases: List SuiteSym, ctx: Ctx, cc: Str, runtime: Str, bin: Str, label: Str) -> Result Str Str =
  match (ctx)
    | Ctx(_, _, _, triple, _, _, order, inits, _, _, _) ->
      {
        let inits0 = deref(inits)
        let syms = append-strs(inits0, case-syms(cases))
        let forms = suite-bootstrap(inits0, cases)
        match (lower-program-sep(forms, triple, ["<bootstrap>"], imps-of-syms(syms), []))
          | Err(msg) -> Err(msg)
          | Ok(bytes) ->
            {
              let bp = boot-path(key)
              write-if-changed(bp, bytes)
              let objs = snoc-str(deref(order), bp)
              if (any-newer(objs, bin)) ->
                {
                  let started = now-ms()
                  match (link-objs(cc, runtime, objs, bin))
                    | Ok(out) ->
                      {
                        note-link-label(label, ctx, since(started))
                        Ok(out)
                      }
                    | Err(msg) ->
                      {
                        note-link-label(label, ctx, since(started))
                        link-failed(msg)
                      }
                } | Ok(bin)
            }
      }

; One context, one bootstrap, one binary. The binary path is the hash of
; the canonical file list, so a second run with the same files links nothing
; when every object and the bootstrap are older than that binary.
pub let build-suite(displays: List Str, label: Str, clean: Bool, cc: Str, runtime: Str, quiet: Bool) -> Result Str Str {
  let paths = canon-files(displays)
  let key = suite-key(paths)
  let bin = cache-bin(key)
  let triple = triple-from-clang(cc)
  let ctx = Ctx("", true, clean, triple, ref(Map.empty()), ref(Map.empty()), ref([]), ref([]), quiet, ref(Map.empty()), ref(fill-suite(paths, Map.empty())))
  match (ensure-list(paths, ctx))
    | Err(e) -> Err(e)
    | Ok(_) ->
      match (collect-cases(displays, paths, deref(ctx-done(ctx))))
        | Err(e) -> Err(e)
        | Ok(cases) -> link-suite(key, cases, ctx, cc, runtime, bin, label)
}

let triple-marker() -> Str =
  "target triple = \""

let bytes-match-at(s: Str, i: Int, pat: Str, j: Int) -> Bool =
  if (j >= String.length(pat)) -> true | if (i + j >= String.length(s)) -> false | if (String.byte(i + j, s) == String.byte(j, pat)) -> bytes-match-at(s, i, pat, j + 1) | false

let find-bytes(s: Str, pat: Str, i: Int) -> Int =
  if (i + String.length(pat) > String.length(s)) -> -1 | if (bytes-match-at(s, i, pat, 0)) -> i | find-bytes(s, pat, i + 1)

let copy-until(s: Str, i: Int, stop: Int, acc: Str) -> Str =
  if (i >= String.length(s)) -> acc | if (String.byte(i, s) == stop) -> acc | copy-until(s, i + 1, stop, String.concat(acc, String.slice(i, 1, s)))

let triple-from-clang(cc: Str) -> Str =
  match (spawn-capture([cc, "-S", "-emit-llvm", "-o", "-", "-x", "c", "-"], "int x;"))
    | Err(_) -> ""
    | Ok(SpawnOutput(st, text, _)) ->
      if (exit-code(st) == 0) ->
        {
          let mark = triple-marker()
          let at = find-bytes(text, mark, 0)
          if (at < 0) -> "" | copy-until(text, at + String.length(mark), 34, "")
        } | ""

; `~/.menard` cache. Interface files and objects mirror the canonical
; absolute source path. Bitcode itself never stores that path or a
; timestamp; both live only here.
;
; An interface is a list of forms the reader accepts:
;   mni(3)
;   src(HASH)
;   dep(HASH, "abs")
;   init("sym") or init("-")
;   main("sym", "Ret") or main("-", "-")
;   fn-rec("name", "link", ARITY)
;   ctor("name", TAG, ARITY)
;   then each stub as its own declaration. `fn` is a keyword, so the
;   function record is `fn-rec`.

import "../reader/ast.mnd"
import "../reader/read.mnd"
import "../reader/print.mnd"
import "../modules/graph.mnd"
import std/fs
import std/io
import std/string
import std/sys

; Version 3 invalidates objects compiled with unscoped qualified imports.
let iface-version = 3

pub record DepRec {
  hash: Int
  path: Str
}

pub record FnRec {
  name: Str
  link: Str
  arity: Int
}

pub record CtorRec {
  name: Str
  tag: Int
  arity: Int
}

pub record Iface {
  src-hash: Int
  deps: List DepRec
  init: Str
  main-sym: Str
  main-ret: Str
  fns: List FnRec
  ctors: List CtorRec
  stubs: List Ast
}

let sym-str(ast: Ast) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> Some(n)
    | _ -> None()

let blank() -> Span =
  Span(0, 0, 0, 1)

let quote-str(s: Str) -> Str =
  print-form(StrNode(s, blank()))

let dirname-of(path: Str) -> Str {
  let n = str-byte-length(path)
  let slash = last-slash(path, n - 1)
  cond
    | slash < 0 -> "."
    | slash == 0 -> "/"
    | else -> str-slice(path, 0, slash)
}

let last-slash(s: Str, i: Int) -> Int =
  cond
    | i < 0 -> -1
    | str-byte(s, i) == 47 -> i
    | else -> last-slash(s, i - 1)

pub let cache-root() -> Str =
  match (getenv("MENARD_CACHE"))
    | Some(s) ->
      if (str-byte-length(s) > 0) -> s | default-cache()
    | None -> default-cache()

let default-cache() -> Str =
  match (getenv("HOME"))
    | Some(h) ->
      if (str-byte-length(h) > 0) -> str-concat(h, "/.menard") | "/tmp/menard"
    | None -> "/tmp/menard"

pub let canonical-path(path: Str) -> Str {
  let direct = realpath(path)
  if (str-byte-length(direct) > 0) -> direct | normalize-path(
    if (starts-with(path, "/")) -> path | str-concat(cwd(), "/", path)
  )
}

; Path recorded in panic frames and diagnostics. Relative to the
; working directory when the file lives under it, so the object bytes
; do not contain an absolute path.
pub let display-path(abs: Str) -> Str {
  let prefix = str-concat(cwd(), "/")
  if (starts-with(abs, prefix)) -> str-slice(abs, str-byte-length(prefix), str-byte-length(abs) - str-byte-length(prefix)) | abs
}

let cache-base(abs: Str) -> Str =
  str-concat(cache-root(), abs)

pub let iface-path(abs: Str) -> Str =
  str-concat(cache-base(abs), ".mni")

pub let object-path(abs: Str) -> Str =
  str-concat(cache-base(abs), ".bc")

pub let cache-bin(abs: Str) -> Str =
  str-concat(cache-root(), "/out/", show(bytes-hash(abs)))

pub let ensure-parent(path: Str) -> Bool =
  ensure-dir(dirname-of(path))

pub let hash-file(path: Str) -> Int =
  match (read-file(path))
    | Ok(s) -> bytes-hash(s)
    | Err(_) -> 0

let nl = {
  let sb = sb-new()
  sb-append-byte!(sb, 10)
  sb-take-str!(sb)
}

let add-line(sb: StringBuffer, s: Str) -> Unit {
  sb-append!(sb, s)
  sb-append!(sb, nl)
  ()
}

let call1(name: Str, arg: Str) -> Str =
  str-concat(name, str-concat("(", str-concat(arg, ")")))

let call2(name: Str, a: Str, b: Str) -> Str =
  str-concat(name, str-concat("(", str-concat(a, str-concat(", ", str-concat(b, ")")))))

let call3(name: Str, a: Str, b: Str, c: Str) -> Str =
  str-concat(name, str-concat("(", str-concat(a, str-concat(", ", str-concat(b, str-concat(", ", str-concat(c, ")")))))))

let write-deps(sb: StringBuffer, deps: List DepRec) -> Unit =
  match (deps)
    | [] -> ()
    | DepRec(h, p) :: rest ->
      {
        add-line(sb, call2("dep", show(h), quote-str(p)))
        write-deps(sb, rest)
      }

let write-fns(sb: StringBuffer, fns: List FnRec) -> Unit =
  match (fns)
    | [] -> ()
    | FnRec(name, link, ar) :: rest ->
      {
        add-line(sb, call3("fn-rec", quote-str(name), quote-str(link), show(ar)))
        write-fns(sb, rest)
      }

let write-ctors(sb: StringBuffer, ctors: List CtorRec) -> Unit =
  match (ctors)
    | [] -> ()
    | CtorRec(name, tag, ar) :: rest ->
      {
        add-line(sb, call3("ctor", quote-str(name), show(tag), show(ar)))
        write-ctors(sb, rest)
      }

; A stub is the declaration itself. Wrapping it in parentheses made the
; reader see a prefix list, which it no longer accepts, so the next run
; treated every cached module as missing.
let write-stubs(sb: StringBuffer, stubs: List Ast) -> Unit =
  match (stubs)
    | [] -> ()
    | f :: rest ->
      {
        add-line(sb, print-form(f))
        write-stubs(sb, rest)
      }

let dash(s: Str) -> Str =
  if (str-byte-length(s) == 0) -> "-" | s

let iface-text(iface: Iface) -> Str =
  match (iface)
    | Iface(src, deps, init, main-sym, main-ret, fns, ctors, stubs) ->
      {
        let sb = sb-new()
        add-line(sb, str-concat("mni(", show(iface-version), ")"))
        add-line(sb, call1("src", show(src)))
        write-deps(sb, deps)
        add-line(sb, call1("init", quote-str(dash(init))))
        add-line(sb, call2("main", quote-str(dash(main-sym)), quote-str(dash(main-ret))))
        write-fns(sb, fns)
        write-ctors(sb, ctors)
        write-stubs(sb, stubs)
        sb-take-str!(sb)
      }

pub let write-iface(abs: Str, iface: Iface) -> Bool {
  let path = iface-path(abs)
  ensure-parent(path)
  match (write-file(path, iface-text(iface)))
    | Ok(_) -> true
    | Err(_) -> false
}

let undash(s: Str) -> Str =
  if (s == "-") -> "" | s

let head-of(a: Ast) -> Str =
  match (a)
    | ParenNode(h :: _, _) ->
      match (sym-str(h))
        | Some(n) -> n
        | None -> ""
    | _ -> ""

let elem-str(elems: List Ast, i: Int) -> Str =
  match (elems)
    | [] -> ""
    | e :: rest ->
      cond
        | i == 0 ->
          match (e)
            | StrNode(s, _) -> s
            | _ -> ""
        | else -> elem-str(rest, i - 1)

let elem-int(elems: List Ast, i: Int) -> Int =
  match (elems)
    | [] -> 0
    | e :: rest ->
      cond
        | i == 0 ->
          match (e)
            | IntNode(n, _) -> n
            | _ -> 0
        | else -> elem-int(rest, i - 1)

let elem-ast(elems: List Ast, i: Int) -> Maybe Ast =
  match (elems)
    | [] -> None()
    | e :: rest ->
      if (i == 0) -> Some(e) | elem-ast(rest, i - 1)

let reverse-deps(xs: List DepRec, acc: List DepRec) -> List DepRec =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-deps(rest, x :: acc)

let reverse-fns(xs: List FnRec, acc: List FnRec) -> List FnRec =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-fns(rest, x :: acc)

let reverse-ctors(xs: List CtorRec, acc: List CtorRec) -> List CtorRec =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-ctors(rest, x :: acc)

let reverse-asts(xs: List Ast, acc: List Ast) -> List Ast =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-asts(rest, x :: acc)

let take-form(a: Ast, src-hash: Ref Int, deps: Ref (List DepRec), init: Ref Str, main-sym: Ref Str, main-ret: Ref Str, fns: Ref (List FnRec), ctors: Ref (List CtorRec), stubs: Ref (List Ast)) -> Unit =
  match (a)
    | ParenNode(elems, _) ->
      {
        let h = head-of(a)
        cond
          | h == "src" -> set!(src-hash, elem-int(elems, 1))
          | h == "dep" -> set!(deps, DepRec(elem-int(elems, 1), elem-str(elems, 2)) :: deref(deps))
          | h == "init" -> set!(init, undash(elem-str(elems, 1)))
          | h == "main" ->
            {
              set!(main-sym, undash(elem-str(elems, 1)))
              set!(main-ret, undash(elem-str(elems, 2)))
              ()
            }
          | h == "fn-rec" -> set!(fns, FnRec(elem-str(elems, 1), elem-str(elems, 2), elem-int(elems, 3)) :: deref(fns))
          | h == "ctor" -> set!(ctors, CtorRec(elem-str(elems, 1), elem-int(elems, 2), elem-int(elems, 3)) :: deref(ctors))
          | h == "mni" -> ()
          | else -> set!(stubs, a :: deref(stubs))
        ()
      }
    | _ -> ()

let take-forms(forms: List Ast, src-hash: Ref Int, deps: Ref (List DepRec), init: Ref Str, main-sym: Ref Str, main-ret: Ref Str, fns: Ref (List FnRec), ctors: Ref (List CtorRec), stubs: Ref (List Ast)) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        take-form(f, src-hash, deps, init, main-sym, main-ret, fns, ctors, stubs)
        take-forms(rest, src-hash, deps, init, main-sym, main-ret, fns, ctors, stubs)
      }

let iface-from-forms(forms: List Ast) -> Iface {
  let src-hash = ref(0)
  let deps = ref([])
  let init = ref("")
  let main-sym = ref("")
  let main-ret = ref("")
  let fns = ref([])
  let ctors = ref([])
  let stubs = ref([])
  take-forms(forms, src-hash, deps, init, main-sym, main-ret, fns, ctors, stubs)
  Iface(deref(src-hash), reverse-deps(deref(deps), []), deref(init), deref(main-sym), deref(main-ret), reverse-fns(deref(fns), []), reverse-ctors(deref(ctors), []), reverse-asts(deref(stubs), []))
}

let compatible-iface(forms: List Ast) -> Bool =
  match (forms)
    | ParenNode([SymNode(name, _), IntNode(version, _)], _) :: _ ->
      name == "mni" && version == iface-version
    | _ -> false

pub let read-iface(abs: Str) -> Maybe Iface =
  match (read-file(iface-path(abs)))
    | Err(_) -> None()
    | Ok(text) ->
      match (read-all(text))
        | Err(_) -> None()
        | Ok(forms) ->
          if (compatible-iface(forms)) -> Some(iface-from-forms(forms)) | None()

let deps-match(deps: List DepRec) -> Bool =
  match (deps)
    | [] -> true
    | DepRec(h, path) :: rest ->
      if (h == hash-file(iface-path(path))) -> deps-match(rest) | false

let stamps-fresh(abs: Str) -> Bool {
  let src = mtime(abs)
  let iface = mtime(iface-path(abs))
  let obj = mtime(object-path(abs))
  src > 0 && iface > src && obj > src && true
}

pub let iface-fresh(abs: Str, iface: Iface) -> Bool =
  match (iface)
    | Iface(src, deps, _, _, _, _, _, _) -> exists(object-path(abs)) && deps-match(deps) && (stamps-fresh(abs) || hash-file(abs) == src)

pub let remove-cache(abs: Str) -> Unit {
  remove(iface-path(abs))
  remove(object-path(abs))
  ()
}

let split-acc(s: Str, i: Int, start: Int, n: Int, acc: List Str) -> List Str =
  cond
    | i > n -> acc
    | i == n || str-byte(s, i) == 10 ->
      if (i == start) -> split-acc(s, i + 1, i + 1, n, acc) | split-acc(s, i + 1, i + 1, n, str-slice(s, start, i - start) :: acc)
    | else -> split-acc(s, i + 1, start, n, acc)

let reverse-strs(xs: List Str, acc: List Str) -> List Str =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-strs(rest, x :: acc)

pub let split-lines(s: Str) -> List Str =
  reverse-strs(split-acc(s, 0, 0, str-byte-length(s), []), [])

; Test harness (not part of the compiler): read a `.mnd` file, print the
; forms back out, re-read the printed text, and check the two form lists
; are structurally equal. Prints "ok" and exits 0 on a clean round trip;
; otherwise prints a reason to stderr and exits non-zero.
;
; Usage: bun run host/src/cli/menard.ts run src/tools/read-roundtrip.mnd -- <file.mnd>
; The same property is src/reader/read.test.mnd.

import "../reader/ast.mnd"

import "../reader/read.mnd"

import "../reader/print.mnd"

import std/io

import std/sys

let nl =
  {
    let sb = sb-new()
    sb-append-byte!(sb, 10)
    sb-take-str!(sb)
  }

let fail(msg: Str) -> Unit {
  write(stderr, msg)
  write(stderr, nl)
  exit(1)
}

let fail-parse(path: Str, e: ParseError) -> Unit =
  match (e)
    | ParseError(_, msg) -> fail(str-concat(path, ": parse error: ", msg))

let compare-roundtrip(path: Str, forms: List Ast, forms2: List Ast) -> Unit =
  cond
    | ast-list-equal(forms, forms2) ->
      {
        println("ok")
        exit(0)
      }
    | else -> fail(str-concat("roundtrip mismatch: ", path))

let reread(path: Str, forms: List Ast, printed: Str) -> Unit =
  match (read-all(printed))
    | Ok(forms2) -> compare-roundtrip(path, forms, forms2)
    | Err(e) -> fail-parse(str-concat(path, " (re-read)"), e)

let check-forms(path: Str, forms: List Ast) -> Unit =
  reread(path, forms, print-form-all(forms))

let check-source(path: Str, src: Str) -> Unit =
  match (read-all(src))
    | Ok(forms) -> check-forms(path, forms)
    | Err(e) -> fail-parse(path, e)

let main() -> Unit =
  cond
    | arg-count() < 1 -> fail("usage: read-roundtrip.mnd <file.mnd>")
    | else ->
      match (read-file(arg(0)))
        | Ok(src) -> check-source(arg(0), src)
        | Err(_) -> fail(str-concat("cannot read ", arg(0)))

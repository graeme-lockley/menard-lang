; Extract library doc comments and check that they are complete.
;
; A doc comment is the contiguous `;` lines immediately above a `defn`,
; with no blank line before the form. The first line is the summary.
; Every `pub let` needs at least one `@test` line.
;
; Usage: bun run host/src/cli/menard.ts run src/tools/docs.mnd -- stdlib
; Prints one record per published function. Exits 1 when a check fails.

import std/fs
import std/io
import std/list
import std/string as String
import std/sys

record Scan {
  text: Str
  ok: Bool
}

; Drop one leading space when the comment has one.
let comment-body(line: Str) -> Str {
  let n = String.length(line)
  let rest = String.slice(1, n - 1, line)
  if (String.length(rest) > 0 && String.byte(0, rest) == 32) -> String.slice(1, String.length(rest) - 1, rest) | rest
}

; The symbol at the start of s, stopping at space, `[`, `(`, or `)`.
let take-sym(s: Str, i: Int, n: Int) -> Str =
  cond
    | i >= n -> String.slice(0, n, s)
    | else ->
      {
        let b = String.byte(i, s)
        if (b == 32 || b == 91 || b == 40 || b == 41) -> String.slice(0, i, s) | take-sym(s, i + 1, n)
      }

; Bytes to skip before the name of a defn or runtime header.
let header-skip(line: Str) -> Int =
  cond
    | String.starts-with("pub runtime ", line) -> 12
    | String.starts-with("pub let ", line) -> 8
    | String.starts-with("runtime ", line) -> 8
    | else -> 4

; The function name from a defn or runtime header line.
let defn-name(line: Str) -> Str {
  let raw = String.slice(header-skip(line), String.length(line) - header-skip(line), line)
  take-sym(raw, 0, String.length(raw))
}

; True when line is a top-level defn or runtime header.
let is-defn(line: Str) -> Bool =
  String.starts-with("let ", line) || String.starts-with("pub let ", line) || String.starts-with("runtime ", line) || String.starts-with("pub runtime ", line)

; True when the defn or runtime binding is published.
let is-pub(line: Str) -> Bool =
  String.starts-with("pub let ", line) || String.starts-with("pub runtime ", line)

; The first summary line.
let summary-of(docs: List Str) -> Str =
  match (docs)
    | [] -> ""
    | h :: _ -> h

; Doc lines that record an example.
let tests-of(docs: List Str, acc: List Str) -> List Str =
  match (docs)
    | [] -> reverse(acc)
    | h :: t ->
      if (String.starts-with("@test", h)) -> tests-of(t, h :: acc) | tests-of(t, acc)

; `@module name` from a comment body, or the current module.
let module-of(body: Str, current: Str) -> Str =
  if (String.starts-with("@module ", body)) -> String.slice(8, String.length(body) - 8, body) | current

; One published record, plus a missing-summary or missing-@test note.
let scan-record(module: Str, name: Str, sig: Str, docs: List Str, exported: Bool) -> Scan {
  let summary = summary-of(docs)
  let tests = tests-of(docs, [])
  let missing-summary = summary == ""
  let missing-test = exported && length(tests) == 0
  let note =
    cond
      | missing-summary -> String.concat("error: ", module, " ", name, " has no summary\n")
      | missing-test -> String.concat("error: ", module, " ", name, " has no @test\n")
      | else -> ""
  let body =
    if (exported) -> String.concat("module: ", module, "\nname: ", name, "\nsignature: ", sig, "\nsummary: ", summary, "\n", String.join("\n", tests), "\n\n") | ""
  Scan(String.concat(note, body), not(missing-summary || missing-test))
}

; Walk the lines of one file.
let scan-lines(ls: List Str, docs: List Str, module: Str, acc: Scan) -> Scan =
  match (ls)
    | [] -> acc
    | raw :: rest ->
      {
        let line = raw
        cond
          | line == "" -> scan-lines(rest, [], module, acc)
          | String.byte(0, line) == 59 -> scan-lines(rest, append(docs, [comment-body(line)]), module-of(comment-body(line), module), acc)
          | is-defn(line) ->
            {
              let rec = scan-record(module, defn-name(line), line, docs, is-pub(line))
              match (rec)
                | Scan(text, ok) ->
                  match (acc)
                    | Scan(prev, pok) -> scan-lines(rest, [], module, Scan(String.concat(prev, text), pok && ok))
            }
          | else -> scan-lines(rest, [], module, acc)
      }

; Lines of s, keeping blanks so a blank line can end a doc comment.
let split-keep(s: Str, i: Int, start: Int, n: Int, acc: List Str) -> List Str =
  cond
    | i > n -> reverse(acc)
    | i == n || String.byte(i, s) == 10 -> split-keep(s, i + 1, i + 1, n, String.slice(start, i - start, s) :: acc)
    | else -> split-keep(s, i + 1, start, n, acc)

; Scan one library file. A missing file is a failure.
let scan-file(path: Str) -> Scan =
  match (read-file(path))
    | Err(_) -> Scan(String.concat("error: cannot read ", path, "\n"), false)
    | Ok(src) -> scan-lines(split-keep(src, 0, 0, String.length(src), []), [], "", Scan("", true))

; Library sources, not the colocated tests.
let lib-name(name: Str) -> Bool =
  String.ends-with(".mnd", name) && not(String.ends-with(".test.mnd", name))

; Join dir and name.
let join-path(dir: Str, name: Str) -> Str =
  if (dir == "" || dir == ".") -> name | String.concat(dir, "/", name)

; Scan each library file in dir.
let scan-names(dir: Str, names: List Str, acc: Scan) -> Scan =
  match (names)
    | [] -> acc
    | name :: rest ->
      cond
        | lib-name(name) ->
          {
            let one = scan-file(join-path(dir, name))
            match (one)
              | Scan(text, ok) ->
                match (acc)
                  | Scan(prev, pok) -> scan-names(dir, rest, Scan(String.concat(prev, text), pok && ok))
          }
        | else -> scan-names(dir, rest, acc)

; The published records for dir, and whether every defn is documented.
let library-docs(dir: Str) -> Scan =
  scan-names(dir, sort(split-keep(list-dir(dir), 0, 0, String.length(list-dir(dir)), [])), Scan("", true))

; True when dir's library defns have summaries and every pub defn has @test.
pub let library-docs-ok(dir: Str) -> Bool =
  match (library-docs(dir))
    | Scan(_, ok) -> ok

let main() -> Int {
  let dir =
    if (arg-count() > 0) -> arg(0) | "stdlib"
  match (library-docs(dir))
    | Scan(text, ok) ->
      {
        write(stdout, text)
        if (ok) -> 0 | 1
      }
}

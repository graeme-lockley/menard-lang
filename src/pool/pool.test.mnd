; Static pool summary. Fixture paths are from the repo root, and are
; also found when `./mn test` is run from a subdirectory. The golden
; file is what `pool-dump` used to print, including the newline
; `println` adds. `emit` still running collection stays in
; tests/phase2/pool.test.ts.

import "../reader/read.mnd"
import "../test/paths.mnd"
import "./pool.mnd"
import std/io
import std/string as String

let read-forms(path: Str) -> Maybe (List Ast) =
  match (read-file(project-file(path)))
    | Err(_) -> None()
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> None()
        | Ok(forms) -> Some(forms)

let summary-is(fixture: Str, golden: Str) -> Bool =
  match (read-forms(fixture))
    | None -> false
    | Some(forms) ->
      match (read-file(project-file(golden)))
        | Err(_) -> false
        | Ok(text) -> String.concat(pool-summary(forms), "\n") == text

test "dedups identical Str literals, reports a nullary ctor, and sorts by bytes" = summary-is("tests/phase2/fixtures/pool-basic.mnd", "tests/phase2/goldens/pool-basic.txt")

test "a program with no literals and no nullary ctors has an empty pool" =
  match (read-forms("tests/corpus/comments-and-bools.mnd"))
    | None -> false
    | Some(forms) -> pool-summary(forms) == ""

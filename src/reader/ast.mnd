; Ast — the reader's output shape, plus Span. Mirrors host/src/reader/ast.ts
; and host/src/reader/span.ts.
;
; Span and Ast are declared together in this one module (rather than split
; the way the host splits them across two files) because Menard's
; `E_PUB_PRIVATE_TYPE` check is per-module: a `pub` signature may not mention
; a nominal type the *same* module does not itself export, even if that type
; is `pub` in the module it was imported from (see host/src/type/check.ts
; `checkPubPrivateTypes`). Keeping Span and Ast in one module means every
; downstream module that imports this one gets both names directly.
;
; The host's `Ast` has one "list" tag carrying a paren/bracket `kind` field;
; here we use two constructors (ParenNode / BracketNode) instead, which is
; the more natural Menard idiom for a two-way discriminator and needs no
; extra enum type to match on.
;
; Float is a deliberate deviation from the host. The host reader stores an
; f64 and normalises it on print (see host/src/reader/print.ts: -0.0, 0.0,
; and integer-valued floats get a printed ".0"). Menard has no float
; arithmetic yet — `f+`/`f-`/`f*`/`f/` are reserved builtin names with no
; implementation in the Phase 1 host (host/src/interp/eval.ts has no case
; for them), and there is no `int->float` conversion either — so a running
; Menard program has no way to turn scanned decimal digits into a real
; Float value. FloatNode therefore carries the literal source text
; verbatim; printing it back out is still a byte-identical round trip for
; every input, at the cost of not reproducing the host's normalised form.
; Revisit once float arithmetic lands.

; `origin` is the module index in the flatten path list. A single file is 0.
; `line` is the 1-based source line of `start`, filled before typechecking.
pub record Span {
  start: Int
  end: Int
  origin: Int
  line: Int
}

pub let span-start(sp: Span) -> Int =
  match (sp)
    | Span(s, _, _, _) -> s

pub let span-end(sp: Span) -> Int =
  match (sp)
    | Span(_, e, _, _) -> e

pub let span-origin(sp: Span) -> Int =
  match (sp)
    | Span(_, _, o, _) -> o

pub let span-line(sp: Span) -> Int =
  match (sp)
    | Span(_, _, _, n) -> n

; Forward declaration: the current host typer (host/src/type/check.ts,
; `collectDef`) resolves each nominal type's own fields/ctors in a single
; pass *before* registering the type's own name, so a variant cannot name
; itself in its own ctor payloads (confirmed directly against the spec's own
; `(variant (Tree [a]) (Leaf a) (Node (Tree a) (Tree a)) (Empty))` example,
; which currently fails with E_TYPE_EXPR). Declaring the name once with no
; constructors registers it in `env.types` first, so the real declaration
; right below — which does need to reference `Ast` from within itself, for
; `(List Ast)` — resolves. Revisit once the typer pre-registers type names.
type Ast =

pub type Ast =
  | ParenNode(List Ast, Span)
  | BracketNode(List Ast, Span)
  | SymNode(Str, Span)
  | IntNode(Int, Span)
  | FloatNode(Str, Span)
  | StrNode(Str, Span)
  | BoolNode(Bool, Span)

pub let ast-span(a: Ast) -> Span =
  match (a)
    | ParenNode(_, sp) -> sp
    | BracketNode(_, sp) -> sp
    | SymNode(_, sp) -> sp
    | IntNode(_, sp) -> sp
    | FloatNode(_, sp) -> sp
    | StrNode(_, sp) -> sp
    | BoolNode(_, sp) -> sp

pub let ast-list-equal(xs: List Ast, ys: List Ast) -> Bool =
  match (xs)
    | [] ->
      match (ys)
        | [] -> true
        | _ -> false
    | Cons(hx, tx) ->
      match (ys)
        | [] -> false
        | Cons(hy, ty) -> ast-equal(hx, hy) && ast-list-equal(tx, ty)

; Structural equality, ignoring spans. Mirrors host astEqual (host/src/reader/ast.ts).
pub let ast-equal(a: Ast, b: Ast) -> Bool =
  match (a)
    | ParenNode(xs, _) ->
      match (b)
        | ParenNode(ys, _) -> ast-list-equal(xs, ys)
        | _ -> false
    | BracketNode(xs, _) ->
      match (b)
        | BracketNode(ys, _) -> ast-list-equal(xs, ys)
        | _ -> false
    | SymNode(n, _) ->
      match (b)
        | SymNode(m, _) -> n == m
        | _ -> false
    | IntNode(n, _) ->
      match (b)
        | IntNode(m, _) -> n == m
        | _ -> false
    | FloatNode(n, _) ->
      match (b)
        | FloatNode(m, _) -> n == m
        | _ -> false
    | StrNode(n, _) ->
      match (b)
        | StrNode(m, _) -> n == m
        | _ -> false
    | BoolNode(n, _) ->
      match (b)
        | BoolNode(m, _) -> n == m
        | _ -> false

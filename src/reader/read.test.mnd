; Reader round-trip: read, print, read again, and the two form lists
; match. Fixture paths are from the repo root, and are also found when
; `./mn test` is run from a subdirectory. `check` / `emit` stay in
; tests/phase2/reader-roundtrip.test.ts.

import "../test/paths.mnd"
import "./ast.mnd"
import "./read.mnd"
import "./print.mnd"
import std/io
import std/string as String

let roundtrip(path: Str) -> Bool =
  match (read-file(project-file(path)))
    | Err(_) -> false
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> false
        | Ok(forms) ->
          match (read-all(print-form-all(forms)))
            | Err(_) -> false
            | Ok(forms2) -> ast-list-equal(forms, forms2)

test "round-trips hello.mnd" = roundtrip("hello.mnd")

test "round-trips comments-and-bools.mnd" = roundtrip("tests/corpus/comments-and-bools.mnd")

test "round-trips spec-examples.mnd" = roundtrip("tests/corpus/spec-examples.mnd")

test "round-trips invalid-utf8.mnd" = roundtrip("tests/corpus/invalid-utf8.mnd")

test "named string escapes decode to bytes" = {
  match (read("\"\\n\\r\\t\""))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | StrNode(s, _) -> String.length(s) == 3 && String.byte(0, s) == 10 && String.byte(1, s) == 13 && String.byte(2, s) == 9
        | _ -> false
}

test "unicode escapes encode UTF-8" = {
  match (read("\"\\u{00e9}\\u{1F600}\""))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | StrNode(s, _) -> String.length(s) == 6 && String.byte(0, s) == 195 && String.byte(1, s) == 169 && String.byte(2, s) == 240 && String.byte(3, s) == 159 && String.byte(4, s) == 152 && String.byte(5, s) == 128
        | _ -> false
}

test "a surrogate escape is rejected" = {
  match (read("\"\\u{D800}\""))
    | Err(_) -> true
    | Ok(_) -> false
}

test "dollar is not interpolation" = {
  match (read("\"$x\""))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | StrNode(s, _) -> String.length(s) == 2 && String.byte(0, s) == 36 && String.byte(1, s) == 120
        | _ -> false
}

test "a closed quote is a character" = {
  match (read("'A'"))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | ParenNode(_ :: IntNode(n, _) :: _, _) -> n == 65 && print-form(a) == "'A'"
        | _ -> false
}

test "a character escape is one scalar" = {
  match (read("'\\n'"))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | ParenNode(_ :: IntNode(n, _) :: _, _) -> n == 10
        | _ -> false
}

test "a unicode character literal round-trips" = {
  match (read("'\\u{1F600}'"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> ast-equal(a, b) && print-form(a) == "'\\u{1f600}'"
}

test "an unclosed quote stays a symbol" = {
  match (read("'red"))
    | Err(_) -> false
    | Ok(a) -> print-form(a) == "'red"
}

test "an escaped newline round-trips through print" = {
  match (read("\"\\n\""))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> ast-equal(a, b)
}

test "pipe groups looser than addition and prints back" = {
  match (read("a + b |> f(c) |> g(d)"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> print-form(a) == "a + b |> f(c) |> g(d)" && ast-equal(a, b)
}

test "pipe needs whitespace on both sides" = {
  match (read("a|>b"))
    | Err(_) -> true
    | Ok(_) -> false
}

test "an arm bar stays a bar when the condition is a pipe" = {
  let src = "let f(n: Int) -> Int =
  cond
    | n |> g(1) -> 0
    | else -> 1
"
  match (read-all(src))
    | Err(_) -> false
    | Ok(forms) ->
      {
        let printed = print-form-all(forms)
        match (read-all(printed))
          | Err(_) -> false
          | Ok(again) -> printed == "let f(n: Int) -> Int =\n  if (n |> g(1)) -> 0 | 1\n" && print-form-all(again) == printed
      }
}

test "binding and test blocks put the opening brace after equals" = {
  let src = "let value = {
  let inner = {
    41
  }
  inner + 1
}

test \"block value\" = {
  value == 42
}
"
  match (read-all(src))
    | Err(_) -> false
    | Ok(forms) -> print-form-all(forms) == src
}

test "an empty map round-trips" = {
  match (read("{}"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> print-form(a) == "{}" && ast-equal(a, b)
}

test "a map literal and a question chain round-trip" = {
  match (read("{\"a\" => 1, \"b\" => 2}"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> ast-equal(a, b)
} && {
  match (read("{...x, \"a\" => 1, ...y}"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> ast-equal(a, b)
} && {
  match (read("a ? b ? c"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> print-form(a) == "a ? b ? c" && ast-equal(a, b)
}

test "one expression in braces stays a block" = {
  match (read("{ 1 }"))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | ParenNode(h :: _, _) ->
          match (h)
            | SymNode(n, _) -> n == "do"
            | _ -> false
        | _ -> false
}

test "question needs whitespace on both sides" = {
  match (read("a?b"))
    | Err(_) -> true
    | Ok(_) -> false
}

test "a fat arrow needs whitespace on both sides" = {
  match (read("{\"a\"=>1}"))
    | Err(_) -> true
    | Ok(_) -> false
}

test "a map entry needs a value" = {
  match (read("{\"a\" => }"))
    | Err(_) -> true
    | Ok(_) -> false
}

test "a leading shebang is ignored and the next line keeps its number" = {
  match (read("#!/usr/bin/env mn\n42"))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | IntNode(n, sp) -> n == 42 && span-line(sp) == 2
        | _ -> false
}

test "a shebang program matches the same program without it" = {
  match (read-all("#!/usr/bin/env mn\nlet main() -> Int = 0\n"))
    | Err(_) -> false
    | Ok(forms) ->
      match (read-all("let main() -> Int = 0\n"))
        | Err(_) -> false
        | Ok(plain) -> ast-list-equal(forms, plain)
}

test "a shebang with no following program is an empty file" = {
  match (read-all("#!/usr/bin/env mn\n"))
    | Err(_) -> false
    | Ok(forms) ->
      match (forms)
        | [] -> true
        | _ -> false
}

test "a hash that is not the first two bytes is an error" = {
  match (read(" #!/usr/bin/env mn\n42"))
    | Err(_) -> true
    | Ok(_) -> false
} && {
  match (read("42\n#"))
    | Err(_) -> true
    | Ok(_) -> false
}

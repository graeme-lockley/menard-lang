; Reader round-trip: read, print, read again, and the two form lists
; match. Paths are relative to the process cwd, which `./mn test` leaves
; as the repo root. `check` / `emit` stay in tests/phase2/reader-roundtrip.test.ts.

import "./ast.mnd"
import "./read.mnd"
import "./print.mnd"
import std/io
import std/string as String

let roundtrip(path: Str) -> Bool =
  match (read-file(path))
    | Err(_) -> false
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> false
        | Ok(forms) ->
          match (read-all(print-form-all(forms)))
            | Err(_) -> false
            | Ok(forms2) -> ast-list-equal(forms, forms2)

test "round-trips hello.mnd" = roundtrip("hello.mnd")

test "round-trips comments-and-bools.mnd" = roundtrip("tests/corpus/comments-and-bools.mnd")

test "round-trips spec-examples.mnd" = roundtrip("tests/corpus/spec-examples.mnd")

test "round-trips invalid-utf8.mnd" = roundtrip("tests/corpus/invalid-utf8.mnd")

test "named string escapes decode to bytes" = {
  match (read("\"\\n\\r\\t\""))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | StrNode(s, _) -> String.length(s) == 3 && String.byte(0, s) == 10 && String.byte(1, s) == 13 && String.byte(2, s) == 9
        | _ -> false
}

test "unicode escapes encode UTF-8" = {
  match (read("\"\\u{00e9}\\u{1F600}\""))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | StrNode(s, _) -> String.length(s) == 6 && String.byte(0, s) == 195 && String.byte(1, s) == 169 && String.byte(2, s) == 240 && String.byte(3, s) == 159 && String.byte(4, s) == 152 && String.byte(5, s) == 128
        | _ -> false
}

test "a surrogate escape is rejected" = {
  match (read("\"\\u{D800}\""))
    | Err(_) -> true
    | Ok(_) -> false
}

test "dollar is not interpolation" = {
  match (read("\"$x\""))
    | Err(_) -> false
    | Ok(a) ->
      match (a)
        | StrNode(s, _) -> String.length(s) == 2 && String.byte(0, s) == 36 && String.byte(1, s) == 120
        | _ -> false
}

test "an escaped newline round-trips through print" = {
  match (read("\"\\n\""))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> ast-equal(a, b)
}

test "pipe groups looser than addition and prints back" = {
  match (read("a + b |> f(c) |> g(d)"))
    | Err(_) -> false
    | Ok(a) ->
      match (read(print-form(a)))
        | Err(_) -> false
        | Ok(b) -> print-form(a) == "a + b |> f(c) |> g(d)" && ast-equal(a, b)
}

test "pipe needs whitespace on both sides" = {
  match (read("a|>b"))
    | Err(_) -> true
    | Ok(_) -> false
}

test "an arm bar stays a bar when the condition is a pipe" = {
  let src = "let f(n: Int) -> Int =
  cond
    | n |> g(1) -> 0
    | else -> 1
"
  match (read-all(src))
    | Err(_) -> false
    | Ok(forms) ->
      {
        let printed = print-form-all(forms)
        match (read-all(printed))
          | Err(_) -> false
          | Ok(again) -> printed == "let f(n: Int) -> Int =\n  if (n |> g(1)) -> 0 | 1\n" && print-form-all(again) == printed
      }
}

test "binding and test blocks put the opening brace after equals" = {
  let src = "let value = {
  let inner = {
    41
  }
  inner + 1
}

test \"block value\" = {
  value == 42
}
"
  match (read-all(src))
    | Err(_) -> false
    | Ok(forms) -> print-form-all(forms) == src
}

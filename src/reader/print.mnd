; Printer — turns Ast forms back into source bytes. Mirrors
; host/src/reader/print.ts. "Canonical enough for round-trip", not a
; pretty-printer: no re-indentation, no comment preservation.

(import "./ast.mnd")

; Re-export shim — see casing.mnd for why this is needed.
(pub alias Ast Ast)
(pub alias Span Span)

(defn print-str-byte-into (bytes: Str) (sb: StringBuffer) (i: Int) -> Unit
  (let b (str-byte bytes i))
  (if (or (= b 92) (= b 34)) (sb-append-byte! sb 92) ())
  (sb-append-byte! sb b))

(defn print-str-bytes-into (bytes: Str) (sb: StringBuffer) (i: Int) (n: Int) -> Unit
  (if (>= i n) ()
    (do
      (print-str-byte-into bytes sb i)
      (print-str-bytes-into bytes sb (+ i 1) n))))

(defn print-str-into (bytes: Str) (sb: StringBuffer) -> Unit
  (do
    (sb-append-byte! sb 34)
    (print-str-bytes-into bytes sb 0 (str-byte-length bytes))
    (sb-append-byte! sb 34)))

(defn print-list-elems-into (elems: (List Ast)) (sb: StringBuffer) (first: Bool) -> Unit
  (match elems
    (Nil) ()
    (Cons x rest)
      (do
        (if first () (sb-append-byte! sb 32))
        (print-into x sb)
        (print-list-elems-into rest sb false))))

(defn print-list-into (open: Int) (close: Int) (elems: (List Ast)) (sb: StringBuffer) -> Unit
  (do
    (sb-append-byte! sb open)
    (print-list-elems-into elems sb true)
    (sb-append-byte! sb close)))

(defn print-into (a: Ast) (sb: StringBuffer) -> Unit
  (match a
    (ParenNode elems _) (print-list-into 40 41 elems sb)
    (BracketNode elems _) (print-list-into 91 93 elems sb)
    (SymNode name _) (sb-append! sb name)
    (IntNode v _) (sb-append! sb (show v))
    ; FloatNode carries raw source text verbatim (see ast.mnd) — printed
    ; back out as-is, which is what keeps this a byte-identical round trip.
    (FloatNode text _) (sb-append! sb text)
    (StrNode bytes _) (print-str-into bytes sb)
    (BoolNode v _) (sb-append! sb (show v))))

; Print a single Ast to a Str (canonical enough for round-trip).
(pub defn print-form (a: Ast) -> Str
  (do
    (let sb (sb-new))
    (print-into a sb)
    (sb-take-str! sb)))

(defn print-all-into (xs: (List Ast)) (sb: StringBuffer) (first: Bool) -> Unit
  (match xs
    (Nil) ()
    (Cons x rest)
      (do
        (if first () (sb-append-byte! sb 10))
        (print-into x sb)
        (print-all-into rest sb false))))

; Print top-level forms separated by newlines, with one trailing newline
; when non-empty.
(pub defn print-form-all (xs: (List Ast)) -> Str
  (do
    (let sb (sb-new))
    (print-all-into xs sb true)
    (match xs (Nil) () _ (sb-append-byte! sb 10))
    (sb-take-str! sb)))

; Casing — form-aware casing check for defn/defrec/variant/alias skeletons.
; Mirrors host/src/reader/casing.ts.

import "./ast.mnd"
import std/result as Result
import std/string as String

; Re-export shim: the current host typer (host/src/type/check.ts,
; `checkPubPrivateTypes`) only accepts a `pub` signature mentioning a
; nominal type if *this* module's own export set contains that type's name —
; even when the type is `pub` in the module it was imported from. `(pub
; alias T T)` registers the name in this module's own export set without
; introducing a second, distinct nominal type (aliases are fully
; transparent, so `Ast` here and `Ast` in ast.mnd remain the same type).
; Revisit once the typer treats a re-exported type as satisfying the check.
pub alias Ast = Ast

pub alias Span = Span

pub record CasingError {
  span: Span
  message: Str
}

let mk-err(sp: Span, message: Str) -> Result Unit CasingError =
  Err(CasingError(sp, message))

let first-byte(name: Str) -> Int =
  if (String.length(name) > 0) -> String.byte(0, name) | -1

let is-upper-initial(name: Str) -> Bool {
  let b = first-byte(name)
  b >= 65 && b <= 90
}

let is-lower-initial(name: Str) -> Bool {
  let b = first-byte(name)
  b >= 97 && b <= 122
}

let expect-lower(node: Ast, role: Str) -> Result Unit CasingError =
  match (node)
    | SymNode(name, sp) ->
      if (is-lower-initial(name)) -> Ok(()) | mk-err(sp, String.concat(role, " must begin with a lowercase letter"))
    | _ -> mk-err(ast-span(node), String.concat("expected ", role, " to be a symbol"))

let expect-upper(node: Ast, role: Str) -> Result Unit CasingError =
  match (node)
    | SymNode(name, sp) ->
      if (is-upper-initial(name)) -> Ok(()) | mk-err(sp, String.concat(role, " must begin with an uppercase letter"))
    | _ -> mk-err(ast-span(node), String.concat("expected ", role, " to be a symbol"))

; Run `f` over every element of `xs`, stopping at the first failure.
let check-all(xs: List Ast, f: (Ast) -> Result Unit CasingError) -> Result Unit CasingError =
  match (xs)
    | [] -> Ok(())
    | x :: rest -> Result.and-then(fn (_) = check-all(rest, f), f(x))

let check-type-params(node: Ast) -> Result Unit CasingError =
  match (node)
    | BracketNode(elems, _) -> check-all(elems, fn (p) = expect-lower(p, "type parameter"))
    | _ -> mk-err(ast-span(node), "type parameters must be a bracket list")

; Walk type expressions in declaration skeletons: Upper constructors, lower vars.
let check-type-expr(node: Ast) -> Result Unit CasingError =
  match (node)
    | SymNode(name, sp) ->
      if (is-lower-initial(name) || is-upper-initial(name)) -> Ok(()) | mk-err(sp, "type name must begin with a letter")
    | BracketNode(elems, _) -> check-all(elems, check-type-expr)
    | ParenNode(elems, sp) -> check-type-expr-app(elems, sp)
    | _ -> mk-err(ast-span(node), "invalid type expression")

let check-type-expr-app(elems: List Ast, sp: Span) -> Result Unit CasingError =
  match (elems)
    | [] -> Ok(())
    | head :: rest -> check-type-expr-app-head(head, rest, elems)

let check-type-expr-app-head(head: Ast, rest: List Ast, elems: List Ast) -> Result Unit CasingError =
  match (head)
    | SymNode(_, _) -> Result.and-then(fn (_) = check-all(rest, check-type-expr), expect-upper(head, "type constructor"))
    | _ -> check-all(elems, check-type-expr)

; (fst: a) — field name (with optional trailing ':') plus its type expression(s).
let check-field(node: Ast) -> Result Unit CasingError =
  match (node)
    | ParenNode(elems, sp) -> check-field-elems(elems, sp)
    | _ -> mk-err(ast-span(node), "expected field form (name: Type)")

let check-field-elems(elems: List Ast, sp: Span) -> Result Unit CasingError =
  match (elems)
    | [] -> mk-err(sp, "expected field form (name: Type)")
    | name :: rest -> check-field-name-and-types(name, rest)

let check-field-name-and-types(name: Ast, rest: List Ast) -> Result Unit CasingError =
  match (name)
    | SymNode(raw, sp) -> Result.and-then(fn (_) = check-all(rest, check-type-expr), check-field-name(raw, sp))
    | _ -> mk-err(ast-span(name), "expected field name")

let strip-trailing-colon(raw: Str) -> Str {
  let n = String.length(raw)
  if (n > 0 && String.byte(n - 1, raw) == 58) -> String.slice(0, n - 1, raw) | raw
}

let check-field-name(raw: Str, sp: Span) -> Result Unit CasingError {
  let field-name = strip-trailing-colon(raw)
  if (String.length(field-name) > 0 && is-lower-initial(field-name)) -> Ok(()) | mk-err(sp, "field name must begin with a lowercase letter")
}

let check-variant-ctor(node: Ast) -> Result Unit CasingError =
  match (node)
    | ParenNode(elems, sp) -> check-variant-ctor-elems(elems, sp)
    | _ -> mk-err(ast-span(node), "expected variant constructor form")

let check-variant-ctor-elems(elems: List Ast, sp: Span) -> Result Unit CasingError =
  match (elems)
    | [] -> mk-err(sp, "expected variant constructor form")
    | head :: rest -> Result.and-then(fn (_) = check-all(rest, check-type-expr), expect-upper(head, "variant constructor"))

; Shared by defn/defrec/variant: `Name` or `(Name [params…])`.
let check-decl-name(name-part: Ast, role: Str, whole-message: Str, expect: (Ast, Str) -> Result Unit CasingError) -> Result Unit CasingError =
  match (name-part)
    | SymNode(_, _) -> expect(name-part, role)
    | ParenNode(np-elems, _) -> check-decl-name-app(np-elems, name-part, role, whole-message, expect)
    | _ -> mk-err(ast-span(name-part), whole-message)

let check-decl-name-app(np-elems: List Ast, name-part: Ast, role: Str, whole-message: Str, expect: (Ast, Str) -> Result Unit CasingError) -> Result Unit CasingError =
  match (np-elems)
    | [] -> mk-err(ast-span(name-part), whole-message)
    | the-name :: more -> Result.and-then(fn (_) = check-decl-tparams(more), expect(the-name, role))

let check-decl-tparams(more: List Ast) -> Result Unit CasingError =
  match (more)
    | [] -> Ok(())
    | tparams :: _ -> check-type-params(tparams)

; (defn name … ) or (defn (name [params…]) … )
let check-defn(elems: List Ast, whole-span: Span) -> Result Unit CasingError =
  match (elems)
    | _ :: name-part :: _ -> check-decl-name(name-part, "function name", "malformed defn name", expect-lower)
    | _ -> mk-err(whole-span, "malformed defn")

; (defrec Name fields…) or (defrec (Name [params…]) fields…)
let check-defrec(elems: List Ast, whole-span: Span) -> Result Unit CasingError =
  match (elems)
    | _ :: name-part :: fields -> Result.and-then(fn (_) = check-all(fields, check-field), check-decl-name(name-part, "record type name", "malformed defrec name", expect-upper))
    | _ -> mk-err(whole-span, "malformed defrec")

; (variant Name ctors…) or (variant (Name [params…]) ctors…)
let check-variant(elems: List Ast, whole-span: Span) -> Result Unit CasingError =
  match (elems)
    | _ :: name-part :: ctors -> Result.and-then(fn (_) = check-all(ctors, check-variant-ctor), check-decl-name(name-part, "variant type name", "malformed variant name", expect-upper))
    | _ -> mk-err(whole-span, "malformed variant")

; (alias Name Type) — Name is a type spelling, Upper.
let check-alias(elems: List Ast, whole-span: Span) -> Result Unit CasingError =
  match (elems)
    | _ :: name-part :: type-part :: _ -> Result.and-then(fn (_) = check-type-expr(type-part), expect-upper(name-part, "alias name"))
    | _ -> mk-err(whole-span, "malformed alias")

let check-form-named(name: Str, elems: List Ast, rest: List Ast, sp: Span) -> Result Unit CasingError =
  cond
    | name == "defn" -> check-defn(elems, sp)
    | name == "defrec" -> check-defrec(elems, sp)
    | name == "variant" -> check-variant(elems, sp)
    | name == "alias" -> check-alias(elems, sp)
    | else -> check-all(rest, check-form)

let check-form-nonempty(head: Ast, rest: List Ast, elems: List Ast, sp: Span) -> Result Unit CasingError =
  match (head)
    | SymNode(name, _) -> check-form-named(name, elems, rest, sp)
    | _ -> check-all(elems, check-form)

; Form-aware casing check for known special-form skeletons (spec §2.1).
; Unknown heads are skipped (no false positives), recursing into children.
pub let check-form(node: Ast) -> Result Unit CasingError =
  match (node)
    | ParenNode(elems, sp) -> check-form-paren(elems, sp)
    | _ -> Ok(())

let check-form-paren(elems: List Ast, sp: Span) -> Result Unit CasingError =
  match (elems)
    | [] -> Ok(())
    | head :: rest -> check-form-nonempty(head, rest, elems, sp)

pub let check-casing(node: Ast) -> Result Unit CasingError =
  check-form(node)

pub let check-casing-all(xs: List Ast) -> Result Unit CasingError =
  check-all(xs, check-form)

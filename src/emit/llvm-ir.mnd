; `ICallVoid`'s `kind` tag — which of the two fixed extern function
; *types* a void call's `fnty` field references (see `ICallVoid`'s own
; doc comment above for why arity alone can't disambiguate them).
pub let extern-kind-write = 0

 ; void(ptr, i64) — write_stdout/write_stderr
pub let extern-kind-print = 1

 ; void(i64) — print_i64 / print_str / mn_exit
pub let extern-kind-init = 2

 ; void(i32, ptr) — mn_init
pub let extern-kind-panic = 3

 ; void(ptr) — mn_panic
pub let extern-kind-trace-push = 4

 ; void(ptr, i64) — mn_trace_push
pub let extern-kind-trace-pop = 5

 ; void() — mn_trace_pop
pub let extern-kind-panic-at = 6

 ; void(ptr, i64, ptr) — mn_panic_at

pub let cast-zext = 1

 ; LLVM CastOps::ZExt — i1 -> i64 for Bool immediates
pub let cast-ptrtoint = 9

 ; LLVM CastOps::PtrToInt — string global -> i64


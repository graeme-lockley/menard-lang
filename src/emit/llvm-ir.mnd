; Builtin constructor tags — must match runtime/src/variants.c.
(pub let tag-nil 0)
(pub let tag-cons 1)
(pub let tag-none 2)
(pub let tag-some 3)
(pub let tag-ok 4)
(pub let tag-err 5)

; `ICallVoid`'s `kind` tag — which of the two fixed extern function
; *types* a void call's `fnty` field references (see `ICallVoid`'s own
; doc comment above for why arity alone can't disambiguate them).
(pub let extern-kind-write 0) ; void(ptr, i64) — write_stdout/write_stderr
(pub let extern-kind-print 1) ; void(i64) — print_i64 / print_str / mn_exit
(pub let extern-kind-init 2) ; void(i32, ptr) — mn_init

(pub let cast-zext 1) ; LLVM CastOps::ZExt — i1 -> i64 for Bool immediates
(pub let cast-ptrtoint 9) ; LLVM CastOps::PtrToInt — string global -> i64

; ---------------------------------------------------------------------------
; Opcode/predicate constants (llvm/Bitcode/LLVMBitCodes.h's
; `Instruction`/`CmpInst::Predicate` encodings; the small subset this
; backend needs — confirmed against `llvm-bcanalyzer --dump` by
; `tools/bc-writer/write-ssa.ts`, see its header comment).

(pub let binop-add 0)
(pub let binop-sub 1)
(pub let binop-mul 2)
(pub let binop-sdiv 4)
(pub let binop-srem 6)
(pub let binop-shl 7)
(pub let binop-lshr 8)
(pub let binop-ashr 9)
(pub let binop-or 11)

(pub let cast-trunc 0)

(pub let icmp-eq 32)
(pub let icmp-ne 33)
(pub let icmp-sgt 38)
(pub let icmp-sge 39)
(pub let icmp-slt 40)
(pub let icmp-sle 41)

; ---------------------------------------------------------------------------
; The fixed leading type-table indices every module `write-module-bc`
; writes uses (see that module's `write-types!`): `ptr`, `i64`, `i32`,
; `void`, then one function type per distinct arity actually
; defined/called. `lower.mnd`'s `Builder` needs `ty-i64`/`ty-i32` itself
; (an `IAlloca`'s "1" is `i32`; `main`'s untag-and-return sequence casts to
; `i32`) — both modules import these from here rather than each defining
; (and risking disagreeing about) their own copy.
(pub let ty-ptr 0)
(pub let ty-i64 1)
(pub let ty-i32 2)

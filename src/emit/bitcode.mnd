; Bitcode emitter — slice 2.7/2.8/2A/2B.
;
; ADR 40: the compiler's product is LLVM bitcode (`.bc`); `menard emit`
; never shells out to `llvm-as`, and this module does not either.
; `emit-program-bc` is the `emit` CLI's one entry point into code
; generation: it hands `forms` to `src/emit/lower.mnd`'s `lower-program`,
; which lowers the phase-3 subset (loops, match, strings, closures, maps,
; I/O) over the tagged-word ABI and calls `src/emit/bc-writer.mnd`'s
; `write-module-bc`. A program with no `defn main`, or a form the lowerer
; refuses, is an `Err`: `emit` fails rather than writing
; a stale module.

import "../reader/ast.mnd"
import "./lower.mnd"

; Re-export shim — see `reader/casing.mnd`'s header comment for why this
; is needed: a `pub` signature (`emit-program-bc`, below) may not mention
; a private nominal type, even one imported `pub` from elsewhere.
pub alias Ast = Ast

; String globals are `pool.mnd`'s sorted literals, consumed inside
; `lower-program`. Nullary constructors stay the C static objects.
; Emit a bitcode module for a program's forms, or an error message if the
; program has no lowerable `defn main` (see `lower.mnd`).
pub let emit-program-bc(forms: List Ast, triple: Str, paths: List Str) -> Result Str Str =
  lower-program(forms, triple, paths)

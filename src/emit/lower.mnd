; Lowering — real instruction emission for the tagged-`Int` ABI (spec
; §2.2/§3.4), replacing slice 2B/2G's constant-folding evaluator entirely.
;
; ## What changed, and why
;
; The previous version of this module (`FoldVal`, `fold-expr`, …) never
; wrote a single LLVM instruction: it *evaluated* `main`'s body down to
; one compile-time `Int` and handed that number to `bc-writer.mnd`'s
; `write-int-main-bc`, which always produced `define i32 @main() { ret
; i32 N }` — a correct exit code, but a `.bc` whose instructions do not
; compute anything. That was a deliberate, documented shortcut for
; slices 2B/2G (see the plan for exactly what it bought); this slice
; replaces it with a real (if still narrow) instruction selector: `Int`
; literals, `+ - * / %`, comparisons, `if`, `let` (both shapes), `do`, and
; calls to other top-level `Int`-returning `defn`s all become real
; `alloca`/`store`/`load`/`binop`/`icmp`/`br`/`call`/`ret` instructions
; (`src/emit/llvm-ir.mnd`'s `Item`s), assembled into an `LlvmModule` and
; handed to `src/emit/bc-writer.mnd`'s `write-module-bc`. `FoldVal` and
; every `fold-*` function are gone; there is no more "evaluate the
; program inside the compiler" path at all.
;
; What is *not* lowered here — `match`, `fn` (a closure
; `close/close.mnd` failed to lambda-lift), and any value that isn't
; `Int` (`Bool` as a first-class value, `Str`, lists, records, other
; `variant`s) — is a clean `Err`, not a crash and not a silent
; miscompile; see "Scope" below for exactly what that means for each.
; `loop`/`recur` over Int bindings *are* lowered (slice 3A).
;
; ## The tagged-`Int` ABI, literally
;
; Every `Int` this module ever produces a value for is the *tagged*
; representation, `t(v) = (v << 1) | 1` (`runtime/include/menard.h`),
; held in an `i64`. Two operations are free (spec §2.2): `+`/`-` on the
; tagged words directly, fixed up by one extra `add`/`sub` of the
; constant `1` (`t(a) + t(b) - 1 == t(a + b)`; `t(a) - t(b) + 1 == t(a -
; b)`) — the fixup is *not* optional, and skipping it is exactly the
; "naive tagged multiply" mistake spec §2.2 calls out (for `+`/`-` the
; fixup is required for correctness, not an optimisation). `*`/`/`/`%`
; untag both operands (`ashr 1`, sign-extending), perform the native
; 64-bit op, then retag (`shl 1`, `or 1`). `/` and `%` check the
; divisor first and call `mn_panic` when it is zero (spec §3.4).
; Comparisons (`< > <= >= =`) run directly on the tagged words
; (tagging is order- and equality-preserving, an injective affine map, so
; no untagging is needed) and produce `i1`, consumed only by `if`'s own
; conditional branch — this module has no other way to produce or
; consume a `Bool` value (see "Scope").
;
; ## `Builder`: the one piece of mutable state per function
;
; Exactly one `Builder` is threaded through lowering one function's body
; (never shared across functions). It owns three `Ref`s:
;
; - `items`: every `Item` appended so far, **in reverse** (`Cons`ed onto
;   the front — O(1) — then reversed once, at the end, into the order
;   `LFunc`/`write-module-bc` need).
; - `next-val`: the running absolute SSA value-id counter. A function's
;   own params occupy the first `nparams` ids right after every
;   module-scope global value (`num-globals` — the total count of
;   `Int`-returning top-level `defn`s, fixed once for the whole module
;   before any function body is lowered); `builder-new` is handed
;   `num-globals + nparams` as this counter's starting point, i.e. *after*
;   the params, since params never themselves appear as an `Item` (they
;   are simply referenced by their fixed ids). Each value-producing `Item`
;   consumes exactly one id, at the moment it is appended (`bump-val!`).
; - `next-bb`: the next not-yet-used basic-block index (`fresh-bb!`);
;   block 0 (the entry block) is implicitly already "current" the moment
;   a `Builder` is created, so this starts at `1`. See `llvm-ir.mnd`'s
;   "Basic blocks are implicit" note: nothing here tracks "which block is
;   currently open" beyond this counter — a new block simply begins right
;   after whatever `Item` most recently terminated one (`IBr`/`ICondBr`/
;   `IRet`), which holds automatically as long as every `if`'s `then`
;   block's `Item`s are fully appended before its `else` block's, which
;   are fully appended before `join`'s — exactly the order `lower-if`
;   below produces by simple recursive-descent structure, with no explicit
;   block bookkeeping needed beyond the three fresh indices it allocates.
;
; Every relative-value-reference computation (`rel-ref`) reads `next-val`
; *at the moment an instruction is appended*, before that instruction's
; own result (if it has one) is counted — exactly the semantics module
; format version 1 needs (`nextValueNo - targetAbsoluteId`; see
; `bc-writer.mnd`'s and `tools/bc-writer/write-ssa.ts`'s header comments
; for how this was confirmed against a real bitcode reader).
;
; ## Constants are never cached across a function — a real bug, fixed once
;
; An earlier draft of this module (and of `tools/bc-writer/write-ssa.ts`,
; where the mistake was actually caught) tried to dedupe small constants
; per function — "the tagged `1` is always the same value, so intern it
; once and reuse its id everywhere". That is wrong the moment the first
; use is inside an `if`'s `then` branch and a later use is inside its
; `else` sibling: `then` does not dominate `else`, so a value defined
; there is not valid there, and the module fails to verify (or worse,
; behaves unpredictably in a toolchain that skips verification). The fix
; kept here is the simple, always-correct one: `const-i64!`/`const-i32!`
; below never cache anything — every call materializes a brand-new
; `IConstI64`/`IConstI32` `Item`, right at the point of use, in whichever
; block is currently being appended to. This costs a little bitcode size
; (the same small integer may appear several times) and costs nothing in
; correctness: a freshly created value trivially dominates its own,
; immediately-following use, unconditionally, regardless of what control
; flow is or isn't open around it.
;
; ## Locals: `alloca` + `store`/`load`, uniformly, for params too
;
; Spec §3.4 "emit naive IR; let LLVM optimise" — this module allocates one
; `i64` slot per bound name (a `defn`'s own parameters *and* every `let`),
; stores into it once, and reads it back with a fresh `load` at every
; reference, never reusing a cached SSA value across uses the way a
; smarter frontend would. `mem2reg` (run by `clang`/`opt`, never by this
; compiler) turns every one of these into real SSA once the module is
; loaded; this module's own job is only to be *obviously correct*, not
; small. `env`, threaded through every lowering function below, maps a
; bound name to its alloca's absolute value id (never to a raw value) —
; `lower-sym` is the one place that turns a name into a value, via `load`.
;
; ## `if`, without hand-built `phi`s
;
; `lower-if` allocates a temporary result slot (another `alloca`, in the
; block open when the `if` is encountered — which dominates `then`,
; `else` and `join` alike), lowers `then` into a fresh `then` block ending
; in a `store` to that slot and a `br` to `join`, lowers `else` into a
; fresh `else` block the same way, then `load`s the slot back in `join` —
; exactly spec §3.4's "no hand-built phi nodes, no dominance-frontier
; reasoning" instruction, at the cost of one extra `alloca`/`store`/`load`
; per `if` that `mem2reg` is expected to clean up later, not by this
; compiler.
;
; ## Calls, and the two kinds of top-level `defn` this module sees
;
; After `close/close.mnd` (lambda lifting) and `root/root.mnd` (shadow-
; stack wrapping) have run, every top-level `defn` a real program's forms
; contain is one of exactly two shapes:
;
; - An **`Int`-only `defn`** (every param and the return both a bare
;   `Int`): `main`, any user-written helper, and every lambda-lifted
;   `__lamN`. Every one of these becomes a real `i64`-params-and-return
;   `LFunc` (`main` alone gets `() -> i32`, spec's C entry point — see
;   `finish-main-return!` below) — `collect-int-defns`/`build-func-refs`
;   assign each one a module-scope global value id, `0..N-1`, in the
;   order they appear in the program's top-level forms (this fixes the
;   global numbering `ICall`'s callee-rel operands are computed against —
;   see `llvm-ir.mnd`'s "order fixes each function's... id" note; it must
;   match `write-module-bc`'s own traversal of the same list exactly, and
;   does, since both walk the one `LFunc` list this module builds).
; - A **`Unit`, zero-parameter, empty-body no-op `defn`** — precisely
;   `root/root.mnd`'s own `shadow-push`/`shadow-pop` stand-ins (spec §4.4's
;   shadow-stack rooting ABI, still a no-op in phase 2 — see that module's
;   header comment and `runtime/src/shadow.c`'s). This module never lowers
;   these to a real function at all: `collect-noop-names` recognises the
;   shape structurally (not by hardcoding the two names), and
;   `lower-sequence` simply *skips* a call to one wherever it appears in a
;   body sequence (always mid-sequence, never a body's last form, by
;   `root/root.mnd`'s own construction) — no `LFunc`, no `ICall`, nothing
;   in the emitted module at all for either helper.
;
; Any *other* call — to a name that is neither of the above (a `Bool`-
; returning helper, a constructor, an unresolved free variable, …) — is a
; clean `Err`.
;
; ## Scope: what is not lowered, and why that is an `Err`, not a fallback
;
; - **`match`, `fn`.** `match` needs a real heap-object/shape-descriptor
;   model (spec §2.2's tagged-pointer objects) this backend has no
;   allocator story for at all; a leftover `fn` means `close-convert`
;   failed to lambda-lift it (its own documented limitation). Rather than
;   half-implement any of these, every one is a named, explicit `Err`.
;   `loop`/`recur` *are* lowered (slice 3A: alloca bindings, header/exit
;   blocks, parallel `recur` assignment).
; - **`Bool`/`Unit` as first-class values (slice 3B).** Spec §2.2 leaves
;   the bit patterns unspecified; Int already occupies every odd residue
;   via `t(v)=(v<<1)|1`, so this module uses the type-erased immediates
;   `false`/`Unit` = 1 and `true` = 3 (same bits as `t(0)`/`t(1)`).
;   Comparisons as values zext the `i1` and retag; `if`'s test accepts
;   either a direct comparison or any Bool-valued expression (`icmp ne`
;   against `false`). `Int`/`Bool`/`Unit` params and returns share the
;   same `i64` word ABI (alloca/store/load).
; - **`sdiv`/`srem`-by-zero guard (spec §3.4).** `/` and `%` untag, then
;   branch on a zero divisor to a block that calls `mn_panic` with
;   `"division by zero"` and ends in `unreachable`. The success block
;   does the native op and retags. LLVM's `sdiv`/`srem` by zero is
;   undefined, so the check has to be explicit.

import "../reader/ast.mnd"
import "../pool/pool.mnd"
import "./llvm-ir.mnd"
import "./bc-writer.mnd"
import std/list
import std/result as Result
import std/string as String
import std/map as Map
import std/string-buffer as Buf

pub alias Ast = Ast

pub alias Span = Span

pub alias Imp = Imp

; ---------------------------------------------------------------------------
; Small Ast helpers, restated locally per `src/`'s "no prelude import"
; rule (see `type/check.mnd`'s equivalent header note).

let sym-str(ast: Ast) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> Some(n)
    | _ -> None()

let is-sym(ast: Ast, name: Str) -> Bool =
  match (sym-str(ast))
    | Some(n) -> n == name
    | None -> false

let strip-trailing-colon(raw: Str) -> Str {
  let n = String.length(raw)
  if (n > 0 && String.byte(n - 1, raw) == 58) -> String.slice(0, n - 1, raw) | raw
}

; ---------------------------------------------------------------------------
; `defn` header parsing: name, `(name: Type)` params (both parts kept —
; unlike the old fold-based lowerer, this module needs a param's declared
; type to decide whether the whole `defn` is lowerable at all), the
; return type, and the body.

record LParam {
  name: Str
  ty: Ast
}

let lparam-name(p: LParam) -> Str =
  match (p)
    | LParam(n, _) -> n

let lparam-ty(p: LParam) -> Ast =
  match (p)
    | LParam(_, t) -> t

record LDefn {
  name: Str
  params: List LParam
  ret: Ast
  body: List Ast
}

let ldefn-name(ld: LDefn) -> Str =
  match (ld)
    | LDefn(n, _, _, _) -> n

let ldefn-params(ld: LDefn) -> List LParam =
  match (ld)
    | LDefn(_, p, _, _) -> p

let ldefn-ret(ld: LDefn) -> Ast =
  match (ld)
    | LDefn(_, _, r, _) -> r

let ldefn-body(ld: LDefn) -> List Ast =
  match (ld)
    | LDefn(_, _, _, b) -> b

let param-arity-of(ps: List LParam) -> Int =
  match (ps)
    | [] -> 0
    | _ :: rest -> 1 + param-arity-of(rest)

let lparam-names(ps: List LParam) -> List Str =
  match (ps)
    | [] -> []
    | p :: rest -> lparam-name(p) :: lparam-names(rest)

record ArrowSplit {
  before: List Ast
  after: List Ast
}

let find-arrow(elems: List Ast) -> Maybe ArrowSplit =
  match (elems)
    | [] -> None()
    | e :: rest -> find-arrow-cons(e, rest)

let find-arrow-cons(e: Ast, rest: List Ast) -> Maybe ArrowSplit =
  if (is-sym(e, "->")) -> Some(ArrowSplit([], rest)) | find-arrow-cons-recurse(e, rest)

let find-arrow-cons-recurse(e: Ast, rest: List Ast) -> Maybe ArrowSplit =
  match (find-arrow(rest))
    | None -> None()
    | Some(split) -> Some(ArrowSplit(e :: arrow-split-before(split), arrow-split-after(split)))

let arrow-split-before(s: ArrowSplit) -> List Ast =
  match (s)
    | ArrowSplit(b, _) -> b

let arrow-split-after(s: ArrowSplit) -> List Ast =
  match (s)
    | ArrowSplit(_, a) -> a

let param-of(ast: Ast) -> Maybe LParam =
  match (ast)
    | ParenNode(name-ast :: ty-ast :: _, _) -> param-of-named(name-ast, ty-ast)
    | _ -> None()

let param-of-named(name-ast: Ast, ty-ast: Ast) -> Maybe LParam =
  match (sym-str(name-ast))
    | Some(n) -> Some(LParam(strip-trailing-colon(n), ty-ast))
    | None -> None()

let params-of(elems: List Ast) -> List LParam =
  match (elems)
    | [] -> []
    | e :: rest -> params-of-cons(e, rest)

let params-of-cons(e: Ast, rest: List Ast) -> List LParam =
  match (param-of(e))
    | Some(p) -> p :: params-of(rest)
    | None -> params-of(rest)

; `main` or `(f [a])` — the type-parameter list (if any) is irrelevant
; here (this lowerer never instantiates one), only the bare name is.
let defn-name-of(name-part: Ast) -> Maybe Str =
  match (name-part)
    | SymNode(n, _) -> Some(n)
    | ParenNode(n-ast :: _, _) -> sym-str(n-ast)
    | _ -> None()

let parse-ldefn(elems: List Ast) -> Maybe LDefn =
  match (elems)
    | _ :: name-part :: rest -> parse-ldefn-named(name-part, rest)
    | _ -> None()

let parse-ldefn-named(name-part: Ast, rest: List Ast) -> Maybe LDefn =
  match (defn-name-of(name-part))
    | None -> None()
    | Some(name) -> parse-ldefn-header(name, rest)

let parse-ldefn-header(name: Str, rest: List Ast) -> Maybe LDefn =
  match (find-arrow(rest))
    | None -> None()
    | Some(split) -> parse-ldefn-ret(name, params-of(arrow-split-before(split)), arrow-split-after(split))

let parse-ldefn-ret(name: Str, params: List LParam, after: List Ast) -> Maybe LDefn =
  match (after)
    | ret-ast :: body -> Some(LDefn(name, params, ret-ast, body))
    | [] -> None()

; `(pub defn …)` — strip the `pub` wrapper; every other top-level shape
; (`defrec`, `variant`, `alias`, a bare expression, …) is not a `defn` and
; is simply not a lowering-relevant form.
let unwrap-pub(ast: Ast) -> Ast =
  match (ast)
    | ParenNode(head :: rest, sp) -> unwrap-pub-head(head, rest, sp, ast)
    | _ -> ast

let unwrap-pub-head(head: Ast, rest: List Ast, sp: Span, ast: Ast) -> Ast =
  if (is-sym(head, "pub")) -> unwrap-pub(ParenNode(rest, sp)) | ast

let top-form-ldefn(ast: Ast) -> Maybe LDefn =
  match (unwrap-pub(ast))
    | ParenNode(head :: rest, _) -> top-form-ldefn-named(head, rest)
    | _ -> None()

let top-form-ldefn-named(head: Ast, rest: List Ast) -> Maybe LDefn =
  if (is-sym(head, "defn")) -> parse-ldefn(head :: rest) | None()

let collect-ldefns-all(forms: List Ast) -> List LDefn =
  match (forms)
    | [] -> []
    | f :: rest -> collect-ldefns-all-cons(f, rest)

let collect-ldefns-all-cons(f: Ast, rest: List Ast) -> List LDefn =
  match (top-form-ldefn(f))
    | None -> collect-ldefns-all(rest)
    | Some(ld) -> ld :: collect-ldefns-all(rest)

; ---------------------------------------------------------------------------
; Which top-level `defn`s this module actually lowers — see header
; comment's "Calls, and the two kinds of top-level `defn`".

let is-type-named(ast: Ast, name: Str) -> Bool =
  match (ast)
    | SymNode(n, _) -> n == name
    | _ -> false

let is-int-type(ast: Ast) -> Bool =
  is-type-named(ast, "Int")

let is-bool-type(ast: Ast) -> Bool =
  is-type-named(ast, "Bool")

let is-unit-type(ast: Ast) -> Bool =
  is-type-named(ast, "Unit")

; One-word immediates share the `i64` ABI (slice 3B).
let is-word-type(ast: Ast) -> Bool =
  is-int-type(ast) || is-bool-type(ast) || is-unit-type(ast)

; Heap object types are still one `i64` word (a pointer) — List/Maybe/Result
; for slice 3C; more shapes land in later slices. User nominals (`Ast`,
; `Span`, `Type`, …) are the same ABI: a tagged heap pointer in an `i64`.
; After private-symbol uniquify, names look like `__m3_Span` — strip the
; `__mN_` prefix before the Upper-initial check.
let is-raw-upper-name(n: Str) -> Bool =
  String.length(n) > 0 && {
    let b = String.byte(0, n)
    b >= 65 && b <= 90
  }

; `__m12_Foo` → `Foo`; otherwise identity.
let strip-uniq-prefix(n: Str) -> Str {
  let len = String.length(n)
  if (len >= 4 && String.byte(0, n) == 95 && String.byte(1, n) == 95 && String.byte(2, n) == 109) -> strip-uniq-prefix-digits(n, 3, len) | n
}

let strip-uniq-prefix-digits(n: Str, i: Int, len: Int) -> Str =
  cond
    | i >= len -> n
    | else ->
      {
        let b = String.byte(i, n)
        cond
          | b >= 48 && b <= 57 -> strip-uniq-prefix-digits(n, i + 1, len)
          | b == 95 -> String.slice(i + 1, len - (i + 1), n)
          | else -> n
      }

let is-upper-type-name(n: Str) -> Bool =
  is-raw-upper-name(strip-uniq-prefix(n))

let is-heap-type(ast: Ast) -> Bool =
  match (ast)
    | SymNode(n, _) -> is-upper-type-name(n)
    | ParenNode(head :: _, _) -> is-heap-type-head(head)
    | _ -> false

let is-heap-type-head(head: Ast) -> Bool =
  match (sym-str(head))
    | Some(n) -> n == "List" || n == "Maybe" || n == "Result" || n == "Ref" || n == "Map" || n == "Fn" || is-upper-type-name(n)
    | None -> false

let is-str-type(ast: Ast) -> Bool =
  is-type-named(ast, "Str")

let is-sb-type(ast: Ast) -> Bool =
  is-type-named(ast, "StringBuffer")

; A declared type parameter (`a` in `(defn (f [a]) …)`) is one word too.
; The lowerer emits one body and never instantiates, so `a` has the same
; ABI as `Int` or `(List a)`.
let is-type-var(ast: Ast) -> Bool =
  match (ast)
    | SymNode(n, _) ->
      String.length(n) > 0 && {
        let b = String.byte(0, n)
        b >= 97 && b <= 122 && not(n == "Int" || n == "Bool" || n == "Unit" || n == "Str")
      }
    | _ -> false

let is-value-type(ast: Ast) -> Bool =
  is-word-type(ast) || is-heap-type(ast) || is-str-type(ast) || is-sb-type(ast) || is-type-var(ast)

let all-params-value(ps: List LParam) -> Bool =
  match (ps)
    | [] -> true
    | p :: rest -> is-value-type(lparam-ty(p)) && all-params-value(rest)

; Empty Unit no-ops (`shadow-push`/`shadow-pop`) stay out of the emitted
; function list — see `is-unit-noop-ldefn` below.
let is-word-ldefn(ld: LDefn) -> Bool =
  if (is-unit-noop-ldefn(ld)) -> false | is-value-type(ldefn-ret(ld)) && all-params-value(ldefn-params(ld))

let filter-word-ldefns(lds: List LDefn) -> List LDefn =
  match (lds)
    | [] -> []
    | ld :: rest -> filter-word-ldefns-cons(ld, rest)

let filter-word-ldefns-cons(ld: LDefn, rest: List LDefn) -> List LDefn =
  if (is-word-ldefn(ld)) -> ld :: filter-word-ldefns(rest) | filter-word-ldefns(rest)

; `root/root.mnd`'s `shadow-helper-defn` builds exactly `(defn NAME ->
; Unit ())` — a single-form body that is itself the empty-parens `Unit`
; literal `()` (an empty `ParenNode`), not an empty body list.
let is-unit-literal(ast: Ast) -> Bool =
  match (ast)
    | ParenNode([], _) -> true
    | _ -> false

let is-unit-literal-body(body: List Ast) -> Bool =
  match (body)
    | [f] -> is-unit-literal(f)
    | _ -> false

let is-unit-noop-ldefn(ld: LDefn) -> Bool =
  cond
    | not(is-unit-type(ldefn-ret(ld))) -> false
    | else ->
      match (ldefn-params(ld))
        | [] -> is-unit-literal-body(ldefn-body(ld))
        | _ -> false

let collect-noop-names(lds: List LDefn) -> Map Str Bool =
  match (lds)
    | [] -> Map.empty()
    | ld :: rest -> collect-noop-names-cons(ld, rest)

let collect-noop-names-cons(ld: LDefn, rest: List LDefn) -> Map Str Bool =
  if (is-unit-noop-ldefn(ld)) -> Map.set(ldefn-name(ld), true, collect-noop-names(rest)) | collect-noop-names(rest)

let find-ldefn-named(lds: List LDefn, name: Str) -> Maybe LDefn =
  match (lds)
    | [] -> None()
    | ld :: rest ->
      if (ldefn-name(ld) == name) -> Some(ld) | find-ldefn-named(rest, name)

; A resolved call target: its module-scope global value id and its
; declared arity (for the arity check `lower-call-with-ref` below does).
record FuncRef {
  abs: Int
  arity: Int
}

let func-ref-abs(fr: FuncRef) -> Int =
  match (fr)
    | FuncRef(a, _) -> a

let func-ref-arity(fr: FuncRef) -> Int =
  match (fr)
    | FuncRef(_, a) -> a

let build-func-refs(lds: List LDefn, idx: Int) -> Map Str FuncRef =
  match (lds)
    | [] -> Map.empty()
    | ld :: rest -> Map.set(ldefn-name(ld), FuncRef(idx, param-arity-of(ldefn-params(ld))), build-func-refs(rest, idx + 1))

; ---------------------------------------------------------------------------
; `Builder` — see header comment's "The one piece of mutable state per
; function".

; A basic block is its own independent, mutable slot; a value like
; `IBr`'s target is only known once that block is **closed** (see below)
; — not the instant it is allocated. Two attempts at a simpler design
; were tried and both broke the moment a branch's own content was
; itself another `if` (both are recorded here since either mistake is
; easy to make again):
;
; 1. One shared flat `items` list, with `IBr`/`ICondBr` targets computed
;    as plain absolute block numbers *the moment `fresh-bb!` hands them
;    out* — before `then`/`else` are lowered at all. Nested control flow
;    allocates *more* blocks while `then` is still being lowered, and
;    those ids land, in the actual output stream, in between `then`'s
;    own content and `else`'s — but `else`'s target id was already
;    fixed to a number that assumed no such thing would happen. Caught
;    by `llvm-as`'s "does not dominate all uses", one step removed from
;    the real mistake.
; 2. Giving every block its *own* separate item-slot (fixing #1's
;    branch-target mismatch) but still assigning each slot's final
;    stream position at *allocation* time. This looked right — every
;    branch target now really does point at the block it means — but
;    broke *value* numbering instead: `next-val` counts up in the literal
;    call order lowering happens to run in (`then`'s whole nested subtree
;    finishes — including blocks allocated *after* `else`/`join` were —
;    before `else` is even started), while `write-module-bc` reads the
;    flattened stream in allocation-position order. The two orders only
;    coincide when there is no nesting at all; a nested `if` proved it
;    silently miscounts value ids (`llvm-dis`'s "Invalid store record").
;
; The fix actually kept here: a block's final stream position is decided
; not at allocation, and not by a separately-chosen layout, but at
; **closure** — the moment lowering is done with it and moves on
; (`switch-to!`, or the one implicit close of whatever block is still
; open when the function itself is finished, `finish-builder!`). Closure
; order, it turns out, is *exactly* call order: a block's own content is
; always one contiguous burst of `emit!`/`bump-val!` calls between the
; moment it becomes current and the moment something switches away from
; it, so numbering blocks in the order they close reproduces the same
; order `next-val` already counts up in — value numbering and block
; numbering agree again, at any nesting depth, with no separate
; "layout" decision to get right or wrong.
;
; That leaves branch targets referencing a block that has not closed
; yet (every branch here is a forward reference — `if`'s `condbr` always
; targets `then`/`else`, neither closed; `then`'s and `else`'s own `br`s
; always target `join`, closed last of the three). A block's `BB` handle
; therefore carries its index as a `Ref Int`, unresolved (`-1`) until
; `close-current!` fills it in; `IBr`/`ICondBr` cannot be finished at the
; moment they are appended (their target's `Ref Int` has no real value
; yet), so this module keeps its own `PendingItem` — everything else is
; already a finished `Item`, but a branch instead carries the *handle*
; it will resolve against once every block has finally closed, at
; `builder-items-ordered`'s call to `resolve-pending-list`.
type PendingItem =
  | PDone(Item)
  | PBr(Ref Int)
  | PCondBr(Ref Int, Ref Int, Int)

record BB {
  idx-ref: Ref Int
  slot: Ref (List PendingItem)
}

let bb-idx-ref(bb: BB) -> Ref Int =
  match (bb)
    | BB(r, _) -> r

let bb-slot(bb: BB) -> Ref (List PendingItem) =
  match (bb)
    | BB(_, s) -> s

; `loop`/`recur` (slice 3A) need two more pieces of per-function mutable
; state, threaded alongside everything above:
;
; - `terminated`: true exactly when the block currently open already
;   ends in a terminator (`IBr`/`ICondBr`/`IRet`) — `emit-br!`/
;   `emit-condbr!`/`emit-ret!` set it, `switch-to!` clears it the moment
;   a *different*, freshly-open block becomes current. Two LLVM
;   instructions can never share a block if the first is already a
;   terminator; `recur` (which br's straight back to its loop's header)
;   and `if` (whose `then`/`else` arm might itself be a `recur`, or end
;   in one several levels of nested `if`/`loop` down) both need to know,
;   right where they finish lowering a branch's value, whether the
;   block they are about to append a `store`+`br` to is still open at
;   all — see `maybe-store-and-br!` below.
; - `loops`: the stack of enclosing `LoopFrame`s (innermost first), so
;   `recur` can find which loop it targets (`current-loop-frame`) and
;   `lower-loop`/`lower-recur` can push/pop as loops nest.
record LoopFrame {
  header: BB
  exit-bb: BB
  result-slot: Int
  slots: List Int
  names: List Str
  root-mark: Int
}

let loop-frame-header(lf: LoopFrame) -> BB =
  match (lf)
    | LoopFrame(h, _, _, _, _, _) -> h

let loop-frame-exit-bb(lf: LoopFrame) -> BB =
  match (lf)
    | LoopFrame(_, e, _, _, _, _) -> e

let loop-frame-result-slot(lf: LoopFrame) -> Int =
  match (lf)
    | LoopFrame(_, _, r, _, _, _) -> r

let loop-frame-slots(lf: LoopFrame) -> List Int =
  match (lf)
    | LoopFrame(_, _, _, s, _, _) -> s

let loop-frame-names(lf: LoopFrame) -> List Str =
  match (lf)
    | LoopFrame(_, _, _, _, n, _) -> n

let loop-frame-root-mark(lf: LoopFrame) -> Int =
  match (lf)
    | LoopFrame(_, _, _, _, _, m) -> m

record Builder {
  closed: Ref (List (Ref (List PendingItem)))
  cur: Ref BB
  next-val: Ref Int
  closed-count: Ref Int
  terminated: Ref Bool
  loops: Ref (List LoopFrame)
  rooting: Ref Bool
  root-base: Ref Int
  root-ns: Ref Int
  slots: Ref (List Str)
  slot-arm: Ref Bool
}

let b-closed(b: Builder) -> Ref (List (Ref (List PendingItem))) =
  match (b)
    | Builder(c, _, _, _, _, _, _, _, _, _, _) -> c

let b-cur(b: Builder) -> Ref BB =
  match (b)
    | Builder(_, c, _, _, _, _, _, _, _, _, _) -> c

let b-next-val(b: Builder) -> Ref Int =
  match (b)
    | Builder(_, _, n, _, _, _, _, _, _, _, _) -> n

let b-closed-count(b: Builder) -> Ref Int =
  match (b)
    | Builder(_, _, _, n, _, _, _, _, _, _, _) -> n

let b-terminated(b: Builder) -> Ref Bool =
  match (b)
    | Builder(_, _, _, _, t, _, _, _, _, _, _) -> t

let b-loops(b: Builder) -> Ref (List LoopFrame) =
  match (b)
    | Builder(_, _, _, _, _, l, _, _, _, _, _) -> l

let b-rooting(b: Builder) -> Ref Bool =
  match (b)
    | Builder(_, _, _, _, _, _, r, _, _, _, _) -> r

let b-root-base(b: Builder) -> Ref Int =
  match (b)
    | Builder(_, _, _, _, _, _, _, r, _, _, _) -> r

let b-root-ns(b: Builder) -> Ref Int =
  match (b)
    | Builder(_, _, _, _, _, _, _, _, n, _, _) -> n

let b-slots(b: Builder) -> Ref (List Str) =
  match (b)
    | Builder(_, _, _, _, _, _, _, _, _, s, _) -> s

let b-slot-arm(b: Builder) -> Ref Bool =
  match (b)
    | Builder(_, _, _, _, _, _, _, _, _, _, a) -> a

let new-bb() -> BB =
  BB(ref(-1), ref([]))

let builder-new(start-val: Int) -> Builder =
  Builder(ref([]), ref(new-bb()), ref(start-val), ref(0), ref(false), ref([]), ref(false), ref(0), ref(0), ref([]), ref(false))

let block-terminated(b: Builder) -> Bool =
  deref(b-terminated(b))

let mark-terminated!(b: Builder) -> Unit =
  set!(b-terminated(b), true)

let push-loop-frame!(b: Builder, lf: LoopFrame) -> Unit =
  set!(b-loops(b), lf :: deref(b-loops(b)))

let pop-loop-frame!(b: Builder) -> Unit =
  set!(
    b-loops(b),
    match (deref(b-loops(b)))
      | [] -> []
      | _ :: rest -> rest
  )

let current-loop-frame(b: Builder) -> Maybe LoopFrame =
  match (deref(b-loops(b)))
    | [] -> None()
    | lf :: _ -> Some(lf)

let emit-pending!(b: Builder, p: PendingItem) -> Unit {
  let cur = deref(b-cur(b))
  let slot = bb-slot(cur)
  set!(slot, p :: deref(slot))
}

let emit!(b: Builder, it: Item) -> Unit =
  emit-pending!(b, PDone(it))

let rel-ref(b: Builder, abs-id: Int) -> Int =
  deref(b-next-val(b)) - abs-id

let bump-val!(b: Builder) -> Int {
  let v = deref(b-next-val(b))
  set!(b-next-val(b), v + 1)
  v
}

; Allocates a fresh, still-open block; call `switch-to!` once lowering
; actually reaches it (its final index stays unresolved until then).
let fresh-bb!(b: Builder) -> BB =
  new-bb()

; Closes whichever block is currently open: resolves *its* index to the
; running closure-order counter, files its slot away in closure order,
; then bumps the counter — see header comment's "closure order ... is
; exactly call order".
let close-current!(b: Builder) -> Unit {
  let cur = deref(b-cur(b))
  let n = deref(b-closed-count(b))
  set!(bb-idx-ref(cur), n)
  set!(b-closed(b), bb-slot(cur) :: deref(b-closed(b)))
  set!(b-closed-count(b), n + 1)
}

; Closing whichever block was open and moving on always lands on a
; block with no terminator yet (even if the block we're leaving had
; one) — clearing `terminated` here, unconditionally, is what lets
; `block-terminated?` answer for "the block open right now", not "the
; block open when some earlier value was produced".
let switch-to!(b: Builder, target: BB) -> Unit {
  close-current!(b)
  set!(b-cur(b), target)
  set!(b-terminated(b), false)
}

; The one open block left when the function's body is fully lowered
; (`main`'s or an ordinary function's final `ret`'s own block) never
; goes through `switch-to!`; this closes it explicitly, exactly once,
; right before `total-blocks`/`builder-items-ordered` read the result.
let finish-builder!(b: Builder) -> Unit =
  close-current!(b)

let total-blocks(b: Builder) -> Int =
  deref(b-closed-count(b))

let pending-reverse-onto(xs: List PendingItem, acc: List PendingItem) -> List PendingItem =
  match (xs)
    | [] -> acc
    | x :: rest -> pending-reverse-onto(rest, x :: acc)

let blocks-reverse-onto(xs: List (Ref (List PendingItem)), acc: List (Ref (List PendingItem))) -> List (Ref (List PendingItem)) =
  match (xs)
    | [] -> acc
    | x :: rest -> blocks-reverse-onto(rest, x :: acc)

let append-items(xs: List Item, ys: List Item) -> List Item =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-items(rest, ys)

; Every block's own `idx-ref` is resolved by now (`finish-builder!` has
; already run) — a `PBr`/`PCondBr`'s target(s) can finally be read.
let resolve-pending(p: PendingItem) -> Item =
  match (p)
    | PDone(it) -> it
    | PBr(r) -> IBr(deref(r))
    | PCondBr(t, f, c) -> ICondBr(deref(t), deref(f), c)

let resolve-pending-list(xs: List PendingItem) -> List Item =
  match (xs)
    | [] -> []
    | x :: rest -> resolve-pending(x) :: resolve-pending-list(rest)

; `closed` accumulated blocks in closure order via Cons-prepend, so one
; reversal recovers that order; each block's own content was likewise
; Cons-prepended by `emit-pending!`, needing the same one-time reversal
; before its `PendingItem`s can be resolved and concatenated into the
; final flat stream `write-module-bc` expects.
let flatten-blocks(ordered: List (Ref (List PendingItem))) -> List Item =
  match (ordered)
    | [] -> []
    | slot :: rest -> append-items(resolve-pending-list(pending-reverse-onto(deref(slot), [])), flatten-blocks(rest))

let builder-items-ordered(b: Builder) -> List Item =
  flatten-blocks(blocks-reverse-onto(deref(b-closed(b)), []))

; ---------------------------------------------------------------------------
; Builder operations — each one appends exactly the `Item`(s) its name
; says, computing every relative reference at the moment of appending
; (see header comment's "`next-val` ... at the moment an instruction is
; appended"), and returns the fresh value's absolute id where it produces
; one.

; See header comment's "Constants are never cached across a function" —
; every call here is a brand-new `Item`, deliberately never deduped.
let const-i64!(b: Builder, raw: Int) -> Int {
  emit!(b, IConstI64(encode-signed-i64(raw)))
  bump-val!(b)
}

let const-i32!(b: Builder, raw: Int) -> Int {
  emit!(b, IConstI32(encode-signed-i64(raw)))
  bump-val!(b)
}

; `t(v) = (v << 1) | 1` — the raw i64 value a tagged `Int` literal `v`
; is; `const-i64!` then encodes *that* per the bitcode's own zig-zag
; integer-constant scheme (two independent layers — see `bc-writer.mnd`'s
; `encode-signed-i64` doc comment).
let const-tagged!(b: Builder, v: Int) -> Int =
  const-i64!(b, v * 2 + 1)

; Bool/Unit immediates (slice 3B): false/Unit = 1, true = 3.
let const-false!(b: Builder) -> Int =
  const-i64!(b, 1)

let const-true!(b: Builder) -> Int =
  const-i64!(b, 3)

let const-unit!(b: Builder) -> Int =
  const-i64!(b, 1)

let const-bool!(b: Builder, v: Bool) -> Int =
  if (v) -> const-true!(b) | const-false!(b)

; `i1` from icmp → Bool immediate: zext to i64 (0/1) then retag → 1/3.
let bool-from-i1!(b: Builder, cond-abs: Int) -> Int {
  let z = emit-cast!(b, cast-zext, cond-abs, ty-i64)
  arith-retag!(b, z)
}

let emit-binop!(b: Builder, op: Int, lhs-abs: Int, rhs-abs: Int) -> Int {
  let it = IBinop(op, rel-ref(b, lhs-abs), rel-ref(b, rhs-abs))
  emit!(b, it)
  bump-val!(b)
}

let emit-cmp2!(b: Builder, pred: Int, lhs-abs: Int, rhs-abs: Int) -> Int {
  let it = ICmp2(pred, rel-ref(b, lhs-abs), rel-ref(b, rhs-abs))
  emit!(b, it)
  bump-val!(b)
}

let emit-cast!(b: Builder, op: Int, val-abs: Int, to-ty: Int) -> Int {
  let it = ICast(op, rel-ref(b, val-abs), to-ty)
  emit!(b, it)
  bump-val!(b)
}

; `alloca i64, align 8`. The array-size operand is a fresh `i32` `1`
; (never cached — see above); its id is absolute, not relative, per
; `llvm-ir.mnd`'s `IAlloca` doc comment.
let emit-alloca!(b: Builder) -> Int {
  let size-abs = const-i32!(b, 1)
  emit!(b, IAlloca(size-abs))
  bump-val!(b)
}

let emit-store!(b: Builder, ptr-abs: Int, val-abs: Int) -> Unit =
  emit!(b, IStore(rel-ref(b, ptr-abs), rel-ref(b, val-abs)))

let emit-load!(b: Builder, ptr-abs: Int) -> Int {
  emit!(b, ILoad(rel-ref(b, ptr-abs)))
  bump-val!(b)
}

; Branch targets are `BB` handles, not raw ints — their real index is
; unresolved until closure (see header comment); `emit-pending!` files
; a `PBr`/`PCondBr` carrying the target's own `idx-ref` directly, to be
; read back only once every block has closed.
let emit-br!(b: Builder, target: BB) -> Unit {
  emit-pending!(b, PBr(bb-idx-ref(target)))
  mark-terminated!(b)
}

let emit-condbr!(b: Builder, true-bb: BB, false-bb: BB, cond-abs: Int) -> Unit {
  emit-pending!(b, PCondBr(bb-idx-ref(true-bb), bb-idx-ref(false-bb), rel-ref(b, cond-abs)))
  mark-terminated!(b)
}

let rel-refs(b: Builder, xs: List Int) -> List Int =
  match (xs)
    | [] -> []
    | x :: rest -> rel-ref(b, x) :: rel-refs(b, rest)

let emit-call!(b: Builder, callee-abs: Int, arg-abs: List Int) -> Int {
  let callee-rel = rel-ref(b, callee-abs)
  let arg-rels = rel-refs(b, arg-abs)
  emit!(b, ICall(callee-rel, arg-rels))
  bump-val!(b)
}

; May-collect functions keep every Menard word in a shadow slot and reload
; it at each use, so a copying collection can update the slot. The index
; `mn_root_keep` returns is a tagged immediate, not a pointer.
let is-rooting(b: Builder) -> Bool =
  deref(b-rooting(b))

let keep!(b: Builder, v: Int) -> Int =
  if (not(is-rooting(b)) || block-terminated(b)) -> v | emit-call!(b, extern-root-keep-abs(deref(b-root-ns(b))), [v])

let get!(b: Builder, v: Int) -> Int =
  if (not(is-rooting(b)) || block-terminated(b)) -> v | emit-call!(b, extern-root-get-abs(deref(b-root-ns(b))), [v])

let get-words!(b: Builder, xs: List Int) -> List Int =
  match (xs)
    | [] -> []
    | x :: rest -> get!(b, x) :: get-words!(b, rest)

let emit-call-words!(b: Builder, callee-abs: Int, arg-abs: List Int) -> Int =
  emit-call!(b, callee-abs, get-words!(b, arg-abs))

let emit-root-save!(b: Builder) -> Int =
  emit-call!(b, extern-root-save-abs(deref(b-root-ns(b))), [])

let emit-root-restore!(b: Builder, depth-abs: Int) -> Unit =
  cond
    | is-rooting(b) ->
      {
        emit-call!(b, extern-root-restore-abs(deref(b-root-ns(b))), [depth-abs])
        ()
      }

; Alloca whose address is on the shadow stack. The push is a real
; `ptr` call so LLVM cannot drop the following store or fold the slot
; into an incoming stack argument (which the push would then zero).
; Allocation-free functions get a plain alloca.
let root-alloca!(b: Builder) -> Int {
  let slot = emit-alloca!(b)
  cond
    | is-rooting(b) ->
      {
        emit-call-void!(b, extern-kind-write, extern-root-push-abs(deref(b-root-ns(b))), [slot, const-i64!(b, 0)])
        slot
      }
    | else -> slot
}

let emit-ret!(b: Builder, val-abs: Int) -> Unit {
  emit!(b, IRet(rel-ref(b, val-abs)))
  mark-terminated!(b)
}

let emit-unreachable!(b: Builder) -> Unit {
  emit!(b, IUnreachable())
  mark-terminated!(b)
}

; `if`'s (and `loop`'s) own "does this branch's value even reach the
; join/exit block" check — see `LoopFrame`'s doc comment. If the block
; open right now already ended in a terminator (a `recur` branching
; straight back to its loop's header, several `if`/`loop` levels down),
; a further `store`+`br` here would be a second terminator in the same
; block — always wrong, never merely redundant — so this is skipped
; entirely; the caller's `switch-to!` to whatever comes next still runs
; unconditionally, exactly as if this branch had produced a value.
    ; The slot holds a root index (an immediate). The join reloads it
    ; with `get!`. Storing the index, not the word, means this alloca
    ; does not have to be a shadow root — including when the `if` sits
    ; in a loop header.
let maybe-store-and-br!(b: Builder, result-slot: Int, val-abs: Int, target: BB) -> Unit =
  cond
    | block-terminated(b) -> ()
    | else ->
      {
        emit-store!(b, result-slot, val-abs)
        emit-br!(b, target)
      }

; `+`/`-`: free plus a one-instruction fixup (header comment's "The
; tagged-`Int` ABI, literally").
let arith-add!(b: Builder, av: Int, cv: Int) -> Int {
  let sum = emit-binop!(b, binop-add, av, cv)
  let one = const-i64!(b, 1)
  emit-binop!(b, binop-sub, sum, one)
}

let arith-sub!(b: Builder, av: Int, cv: Int) -> Int {
  let diff = emit-binop!(b, binop-sub, av, cv)
  let one = const-i64!(b, 1)
  emit-binop!(b, binop-add, diff, one)
}

; untag (`ashr 1`) / retag (`shl 1`, `or 1`) — shared by `*`/`/`/`%`.
let arith-untag!(b: Builder, v: Int) -> Int {
  let one = const-i64!(b, 1)
  emit-binop!(b, binop-ashr, v, one)
}

let arith-retag!(b: Builder, v: Int) -> Int {
  let one = const-i64!(b, 1)
  let shifted = emit-binop!(b, binop-shl, v, one)
  emit-binop!(b, binop-or, shifted, one)
}

let arith-mul!(b: Builder, av: Int, cv: Int) -> Int {
  let ua = arith-untag!(b, av)
  let uc = arith-untag!(b, cv)
  let prod = emit-binop!(b, binop-mul, ua, uc)
  arith-retag!(b, prod)
}

; A zero divisor panics before `sdiv`/`srem`. The panic block does not
; fall through: `mn_panic` does not return, and `unreachable` is the
; terminator. The success block stays open so the retagged result is
; the value later instructions see.
; `file-gid` is the NUL-terminated path global. `line` is a raw i64, not a tagged Int.
let arith-checked!(b: Builder, panic-at-abs: Int, file-gid: Int, line: Int, msg-gid: Int, op: Int, av: Int, cv: Int) -> Int {
  let ua = arith-untag!(b, av)
  let uc = arith-untag!(b, cv)
  let zero = const-i64!(b, 0)
  let is-zero = emit-cmp2!(b, icmp-eq, uc, zero)
  let panic-bb = fresh-bb!(b)
  let ok-bb = fresh-bb!(b)
  emit-condbr!(b, panic-bb, ok-bb, is-zero)
  switch-to!(b, panic-bb)
  let line-c = const-i64!(b, line)
  emit-call-void!(b, extern-kind-panic-at, panic-at-abs, [file-gid, line-c, msg-gid])
  emit-unreachable!(b)
  switch-to!(b, ok-bb)
  arith-retag!(b, emit-binop!(b, op, ua, uc))
}

let arith-div!(b: Builder, panic-at-abs: Int, file-gid: Int, line: Int, msg-gid: Int, av: Int, cv: Int) -> Int =
  arith-checked!(b, panic-at-abs, file-gid, line, msg-gid, binop-sdiv, av, cv)

let arith-rem!(b: Builder, panic-at-abs: Int, file-gid: Int, line: Int, msg-gid: Int, av: Int, cv: Int) -> Int =
  arith-checked!(b, panic-at-abs, file-gid, line, msg-gid, binop-srem, av, cv)

; ---------------------------------------------------------------------------
; `StrPool` — every distinct `Str` literal `println`/`print`/`write`
; lowering needs a global for, deduped by content (so two `(println
; "x")` call sites, or a `println` and an unrelated `(write 1 "x")` that
; happen to share literal text, share one global rather than each
; getting their own). `"\n"`, which `println` always writes, shares that
; global with any literal of the same bytes. Two passes share this one type:
;
; 1. **Collection** (`collect-str-pool`, called once by `lower-program`,
;    before lowering anything): a pure syntactic walk of *every* form —
;    every top-level form and every `defn`'s body, recursing into every
;    nested `ParenNode`/`BracketNode` unconditionally — looking for a
;    `println`/`print`/`write` call shape and pulling out its `Str`-
;    literal argument(s) (`println` additionally, always, adds
;    `"\n"` — even a bare `(println)`). This never calls
;    `lower-expr` and needs no `env`/`funcs`/`noop`: it is *purely*
;    syntactic, so it cannot fail, and — critically — it can run before
;    `num-globals` (how many ids every function's own local `Builder`
;    numbering must start after, see `lower-program-build`) is known,
;    which real lowering's own value ids depend on.
; 2. **Lookup** (`str-pool-get`, called throughout real lowering): the
;    *same* pool, finalized (`str-pool-finalize`, which fixes the three
;    runtike externs' own abs ids once the final string count is known
;    — see `llvm-ir.mnd`'s `extern-write-stdout-abs`/etc.), threaded
;    through every `lower-*` function (the same way `funcs`/`noop`
;    already are) purely so `println`/`print`/`write`'s own lowering can
;    look up which abs id a given literal's global occupies — by
;    *content*, not by traversal order, so collection and lowering never
;    need to visit nodes in lock-step for this to stay correct.
;
; `order-rev` accumulates in reverse (`Cons`-prepend, same rationale as
; `Builder`'s own `items`); `str-pool-strs` reverses it once, for
; `LlvmModule`'s `globals` (id `0..S-1`, in `pool.mnd`'s sorted order,
; with `println`'s newline appended when it is not already a literal).
pub record CtorSpec {
  tag: Int
  arity: Int
}

let ctor-spec-tag(c: CtorSpec) -> Int =
  match (c)
    | CtorSpec(t, _) -> t

let ctor-spec-arity(c: CtorSpec) -> Int =
  match (c)
    | CtorSpec(_, a) -> a

record StrPool {
  order-rev: List Str
  by-content: Map Str Int
  next: Int
  write-stdout-abs: Int
  print-i64-abs: Int
  write-stderr-abs: Int
  ctors: Map Str CtorSpec
  origins: List Str
  file-gids: Ref (Map Str Int)
}

let str-pool-order-rev(p: StrPool) -> List Str =
  match (p)
    | StrPool(o, _, _, _, _, _, _, _, _) -> o

let str-pool-by-content(p: StrPool) -> Map Str Int =
  match (p)
    | StrPool(_, m, _, _, _, _, _, _, _) -> m

let str-pool-next(p: StrPool) -> Int =
  match (p)
    | StrPool(_, _, n, _, _, _, _, _, _) -> n

let str-pool-write-stdout-abs(p: StrPool) -> Int =
  match (p)
    | StrPool(_, _, _, w, _, _, _, _, _) -> w

let str-pool-print-i64-abs(p: StrPool) -> Int =
  match (p)
    | StrPool(_, _, _, _, pr, _, _, _, _) -> pr

let str-pool-write-stderr-abs(p: StrPool) -> Int =
  match (p)
    | StrPool(_, _, _, _, _, e, _, _, _) -> e

let str-pool-ctors(p: StrPool) -> Map Str CtorSpec =
  match (p)
    | StrPool(_, _, _, _, _, _, c, _, _) -> c

let str-pool-origins(p: StrPool) -> List Str =
  match (p)
    | StrPool(_, _, _, _, _, _, _, o, _) -> o

let str-pool-file-gids(p: StrPool) -> Ref (Map Str Int) =
  match (p)
    | StrPool(_, _, _, _, _, _, _, _, g) -> g

; Every abs-id field is meaningless until `str-pool-finalize` runs
; (collection alone never reads them) — `0 - 1` (`-1`) as a visibly
; invalid placeholder, same convention `new-bb`'s unresolved index uses.
let str-pool-new(origins: List Str) -> StrPool =
  StrPool([], Map.empty(), 0, -1, -1, -1, Map.empty(), origins, ref(Map.empty()))

let str-pool-count(p: StrPool) -> Int =
  str-pool-next(p)

let str-pool-add(p: StrPool, s: Str) -> StrPool =
  match (Map.lookup(s, str-pool-by-content(p)))
    | Some(_) -> p
    | None -> StrPool(s :: str-pool-order-rev(p), Map.set(s, str-pool-next(p), str-pool-by-content(p)), str-pool-next(p) + 1, str-pool-write-stdout-abs(p), str-pool-print-i64-abs(p), str-pool-write-stderr-abs(p), str-pool-ctors(p), str-pool-origins(p), str-pool-file-gids(p))

; Always found once `str-pool-add` has run over every occurrence
; `collect-str-pool` sees — see that function's header comment for why
; this content-keyed lookup never depends on traversal order matching.
let str-pool-get(p: StrPool, s: Str) -> Int =
  match (Map.lookup(s, str-pool-by-content(p)))
    | Some(id) -> id
    | None -> -1

let str-pool-strs(p: StrPool) -> List Str =
  reverse(str-pool-order-rev(p))

; Fixes the three externs' abs ids (`llvm-ir.mnd`'s `extern-write-stdout-
; abs`/etc.) once the final string count is known — called exactly once,
; by `lower-program-build`, right after collection finishes and before
; any real lowering begins. Also attaches the program's user-ctor table.
let str-pool-finalize(p: StrPool, ctors: Map Str CtorSpec) -> StrPool {
  let s = str-pool-count(p)
  StrPool(str-pool-order-rev(p), str-pool-by-content(p), str-pool-next(p), s, s + 1, s + 2, ctors, str-pool-origins(p), str-pool-file-gids(p))
}

; String globals come from `pool.mnd`'s sorted literals. `"\n"` is
; appended so a bare `(println)` still has a global; `str-pool-add` leaves
; an existing literal where the sort put it.
let str-pool-from-list(xs: List Str, p: StrPool) -> StrPool =
  match (xs)
    | [] -> p
    | s :: rest -> str-pool-from-list(rest, str-pool-add(p, s))

let list-nth-str(xs: List Str, i: Int) -> Str =
  match (xs)
    | [] -> ""
    | h :: t ->
      if (i <= 0) -> h | list-nth-str(t, i - 1)

let origin-path(pool: StrPool, origin: Int) -> Str =
  list-nth-str(str-pool-origins(pool), origin)

let c-str(s: Str) -> Str {
  let sb = Buf.new()
  Buf.append!(sb, s)
  Buf.append-byte!(sb, 0)
  Buf.take-str!(sb)
}

let add-origin-cstrs(ps: List Str, p: StrPool) -> StrPool =
  match (ps)
    | [] -> str-pool-add(p, c-str(""))
    | s :: rest -> add-origin-cstrs(rest, str-pool-add(p, c-str(s)))

let span-line-clamped(sp: Span) -> Int {
  let n = span-line(sp)
  if (n < 1) -> 1 | n
}

let file-gid-of(pool: StrPool, origin: Int) -> Int {
  let path = origin-path(pool, origin)
  let gids = str-pool-file-gids(pool)
  match (Map.lookup(path, deref(gids)))
    | Some(id) -> id
    | None ->
      {
        let id = str-pool-get(pool, c-str(path))
        set!(gids, Map.set(path, id, deref(gids)))
        id
      }
}

let collect-str-pool(forms: List Ast, paths: List Str) -> StrPool =
  add-origin-cstrs(paths, str-pool-add(str-pool-add(str-pool-from-list(pool-string-literals(forms), str-pool-new(paths)), "\n"), div-zero-msg()))

; -- real lowering's own void-call emission: `println`/`print`/`write`
; call one of the three fixed runtime externs directly (never a real
; user-defined `defn`), producing no `Int` value at all (spec: `Unit`) —
; see `llvm-ir.mnd`'s `ICallVoid` doc comment for why this needs its own
; `Item`/emission path rather than reusing `emit-call!`, which always
; assumes (and bumps a value id for) an `Int`-returning callee. --

let emit-call-void!(b: Builder, kind: Int, callee-abs: Int, arg-abs: List Int) -> Unit {
  let callee-rel = rel-ref(b, callee-abs)
  let arg-rels = rel-refs(b, arg-abs)
  emit!(b, ICallVoid(kind, callee-rel, arg-rels))
}

; `mn_write_stdout`/`mn_write_stderr(ptr, i64)` — `s`'s own global
; (looked up by content in `pool`) and its byte length, a fresh `i64`
; constant (never cached — same rationale as every other constant in
; this module, see the header comment's "Constants are never cached").
let emit-write-str-to!(b: Builder, pool: StrPool, s: Str, callee-abs: Int) -> Unit {
  let gid = str-pool-get(pool, s)
  let len-abs = const-i64!(b, String.length(s))
  emit-call-void!(b, extern-kind-write, callee-abs, [gid, len-abs])
}

; `mn_print_i64(i64)` — `v`'s already-tagged `Int` value, untagged
; (`arith-untag!`, the same `ashr 1` `*`/`/`/`%` already share) before
; the call: the runtime helper takes a plain machine `int64_t`, per its
; own doc comment (`runtime/include/menard.h`).
let emit-print-i64!(b: Builder, pool: StrPool, v: Int) -> Unit {
  let untagged = arith-untag!(b, get!(b, v))
  emit-call-void!(b, extern-kind-print, str-pool-print-i64-abs(pool), [untagged])
}

; ---------------------------------------------------------------------------
; The lowerer proper. `env` binds a body's local names (params, `let`s)
; to alloca absolute ids; `funcs` is every lowerable (`Int`-only) `defn`,
; for calls; `noop` is every `Unit`, zero-arg, empty-body `defn`'s name,
; for the shadow-push/pop skip (see header comment).

let is-arith-binop(s: Str) -> Bool =
  s == "+" || s == "-" || s == "*" || s == "/" || s == "%"

let is-cmp-op(s: Str) -> Bool =
  s == "<" || s == ">" || s == "<=" || s == ">=" || s == "="

let str-in-list(s: Str, xs: List Str) -> Bool =
  match (xs)
    | [] -> false
    | x :: rest ->
      if (s == x) -> true | str-in-list(s, rest)

let unsupported-form-names() -> List Str =
  ["quote"]

let is-unsupported-form(s: Str) -> Bool =
  str-in-list(s, unsupported-form-names())

let lower-expr(ast: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(fn (v) = Ok(keep!(b, v)), lower-expr-raw(ast, env, b, funcs, noop, pool))

let lower-expr-raw(ast: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (ast)
    | IntNode(n, _) -> Ok(const-tagged!(b, n))
    | BoolNode(v, _) -> Ok(const-bool!(b, v))
    | SymNode(name, _) -> lower-sym(name, env, b, funcs, pool)
    | ParenNode(elems, sp) -> lower-paren(elems, sp, env, b, funcs, noop, pool)
    | BracketNode(_, _) -> Err("cannot lower a list literal with the real instruction lowerer yet")
    | StrNode(s, _) -> Ok(emit-str-lit!(b, pool, s))
    | FloatNode(s, _) -> Ok(emit-float-lit!(b, pool, s))

let emit-float-lit!(b: Builder, pool: StrPool, s: Str) -> Int {
  let gid = str-pool-get(pool, s)
  let ptr-i64 = emit-cast!(b, cast-ptrtoint, gid, ty-i64)
  let len = const-i64!(b, String.length(s))
  emit-call!(b, extern-float-from-str-abs(str-pool-count(pool)), [ptr-i64, len])
}

let emit-str-lit!(b: Builder, pool: StrPool, s: Str) -> Int {
  let gid = str-pool-get(pool, s)
  let ptr-i64 = emit-cast!(b, cast-ptrtoint, gid, ty-i64)
  let len = const-i64!(b, String.length(s))
  emit-call!(b, extern-str-new-abs(str-pool-count(pool)), [ptr-i64, len])
}

; A module slot's key is the binding's name, looked up in the string pool.
; `mn_slot_get` / `mn_slot_set` take that global's address and byte length.
let emit-slot-get!(b: Builder, pool: StrPool, name: Str) -> Int {
  let gid = str-pool-get(pool, name)
  let ptr-i64 = emit-cast!(b, cast-ptrtoint, gid, ty-i64)
  let len = const-i64!(b, String.length(name))
  emit-call!(b, extern-slot-get-abs(str-pool-count(pool)), [ptr-i64, len])
}

let emit-slot-set!(b: Builder, pool: StrPool, name: Str, w: Int) -> Unit {
  let gid = str-pool-get(pool, name)
  let ptr-i64 = emit-cast!(b, cast-ptrtoint, gid, ty-i64)
  let len = const-i64!(b, String.length(name))
  emit-call!(b, extern-slot-set-abs(str-pool-count(pool)), [ptr-i64, len, w])
  ()
}

let lower-sym(name: Str, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, pool: StrPool) -> Result Int Str =
  match (Map.lookup(name, env))
    | Some(slot) -> Ok(emit-load!(b, slot))
    | None ->
      match (Map.lookup(name, funcs))
        | Some(fr) -> lower-func-as-value(fr, b, pool)
        | None ->
          if (str-in-list(name, deref(b-slots(b)))) -> Ok(emit-slot-get!(b, pool, name)) | lower-sym-ctor-or-err(name, b, pool)

    ; `func-ref-abs` is already the module-scope absolute id
    ; (`num-strings + extern-count + idx`).
let lower-func-as-value(fr: FuncRef, b: Builder, pool: StrPool) -> Result Int Str {
  let code = emit-cast!(b, cast-ptrtoint, func-ref-abs(fr), ty-i64)
  Ok(emit-call!(b, extern-closure-bare-abs(str-pool-count(pool)), [code]))
}

          ; Nullary ctor as an expression *is* the value (Nil, None, …).
let lower-sym-ctor-or-err(name: Str, b: Builder, pool: StrPool) -> Result Int Str =
  match (ctor-tag-of(name, pool))
    | None -> Err(String.concat("cannot lower unbound name ", name))
    | Some(tag) ->
      {
        let ns = str-pool-count(pool)
        let arity = ctor-arity-of(name, pool)
        cond
          | arity == 0 ->
            cond
              | is-builtin-ctor(name) -> Ok(emit-call!(b, ctor-extern-abs(name, ns), []))
              | else ->
                {
                  let tag-c = const-i64!(b, tag)
                  let ar-c = const-i64!(b, 0)
                  Ok(emit-call!(b, extern-new-abs(ns), [tag-c, ar-c]))
                }
          | else ->
            {
              let tag-c = const-i64!(b, tag)
              let ar-c = const-i64!(b, arity)
              Ok(emit-call!(b, extern-ctor-closure-abs(ns), [tag-c, ar-c]))
            }
      }

; A reader span covers a source extent (`end` > `start`). Compiler-built
; calls — the import bootstrap's calls to module inits and to the entry
; `main` — use a zero-width span (`graph.mnd`'s `dummy-span`). That span's
; origin is 0, the first loaded file, so recording it names the wrong file.
let span-located(sp: Span) -> Bool =
  span-end(sp) > span-start(sp)

let emit-trace-push!(b: Builder, pool: StrPool, sp: Span) -> Unit {
  let file-gid = file-gid-of(pool, span-origin(sp))
  let line = const-i64!(b, span-line-clamped(sp))
  emit-call-void!(b, extern-kind-trace-push, extern-trace-push-abs(str-pool-count(pool)), [file-gid, line])
}

let emit-trace-pop!(b: Builder, pool: StrPool) -> Unit =
  emit-call-void!(b, extern-kind-trace-pop, extern-trace-pop-abs(str-pool-count(pool)), [])

; Push the call expression's file and line, call, then pop. A panic inside
; the callee leaves the frame in place. A zero-width span is not a source
; location, so the call is emitted with no frame.
; `args` are the words the call should receive. Callers that still hold root
; indexes reload them first; this wrapper does not, so a value loaded out of
; a shadow slot is not passed to `mn_root_get` a second time.
let emit-traced-call-at!(b: Builder, pool: StrPool, sp: Span, callee: Int, args: List Int) -> Int {
  emit-trace-push!(b, pool, sp)
  let v = emit-call!(b, callee, args)
  emit-trace-pop!(b, pool)
  v
}

let emit-traced-call!(b: Builder, pool: StrPool, sp: Span, callee: Int, args: List Int) -> Int =
  if (span-located(sp)) -> emit-traced-call-at!(b, pool, sp, callee, args) | emit-call!(b, callee, args)

let lower-paren(elems: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (elems)
    | [] -> Ok(const-unit!(b))
    | head :: rest -> lower-paren-head(head, rest, sp, env, b, funcs, noop, pool)

let lower-paren-head(head: Ast, rest: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (sym-str(head))
    | None -> lower-apply-value(head, rest, sp, env, b, funcs, noop, pool)
    | Some(hn) -> lower-named(hn, rest, sp, env, b, funcs, noop, pool)

let lower-apply-value(head: Ast, args: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(fn (clo) = lower-apply-clo(clo, args, sp, env, b, funcs, noop, pool), lower-expr(head, env, b, funcs, noop, pool))

let lower-apply-clo(clo: Int, args: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (args)
    | [] -> Ok(emit-traced-call!(b, pool, sp, extern-apply-0-abs(str-pool-count(pool)), get-words!(b, [clo])))
    | [a0] -> Result.and-then(fn (arg) = Ok(emit-traced-call!(b, pool, sp, extern-apply-1-abs(str-pool-count(pool)), get-words!(b, [clo, arg]))), lower-expr(a0, env, b, funcs, noop, pool))
    | [a0, a1] -> Result.and-then(fn (x) = Result.and-then(fn (y) = Ok(emit-traced-call!(b, pool, sp, extern-apply-2-abs(str-pool-count(pool)), get-words!(b, [clo, x, y]))), lower-expr(a1, env, b, funcs, noop, pool)), lower-expr(a0, env, b, funcs, noop, pool))
    | _ -> Err("closure application supports at most 2 arguments currently")

let lower-named(hn: Str, rest: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  cond
    | hn == "char" -> lower-char-lit(rest, b)
    | hn == "if" -> lower-if(rest, env, b, funcs, noop, pool)
    | hn == "let" -> lower-let-inline(rest, env, b, funcs, noop, pool)
    | hn == "do" -> lower-sequence(rest, env, b, funcs, noop, pool)
    | hn == "loop" -> lower-loop(rest, env, b, funcs, noop, pool)
    | hn == "recur" -> lower-recur(rest, env, b, funcs, noop, pool)
    | hn == "match" -> lower-match(rest, env, b, funcs, noop, pool)
    | hn == "slot" -> lower-slot(rest, env, b, funcs, noop, pool)
    | is-arith-binop(hn) -> lower-arith(rest, hn, sp, env, b, funcs, noop, pool)
    | is-cmp-op(hn) -> lower-cmp-value(rest, hn, env, b, funcs, noop, pool)
    | is-ctor-name(hn, pool) -> lower-ctor(hn, rest, env, b, funcs, noop, pool)
    | else ->
      match (Map.lookup(hn, funcs))
        | Some(_) -> lower-call(hn, rest, sp, env, b, funcs, noop, pool)
        | None ->
          cond
            | is-runtime-op(hn) -> lower-runtime-op(hn, rest, env, b, funcs, noop, pool)
            | is-effect-head(hn) -> Result.and-then(fn (_) = Ok(const-unit!(b)), lower-effect-op(hn, rest, env, b, funcs, noop, pool))
            | is-unsupported-form(hn) -> Err(String.concat("cannot lower `", hn, "` with the real instruction lowerer yet"))
            | else -> lower-call(hn, rest, sp, env, b, funcs, noop, pool)

let lower-char-lit(rest: List Ast, b: Builder) -> Result Int Str =
  match (rest)
    | IntNode(n, _) :: _ -> Ok(const-tagged!(b, n))
    | _ -> Err("char literal requires a code point")

; -- if --

; A record field is the payload slot chosen by the typer.
let lower-slot(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | obj :: idx :: _ -> lower-slot-index(obj, idx, env, b, funcs, noop, pool)
    | _ -> Err("slot requires a value and an index")

; Load payload slot `n` from the lowered receiver.
let lower-slot-index(obj: Ast, idx: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (idx)
    | IntNode(n, _) ->
      Result.and-then(
        fn (val) = Ok(emit-call!(b, extern-slot-abs(str-pool-count(pool)), [val, const-i64!(b, n)])),
        lower-expr(obj, env, b, funcs, noop, pool)
      )
    | _ -> Err("slot index must be an integer")

let lower-if(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | [test, then, els] -> Result.and-then(fn (cond-abs) = lower-if-branches(cond-abs, then, els, env, b, funcs, noop, pool), lower-cond(test, env, b, funcs, noop, pool))
    | _ -> Err("if requires a test, a then-branch and an else-branch")

    ; `result-slot` is allocated into the block still open when the
    ; `if` is encountered — the one block guaranteed to dominate
    ; `then`, `else` and `join` alike, however many blocks each of
    ; those turns out to need internally (see `Builder`'s header
    ; comment).
let lower-if-branches(cond-abs: Int, then: Ast, els: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let result-slot = emit-alloca!(b)
  let then-bb = fresh-bb!(b)
  let else-bb = fresh-bb!(b)
  let join-bb = fresh-bb!(b)
  emit-condbr!(b, then-bb, else-bb, cond-abs)
  switch-to!(b, then-bb)
  Result.and-then(fn (then-val) = lower-if-then-done(then-val, els, result-slot, else-bb, join-bb, env, b, funcs, noop, pool), lower-expr(then, env, b, funcs, noop, pool))
}

    ; `maybe-store-and-br!`: if `then` ended in `recur` (block already
    ; terminated), skip the store+br — a second terminator would be
    ; illegal. Still switch into `else` either way.
let lower-if-then-done(then-val: Int, els: Ast, result-slot: Int, else-bb: BB, join-bb: BB, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  maybe-store-and-br!(b, result-slot, then-val, join-bb)
  switch-to!(b, else-bb)
  Result.and-then(fn (else-val) = lower-if-else-done(else-val, result-slot, join-bb, b), lower-expr(els, env, b, funcs, noop, pool))
}

let lower-if-else-done(else-val: Int, result-slot: Int, join-bb: BB, b: Builder) -> Result Int Str {
  maybe-store-and-br!(b, result-slot, else-val, join-bb)
  switch-to!(b, join-bb)
  Ok(get!(b, emit-load!(b, result-slot)))
}

; -- loop / recur (slice 3A) --
;
; `(loop ((name init)…) body)`: allocas for each binding + a result
; slot in the dominating block; store inits; br header; in header,
; lower body with names bound to those slots; a normal body value
; stores into the result slot and br's exit; `recur` stores new values
; and br's header. Nested loops push/pop `LoopFrame` on the Builder.

let binding-pair-of(ast: Ast) -> Maybe (List Ast) =
  match (ast)
    | ParenNode([name-ast, init-ast], _) -> Some([name-ast, init-ast])
    | BracketNode([name-ast, init-ast], _) -> Some([name-ast, init-ast])
    | _ -> None()

let binding-list-elems(ast: Ast) -> Maybe (List Ast) =
  match (ast)
    | ParenNode(elems, _) -> Some(elems)
    | BracketNode(elems, _) -> Some(elems)
    | _ -> None()

let lower-loop(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | [bindings-ast, body] ->
      match (binding-list-elems(bindings-ast))
        | None -> Err("loop bindings must be a list of (name init) pairs")
        | Some(pairs) -> lower-loop-with-pairs(pairs, body, env, b, funcs, noop, pool)
    | _ -> Err("loop requires bindings and a body")

let list-reverse-str(xs: List Str) -> List Str =
  list-reverse-str-onto(xs, [])

let list-reverse-str-onto(xs: List Str, acc: List Str) -> List Str =
  match (xs)
    | [] -> acc
    | x :: rest -> list-reverse-str-onto(rest, x :: acc)

let list-reverse-int(xs: List Int) -> List Int =
  list-reverse-int-onto(xs, [])

let list-reverse-int-onto(xs: List Int, acc: List Int) -> List Int =
  match (xs)
    | [] -> acc
    | x :: rest -> list-reverse-int-onto(rest, x :: acc)

let lower-loop-with-pairs(pairs: List Ast, body: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let result-slot = emit-alloca!(b)
  lower-loop-bind-all(pairs, body, result-slot, env, b, funcs, noop, pool, [], [], env)
}

let lower-loop-bind-all(pairs: List Ast, body: Ast, result-slot: Int, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool, names-acc: List Str, slots-acc: List Int, env-acc: Map Str Int) -> Result Int Str =
  match (pairs)
    | [] -> lower-loop-run(body, result-slot, list-reverse-str(names-acc), list-reverse-int(slots-acc), env-acc, b, funcs, noop, pool)
    | pair :: rest ->
      match (binding-pair-of(pair))
        | None -> Err("each loop binding must be (name init)")
        | Some([name-ast, init-ast]) ->
          match (sym-str(name-ast))
            | None -> Err("loop binding name must be a symbol")
            | Some(name) ->
              Result.and-then(
                fn (v) {
                  let slot = root-alloca!(b)
                  emit-store!(b, slot, get!(b, v))
                  lower-loop-bind-all(rest, body, result-slot, env, b, funcs, noop, pool, name :: names-acc, slot :: slots-acc, Map.set(name, slot, env-acc))
                },
                lower-expr(init-ast, env, b, funcs, noop, pool)
              )
        | _ -> Err("each loop binding must be (name init)")

    ; Save once, in the block that dominates the header, so `recur` can
    ; pop body roots without popping the loop slots rooted above.
let lower-loop-run(body: Ast, result-slot: Int, names: List Str, slots: List Int, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let header = fresh-bb!(b)
  let exit-bb = fresh-bb!(b)
  let mark =
    if (is-rooting(b)) -> emit-root-save!(b) | 0
  emit-br!(b, header)
  switch-to!(b, header)
  push-loop-frame!(b, LoopFrame(header, exit-bb, result-slot, slots, names, mark))
  Result.and-then(
    fn (body-val) {
      maybe-store-and-br!(b, result-slot, body-val, exit-bb)
      pop-loop-frame!(b)
      switch-to!(b, exit-bb)
      Ok(get!(b, emit-load!(b, result-slot)))
    },
    lower-expr(body, env, b, funcs, noop, pool)
  )
}

let lower-recur(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (current-loop-frame(b))
    | None -> Err("recur outside loop")
    | Some(lf) -> lower-recur-eval-all(rest, [], loop-frame-slots(lf), loop-frame-header(lf), env, b, funcs, noop, pool)

; Evaluate every `recur` argument *before* any store — parallel assignment
; (spec: all new bindings computed from the previous iteration's values).
; Storing as we go would make `(recur (+ i 1) (+ acc i))` see the updated
; `i` in the second argument.
let lower-recur-eval-all(args: List Ast, vals-acc: List Int, slots: List Int, header: BB, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (args)
    | [] -> lower-recur-store-all(list-reverse-int(vals-acc), slots, header, b)
    | a :: rest -> Result.and-then(fn (v) = lower-recur-eval-all(rest, v :: vals-acc, slots, header, env, b, funcs, noop, pool), lower-expr(a, env, b, funcs, noop, pool))

let lower-recur-store-all(vals: List Int, slots: List Int, header: BB, b: Builder) -> Result Int Str =
  match (vals)
    | [] ->
      match (slots)
        | [] ->
          {
            match (current-loop-frame(b))
              | Some(lf) -> emit-root-restore!(b, loop-frame-root-mark(lf))
              | None -> ()
            emit-br!(b, header)
            Ok(const-tagged!(b, 0))
          }
        | _ -> Err("recur argument count does not match loop bindings")
    | v :: rest-vals ->
      match (slots)
        | [] -> Err("recur argument count does not match loop bindings")
        | slot :: rest-slots ->
          {
            emit-store!(b, slot, get!(b, v))
            lower-recur-store-all(rest-vals, rest-slots, header, b)
          }

; -- builtin + user constructors + match (slice 3C / H) --

; User-ctor tags start here so they never collide with runtime tags
; (List/Maybe/Result 0–5, Str/Ref/SB 10–12, Map/IoError 20–27, closure 100+).
let user-ctor-tag-base = 1000

let decl-name-of(name-part: Ast) -> Maybe Str =
  match (name-part)
    | SymNode(n, _) -> Some(n)
    | ParenNode(n-ast :: _, _) -> sym-str(n-ast)
    | _ -> None()

let register-ctor-spec(acc: Map Str CtorSpec, name: Str, arity: Int, tag-ref: Ref Int) -> Map Str CtorSpec {
  let tag = deref(tag-ref)
  set!(tag-ref, tag + 1)
  Map.set(name, CtorSpec(tag, arity), acc)
}

let register-one-variant-ctor(c: Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (c)
    | ParenNode(cname-ast :: payload-asts, _) ->
      match (sym-str(cname-ast))
        | None -> acc
        | Some(cname) -> register-variant-ctor-name(cname, payload-asts, acc, tag-ref)
    | _ -> acc

; IoError and SpawnStatus already have runtime tags (20–27, 30–31).
; Collecting them again would mint a user tag at 1000 and disagree with
; the objects the C functions return.
let register-variant-ctor-name(cname: Str, payload-asts: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (builtin-ctor-tag-of(cname))
    | Some(_) -> acc
    | None -> register-ctor-spec(acc, cname, length(payload-asts), tag-ref)

let register-variant-ctors(ctors: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (ctors)
    | [] -> acc
    | c :: rest -> register-variant-ctors(rest, register-one-variant-ctor(c, acc, tag-ref), tag-ref)

let collect-variant-decl(rest: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (rest)
    | _name-part :: ctors -> register-variant-ctors(ctors, acc, tag-ref)
    | [] -> acc

let collect-defrec-decl(rest: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (rest)
    | name-part :: fields ->
      match (decl-name-of(name-part))
        | None -> acc
        | Some(name) ->
          match (builtin-ctor-tag-of(name))
            | Some(_) -> acc
            | None -> register-ctor-spec(acc, name, length(fields), tag-ref)
    | [] -> acc

let collect-ctors-named(hn: Str, rest: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  cond
    | hn == "variant" -> collect-variant-decl(rest, acc, tag-ref)
    | hn == "defrec" -> collect-defrec-decl(rest, acc, tag-ref)
    | else -> acc

let collect-ctors-form(ast: Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (unwrap-pub(ast))
    | ParenNode(head :: rest, _) ->
      match (sym-str(head))
        | None -> acc
        | Some(hn) -> collect-ctors-named(hn, rest, acc, tag-ref)
    | _ -> acc

let collect-ctors-forms(forms: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int) -> Map Str CtorSpec =
  match (forms)
    | [] -> acc
    | f :: rest -> collect-ctors-forms(rest, collect-ctors-form(f, acc, tag-ref), tag-ref)

let collect-user-ctors(forms: List Ast) -> Map Str CtorSpec {
  let tag-ref = ref(user-ctor-tag-base)
  collect-ctors-forms(forms, Map.empty(), tag-ref)
}

let is-builtin-ctor(hn: Str) -> Bool =
  hn == "Nil" || hn == "Cons" || hn == "None" || hn == "Some" || hn == "Ok" || hn == "Err"

let is-user-ctor(hn: Str, pool: StrPool) -> Bool =
  match (Map.lookup(hn, str-pool-ctors(pool)))
    | Some(_) -> true
    | None -> false

let has-builtin-tag(hn: Str) -> Bool =
  match (builtin-ctor-tag-of(hn))
    | Some(_) -> true
    | None -> false

let is-ctor-name(hn: Str, pool: StrPool) -> Bool =
  has-builtin-tag(hn) || is-user-ctor(hn, pool)

    ; IoError ctors — constructed by the runtime, matched in user code.
let builtin-ctor-tag-of(hn: Str) -> Maybe Int =
  cond
    | hn == "Nil" -> Some(tag-nil)
    | hn == "Cons" -> Some(tag-cons)
    | hn == "None" -> Some(tag-none)
    | hn == "Some" -> Some(tag-some)
    | hn == "Ok" -> Some(tag-ok)
    | hn == "Err" -> Some(tag-err)
    | hn == "NotFound" -> Some(20)
    | hn == "Permission" -> Some(21)
    | hn == "Exists" -> Some(22)
    | hn == "IsADirectory" -> Some(23)
    | hn == "NotADirectory" -> Some(24)
    | hn == "InvalidPath" -> Some(25)
    | hn == "TooLarge" -> Some(26)
    | hn == "Other" -> Some(27)
    | hn == "Exited" -> Some(30)
    | hn == "Signalled" -> Some(31)
    | hn == "SpawnOutput" -> Some(32)
    | hn == "NotExecutable" -> Some(33)
    | hn == "InvalidArgument" -> Some(34)
    | hn == "TooManyArguments" -> Some(35)
    | hn == "Unsupported" -> Some(36)
    | else -> None()

let ctor-tag-of(hn: Str, pool: StrPool) -> Maybe Int =
  match (builtin-ctor-tag-of(hn))
    | Some(t) -> Some(t)
    | None ->
      match (Map.lookup(hn, str-pool-ctors(pool)))
        | Some(spec) -> Some(ctor-spec-tag(spec))
        | None -> None()

let seam-fixed-arity(hn: Str) -> Maybe Int =
  cond
    | hn == "SpawnOutput" -> Some(3)
    | hn == "Other" || hn == "Exited" || hn == "Signalled" -> Some(1)
    | hn == "NotFound" || hn == "Permission" || hn == "Exists" || hn == "IsADirectory" || hn == "NotADirectory" || hn == "InvalidPath" || hn == "TooLarge" || hn == "NotExecutable" || hn == "InvalidArgument" || hn == "TooManyArguments" || hn == "Unsupported" -> Some(0)
    | else -> None()

let ctor-arity-of(hn: Str, pool: StrPool) -> Int =
  match (seam-fixed-arity(hn))
    | Some(n) -> n
    | None ->
      cond
        | hn == "Nil" || hn == "None" -> 0
        | hn == "Cons" -> 2
        | hn == "Some" || hn == "Ok" || hn == "Err" -> 1
        | else ->
          match (Map.lookup(hn, str-pool-ctors(pool)))
            | Some(spec) -> ctor-spec-arity(spec)
            | None -> -1

let ctor-extern-abs(hn: Str, ns: Int) -> Int =
  cond
    | hn == "Nil" -> extern-nil-abs(ns)
    | hn == "Cons" -> extern-cons-abs(ns)
    | hn == "None" -> extern-none-abs(ns)
    | hn == "Some" -> extern-some-abs(ns)
    | hn == "Ok" -> extern-ok-abs(ns)
    | else -> extern-err-abs(ns)

let lower-user-ctor-fill(obj: Int, avs: List Int, i: Int, b: Builder, pool: StrPool) -> Int =
  match (avs)
    | [] -> obj
    | v :: rest ->
      {
        let idx = const-i64!(b, i)
        let obj2 = emit-call!(b, extern-set-slot-abs(str-pool-count(pool)), [obj, idx, get!(b, v)])
        lower-user-ctor-fill(obj2, rest, i + 1, b, pool)
      }

let lower-user-ctor(hn: Str, args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (Map.lookup(hn, str-pool-ctors(pool)))
    | None -> Err(String.concat("unknown constructor ", hn))
    | Some(spec) ->
      if (length(args) == ctor-spec-arity(spec)) ->
        Result.and-then(
          fn (avs) {
            let tag-c = const-i64!(b, ctor-spec-tag(spec))
            let nslots = const-i64!(b, ctor-spec-arity(spec))
            let obj = emit-call!(b, extern-new-abs(str-pool-count(pool)), [tag-c, nslots])
            Ok(lower-user-ctor-fill(obj, avs, 0, b, pool))
          },
          lower-args(args, env, b, funcs, noop, pool)
        ) | Err(String.concat("arity mismatch constructing ", hn))

let lower-fixed-tag-ctor(hn: Str, args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (builtin-ctor-tag-of(hn))
    | None -> Err(String.concat("unknown constructor ", hn))
    | Some(tag) ->
      if (length(args) == ctor-arity-of(hn, pool)) ->
        Result.and-then(
          fn (avs) {
            let tag-c = const-i64!(b, tag)
            let nslots = const-i64!(b, ctor-arity-of(hn, pool))
            let obj = emit-call!(b, extern-new-abs(str-pool-count(pool)), [tag-c, nslots])
            Ok(lower-user-ctor-fill(obj, avs, 0, b, pool))
          },
          lower-args(args, env, b, funcs, noop, pool)
        ) | Err(String.concat("arity mismatch constructing ", hn))

let lower-ctor(hn: Str, args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  cond
    | is-builtin-ctor(hn) ->
      if (length(args) == ctor-arity-of(hn, pool)) -> Result.and-then(fn (avs) = Ok(emit-call-words!(b, ctor-extern-abs(hn, str-pool-count(pool)), avs)), lower-args(args, env, b, funcs, noop, pool)) | Err(String.concat("arity mismatch constructing ", hn))
    | has-builtin-tag(hn) -> lower-fixed-tag-ctor(hn, args, env, b, funcs, noop, pool)
    | else -> lower-user-ctor(hn, args, env, b, funcs, noop, pool)

let is-runtime-op(hn: Str) -> Bool =
  hn == "write" || hn == "mn_write" || str-in-list(hn, runtime-op-names())

let runtime-op-names() -> List Str =
  ["str-concat", "str-byte-length", "str-byte", "str-slice", "char->str", "ref", "deref", "set!", "sb-new", "sb-append!", "sb-append-byte!", "sb-take-str!", "sb-clear!", "map-new", "map-set", "map-get", "map-has", "map-size", "map-keys", "mn-env-0", "mn-env-1", "mn-env-get", "mn-closure-new", "mn-apply-0", "mn-apply-1", "mn-apply-2", "arg-count", "arg", "read-file", "write-file", "show", "mn-env-new", "mn-env-set", "compare", "sb-length", "sb-to-str", "dump", "spawn", "spawn-capture", "getenv", "exists", "rename", "isatty", "mtime", "cwd", "ensure-dir", "list-dir", "realpath", "now-ms", "remove", "is-dir", "mn_isatty", "mn_mtime", "mn_cwd", "mn_ensure_dir", "mn_list_dir", "mn_realpath", "mn_now_ms", "mn_remove", "mn_is_dir", "mn_arg_count", "mn_arg", "mn_read_file", "mn_write_file", "mn_spawn", "mn_spawn_capture", "mn_getenv", "mn_exists", "mn_rename", "f+", "f-", "f*", "f/"]

; `extern` declares the C symbol (`mn_exists`). Ambient compiler calls
; still use the Menard name (`exists`). Both lower to the same abs id.
let seam-menard-name(hn: Str) -> Str =
  cond
    | hn == "mn_write" -> "write"
    | hn == "mn_arg_count" -> "arg-count"
    | hn == "mn_arg" -> "arg"
    | hn == "mn_read_file" -> "read-file"
    | hn == "mn_write_file" -> "write-file"
    | hn == "mn_spawn" -> "spawn"
    | hn == "mn_spawn_capture" -> "spawn-capture"
    | hn == "mn_getenv" -> "getenv"
    | hn == "mn_exists" -> "exists"
    | hn == "mn_rename" -> "rename"
    | else -> os-menard-name(hn)

let os-menard-name(hn: Str) -> Str =
  cond
    | hn == "mn_isatty" -> "isatty"
    | hn == "mn_mtime" -> "mtime"
    | hn == "mn_cwd" -> "cwd"
    | hn == "mn_ensure_dir" -> "ensure-dir"
    | hn == "mn_list_dir" -> "list-dir"
    | hn == "mn_realpath" -> "realpath"
    | hn == "mn_now_ms" -> "now-ms"
    | hn == "mn_remove" -> "remove"
    | hn == "mn_is_dir" -> "is-dir"
    | else -> hn

let effect-alias(hn: Str) -> Str =
  cond
    | hn == "mn_exit" -> "exit"
    | else -> hn

let runtime-op-abs(hn: Str, ns: Int) -> Int =
  runtime-op-abs-named(seam-menard-name(hn), ns)

let os-op-abs(hn: Str, ns: Int) -> Int =
  cond
    | hn == "isatty" -> extern-isatty-abs(ns)
    | hn == "mtime" -> extern-mtime-abs(ns)
    | hn == "cwd" -> extern-cwd-abs(ns)
    | hn == "ensure-dir" -> extern-ensure-dir-abs(ns)
    | hn == "list-dir" -> extern-list-dir-abs(ns)
    | hn == "realpath" -> extern-realpath-abs(ns)
    | hn == "now-ms" -> extern-now-ms-abs(ns)
    | hn == "remove" -> extern-remove-abs(ns)
    | else -> extern-is-dir-abs(ns)

let runtime-op-abs-named(hn: Str, ns: Int) -> Int =
  cond
    | hn == "write" -> extern-write-abs(ns)
    | str-in-list(hn, ["isatty", "mtime", "cwd", "ensure-dir", "list-dir", "realpath", "now-ms", "remove", "is-dir"]) -> os-op-abs(hn, ns)
    | hn == "f+" -> extern-fadd-abs(ns)
    | hn == "f-" -> extern-fsub-abs(ns)
    | hn == "f*" -> extern-fmul-abs(ns)
    | hn == "f/" -> extern-fdiv-abs(ns)
    | hn == "str-concat" -> extern-str-concat-abs(ns)
    | hn == "str-byte-length" -> extern-str-byte-length-abs(ns)
    | hn == "str-byte" -> extern-str-byte-abs(ns)
    | hn == "str-slice" -> extern-str-slice-abs(ns)
    | hn == "char->str" -> extern-char-to-str-abs(ns)
    | hn == "ref" -> extern-ref-new-abs(ns)
    | hn == "deref" -> extern-ref-deref-abs(ns)
    | hn == "set!" -> extern-ref-set-abs(ns)
    | hn == "sb-new" -> extern-sb-new-abs(ns)
    | hn == "sb-append!" -> extern-sb-append-abs(ns)
    | hn == "sb-append-byte!" -> extern-sb-append-byte-abs(ns)
    | hn == "sb-take-str!" -> extern-sb-take-str-abs(ns)
    | hn == "map-new" -> extern-map-new-abs(ns)
    | hn == "map-set" -> extern-map-set-abs(ns)
    | hn == "map-get" -> extern-map-get-abs(ns)
    | hn == "map-has" -> extern-map-has-abs(ns)
    | hn == "map-size" -> extern-map-size-abs(ns)
    | hn == "map-keys" -> extern-map-keys-abs(ns)
    | hn == "mn-env-0" -> extern-env-0-abs(ns)
    | hn == "mn-env-1" -> extern-env-1-abs(ns)
    | hn == "mn-env-get" -> extern-env-get-abs(ns)
    | hn == "mn-closure-new" -> extern-closure-new-abs(ns)
    | hn == "mn-apply-0" -> extern-apply-0-abs(ns)
    | hn == "mn-apply-1" -> extern-apply-1-abs(ns)
    | hn == "mn-apply-2" -> extern-apply-2-abs(ns)
    | hn == "arg-count" -> extern-arg-count-abs(ns)
    | hn == "arg" -> extern-arg-abs(ns)
    | hn == "read-file" -> extern-read-file-abs(ns)
    | hn == "write-file" -> extern-write-file-abs(ns)
    | hn == "show" -> extern-show-abs(ns)
    | hn == "mn-env-new" -> extern-env-new-abs(ns)
    | hn == "mn-env-set" -> extern-env-set-abs(ns)
    | hn == "compare" -> extern-compare-abs(ns)
    | hn == "sb-length" -> extern-sb-length-abs(ns)
    | hn == "sb-to-str" -> extern-sb-to-str-abs(ns)
    | hn == "sb-clear!" -> extern-sb-clear-abs(ns)
    | hn == "dump" -> extern-dump-abs(ns)
    | hn == "spawn" -> extern-spawn-abs(ns)
    | hn == "spawn-capture" -> extern-spawn-capture-abs(ns)
    | hn == "getenv" -> extern-getenv-abs(ns)
    | hn == "exists" -> extern-exists-abs(ns)
    | else -> extern-rename-abs(ns)

let runtime-op-arity(hn: Str) -> Int =
  runtime-op-arity-named(seam-menard-name(hn))

let runtime-op-arity-named(hn: Str) -> Int =
  cond
    | hn == "cwd" || hn == "now-ms" -> 0
    | str-in-list(hn, ["isatty", "mtime", "ensure-dir", "list-dir", "realpath", "remove", "is-dir"]) -> 1
    | hn == "sb-new" || hn == "map-new" || hn == "mn-env-0" || hn == "arg-count" -> 0
    | str-in-list(hn, ["str-byte-length", "char->str", "ref", "deref", "sb-take-str!", "sb-clear!", "map-size", "map-keys", "mn-env-1", "mn-env-new", "arg", "read-file", "mn-apply-0", "show", "sb-length", "sb-to-str", "dump", "spawn", "getenv", "exists"]) -> 1
    | hn == "str-slice" || hn == "map-set" || hn == "mn-apply-2" || hn == "mn-env-set" -> 3
    | else -> 2

let lower-runtime-op(hn: Str, args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  cond
    | hn == "mn-closure-new" -> lower-closure-new(args, env, b, funcs, noop, pool)
    | length(args) == runtime-op-arity(hn) -> Result.and-then(fn (avs) = Ok(emit-call-words!(b, runtime-op-abs(hn, str-pool-count(pool)), avs)), lower-args(args, env, b, funcs, noop, pool))
    | else -> Err(String.concat("arity mismatch calling ", hn))

; `(mn-closure-new __lamN env)` — first arg is a FuncRef symbol; emit
; ptrtoint of that function's module-scope abs id, then call mn_closure_new.
let lower-closure-new(args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (args)
    | [code-ast, env-ast] ->
      match (sym-str(code-ast))
        | None -> Err("mn-closure-new requires a function name as its first argument")
        | Some(lam-name) ->
          match (Map.lookup(lam-name, funcs))
            | None -> Err(String.concat("mn-closure-new: unknown function ", lam-name))
            | Some(fr) ->
              {
                let code-bits = emit-cast!(b, cast-ptrtoint, func-ref-abs(fr), ty-i64)
                Result.and-then(fn (env-val) = Ok(emit-call!(b, extern-closure-new-abs(str-pool-count(pool)), [code-bits, get!(b, env-val)])), lower-expr(env-ast, env, b, funcs, noop, pool))
              }
    | _ -> Err("mn-closure-new requires a function name and an env")

let is-wildcard-pat(pat: Ast) -> Bool =
  match (pat)
    | SymNode(n, _) -> n == "_"
    | _ -> false

let pat-ctor-name(pat: Ast) -> Maybe Str =
  match (pat)
    | ParenNode(head :: _, _) -> sym-str(head)
    | SymNode(n, _) -> Some(n)
    | _ -> None()

let pat-payload-asts(pat: Ast) -> List Ast =
  match (pat)
    | ParenNode(_ :: rest, _) -> rest
    | _ -> []

let is-upper-name(s: Str) -> Bool {
  let b = String.byte(0, s)
  b >= 65 && b <= 90
}

let bind-name!(name: Str, val: Int, env: Map Str Int, b: Builder) -> Map Str Int {
  let slot = root-alloca!(b)
  emit-store!(b, slot, val)
  Map.set(name, slot, env)
}

; Bind `pat` against `val`. Constructor and literal mismatches branch to
; `else-bb` (not yet closed). Names, including nested payload names, are
; added to the returned env. `_` and uppercase nullary ctors bind nothing.
let bind-pat!(pat: Ast, val: Int, else-bb: BB, env: Map Str Int, b: Builder, pool: StrPool) -> Result (Map Str Int) Str =
  match (pat)
    | SymNode(n, _) ->
      cond
        | n == "_" -> Ok(env)
        | is-upper-name(n) -> bind-nullary-pat!(n, val, else-bb, env, b, pool)
        | else -> Ok(bind-name!(n, val, env, b))
    | ParenNode(head :: args, _) ->
      match (sym-str(head))
        | Some(cname) ->
          if (cname == "char") -> bind-char-pat!(args, val, else-bb, env, b) | bind-ctor-pat!(cname, args, val, else-bb, env, b, pool)
        | None -> Err("unsupported match pattern")
    | IntNode(n, _) -> bind-int-pat!(n, val, else-bb, env, b)
    | BoolNode(flag, _) -> bind-bool-pat!(flag, val, else-bb, env, b)
    | StrNode(s, _) -> bind-str-pat!(s, val, else-bb, env, b, pool)
    | _ -> Err("unsupported match pattern")

let bind-nullary-pat!(cname: Str, val: Int, else-bb: BB, env: Map Str Int, b: Builder, pool: StrPool) -> Result (Map Str Int) Str =
  bind-ctor-pat!(cname, [], val, else-bb, env, b, pool)

let bind-ctor-pat!(cname: Str, payloads: List Ast, val: Int, else-bb: BB, env: Map Str Int, b: Builder, pool: StrPool) -> Result (Map Str Int) Str =
  match (ctor-tag-of(cname, pool))
    | None -> Err(String.concat("cannot lower match on constructor ", cname))
    | Some(want-tag) ->
      {
        let tag-abs = emit-call!(b, extern-tag-abs(str-pool-count(pool)), [val])
        let want = const-i64!(b, want-tag)
        let pred = emit-cmp2!(b, icmp-eq, tag-abs, want)
        let ok-bb = fresh-bb!(b)
        emit-condbr!(b, ok-bb, else-bb, pred)
        switch-to!(b, ok-bb)
        bind-payloads!(payloads, val, 0, else-bb, env, b, pool)
      }

let bind-payloads!(payloads: List Ast, val: Int, i: Int, else-bb: BB, env: Map Str Int, b: Builder, pool: StrPool) -> Result (Map Str Int) Str =
  match (payloads)
    | [] -> Ok(env)
    | p :: rest ->
      {
        let idx = const-i64!(b, i)
        let slotv = emit-call!(b, extern-slot-abs(str-pool-count(pool)), [val, idx])
        Result.and-then(fn (env2) = bind-payloads!(rest, val, i + 1, else-bb, env2, b, pool), bind-pat!(p, slotv, else-bb, env, b, pool))
      }

let bind-bool-pat!(flag: Bool, val: Int, else-bb: BB, env: Map Str Int, b: Builder) -> Result (Map Str Int) Str =
  bind-int-pat!(
    if (flag) -> 1 | 0,
    val,
    else-bb,
    env,
    b
  )

let bind-char-pat!(args: List Ast, val: Int, else-bb: BB, env: Map Str Int, b: Builder) -> Result (Map Str Int) Str =
  match (args)
    | IntNode(n, _) :: _ -> bind-int-pat!(n, val, else-bb, env, b)
    | _ -> Err("unsupported match pattern")

let bind-int-pat!(n: Int, val: Int, else-bb: BB, env: Map Str Int, b: Builder) -> Result (Map Str Int) Str {
  let lit = const-tagged!(b, n)
  let pred = emit-cmp2!(b, icmp-eq, val, lit)
  let ok-bb = fresh-bb!(b)
  emit-condbr!(b, ok-bb, else-bb, pred)
  switch-to!(b, ok-bb)
  Ok(env)
}

; `val` is the scrutinee word. Root it before `mn_str_new`: that allocation
; can copy, and a word held only in a register would not be updated.
let bind-str-pat!(s: Str, val: Int, else-bb: BB, env: Map Str Int, b: Builder, pool: StrPool) -> Result (Map Str Int) Str {
  let rooted = keep!(b, val)
  let lit = keep!(b, emit-str-lit!(b, pool, s))
  let eqw = emit-call!(b, extern-equal-abs(str-pool-count(pool)), [get!(b, rooted), get!(b, lit)])
  let f = const-false!(b)
  let pred = emit-cmp2!(b, icmp-ne, eqw, f)
  let ok-bb = fresh-bb!(b)
  emit-condbr!(b, ok-bb, else-bb, pred)
  switch-to!(b, ok-bb)
  Ok(env)
}

let lower-match(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | scrut :: clauses -> Result.and-then(fn (sv) = lower-match-with-scrut(sv, clauses, env, b, funcs, noop, pool), lower-expr(scrut, env, b, funcs, noop, pool))
    | [] -> Err("match requires a scrutinee")

let lower-match-with-scrut(sv: Int, clauses: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let result-slot = emit-alloca!(b)
  let join-bb = fresh-bb!(b)
  lower-match-clauses(sv, clauses, result-slot, join-bb, env, b, funcs, noop, pool)
}

let lower-match-clauses(sv: Int, clauses: List Ast, result-slot: Int, join-bb: BB, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (clauses)
    | [] ->
      {
        emit-store!(b, result-slot, keep!(b, const-tagged!(b, 0)))
        emit-br!(b, join-bb)
        switch-to!(b, join-bb)
        Ok(get!(b, emit-load!(b, result-slot)))
      }
    | pat :: body :: rest-clauses ->
      if (is-wildcard-pat(pat)) -> lower-match-wildcard-body(body, result-slot, join-bb, env, b, funcs, noop, pool) | lower-match-pat-clause(sv, pat, body, rest-clauses, result-slot, join-bb, env, b, funcs, noop, pool)
    | [_] -> Err("match clause missing a body")

let lower-match-wildcard-body(body: Ast, result-slot: Int, join-bb: BB, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(
    fn (v) {
      maybe-store-and-br!(b, result-slot, v, join-bb)
      switch-to!(b, join-bb)
      Ok(get!(b, emit-load!(b, result-slot)))
    },
    lower-expr(body, env, b, funcs, noop, pool)
  )

let lower-match-pat-clause(sv: Int, pat: Ast, body: Ast, rest-clauses: List Ast, result-slot: Int, join-bb: BB, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let else-bb = fresh-bb!(b)
  let val = get!(b, sv)
  Result.and-then(
    fn (env2) =
      Result.and-then(
        fn (v) {
          maybe-store-and-br!(b, result-slot, v, join-bb)
          switch-to!(b, else-bb)
          lower-match-clauses(sv, rest-clauses, result-slot, join-bb, env, b, funcs, noop, pool)
        },
        lower-expr(body, env2, b, funcs, noop, pool)
      ),
    bind-pat!(pat, val, else-bb, env, b, pool)
  )
}

; `if`'s test: a direct comparison (produces `i1` directly) or any
; Bool-valued expression (`icmp ne` against the `false` immediate).
let lower-cond(ast: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (ast)
    | ParenNode([head, a, c], _) -> lower-cond-maybe-cmp(head, a, c, ast, env, b, funcs, noop, pool)
    | _ -> lower-cond-bool-value(ast, env, b, funcs, noop, pool)

let lower-cond-maybe-cmp(head: Ast, a-ast: Ast, c-ast: Ast, whole: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (sym-str(head))
    | Some(hn) ->
      if (is-cmp-op(hn)) -> lower-cond-op(hn, a-ast, c-ast, env, b, funcs, noop, pool) | lower-cond-bool-value(whole, env, b, funcs, noop, pool)
    | None -> lower-cond-bool-value(whole, env, b, funcs, noop, pool)

let lower-cond-op(hn: Str, a-ast: Ast, c-ast: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(fn (av) = Result.and-then(fn (cv) = Ok(lower-cond-cmp!(hn, av, cv, b, pool)), lower-expr(c-ast, env, b, funcs, noop, pool)), lower-expr(a-ast, env, b, funcs, noop, pool))

; `=` is value-directed (`mn_equal`). Ordering ops stay immediate icmp.
let lower-cond-cmp!(hn: Str, av: Int, cv: Int, b: Builder, pool: StrPool) -> Int =
  cond
    | hn == "=" ->
      {
        let eqw = emit-call!(b, extern-equal-abs(str-pool-count(pool)), [get!(b, av), get!(b, cv)])
        let f = const-false!(b)
        emit-cmp2!(b, icmp-ne, eqw, f)
      }
    | else -> emit-cmp2!(b, cmp-pred-for(hn), get!(b, av), get!(b, cv))

let lower-cond-bool-value(ast: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(
    fn (bv) {
      let f = const-false!(b)
      Ok(emit-cmp2!(b, icmp-ne, get!(b, bv), f))
    },
    lower-expr(ast, env, b, funcs, noop, pool)
  )

; Comparison as a Bool *value* (not only as `if`'s test).
let lower-cmp-value(args: List Ast, op: Str, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (args)
    | [a-ast, c-ast] -> Result.and-then(fn (av) = Result.and-then(fn (cv) = Ok(lower-cmp-word!(op, av, cv, b, pool)), lower-expr(c-ast, env, b, funcs, noop, pool)), lower-expr(a-ast, env, b, funcs, noop, pool))
    | _ -> Err(String.concat("comparison `", op, "` expects exactly 2 arguments"))

let lower-cmp-word!(op: Str, av: Int, cv: Int, b: Builder, pool: StrPool) -> Int =
  if (op == "=") -> emit-call!(b, extern-equal-abs(str-pool-count(pool)), [get!(b, av), get!(b, cv)]) | bool-from-i1!(b, emit-cmp2!(b, cmp-pred-for(op), get!(b, av), get!(b, cv)))

let cmp-pred-for(op: Str) -> Int =
  cond
    | op == "<" -> icmp-slt
    | op == ">" -> icmp-sgt
    | op == "<=" -> icmp-sle
    | op == ">=" -> icmp-sge
    | else -> icmp-eq

; -- arithmetic --

let lower-arith(args: List Ast, op: Str, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (args)
    | [a-ast, c-ast] -> Result.and-then(fn (av) = Result.and-then(fn (cv) = Ok(apply-arith!(b, pool, sp, op, av, cv)), lower-expr(c-ast, env, b, funcs, noop, pool)), lower-expr(a-ast, env, b, funcs, noop, pool))
    | _ -> Err(String.concat("operator ", op, " expects exactly 2 arguments"))

let apply-arith!(b: Builder, pool: StrPool, sp: Span, op: Str, av: Int, cv: Int) -> Int {
  let aw = get!(b, av)
  let cw = get!(b, cv)
  let panic-at = extern-panic-at-abs(str-pool-count(pool))
  let file-gid = file-gid-of(pool, span-origin(sp))
  let line = span-line-clamped(sp)
  let msg-gid = str-pool-get(pool, div-zero-msg())
  cond
    | op == "+" -> arith-add!(b, aw, cw)
    | op == "-" -> arith-sub!(b, aw, cw)
    | op == "*" -> arith-mul!(b, aw, cw)
    | op == "/" -> arith-div!(b, panic-at, file-gid, line, msg-gid, aw, cw)
    | else -> arith-rem!(b, panic-at, file-gid, line, msg-gid, aw, cw)
}

; -- let (both the inline-body form `(let n e body…)` and the bare,
; sequence-threading form `(let n e)` — see `lower-sequence` for the
; latter). --

let lower-let-inline(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | name-ast :: expr-ast :: body -> lower-let-inline-named(name-ast, expr-ast, body, env, b, funcs, noop, pool)
    | _ -> Err("let requires a name and an expression")

let lower-let-inline-named(name-ast: Ast, expr-ast: Ast, body: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (sym-str(name-ast))
    | None -> Err("let name must be a symbol")
    | Some(name) -> Result.and-then(fn (v) = lower-let-inline-bind(name, v, body, env, b, funcs, noop, pool), lower-expr(expr-ast, env, b, funcs, noop, pool))

let lower-let-inline-bind(name: Str, v: Int, body: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let w = get!(b, v)
  let slot = root-alloca!(b)
  emit-store!(b, slot, w)
  lower-let-inline-continue(body, Map.set(name, slot, env), b, funcs, noop, pool, w)
}

let lower-let-inline-continue(body: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool, v: Int) -> Result Int Str =
  match (body)
    | [] -> Ok(v)
    | _ -> lower-sequence(body, env, b, funcs, noop, pool)

; -- sequences: a `defn` body (or a `do`'s tail) is a `(List Ast)` of
; sequential forms; a bare `(let n e)` among them extends the env for
; every sibling that follows; a call to a known no-op (`shadow-push`/
; `shadow-pop`) is skipped entirely (see header comment). --

record SimpleLet {
  name: Str
  expr: Ast
}

let as-simple-let(f: Ast) -> Maybe SimpleLet =
  match (f)
    | ParenNode([head, name-ast, expr-ast], _) -> as-simple-let-named(head, name-ast, expr-ast)
    | _ -> None()

let as-simple-let-named(head: Ast, name-ast: Ast, expr-ast: Ast) -> Maybe SimpleLet =
  cond
    | is-sym(head, "let") ->
      match (sym-str(name-ast))
        | Some(n) -> Some(SimpleLet(n, expr-ast))
        | None -> None()
    | else -> None()

let is-unit-noop-call(f: Ast, noop: Map Str Bool) -> Bool =
  match (f)
    | ParenNode([head], _) -> is-unit-noop-call-named(head, noop)
    | _ -> false

let is-unit-noop-call-named(head: Ast, noop: Map Str Bool) -> Bool =
  match (sym-str(head))
    | None -> false
    | Some(name) ->
      match (Map.lookup(name, noop))
        | Some(_) -> true
        | None -> false

; -- `println`/`print`: Unit-producing "effect" steps, usable
; only mid-sequence (never a body's last form — see header comment's
; "Unit results") — see `StrPool`'s doc comment (below `lower-program`)
; for the two-pass string-global scheme these lower against.

let is-effect-head(s: Str) -> Bool =
  s == "println" || s == "print" || s == "print-text" || s == "exit" || s == "mn_exit"

let is-effect-call(f: Ast) -> Bool =
  match (f)
    | ParenNode(head :: _, _) -> is-effect-call-named(head)
    | _ -> false

let is-effect-call-named(head: Ast) -> Bool =
  match (sym-str(head))
    | Some(n) -> is-effect-head(n)
    | None -> false

; Trailing 0 so `mn_panic`'s `strlen` stops at the end of the message.
; The pool stores the bytes as given; a Menard string literal has no NUL.
let div-zero-msg() -> Str {
  let sb = Buf.new()
  Buf.append!(sb, "division by zero")
  Buf.append-byte!(sb, 0)
  Buf.take-str!(sb)
}

let lower-effect(f: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  match (f)
    | ParenNode(head :: rest, _) -> lower-effect-named(head, rest, env, b, funcs, noop, pool)
    | _ -> Err("not an effect call")

let lower-effect-named(head: Ast, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  match (sym-str(head))
    | None -> Err("not an effect call")
    | Some(hn) -> lower-effect-op(hn, rest, env, b, funcs, noop, pool)

let lower-effect-op(hn: Str, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  lower-effect-known(effect-alias(hn), rest, env, b, funcs, noop, pool)

let lower-effect-known(hn: Str, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  cond
    | hn == "println" -> lower-println(rest, env, b, funcs, noop, pool)
    | hn == "print" -> lower-print(rest, env, b, funcs, noop, pool)
    | hn == "print-text" ->
      match (rest)
        | [value] -> lower-print-text(value, env, b, funcs, noop, pool)
        | _ -> Err("print-text requires exactly one Str argument")
    | hn == "exit" -> lower-exit(rest, env, b, funcs, noop, pool)
    | else -> Err(String.concat("unknown effect ", hn))

; `(exit code)` — noreturn via `mn_exit` (tagged Int in, untagged inside).
let lower-exit(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  match (rest)
    | [code-ast] -> Result.and-then(fn (v) = Ok(emit-call-void!(b, extern-kind-print, extern-exit-abs(str-pool-count(pool)), [get!(b, v)])), lower-expr(code-ast, env, b, funcs, noop, pool))
    | _ -> Err("exit requires exactly one Int argument")

; Typechecking expands user print calls into print-text calls, formatting
; non-Str arguments using their inferred types. Literal-only generated calls
; can still use the original print/println path.
let lower-print-text(a: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  match (a)
    | StrNode(s, _) -> Ok(emit-write-str-to!(b, pool, s, str-pool-write-stdout-abs(pool)))
    | _ ->
      Result.and-then(fn (v) = Ok(emit-call-void!(b, extern-kind-print, extern-print-str-abs(str-pool-count(pool)), [get!(b, v)])), lower-expr(a, env, b, funcs, noop, pool))

let lower-print-args(args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  match (args)
    | [] -> Ok(())
    | a :: rest -> Result.and-then(fn (_) = lower-print-args(rest, env, b, funcs, noop, pool), lower-print-arg(a, env, b, funcs, noop, pool))

let lower-print-arg(a: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  match (a)
    | StrNode(s, _) -> Ok(emit-write-str-to!(b, pool, s, str-pool-write-stdout-abs(pool)))
    | _ -> lower-print-int-arg(a, env, b, funcs, noop, pool)

let lower-print-int-arg(a: Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  Result.and-then(fn (v) = Ok(emit-print-i64!(b, pool, v)), lower-expr(a, env, b, funcs, noop, pool))

let lower-print(args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  lower-print-args(args, env, b, funcs, noop, pool)

let lower-println(args: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Unit Str =
  Result.and-then(fn (_) = Ok(emit-write-str-to!(b, pool, "\n", str-pool-write-stdout-abs(pool))), lower-print-args(args, env, b, funcs, noop, pool))

let lower-sequence(forms: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (forms)
    | [] -> Err("an empty body cannot be lowered to an Int")
    | f :: rest -> lower-sequence-step(f, rest, env, b, funcs, noop, pool)

let lower-sequence-step(f: Ast, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  cond
    | is-unit-noop-call(f, noop) -> lower-sequence-after-skip(rest, env, b, funcs, noop, pool)
    | is-effect-call(f) -> lower-sequence-effect(f, rest, env, b, funcs, noop, pool)
    | else -> lower-sequence-step-real(f, rest, env, b, funcs, noop, pool)

let lower-sequence-after-skip(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | [] -> Err("a no-op call cannot be the last form of a body")
    | _ -> lower-sequence(rest, env, b, funcs, noop, pool)

; `println`/`print`/`write` produce `Unit`, never an `Int` — exactly the
; same "cannot be the body's last form" restriction a no-op skip already
; has (see header comment's "Unit results"); lowering the effect itself
; (real `mn_write_stdout`/`mn_print_i64` calls) happens here, then
; `rest` continues exactly like a skipped no-op would.
let lower-sequence-effect(f: Ast, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(fn (_) = lower-sequence-after-effect(rest, env, b, funcs, noop, pool), lower-effect(f, env, b, funcs, noop, pool))

let lower-sequence-after-effect(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (rest)
    | [] -> Ok(const-unit!(b))
    | _ -> lower-sequence(rest, env, b, funcs, noop, pool)

let lower-sequence-step-real(f: Ast, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (as-simple-let(f))
    | Some(sl) -> lower-sequence-let(sl, rest, env, b, funcs, noop, pool)
    | None -> lower-sequence-plain(f, rest, env, b, funcs, noop, pool)

        ; A nested let of the same name inside the initializer is a local,
        ; not a second store of the module slot.
let lower-sequence-let(sl: SimpleLet, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (sl)
    | SimpleLet(name, expr) ->
      {
        let was = deref(b-slot-arm(b))
        set!(b-slot-arm(b), false)
        Result.and-then(
          fn (v) {
            set!(b-slot-arm(b), was)
            lower-sequence-let-bind(name, v, rest, env, b, funcs, noop, pool)
          },
          lower-expr(expr, env, b, funcs, noop, pool)
        )
      }

let slot-store(b: Builder, name: Str, env: Map Str Int) -> Bool =
  cond
    | deref(b-slot-arm(b)) ->
      cond
        | str-in-list(name, deref(b-slots(b))) ->
          match (Map.lookup(name, env))
            | None -> true
            | Some(_) -> false
        | else -> false
    | else -> false

let lower-sequence-let-bind(name: Str, v: Int, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str {
  let w = get!(b, v)
  if (slot-store(b, name, env)) -> emit-slot-set!(b, pool, name, w)
  let slot = root-alloca!(b)
  emit-store!(b, slot, w)
  lower-sequence-rest(rest, Map.set(name, slot, env), b, funcs, noop, pool, w)
}

let lower-sequence-rest(rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool, fallback: Int) -> Result Int Str =
  match (rest)
    | [] -> Ok(fallback)
    | _ -> lower-sequence(rest, env, b, funcs, noop, pool)

let lower-sequence-plain(f: Ast, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  Result.and-then(fn (v) = lower-sequence-rest(rest, env, b, funcs, noop, pool, get!(b, v)), lower-expr(f, env, b, funcs, noop, pool))

; -- calls to other top-level `Int`-only `defn`s --

let lower-args(arg-asts: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result (List Int) Str =
  match (arg-asts)
    | [] -> Ok([])
    | a :: rest -> Result.and-then(fn (v) = lower-args-cons(v, rest, env, b, funcs, noop, pool), lower-expr(a, env, b, funcs, noop, pool))

let lower-args-cons(v: Int, rest: List Ast, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result (List Int) Str =
  Result.and-then(fn (vs) = Ok(v :: vs), lower-args(rest, env, b, funcs, noop, pool))

let lower-call(name: Str, arg-asts: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (Map.lookup(name, funcs))
    | Some(fr) -> lower-call-with-ref(fr, name, arg-asts, sp, env, b, funcs, noop, pool)
    | None -> lower-call-local-or-err(name, arg-asts, sp, env, b, funcs, noop, pool)

; A local holding a heap closure: `(f arg)` → `mn_apply_1`.
let lower-call-local-or-err(name: Str, arg-asts: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (Map.lookup(name, env))
    | None -> Err(String.concat("cannot lower a call to ", name))
    | Some(slot) -> lower-apply-local(slot, name, arg-asts, sp, env, b, funcs, noop, pool)

let lower-apply-local(slot: Int, name: Str, arg-asts: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  match (arg-asts)
    | [] ->
      {
        let clo = emit-load!(b, slot)
        Ok(emit-traced-call!(b, pool, sp, extern-apply-0-abs(str-pool-count(pool)), [clo]))
      }
    | [a0] ->
      Result.and-then(
        fn (arg) {
          let clo = emit-load!(b, slot)
          Ok(emit-traced-call!(b, pool, sp, extern-apply-1-abs(str-pool-count(pool)), [clo, get!(b, arg)]))
        },
        lower-expr(a0, env, b, funcs, noop, pool)
      )
    | [a0, a1] ->
      Result.and-then(
        fn (arg0) =
          Result.and-then(
            fn (arg1) {
              let clo = emit-load!(b, slot)
              Ok(emit-traced-call!(b, pool, sp, extern-apply-2-abs(str-pool-count(pool)), [clo, get!(b, arg0), get!(b, arg1)]))
            },
            lower-expr(a1, env, b, funcs, noop, pool)
          ),
        lower-expr(a0, env, b, funcs, noop, pool)
      )
    | _ -> Err(String.concat("closure application supports 0–2 arguments (calling local `", name, "`)"))

let lower-call-with-ref(fr: FuncRef, name: Str, arg-asts: List Ast, sp: Span, env: Map Str Int, b: Builder, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool) -> Result Int Str =
  if (length(arg-asts) == func-ref-arity(fr)) -> Result.and-then(fn (args) = Ok(emit-traced-call!(b, pool, sp, func-ref-abs(fr), get-words!(b, args))), lower-args(arg-asts, env, b, funcs, noop, pool)) | Err(String.concat("arity mismatch calling ", name))

; ---------------------------------------------------------------------------
; One function: bind params (each its own alloca, uniformly with `let`s
; — see header comment), lower the body, then either `ret` the tagged
; `i64` result directly, or — `main` only — untag+trunc to `i32` first.

let bind-params!(b: Builder, names: List Str, start: Int, i: Int) -> Map Str Int =
  match (names)
    | [] -> Map.empty()
    | n :: rest -> bind-params-cons!(b, n, rest, start, i)

let bind-params-cons!(b: Builder, n: Str, rest: List Str, start: Int, i: Int) -> Map Str Int {
  let param-abs = start + i
  let slot = root-alloca!(b)
  emit-store!(b, slot, param-abs)
  Map.set(n, slot, bind-params!(b, rest, start, i + 1))
}

let finish-return!(b: Builder, is-main: Bool, result-abs: Int) -> Unit {
  emit-root-restore!(b, deref(b-root-base(b)))
  if (is-main) -> finish-main-return!(b, result-abs) | emit-ret!(b, result-abs)
}

; spec: `main` computes a tagged `i64` `Int` like any other function,
; then `lshr 1` (untag) + `trunc i32` + `ret i32` — see header comment.
let finish-main-return!(b: Builder, result-abs: Int) -> Unit {
  let one = const-i64!(b, 1)
  let untagged = emit-binop!(b, binop-lshr, result-abs, one)
  let i32v = emit-cast!(b, cast-trunc, untagged, ty-i32)
  emit-ret!(b, i32v)
}

    ; Native `@main` is `(i32 argc, ptr argv) -> i32` — two LLVM params that
    ; are not Menard words; Menard `main` itself still takes zero args.
let lower-one-func(ld: LDefn, num-globals: Int, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool, mc: Map Str Bool, slots: List Str) -> Result LFunc Str {
  let is-main = ldefn-name(ld) == "main"
  let llvm-nparams =
    if (is-main) -> 2 | param-arity-of(ldefn-params(ld))
  let b = builder-new(num-globals + llvm-nparams)
  let flag =
    match (Map.lookup(ldefn-name(ld), mc))
      | Some(f) -> f
      | None -> true
  set!(b-rooting(b), flag)
  set!(b-root-ns(b), str-pool-count(pool))
  set!(b-slots(b), slots)
  if (is-main || is-module-init-name(ldefn-name(ld))) -> set!(b-slot-arm(b), true)
  if (flag) -> set!(b-root-base(b), emit-root-save!(b))
  let env0 = bind-params!(b, lparam-names(ldefn-params(ld)), num-globals, 0)
  emit-main-init-if-needed!(b, is-main, num-globals, pool)
  match (lower-sequence(ldefn-body(ld), env0, b, funcs, noop, pool))
    | Ok(result-abs) -> lower-one-func-finish(ld, is-main, result-abs, b)
    | Err(msg) -> Err(String.concat(ldefn-name(ld), ": ", msg))
}

; Call `mn_init(argc, argv)` at the start of `main` so `arg` / `arg-count`
; see the process argv. Param abs ids are `num-globals` and `num-globals+1`.
let emit-main-init-if-needed!(b: Builder, is-main: Bool, num-globals: Int, pool: StrPool) -> Unit =
  if (is-main) -> emit-call-void!(b, extern-kind-init, extern-init-abs(str-pool-count(pool)), [num-globals, num-globals + 1])

; libc already defines `write`, `stdin`, `stdout`, and `stderr`. Menard
; functions keep their source names for calls; the link symbol is prefixed
; so a published `(defn write ...)` does not replace the syscall.
; `main` is the bootstrap C entry. `mn_<hash>_…` is already the link symbol
; of a module `main` or init (see `modules/graph.mnd`).
let is-mn-symbol(name: Str) -> Bool =
  String.length(name) >= 3 && String.slice(0, 3, name) == "mn_"

; `with-module-init` names the generated function `mn_<hash>_init`. A user
; function named `init` is renamed to `__mN_init` and does not match.
let is-module-init-name(name: Str) -> Bool {
  let n = String.length(name)
  is-mn-symbol(name) && n >= 8 && String.slice(n - 5, 5, name) == "_init"
}

let link-symbol(name: Str) -> Str =
  if (name == "main" || is-mn-symbol(name)) -> name | String.concat("menard.", name)

let lower-one-func-finish(ld: LDefn, is-main: Bool, result-abs: Int, b: Builder) -> Result LFunc Str {
  finish-return!(b, is-main, result-abs)
  finish-builder!(b)
  Ok(LFunc(link-symbol(ldefn-name(ld)), param-arity-of(ldefn-params(ld)), is-main, total-blocks(b), builder-items-ordered(b)))
}

let lower-all-funcs(lds: List LDefn, num-globals: Int, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool, mc: Map Str Bool, slots: List Str) -> Result (List LFunc) Str =
  match (lds)
    | [] -> Ok([])
    | ld :: rest -> Result.and-then(fn (lf) = lower-all-funcs-cons(lf, rest, num-globals, funcs, noop, pool, mc, slots), lower-one-func(ld, num-globals, funcs, noop, pool, mc, slots))

let lower-all-funcs-cons(lf: LFunc, rest: List LDefn, num-globals: Int, funcs: Map Str FuncRef, noop: Map Str Bool, pool: StrPool, mc: Map Str Bool, slots: List Str) -> Result (List LFunc) Str =
  Result.and-then(fn (lfs) = Ok(lf :: lfs), lower-all-funcs(rest, num-globals, funcs, noop, pool, mc, slots))

; ---------------------------------------------------------------------------
; Top-level, non-`defn` forms — `hello.mnd`'s standalone `(println
; "Hello, world!")` and `123`, run for effect before `main`'s own body
; (see header comment's "Lowering", point 1). Only *bare expression*
; forms are collected this way — a top-level `defrec`/`variant`/`alias`
; (or a `pub`-wrapped one) is a type declaration, not something with a
; value to compute, and is left exactly as un-lowered as it always was
; (this module has never lowered those, and does not start now); only
; skipping them here, rather than trying to lower them as if they were
; expressions, keeps that behavior unchanged for any program that has
; one.
let is-declaration-head(s: Str) -> Bool =
  s == "defn" || s == "defrec" || s == "variant" || s == "alias" || s == "extern" || s == "runtime" || s == "import"

let is-declaration-form(ast: Ast) -> Bool =
  match (unwrap-pub(ast))
    | ParenNode(head :: _, _) -> is-declaration-form-named(head)
    | _ -> false

let is-declaration-form-named(head: Ast) -> Bool =
  match (sym-str(head))
    | Some(n) -> is-declaration-head(n)
    | None -> false

let collect-non-defn-tops(forms: List Ast) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> collect-non-defn-tops-cons(f, rest)

let collect-non-defn-tops-cons(f: Ast, rest: List Ast) -> List Ast =
  if (is-declaration-form(f)) -> collect-non-defn-tops(rest) | f :: collect-non-defn-tops(rest)

let append-asts(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-asts(rest, ys)

; Splices `extra` onto the *front* of `main`'s own body — `main`'s last
; form (its real `Int` result) stays last; `extra`'s forms (run purely
; for effect, per `collect-non-defn-tops`) run first, in source order.
; Every other `LDefn` in `lds` passes through unchanged.
let replace-main-body(lds: List LDefn, extra: List Ast) -> List LDefn =
  match (lds)
    | [] -> []
    | ld :: rest -> replace-main-body-cons(ld, rest, extra)

let replace-main-body-cons(ld: LDefn, rest: List LDefn, extra: List Ast) -> List LDefn =
  if (ldefn-name(ld) == "main") -> LDefn(ldefn-name(ld), ldefn-params(ld), ldefn-ret(ld), append-asts(extra, ldefn-body(ld))) :: rest | ld :: replace-main-body(rest, extra)

; ---------------------------------------------------------------------------
; Entry point: find `main`, lower every `Int`-only top-level `defn` (in
; source order — this order is the module's global value numbering, see
; header comment), hand the result to `bc-writer.mnd`.

; A top-level `(let stdout 1)` is a value, not a function. Uses of the name
; become the integer, so `(write stdout s)` lowers like `(write 1 s)`.
let add-int-constant(ast: Ast, acc: Map Str Int) -> Map Str Int =
  match (unwrap-pub(ast))
    | ParenNode([head, name-ast, expr], _) ->
      if (is-sym(head, "let")) -> add-int-constant-named(name-ast, expr, acc) | acc
    | _ -> acc

let add-int-constant-named(name-ast: Ast, expr: Ast, acc: Map Str Int) -> Map Str Int =
  match (sym-str(name-ast))
    | None -> acc
    | Some(n) ->
      match (expr)
        | IntNode(k, _) -> Map.set(n, k, acc)
        | _ -> acc

let collect-int-constants-from(forms: List Ast, acc: Map Str Int) -> Map Str Int =
  match (forms)
    | [] -> acc
    | f :: rest -> collect-int-constants-from(rest, add-int-constant(f, acc))

let collect-int-constants(forms: List Ast) -> Map Str Int =
  collect-int-constants-from(forms, Map.empty())

let name-is-bound(name: Str, bound: List Str) -> Bool =
  match (bound)
    | [] -> false
    | b :: rest ->
      if (name == b) -> true | name-is-bound(name, rest)

let subst-list(xs: List Ast, consts: Map Str Int, bound: List Str) -> List Ast =
  match (xs)
    | [] -> []
    | x :: rest -> subst-const(x, consts, bound) :: subst-list(rest, consts, bound)

let subst-sym(name: Str, sp: Span, consts: Map Str Int, bound: List Str) -> Ast =
  cond
    | name-is-bound(name, bound) -> SymNode(name, sp)
    | else ->
      match (Map.lookup(name, consts))
        | Some(k) -> IntNode(k, sp)
        | None -> SymNode(name, sp)

let let-bound-name(name-ast: Ast) -> Str =
  match (sym-str(name-ast))
    | Some(n) -> n
    | None -> ""

; A parameter is `(name: Type)` or a bare symbol. The colon is part of the
; symbol text. The name shadows an integer constant of the same spelling,
; so `(stdin: Str)` is not `(let stdin 0)`.
let strip-trailing-colon(raw: Str) -> Str {
  let n = String.length(raw)
  if (n > 0 && String.byte(n - 1, raw) == 58) -> String.slice(0, n - 1, raw) | raw
}

let param-bound-name(a: Ast) -> Str =
  match (a)
    | ParenNode(n :: _, _) -> strip-trailing-colon(let-bound-name(n))
    | SymNode(n, _) -> strip-trailing-colon(n)
    | _ -> ""

let subst-let(elems: List Ast, sp: Span, consts: Map Str Int, bound: List Str) -> Ast =
  match (elems)
    | head :: name :: rest -> ParenNode(head :: name :: subst-list(rest, consts, let-bound-name(name) :: bound), sp)
    | _ -> ParenNode(subst-list(elems, consts, bound), sp)

; Binders before `->` stay as written. The return type stays as written.
; Only the body is substituted, with the parameter names bound.
let subst-defn-body(xs: List Ast, consts: Map Str Int, bound: List Str) -> List Ast =
  match (xs)
    | [] -> []
    | ret :: body -> ret :: subst-list(body, consts, bound)

let subst-defn-params(xs: List Ast, consts: Map Str Int, bound: List Str) -> List Ast =
  match (xs)
    | [] -> []
    | x :: rest ->
      if (is-sym(x, "->")) -> x :: subst-defn-body(rest, consts, bound) | x :: subst-defn-params(rest, consts, param-bound-name(x) :: bound)

let subst-defn(elems: List Ast, sp: Span, consts: Map Str Int, bound: List Str) -> Ast =
  match (elems)
    | head :: name :: rest -> ParenNode(head :: name :: subst-defn-params(rest, consts, bound), sp)
    | _ -> ParenNode(subst-list(elems, consts, bound), sp)

let subst-paren(elems: List Ast, sp: Span, consts: Map Str Int, bound: List Str) -> Ast =
  match (elems)
    | head :: _ ->
      cond
        | is-sym(head, "quote") -> ParenNode(elems, sp)
        | is-sym(head, "let") -> subst-let(elems, sp, consts, bound)
        | is-sym(head, "defn") || is-sym(head, "fn") -> subst-defn(elems, sp, consts, bound)
        | else -> ParenNode(subst-list(elems, consts, bound), sp)
    | _ -> ParenNode(elems, sp)

let subst-const(ast: Ast, consts: Map Str Int, bound: List Str) -> Ast =
  match (ast)
    | SymNode(name, sp) -> subst-sym(name, sp, consts, bound)
    | ParenNode(elems, sp) -> subst-paren(elems, sp, consts, bound)
    | BracketNode(elems, sp) -> BracketNode(subst-list(elems, consts, bound), sp)
    | _ -> ast

let subst-forms(forms: List Ast, consts: Map Str Int) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> subst-const(f, consts, []) :: subst-forms(rest, consts)

let subst-int-constants(forms: List Ast) -> List Ast =
  subst-forms(forms, collect-int-constants(forms))

; A top-level `(let end-block-code 0)` has already been substituted at every
; use. Leaving the binding in `main` would only store a dead integer.
let is-folded-int-let(ast: Ast) -> Bool =
  match (unwrap-pub(ast))
    | ParenNode([head, _, expr], _) ->
      cond
        | is-sym(head, "let") ->
          match (expr)
            | IntNode(_, _) -> true
            | _ -> false
        | else -> false
    | _ -> false

let drop-folded-int-lets(forms: List Ast) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest ->
      if (is-folded-int-let(f)) -> drop-folded-int-lets(rest) | f :: drop-folded-int-lets(rest)

pub let lower-program(forms: List Ast, triple: Str, paths: List Str) -> Result Str Str =
  lower-program-collected(drop-folded-int-lets(subst-int-constants(forms)), triple, paths)

let lower-program-collected(forms: List Ast, triple: Str, paths: List Str) -> Result Str Str {
  let lds = collect-ldefns-all(forms)
  let word-lds = filter-word-ldefns(lds)
  match (find-ldefn-named(word-lds, "main"))
    | None -> Err("program has no top-level `defn main -> Int …` the real instruction lowerer can handle (`main` must return Int; helpers may use Int/Bool/Unit words)")
    | Some(main-ld) -> lower-program-checked-main(main-ld, word-lds, lds, forms, triple, paths)
}

let lower-program-checked-main(main-ld: LDefn, word-lds: List LDefn, all-lds: List LDefn, forms: List Ast, triple: Str, paths: List Str) -> Result Str Str =
  cond
    | param-arity-of(ldefn-params(main-ld)) > 0 -> Err("`main` must take no arguments")
    | is-int-type(ldefn-ret(main-ld)) || is-unit-type(ldefn-ret(main-ld)) -> lower-program-build(word-lds, all-lds, forms, triple, paths, [], [])
    | else -> Err("`main` must return Int or Unit")

; Global value numbering (see `llvm-ir.mnd`'s header comment and this
; module's `StrPool` doc comment): string globals first (`0..num-
; strings-1`), then the four fixed runtime externs, then every
; word-`defn` in source order — `build-func-refs`'s starting `idx`
; moves from `0` to `num-strings + extern-count` accordingly. Every
; function's own *local* value numbering must start after *all* of that,
; plus the module-level string-initializer constants `write-module-bc`
; also interleaves right after every declaration (one per string, same
; count again) — `num-globals` below is `2*num-strings + extern-count +
; num-funcs`, exactly what `write-module-body!`'s own `init-base` (`bc-
; writer.mnd`) assumes too.
; A function may-collect when it, or something it calls, can reach
; `mn_alloc`. Allocation-free functions are not rooted (spec §4.4).
; Unknown calls are treated as may-collect: over-rooting is safe.
let mc-pure(hn: Str) -> Bool =
  mc-pure-body(effect-alias(seam-menard-name(hn)))

let mc-pure-body(hn: Str) -> Bool =
  str-in-list(hn, ["isatty", "mtime", "now-ms", "ensure-dir", "remove", "is-dir"]) || hn == "if" || hn == "let" || hn == "do" || hn == "loop" || hn == "recur" || hn == "match" || hn == "println" || hn == "print" || hn == "shadow-push" || hn == "shadow-pop" || hn == "exit" || hn == "deref" || hn == "set!" || hn == "str-byte" || hn == "str-byte-length" || hn == "sb-clear!" || hn == "map-has" || hn == "map-size" || hn == "mn-env-get" || hn == "arg-count" || hn == "exists" || hn == "sb-length" || hn == "sb-to-str" || hn == "dump" || hn == "+" || hn == "-" || hn == "*" || hn == "/" || hn == "%" || hn == "<" || hn == ">" || hn == "<=" || hn == ">=" || hn == "=" || hn == "compare"

let mc-alloc-name(hn: Str) -> Bool =
  mc-alloc-body(seam-menard-name(hn))

let mc-alloc-body(hn: Str) -> Bool =
  hn == "write" || hn == "str-concat" || hn == "str-slice" || hn == "char->str" || hn == "ref" || hn == "sb-new" || hn == "sb-append!" || hn == "sb-append-byte!" || hn == "sb-take-str!" || hn == "map-new" || hn == "map-set" || hn == "map-get" || hn == "map-keys" || hn == "mn-env-0" || hn == "mn-env-1" || hn == "mn-env-new" || hn == "mn-closure-new" || hn == "mn-apply-0" || hn == "mn-apply-1" || hn == "mn-apply-2" || hn == "arg" || hn == "read-file" || hn == "write-file" || hn == "show" || hn == "spawn" || hn == "spawn-capture" || hn == "getenv" || hn == "rename" || hn == "f+" || hn == "f-" || hn == "f*" || hn == "f/" || hn == "cwd" || hn == "list-dir" || hn == "realpath"

let mc-ctor-alloc(hn: Str) -> Bool =
  is-upper-name(hn) && hn != "Nil" && hn != "None"

; One walk records direct allocs and the user-function callees. Later
; passes only follow that graph, so the AST is not re-walked per pass.
record McWalk {
  direct: Bool
  callees: List Str
}

let mc-walk-empty() -> McWalk =
  McWalk(false, [])

let mc-append(xs: List Str, ys: List Str) -> List Str =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: mc-append(rest, ys)

let mc-walk-or(a: McWalk, b: McWalk) -> McWalk =
  match (a)
    | McWalk(da, ca) ->
      match (b)
        | McWalk(db, cb) -> McWalk(da || db, mc-append(ca, cb))

let mc-note-head(hn: Str, names: Map Str Bool) -> McWalk =
  cond
    | mc-pure(hn) -> mc-walk-empty()
    | mc-alloc-name(hn) || mc-ctor-alloc(hn) -> McWalk(true, [])
    | else ->
      match (Map.lookup(hn, names))
        | Some(_) -> McWalk(false, [hn])
        | None -> McWalk(true, [])

let mc-walk-forms(xs: List Ast, names: Map Str Bool) -> McWalk =
  match (xs)
    | [] -> mc-walk-empty()
    | a :: rest -> mc-walk-or(mc-walk-ast(a, names), mc-walk-forms(rest, names))

; A string literal lowers to `mn_str_new`. That allocation is not a call
; in the AST, so it has to count on its own — otherwise a function whose
; only allocation is `"..." ` keeps live pointers in unrooted allocas.
let mc-walk-ast(ast: Ast, names: Map Str Bool) -> McWalk =
  match (ast)
    | ParenNode(elems, _) -> mc-walk-paren(elems, names)
    | BracketNode(elems, _) -> mc-walk-forms(elems, names)
    | StrNode(_, _) -> McWalk(true, [])
    | _ -> mc-walk-empty()

; Loop bindings and match patterns look like calls. Walking them would
; mark every arithmetic loop and every match as may-collect. A string
; literal pattern is the exception: it lowers to `mn_str_new`.
let mc-walk-loop-inits(pairs: List Ast, names: Map Str Bool) -> McWalk =
  match (pairs)
    | [] -> mc-walk-empty()
    | p :: rest ->
      mc-walk-or(
        match (binding-pair-of(p))
          | Some([_, init]) -> mc-walk-ast(init, names)
          | _ -> mc-walk-ast(p, names),
        mc-walk-loop-inits(rest, names)
      )

let mc-walk-loop(rest: List Ast, names: Map Str Bool) -> McWalk =
  match (rest)
    | [bindings, body] ->
      match (binding-list-elems(bindings))
        | Some(pairs) -> mc-walk-or(mc-walk-loop-inits(pairs, names), mc-walk-ast(body, names))
        | None -> mc-walk-or(mc-walk-ast(bindings, names), mc-walk-ast(body, names))
    | _ -> mc-walk-forms(rest, names)

let mc-pat-alloc(pat: Ast) -> Bool =
  match (pat)
    | StrNode(_, _) -> true
    | ParenNode(elems, _) -> mc-asts-alloc(elems)
    | BracketNode(elems, _) -> mc-asts-alloc(elems)
    | _ -> false

let mc-asts-alloc(xs: List Ast) -> Bool =
  match (xs)
    | [] -> false
    | p :: rest ->
      if (mc-pat-alloc(p)) -> true | mc-asts-alloc(rest)

let mc-walk-match-clauses(xs: List Ast, names: Map Str Bool) -> McWalk =
  match (xs)
    | [] -> mc-walk-empty()
    | pat :: body :: rest ->
      mc-walk-or(
        if (mc-pat-alloc(pat)) -> McWalk(true, []) | mc-walk-empty(),
        mc-walk-or(mc-walk-ast(body, names), mc-walk-match-clauses(rest, names))
      )
    | [other] -> mc-walk-ast(other, names)

let mc-walk-match(rest: List Ast, names: Map Str Bool) -> McWalk =
  match (rest)
    | scrut :: clauses -> mc-walk-or(mc-walk-ast(scrut, names), mc-walk-match-clauses(clauses, names))
    | [] -> mc-walk-empty()

let mc-walk-paren(elems: List Ast, names: Map Str Bool) -> McWalk =
  match (elems)
    | [] -> mc-walk-empty()
    | head :: rest ->
      match (sym-str(head))
        | None -> mc-walk-or(mc-walk-forms(rest, names), McWalk(true, []))
        | Some(hn) ->
          cond
            | hn == "loop" -> mc-walk-loop(rest, names)
            | hn == "match" -> mc-walk-match(rest, names)
            | else -> mc-walk-or(mc-walk-forms(rest, names), mc-note-head(hn, names))

let mc-seed(lds: List LDefn) -> Map Str Bool =
  match (lds)
    | [] -> Map.empty()
    | ld :: rest -> Map.set(ldefn-name(ld), false, mc-seed(rest))

let mc-build(lds: List LDefn, names: Map Str Bool) -> Map Str McWalk =
  match (lds)
    | [] -> Map.empty()
    | ld :: rest -> Map.set(ldefn-name(ld), mc-walk-forms(ldefn-body(ld), names), mc-build(rest, names))

let mc-any-callee(xs: List Str, flags: Map Str Bool) -> Bool =
  match (xs)
    | [] -> false
    | n :: rest ->
      match (Map.lookup(n, flags))
        | Some(f) ->
          if (f) -> true | mc-any-callee(rest, flags)
        | None -> mc-any-callee(rest, flags)

let mc-body-true(w: McWalk, flags: Map Str Bool) -> Bool =
  match (w)
    | McWalk(direct, callees) ->
      if (direct) -> true | mc-any-callee(callees, flags)

let mc-apply(lds: List LDefn, info: Map Str McWalk, flags: Map Str Bool) -> Map Str Bool =
  match (lds)
    | [] -> flags
    | ld :: rest -> mc-apply-one(ld, rest, info, flags)

let mc-apply-one(ld: LDefn, rest: List LDefn, info: Map Str McWalk, flags: Map Str Bool) -> Map Str Bool {
  let name = ldefn-name(ld)
  let now =
    match (Map.lookup(name, flags))
      | Some(f) -> f
      | None -> false
  let next-flag =
    cond
      | now -> true
      | else ->
        match (Map.lookup(name, info))
          | Some(w) -> mc-body-true(w, flags)
          | None -> true
  mc-apply(rest, info, Map.set(name, next-flag, flags))
}

let mc-flags-equal(lds: List LDefn, a: Map Str Bool, b: Map Str Bool) -> Bool =
  match (lds)
    | [] -> true
    | ld :: rest ->
      match (Map.lookup(ldefn-name(ld), a))
        | None -> false
        | Some(fa) ->
          match (Map.lookup(ldefn-name(ld), b))
            | None -> false
            | Some(fb) ->
              if (fa == fb) -> mc-flags-equal(rest, a, b) | false

let mc-propagate(lds: List LDefn, info: Map Str McWalk, flags: Map Str Bool, n: Int) -> Map Str Bool =
  if (n <= 0) -> flags | mc-propagate-step(lds, info, flags, n)

let mc-propagate-step(lds: List LDefn, info: Map Str McWalk, flags: Map Str Bool, n: Int) -> Map Str Bool {
  let next = mc-apply(lds, info, flags)
  if (mc-flags-equal(lds, flags, next)) -> next | mc-propagate(lds, info, next, n - 1)
}

let mc-analyze(lds: List LDefn) -> Map Str Bool {
  let names = mc-seed(lds)
  mc-propagate(lds, mc-build(lds, names), names, length(lds))
}

; Imported constructors keep the tag recorded in the dependency's
; interface. Names already in `seeds` are not assigned again, so a leaf
; change cannot renumber a constructor another module already inlined.
pub record CtorSeed {
  name: Str
  tag: Int
  arity: Int
}

pub record CtorTable {
  specs: Map Str CtorSpec
  local: List CtorSeed
}

let seed-specs(seeds: List CtorSeed, acc: Map Str CtorSpec) -> Map Str CtorSpec =
  match (seeds)
    | [] -> acc
    | CtorSeed(n, t, a) :: rest -> seed-specs(rest, Map.set(n, CtorSpec(t, a), acc))

let max-seed-tag(seeds: List CtorSeed, acc: Int) -> Int =
  match (seeds)
    | [] -> acc
    | CtorSeed(_, t, _) :: rest ->
      if (t > acc) -> max-seed-tag(rest, t) | max-seed-tag(rest, acc)

let seed-start(seeds: List CtorSeed) -> Int {
  let m = max-seed-tag(seeds, user-ctor-tag-base - 1) + 1
  if (m > user-ctor-tag-base) -> m | user-ctor-tag-base
}

let reverse-seeds(xs: List CtorSeed, acc: List CtorSeed) -> List CtorSeed =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-seeds(rest, x :: acc)

let note-ctor(acc: Map Str CtorSpec, name: Str, arity: Int, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  match (Map.lookup(name, acc))
    | Some(_) -> acc
    | None ->
      {
        let tag = deref(tag-ref)
        set!(tag-ref, tag + 1)
        set!(local, CtorSeed(name, tag, arity) :: deref(local))
        Map.set(name, CtorSpec(tag, arity), acc)
      }

let note-one-variant(c: Ast, acc: Map Str CtorSpec, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  match (c)
    | ParenNode(cname-ast :: payload, _) ->
      match (sym-str(cname-ast))
        | None -> acc
        | Some(name) ->
          match (builtin-ctor-tag-of(name))
            | Some(_) -> acc
            | None -> note-ctor(acc, name, length(payload), tag-ref, local)
    | _ -> acc

let note-variant-ctors(ctors: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  match (ctors)
    | [] -> acc
    | c :: rest -> note-variant-ctors(rest, note-one-variant(c, acc, tag-ref, local), tag-ref, local)

let note-defrec(rest: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  match (rest)
    | name-part :: fields ->
      match (decl-name-of(name-part))
        | None -> acc
        | Some(name) ->
          match (builtin-ctor-tag-of(name))
            | Some(_) -> acc
            | None -> note-ctor(acc, name, length(fields), tag-ref, local)
    | [] -> acc

let note-ctor-named(hn: Str, rest: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  cond
    | hn == "variant" ->
      match (rest)
        | _ :: ctors -> note-variant-ctors(ctors, acc, tag-ref, local)
        | [] -> acc
    | hn == "defrec" -> note-defrec(rest, acc, tag-ref, local)
    | else -> acc

let note-ctor-form(ast: Ast, acc: Map Str CtorSpec, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  match (unwrap-pub(ast))
    | ParenNode(head :: rest, _) ->
      match (sym-str(head))
        | None -> acc
        | Some(hn) -> note-ctor-named(hn, rest, acc, tag-ref, local)
    | _ -> acc

let note-ctor-forms(forms: List Ast, acc: Map Str CtorSpec, tag-ref: Ref Int, local: Ref (List CtorSeed)) -> Map Str CtorSpec =
  match (forms)
    | [] -> acc
    | f :: rest -> note-ctor-forms(rest, note-ctor-form(f, acc, tag-ref, local), tag-ref, local)

pub let ctor-info(forms: List Ast, seeds: List CtorSeed) -> CtorTable {
  let local = ref([])
  let tag-ref = ref(seed-start(seeds))
  let specs = note-ctor-forms(forms, seed-specs(seeds, Map.empty()), tag-ref, local)
  CtorTable(specs, reverse-seeds(deref(local), []))
}

let imp-count(imps: List Imp) -> Int =
  match (imps)
    | [] -> 0
    | _ :: rest -> 1 + imp-count(rest)

; Locals keep the abs ids `build-func-refs` assigned. An import whose
; Menard name is also a local function stays local; its declaration is
; still emitted so the id sequence matches the bitcode writer.
let add-imp-refs(imps: List Imp, idx: Int, acc: Map Str FuncRef) -> Map Str FuncRef =
  match (imps)
    | [] -> acc
    | Imp(name, _, ar) :: rest ->
      match (Map.lookup(name, acc))
        | Some(_) -> add-imp-refs(rest, idx + 1, acc)
        | None -> add-imp-refs(rest, idx + 1, Map.set(name, FuncRef(idx, ar), acc))

; A non-integer top-level `(let name expr)`. Integer lets are already
; folded away before this runs.
let value-let-name(form: Ast) -> Maybe Str =
  match (unwrap-pub(form))
    | ParenNode([head, name, expr], _) ->
      cond
        | is-sym(head, "let") ->
          match (expr)
            | IntNode(_, _) -> None()
            | _ -> sym-str(name)
        | else -> None()
    | _ -> None()

let top-value-let-names(forms: List Ast) -> List Str =
  match (forms)
    | [] -> []
    | f :: rest ->
      match (value-let-name(f))
        | Some(n) -> n :: top-value-let-names(rest)
        | None -> top-value-let-names(rest)

let drop-top-value-lets(forms: List Ast) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest ->
      match (value-let-name(f))
        | Some(_) -> drop-top-value-lets(rest)
        | None -> f :: drop-top-value-lets(rest)

let any-module-init(lds: List LDefn) -> Bool =
  match (lds)
    | [] -> false
    | ld :: rest ->
      if (is-module-init-name(ldefn-name(ld))) -> true | any-module-init(rest)

let add-slot-strs(names: List Str, p: StrPool) -> StrPool =
  match (names)
    | [] -> p
    | n :: rest -> add-slot-strs(rest, str-pool-add(p, n))

    ; When a module init exists, the value let runs there. Drop the
    ; top-level copy so bootstrap `main` does not evaluate it again.
    ; A program with no init splices the let onto `main`, which stores it.
let lower-program-build(word-lds: List LDefn, all-lds: List LDefn, forms: List Ast, triple: Str, paths: List Str, imports: List Imp, seeds: List CtorSeed) -> Result Str Str {
  let slots = top-value-let-names(forms)
  let forms2 =
    if (any-module-init(word-lds)) -> drop-top-value-lets(forms) | forms
  let extra = collect-non-defn-tops(forms2)
  let word-lds2 = replace-main-body(word-lds, extra)
  let specs =
    match (ctor-info(forms2, seeds))
      | CtorTable(s, _) -> s
  let pool = str-pool-finalize(add-slot-strs(slots, collect-str-pool(forms2, paths)), specs)
  let num-strings = str-pool-count(pool)
  let num-funcs = length(word-lds2)
  let nimps = imp-count(imports)
  let funcs0 = build-func-refs(word-lds2, num-strings + extern-count + nimps)
  let funcs = add-imp-refs(imports, num-strings + extern-count, funcs0)
  let noop = collect-noop-names(all-lds)
  let num-globals = 2 * num-strings + extern-count + nimps + num-funcs
  let mc = mc-analyze(word-lds2)
  match (lower-all-funcs(word-lds2, num-globals, funcs, noop, pool, mc, slots))
    | Ok(lfuncs) -> Ok(write-module-bc(LlvmModule(lfuncs, str-pool-strs(pool), imports), triple))
    | Err(msg) -> Err(String.concat("cannot lower `main`: ", msg))
}

let lower-program-collected-sep(forms: List Ast, triple: Str, paths: List Str, imports: List Imp, seeds: List CtorSeed) -> Result Str Str {
  let lds = collect-ldefns-all(forms)
  let word-lds = filter-word-ldefns(lds)
  lower-program-build(word-lds, lds, forms, triple, paths, imports, seeds)
}

; One module, with cross-module calls declared from `imports` and
; constructor tags seeded from dependencies. `main` is optional: a
; library object has none, and the bootstrap object is the only C main.
pub let lower-program-sep(forms: List Ast, triple: Str, paths: List Str, imports: List Imp, seeds: List CtorSeed) -> Result Str Str =
  lower-program-collected-sep(drop-folded-int-lets(subst-int-constants(forms)), triple, paths, imports, seeds)

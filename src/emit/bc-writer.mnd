; Bitcode writer — the real (bit-level) LLVM bitcode encoder, per ADR 40:
; the compiler's product is bitcode (`.bc`), never textual `.ll`, and
; `llvm-as` is never invoked from Menard. This module writes real, valid,
; **unwrapped** LLVM bitcode (magic `BC\xC0\xDE`, no Darwin wrapper) for an
; arbitrary `src/emit/llvm-ir.mnd` `LlvmModule`: any number of `i64`
; (tagged `Int`) functions, plus one `is-main` function returning `i32`,
; each with a real, already-lowered instruction stream (`alloca`/`store`/
; `load`/`binop`/`icmp`/`br`/`call`/`cast`/`ret` — see `llvm-ir.mnd`'s
; header comment for exactly what each `Item` means and how its operands
; are already relativized before this module ever sees them).
;
; This replaces slice 2B/2C's single-constant `write-int-main-bc` (`define
; i32 @main() { ret i32 N }` for a compile-time-folded `N`, module format
; version 0): `src/emit/lower.mnd` no longer folds `main` to one `Int` at
; all — every program's `.bc` now carries real instructions that *compute*
; its result, and `write-module-bc` (below) is the one entry point that
; turns the `LlvmModule` `lower.mnd` builds into bytes.
;
; A TypeScript prototype of the exact same algorithm — written first, to
; validate the bit-level encoding against `llvm-bcanalyzer` and clang
; before porting it here — lives at `tools/bc-writer/write-ssa.ts`. Its
; header comment is the fuller write-up of *why* the format is what it
; is (module version 1's relative value ids, opaque pointers, the
; `alloca`/`call` field shapes that are *not* obvious from the format's
; own documentation and had to be confirmed against a hand-written `.ll`
; assembled with the real `llvm-as` and read back with
; `llvm-bcanalyzer --dump`); this file's comments point back to it rather
; than repeat it. That TypeScript file is reference only: nothing here or
; in the rest of the compiler imports or depends on it.
;
; ## Why an append-only `BitSink`, and why no backpatching
;
; See slice 2A's original note (still exactly true here): a block's
; `ENTER_SUBBLOCK` header carries the block body's length in 32-bit words,
; only known *after* the body is encoded, and Menard's `StringBuffer` is
; append-only (ADR 33/34) — so every block body (including, now, each
; function's own per-constant `CONSTANTS_BLOCK`, see `llvm-ir.mnd`'s
; "Constants are interleaved" note) is rendered into its own fresh
; `BitSink` first, then spliced into the parent as whole, already-aligned
; bytes once its length is known — never patched after the fact.
;
; ## No abbreviations, module format version 1
;
; Every record here is still `UNABBREV_RECORD` (no `DEFINE_ABBREV`, no
; `BLOCKINFO_BLOCK` — see slice 2A's rationale, unchanged), but the module
; version is now **1**, not 0: version 1 is what switches every
; instruction operand that references another value (a binop's operands,
; a call's callee and arguments, a store's pointer and value, …) from an
; absolute value id to a *relative* one (`nextValueNo - targetAbsoluteId`)
; — the one feature multi-instruction, multi-block function bodies
; actually need (a version-0 module could only ever reference the single
; constant slice 2A/2B built). `src/emit/lower.mnd`'s `Builder` computes
; every relative reference itself, at the point an instruction is
; appended (see its header comment) — every operand `write-module-bc`
; sees below is already exactly what belongs in the record; this module
; does no value-numbering of its own.

import "./llvm-ir.mnd"
import std/string as String
import std/string-buffer as Buf

let end-block-code = 0

let enter-subblock-code = 1

let unabbrev-record-code = 3

let abbrev-width = 2

 ; every block here uses this; see header comment

pub let bitstream-magic-byte-0 = 66

 ; 'B'
pub let bitstream-magic-byte-1 = 67

 ; 'C'
pub let bitstream-magic-byte-2 = 192

 ; 0xC0
pub let bitstream-magic-byte-3 = 222

 ; 0xDE

pub let wrapper-magic-byte-0 = 222

 ; 0xDE — 0x0B17C0DE, byte 0 (LE)
pub let wrapper-magic-byte-1 = 192

 ; 0xC0 — byte 1
pub let wrapper-magic-byte-2 = 23

 ; 0x17 — byte 2
pub let wrapper-magic-byte-3 = 11

 ; 0x0B — byte 3

; ---------------------------------------------------------------------------
; Small local helpers (`src/`'s "no prelude import" rule — see
; `type/check.mnd`'s equivalent header note — means these are restated
; here rather than imported).

; 2^n for n in 0..32. A loop, not `(* 2 (pow2 (- n 1)))`: that recursion
; was one call per bit on every bitstream write.
let pow2(n: Int) -> Int =
  loop (i = 0, acc = 1)
    if (i >= n) -> acc | recur(i + 1, acc * 2)

let int-list-length(xs: List Int) -> Int =
  match (xs)
    | [] -> 0
    | _ :: rest -> 1 + int-list-length(rest)

let max-int(a: Int, b: Int) -> Int =
  if (a > b) -> a | b

let str-byte-ops-from(s: Str, i: Int, n: Int) -> List Int =
  if (i >= n) -> [] | String.byte(i, s) :: str-byte-ops-from(s, i + 1, n)

; A Str's bytes as a `(List Int)` — how a record's inline name operands
; (`vst-code-entry`, below) are built from a function's literal name.
let str-byte-ops(s: Str) -> List Int =
  str-byte-ops-from(s, 0, String.length(s))

; ---------------------------------------------------------------------------
; BitSink: pending bits (`pending`, `pending-bits`) plus the accumulated
; output bytes (`buf`). See the header comment.

record BitSink {
  buf: StringBuffer
  pending: Ref Int
  pending-bits: Ref Int
}

let sink-buf(s: BitSink) -> StringBuffer =
  match (s)
    | BitSink(b, _, _) -> b

let sink-pending(s: BitSink) -> Ref Int =
  match (s)
    | BitSink(_, p, _) -> p

let sink-pending-bits(s: BitSink) -> Ref Int =
  match (s)
    | BitSink(_, _, b) -> b

let bitsink-new() -> BitSink =
  BitSink(Buf.new(), ref(0), ref(0))

; Flush every whole byte currently pending (`pending-bits >= 8`) into
; `buf`. Bits above the flushed byte survive in `pending`, shifted down.
; The field walker is the hot path: matching `BitSink` once, then
; touching the refs directly, instead of re-matching on every deref.
let bitsink-flush-fields!(buf: StringBuffer, pending: Ref Int, pending-bits: Ref Int) -> Unit =
  cond
    | deref(pending-bits) >= 8 ->
      {
        let p = deref(pending)
        Buf.append-byte!(buf, p % 256)
        set!(pending, p / 256)
        set!(pending-bits, deref(pending-bits) - 8)
        bitsink-flush-fields!(buf, pending, pending-bits)
      }

let bitsink-flush!(s: BitSink) -> Unit =
  match (s)
    | BitSink(buf, pending, pending-bits) -> bitsink-flush-fields!(buf, pending, pending-bits)

; Write the low `width` bits of `value` (unsigned, `value < 2^width`).
; `value`'s bits occupy positions [pending-bits, pending-bits+width) and
; `pending`'s current bits occupy [0, pending-bits) — disjoint ranges, so
; `+` here is exactly bitwise OR (see the header comment's no-bitwise-ops
; note).
let bitsink-write-fixed!(s: BitSink, value: Int, width: Int) -> Unit =
  match (s)
    | BitSink(buf, pending, pending-bits) ->
      cond
        | width == 0 -> ()
        | else ->
          {
            let shift = deref(pending-bits)
            let p = deref(pending)
            set!(pending, p + value * pow2(shift))
            set!(pending-bits, shift + width)
            bitsink-flush-fields!(buf, pending, pending-bits)
          }

; VBR(width): `value` split into (width-1)-bit chunks, least-significant
; chunk first, each chunk's high bit set iff another chunk follows.
let bitsink-write-vbr-chunks!(s: BitSink, value: Int, cont-bit: Int, width: Int) -> Unit {
  let chunk = value % cont-bit
  let rest = value / cont-bit
  cond
    | rest == 0 -> bitsink-write-fixed!(s, chunk, width)
    | else ->
      {
        bitsink-write-fixed!(s, chunk + cont-bit, width)
        bitsink-write-vbr-chunks!(s, rest, cont-bit, width)
      }
}

let bitsink-write-vbr!(s: BitSink, value: Int, width: Int) -> Unit =
  bitsink-write-vbr-chunks!(s, value, pow2(width - 1), width)

let bitsink-total-bits(s: BitSink) -> Int =
  Buf.length(sink-buf(s)) * 8 + deref(sink-pending-bits(s))

; Pad with zero bits to the next 32-bit boundary. Every rendered block
; body ends with one of these right after its `END_BLOCK` — see the
; header comment on why that makes backpatching unnecessary.
let bitsink-align32!(s: BitSink) -> Unit {
  let rem = bitsink-total-bits(s) % 32
  if (rem == 0) -> () | bitsink-write-fixed!(s, 0, 32 - rem)
}

; Append already byte-aligned bytes verbatim. Only ever called right
; after a `bitsink-align32!` (this sink's own, or — for a spliced-in
; block body — the fact that `render-block-body!` always returns a whole
; number of bytes), so `pending-bits` is always 0 here.
let bitsink-append-raw!(s: BitSink, raw: Str) -> Unit =
  Buf.append!(sink-buf(s), raw)

let bitsink-finish!(s: BitSink) -> Str =
  Buf.take-str!(sink-buf(s))

; ---------------------------------------------------------------------------
; Bitstream structure: blocks and unabbreviated records, built on BitSink.

; One record: `UNABBREV_RECORD code numops op...`, every field VBR6.
let write-record-ops!(s: BitSink, ops: List Int) -> Unit =
  match (ops)
    | [] -> ()
    | op :: rest ->
      {
        bitsink-write-vbr!(s, op, 6)
        write-record-ops!(s, rest)
      }

let write-record!(s: BitSink, code: Int, ops: List Int) -> Unit {
  bitsink-write-fixed!(s, unabbrev-record-code, abbrev-width)
  bitsink-write-vbr!(s, code, 6)
  bitsink-write-vbr!(s, int-list-length(ops), 6)
  write-record-ops!(s, ops)
}

; Render a block's body (records/subblocks written by `write-body!` into
; a fresh sink) terminated by `END_BLOCK` + `align32`. The result is
; always a whole number of 32-bit words — see the header comment.
let render-block-body!(write-body: (BitSink) -> Unit) -> Str {
  let s = bitsink-new()
  write-body(s)
  bitsink-write-fixed!(s, end-block-code, abbrev-width)
  bitsink-align32!(s)
  bitsink-finish!(s)
}

let append-word32-le!(s: BitSink, n: Int) -> Unit {
  Buf.append-byte!(sink-buf(s), n % 256)
  Buf.append-byte!(sink-buf(s), n / 256 % 256)
  Buf.append-byte!(sink-buf(s), n / 65536 % 256)
  Buf.append-byte!(sink-buf(s), n / 16777216 % 256)
}

; Enter a subblock of `parent`: render its body in isolation (so its
; length in words is known), then write the `ENTER_SUBBLOCK` header, the
; length word, and splice the body in as raw bytes — never backpatched.
let enter-subblock!(parent: BitSink, block-id: Int, write-body: (BitSink) -> Unit) -> Unit {
  let body = render-block-body!(write-body)
  bitsink-write-fixed!(parent, enter-subblock-code, abbrev-width)
  bitsink-write-vbr!(parent, block-id, 8)
  bitsink-write-vbr!(parent, abbrev-width, 4)
  bitsink-align32!(parent)
  append-word32-le!(parent, String.length(body) / 4)
  bitsink-append-raw!(parent, body)
}

; ---------------------------------------------------------------------------
; Block ids and record codes actually used here (see
; `tools/bc-writer/write-ssa.ts`'s header comment for the upstream names
; this subset comes from, and how each was confirmed; only what this
; module needs is named).

let module-block-id = 8

let constants-block-id = 11

let function-block-id = 12

let value-symtab-block-id = 14

let type-block-id = 17

let module-code-version = 1

let module-code-triple = 2

let module-code-globalvar = 7

let module-code-function = 8

let type-code-numentry = 1

let type-code-void = 2

let type-code-integer = 7

let type-code-array = 11

let type-code-function = 21

let type-code-opaque-pointer = 25

let cst-code-settype = 1

let cst-code-null = 2

let cst-code-integer = 4

let cst-code-aggregate = 7

let cst-code-string = 8

let type-code-struct-anon = 18

let func-code-declareblocks = 1

let func-code-inst-binop = 2

let func-code-inst-cast = 3

let func-code-inst-ret = 10

let func-code-inst-br = 11

let func-code-inst-unreachable = 15

let func-code-inst-alloca = 19

let func-code-inst-load = 20

let func-code-inst-cmp2 = 28

let func-code-inst-call = 34

let func-code-inst-store = 44

let vst-code-entry = 1

; The fixed leading type-table indices every module here uses (see
; `write-types!` below): `ptr`, `i64`, `i32`, `void`, then one function
; type per distinct arity `0..max-arity` for `(i64 x arity) -> i64`, then
; one trailing `(i32, ptr) -> i32` for `main`, then `i8`, the four fixed
; extern function types (`void(ptr,i64)`, `void(i64)`, `ptr(i64,ptr)` for
; `mn_alloc`, `void(i32,ptr)` for `mn_init`), then one `[len x i8]` array
; type per string global, in `LlvmModule`'s `globals` order.
let ty-ptr = 0

let ty-i64 = 1

let ty-i32 = 2

let ty-void = 3

let func-type-idx-for-arity(arity: Int) -> Int =
  4 + arity

let main-type-idx(ma: Int) -> Int =
  4 + ma + 1

; One slot right after `main`'s own type — see header comment's ordering.
let ty-i8-idx(ma: Int) -> Int =
  main-type-idx(ma) + 1

let ty-write-sig-idx(ma: Int) -> Int =
  ty-i8-idx(ma) + 1

 ; void(ptr, i64)
let ty-print-sig-idx(ma: Int) -> Int =
  ty-write-sig-idx(ma) + 1

 ; void(i64)
let ty-alloc-sig-idx(ma: Int) -> Int =
  ty-print-sig-idx(ma) + 1

 ; ptr(i64, ptr)
let ty-init-sig-idx(ma: Int) -> Int =
  ty-alloc-sig-idx(ma) + 1

 ; void(i32, ptr)
let ty-panic-sig-idx(ma: Int) -> Int =
  ty-init-sig-idx(ma) + 1

 ; void(ptr)
let ty-pop-sig-idx(ma: Int) -> Int =
  ty-panic-sig-idx(ma) + 1

 ; void()
let ty-panic-at-sig-idx(ma: Int) -> Int =
  ty-pop-sig-idx(ma) + 1

 ; void(ptr, i64, ptr)
; String `i`'s (0-indexed, in `globals` order) own `[len x i8]` array type.
let ty-str-array-idx(ma: Int, i: Int) -> Int =
  ty-panic-at-sig-idx(ma) + i + 1

let i64-param-types(n: Int) -> List Int =
  if (n <= 0) -> [] | ty-i64 :: i64-param-types(n - 1)

let write-func-types!(t: BitSink, arity: Int, ma: Int) -> Unit =
  cond
    | arity > ma -> ()
    | else ->
      {
        write-record!(t, type-code-function, 0 :: ty-i64 :: i64-param-types(arity))
        write-func-types!(t, arity + 1, ma)
      }

; One `[len x i8]` array type per string in `globals`, in order — see
; header comment's trailing "then one ... array type per string global".
let str-lengths(globals: List Str) -> List Int =
  match (globals)
    | [] -> []
    | g :: rest -> String.length(g) :: str-lengths(rest)

let write-array-types!(t: BitSink, ma: Int, lens: List Int) -> Unit =
  match (lens)
    | [] -> ()
    | len :: rest ->
      {
        write-record!(t, type-code-array, [len, ty-i8-idx(ma)])
        write-array-types!(t, ma, rest)
      }

; `ptr`(0), `i64`(1), `i32`(2), `void`(3), one `(i64 x arity) -> i64` per
; `arity` in `0..ma`, then `(i32, ptr) -> i32` for `main`, then `i8`, the
; the fixed extern function types, then one `[len x i8]` array type per
; string global — see header comment.
let write-types!(t: BitSink, ma: Int, globals: List Str, extra: Int) -> Unit {
  let ns = int-list-length(str-lengths(globals))
  write-record!(t, type-code-numentry, [4 + ma + 1 + 9 + ns + extra])
  write-record!(t, type-code-opaque-pointer, [0])
  write-record!(t, type-code-integer, [64])
  write-record!(t, type-code-integer, [32])
  write-record!(t, type-code-void, [])
  write-func-types!(t, 0, ma)
  write-record!(t, type-code-function, [0, ty-i32, ty-i32, ty-ptr])
  write-record!(t, type-code-integer, [8])
  write-record!(t, type-code-function, [0, ty-void, ty-ptr, ty-i64])
  write-record!(t, type-code-function, [0, ty-void, ty-i64])
  write-record!(t, type-code-function, [0, ty-ptr, ty-i64, ty-ptr])
  write-record!(t, type-code-function, [0, ty-void, ty-i32, ty-ptr])
  write-record!(t, type-code-function, [0, ty-void, ty-ptr])
  write-record!(t, type-code-function, [0, ty-void])
  write-record!(t, type-code-function, [0, ty-void, ty-ptr, ty-i64, ty-ptr])
  write-array-types!(t, ma, str-lengths(globals))
}

; ---------------------------------------------------------------------------
; `MODULE_CODE_FUNCTION` — one per function, in module order (this order
; *is* each function's module-scope global value id, `0..N-1`; every
; `ICall`'s callee-rel operand was computed by `lower.mnd`'s `Builder`
; against exactly this ordering, so this list must not be reordered).
; type idx, ccc, has a body (not a declaration-only proto), external
; linkage; the remaining fields (paramattrs, alignment, section,
; visibility) are left at their all-zero defaults, same as slice 2A.
let write-function-decls!(m: BitSink, fs: List LFunc, ma: Int) -> Unit =
  match (fs)
    | [] -> ()
    | f :: rest ->
      {
        let ty =
          if (lfunc-is-main(f)) -> main-type-idx(ma) | func-type-idx-for-arity(lfunc-nparams(f))
        write-record!(m, module-code-function, [ty, 0, 0, 0, 0, 0, 0, 0])
        write-function-decls!(m, rest, ma)
      }

; ---------------------------------------------------------------------------
; The three fixed runtime externs (`llvm-ir.mnd`'s `extern-count`) —
; `MODULE_CODE_FUNCTION` records exactly like a user function's, except
; `isproto = 1` (a declaration, no body: no matching `FUNCTION_BLOCK` is
; ever written for these three) and each one's own fixed signature type
; (`ty-write-sig-idx`/`ty-print-sig-idx`, not a `(i64^n)->i64` family
; member). Written right after every string `GLOBALVAR` and before any
; user function's own `MODULE_CODE_FUNCTION` — see `write-module-body!`'s
; ordering and `llvm-ir.mnd`'s `extern-write-stdout-abs`/etc. for why
; that fixes each extern's abs id to `num-strings + 0/1/2`.
let write-extern-decl!(m: BitSink, ty: Int) -> Unit =
  write-record!(m, module-code-function, [ty, 0, 1, 0, 0, 0, 0, 0])

let write-extern-decls!(m: BitSink, ma: Int) -> Unit {
  write-extern-decl!(m, ty-write-sig-idx(ma))
  write-extern-decl!(m, ty-print-sig-idx(ma))
  write-extern-decl!(m, ty-write-sig-idx(ma))
  write-extern-decl!(m, ty-alloc-sig-idx(ma))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, ty-print-sig-idx(ma))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(3))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(3))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, ty-init-sig-idx(ma))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, ty-print-sig-idx(ma))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(3))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(3))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(3))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, ty-write-sig-idx(ma))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, func-type-idx-for-arity(2))
  write-extern-decl!(m, ty-panic-sig-idx(ma))
  write-extern-decl!(m, ty-write-sig-idx(ma))
  write-extern-decl!(m, ty-pop-sig-idx(ma))
  write-extern-decl!(m, ty-panic-at-sig-idx(ma))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(0))
  write-extern-decl!(m, func-type-idx-for-arity(1))
  write-extern-decl!(m, func-type-idx-for-arity(1))

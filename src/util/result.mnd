; Small Result helpers shared by the reader, casing checker and emitter.
; Menard has no macros and no do-notation, so this is the ordinary-function
; substitute for monadic bind: thread a fallible step into a continuation
; without writing out `(match r (Ok v) … (Err e) (Err e))` at every call site.

pub let result-bind[a, b, e](r: Result a e, k: (a) -> Result b e) -> Result b e =
  match (r)
    | Ok(v) -> k(v)
    | Err(err) -> Err(err)

; Sequence a fallible step whose success value is not needed by the next step.
pub let result-then[a, e](r: Result Unit e, k: () -> Result a e) -> Result a e =
  match (r)
    | Ok(_) -> k()
    | Err(err) -> Err(err)

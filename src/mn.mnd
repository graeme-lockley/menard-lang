; Menard driver. `make` compiles this file to the `./mn` binary.
;
; Bootstrap (stage0, before `./mn` exists):
;   bun run host/src/cli/menard.ts run src/mn.mnd -- <check|emit|build|run|inter> <file.mnd> [out.bc] [-o bin] [--cc path] [--runtime dir]
;
; `check` runs the full front end through derive planning (see below).
; `emit` does the same, then writes a bitcode module to `out.bc`, or to
; `<file>.bc` (replacing a trailing `.mnd`, or appending `.bc`) when no
; output path is given. `emit` spawns nothing.
; `build` emits bitcode beside `-o`, spawns the recorded `cc` with an
; argv list, and renames the linker output into place. `run` builds,
; then spawns the binary.
;
; `--dump-after=reader`, `--dump-after=desugar`, `--dump-after=type`,
; `--dump-after=close`, `--dump-after=root`, and `--dump-after=derive`
; may appear anywhere in the argument list; each prints the forms produced
; by that pipeline stage to stderr (via `dump`) — `reader` right after
; reading, before casing; `desugar` right after desugaring, once casing
; has passed; `type` right after typechecking, once the typer has passed;
; `close` after closure conversion; `root` after rooting analysis; `derive`
; after derive planning. None of these count as a positional argument.
; `--dump-after=derive` additionally prints `derive/plan.mnd`'s
; `describe-derives` — which types the program's `show`/`=`/`compare`/
; `dump` use sites need derived (slice 2F) — right after the forms dump.
; The plan is taken from the forms *before* `plan-derives` rewrites
; `(show (Red))` into `(show_Color ...)`, so the line still names the
; declared type.

(import "./reader/ast.mnd")
(import "./reader/read.mnd")
(import "./reader/casing.mnd")
(import "./desugar/desugar.mnd")
(import "./type/check.mnd")
(import "./close/close.mnd")
(import "./root/root.mnd")
(import "./derive/derive.mnd")
(import "./derive/plan.mnd")
(import "./emit/bitcode.mnd")
(import "./modules/graph.mnd")
(import "../stdlib/io.mnd")

(defn nl -> Str
  (do
    (let sb (sb-new))
    (sb-append-byte! sb 10)
    (sb-take-str! sb)))

(defn write-line (fd: Int) (s: Str) -> Unit
  (do
    (write fd s)
    (write fd (nl))
    ()))

; ---------------------------------------------------------------------------
; argv: mode, file, [out] are positional; --dump-after=reader and
; --dump-after=desugar are flags and are skipped when counting/indexing
; positional arguments.

(defn is-dump-after-reader (s: Str) -> Bool
  (= s "--dump-after=reader"))

(defn is-dump-after-desugar (s: Str) -> Bool
  (= s "--dump-after=desugar"))

(defn is-dump-after-type (s: Str) -> Bool
  (= s "--dump-after=type"))

(defn is-dump-after-close (s: Str) -> Bool
  (= s "--dump-after=close"))

(defn is-dump-after-root (s: Str) -> Bool
  (= s "--dump-after=root"))

(defn is-dump-after-derive (s: Str) -> Bool
  (= s "--dump-after=derive"))

(defn is-dump-flag (s: Str) -> Bool
  (or (is-dump-after-reader s)
    (or (is-dump-after-desugar s)
      (or (is-dump-after-type s)
        (or (is-dump-after-close s) (or (is-dump-after-root s) (is-dump-after-derive s)))))))

(defn is-bare-flag (s: Str) -> Bool
  (or (is-dump-flag s) (= s "--show-result")))

(defn is-valued-flag (s: Str) -> Bool
  (or (= s "-o") (or (= s "--cc") (= s "--runtime"))))

(defn has-dump-after-reader-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (is-dump-after-reader (arg i)) true (has-dump-after-reader-from (+ i 1) n))))

(defn has-dump-after-reader -> Bool
  (has-dump-after-reader-from 0 (arg-count)))

(defn has-dump-after-desugar-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (is-dump-after-desugar (arg i)) true (has-dump-after-desugar-from (+ i 1) n))))

(defn has-dump-after-desugar -> Bool
  (has-dump-after-desugar-from 0 (arg-count)))

(defn has-dump-after-type-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (is-dump-after-type (arg i)) true (has-dump-after-type-from (+ i 1) n))))

(defn has-dump-after-type -> Bool
  (has-dump-after-type-from 0 (arg-count)))

(defn has-dump-after-close-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (is-dump-after-close (arg i)) true (has-dump-after-close-from (+ i 1) n))))

(defn has-dump-after-close -> Bool
  (has-dump-after-close-from 0 (arg-count)))

(defn has-dump-after-root-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (is-dump-after-root (arg i)) true (has-dump-after-root-from (+ i 1) n))))

(defn has-dump-after-root -> Bool
  (has-dump-after-root-from 0 (arg-count)))

(defn has-dump-after-derive-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (is-dump-after-derive (arg i)) true (has-dump-after-derive-from (+ i 1) n))))

(defn has-dump-after-derive -> Bool
  (has-dump-after-derive-from 0 (arg-count)))

(defn has-show-result-from (i: Int) (n: Int) -> Bool
  (if (>= i n)
    false
    (if (= (arg i) "--show-result") true (has-show-result-from (+ i 1) n))))

(defn has-show-result -> Bool
  (has-show-result-from 0 (arg-count)))

(defn positional-count-from (i: Int) (n: Int) (acc: Int) -> Int
  (if (>= i n)
    acc
    (if (is-bare-flag (arg i))
      (positional-count-from (+ i 1) n acc)
      (if (is-valued-flag (arg i))
        (positional-count-from (+ i 2) n acc)
        (if (= (arg i) "--")
          acc
          (positional-count-from (+ i 1) n (+ acc 1)))))))

(defn positional-count -> Int
  (positional-count-from 0 (arg-count) 0))

(defn positional-arg-from (want: Int) (i: Int) (seen: Int) (n: Int) -> Str
  (if (>= i n)
    ""
    (if (is-bare-flag (arg i))
      (positional-arg-from want (+ i 1) seen n)
      (if (is-valued-flag (arg i))
        (positional-arg-from want (+ i 2) seen n)
        (if (= (arg i) "--")
          ""
          (if (= seen want)
            (arg i)
            (positional-arg-from want (+ i 1) (+ seen 1) n)))))))

(defn positional-arg (want: Int) -> Str
  (positional-arg-from want 0 0 (arg-count)))

; ---------------------------------------------------------------------------
; Diagnostics (byte-offset spans only — no line/col map yet, see plan).

(defn report-parse-error (path: Str) (e: ParseError) -> Unit
  (match e
    (ParseError sp msg)
      (do
        (write stderr path)
        (write stderr ":")
        (write stderr (show (span-start sp)))
        (write stderr "-")
        (write stderr (show (span-end sp)))
        (write stderr ": error: ")
        (write-line 2 msg))))

(defn report-casing-error (path: Str) (e: CasingError) -> Unit
  (match e
    (CasingError sp msg)
      (do
        (write stderr path)
        (write stderr ":")
        (write stderr (show (span-start sp)))
        (write stderr "-")
        (write stderr (show (span-end sp)))
        (write stderr ": error: ")
        (write-line 2 msg))))

(defn report-desugar-error (path: Str) (e: DesugarError) -> Unit
  (match e
    (DesugarError sp code msg)
      (do
        (write stderr path)
        (write stderr ":")
        (write stderr (show (span-start sp)))
        (write stderr "-")
        (write stderr (show (span-end sp)))
        (write stderr ": error: ")
        (write stderr msg)
        (write stderr " [")
        (write stderr code)
        (write-line 2 "]"))))

(defn report-desugar-errors (path: Str) (es: (List DesugarError)) -> Unit
  (match es
    [] ()
    (Cons e rest) (do (report-desugar-error path e) (report-desugar-errors path rest))))

(defn report-type-error (path: Str) (e: TypeError) -> Unit
  (match e
    (TypeError sp code msg)
      (do
        (write stderr path)
        (write stderr ":")
        (write stderr (show (span-start sp)))
        (write stderr "-")
        (write stderr (show (span-end sp)))
        (write stderr ": error: ")
        (write stderr msg)
        (write stderr " [")
        (write stderr code)
        (write-line 2 "]"))))

(defn report-type-errors (path: Str) (es: (List TypeError)) -> Unit
  (match es
    [] ()
    (Cons e rest) (do (report-type-error path e) (report-type-errors path rest))))

(defn fail-cannot-read (path: Str) -> Unit
  (do
    (write-line 2 (str-concat "error: cannot read " path))
    (exit 2)))

(defn usage -> Unit
  (do
    (write-line 2 "usage: mn <check|emit|build|run|inter> <file.mnd> [out.bc] [-o bin] [--cc path] [--runtime dir] [--show-result] [--dump-after=reader|desugar|type|close|root|derive]")
    (exit 2)))

; ---------------------------------------------------------------------------
; Shared front end: read-all → (dump reader) → casing → desugar → (dump
; desugar) → flatten imports when the entry has any → typecheck → …

(defn maybe-dump (forms: (List Ast)) (dump-after: Bool) -> Unit
  (if dump-after (dump forms) ()))

(defn fail-load (msg: Str) -> Unit
  (do
    (write-line 2 (str-concat "error: " msg))
    (exit 1)))

(defn form-is-import (form: Ast) -> Bool
  (match form
    (ParenNode (Cons head _) _)
      (match head (SymNode n _) (= n "import") _ false)
    _ false))

(defn has-import (forms: (List Ast)) -> Bool
  (match forms
    [] false
    (Cons f rest) (if (form-is-import f) true (has-import rest))))

(defn front-end (path: Str) (src: Str) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (match (read-all src)
    (Ok forms) (front-end-checked path src forms dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive on-ok)
    (Err e) (do (report-parse-error path e) (exit 1))))

(defn front-end-checked (path: Str) (src: Str) (forms: (List Ast)) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (do
    (maybe-dump forms dump-after-reader)
    (match (check-casing-all forms)
      (Ok _) (front-end-desugared path src forms dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive on-ok)
      (Err e) (do (report-casing-error path e) (exit 1)))))

(defn front-end-desugared (path: Str) (src: Str) (forms: (List Ast)) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (match (desugar-all forms)
    (Ok desugared)
      (do
        (maybe-dump desugared dump-after-desugar)
        (front-end-loaded path src desugared dump-after-type dump-after-close dump-after-root dump-after-derive on-ok))
    (Err es) (do (report-desugar-errors path es) (exit 1))))

; A single file keeps the names the reader saw. An import graph is flattened
; and its private bindings renamed before typechecking.
(defn front-end-loaded (path: Str) (src: Str) (desugared: (List Ast)) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (if (has-import desugared)
    (match (flatten-module-graph path src)
      (Ok flat) (front-end-typechecked path flat dump-after-type dump-after-close dump-after-root dump-after-derive on-ok)
      (Err msg) (fail-load msg))
    (front-end-typechecked path desugared dump-after-type dump-after-close dump-after-root dump-after-derive on-ok)))

(defn front-end-typechecked (path: Str) (forms: (List Ast)) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (match (typecheck-forms forms)
    (Ok checked)
      (do
        (maybe-dump checked dump-after-type)
        (front-end-closed path checked dump-after-close dump-after-root dump-after-derive on-ok))
    (Err es) (do (report-type-errors path es) (exit 1))))

(defn front-end-closed (path: Str) (forms: (List Ast)) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (do
    (let closed (closure-convert forms))
    (maybe-dump closed dump-after-close)
    (front-end-rooted path closed dump-after-root dump-after-derive on-ok)))

(defn front-end-rooted (path: Str) (forms: (List Ast)) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (do
    (let rooted (rooting-analyze forms))
    (maybe-dump rooted dump-after-root)
    (front-end-derived path rooted dump-after-derive on-ok)))

(defn maybe-dump-derive-plan (forms: (List Ast)) (dump-after-derive: Bool) -> Unit
  (if dump-after-derive (write-line 2 (describe-derives forms)) ()))

(defn front-end-derived (path: Str) (forms: (List Ast)) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (do
    (let derived (plan-derives forms))
    (maybe-dump derived dump-after-derive)
    (maybe-dump-derive-plan forms dump-after-derive)
    (on-ok derived)))

(defn with-source (path: Str) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) (on-ok: (Fn (List Ast) -> Unit)) -> Unit
  (match (read-file path)
    (Ok src) (front-end path src dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive on-ok)
    (Err _) (fail-cannot-read path)))

; ---------------------------------------------------------------------------
; check

(defn accept-check (forms: (List Ast)) -> Unit
  (exit 0))

(defn run-check (path: Str) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) -> Unit
  (with-source path dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive accept-check))

; ---------------------------------------------------------------------------
; emit

(defn ends-with (s: Str) (suffix: Str) -> Bool
  (do
    (let sn (str-byte-length s))
    (let un (str-byte-length suffix))
    (and (>= sn un) (= (str-slice s (- sn un) un) suffix))))

(defn default-output-path (path: Str) -> Str
  (if (ends-with path ".mnd")
    (str-concat (str-slice path 0 (- (str-byte-length path) 4)) ".bc")
    (str-concat path ".bc")))

(defn output-path (path: Str) (has-out: Bool) (out: Str) -> Str
  (if has-out out (default-output-path path)))

(defn fail-cannot-write (out: Str) -> Unit
  (do
    (write-line 2 (str-concat "error: cannot write " out))
    (exit 2)))

(defn fail-emit (msg: Str) -> Unit
  (do
    (write-line 2 (str-concat "error: " msg))
    (exit 1)))

; `emit-program-bc` (src/emit/bitcode.mnd) lowers `forms` to a bitcode
; module, or fails with a message if the program has no top-level
; `defn main -> Int …` its real instruction lowerer (src/emit/lower.mnd)
; can lower — see that module's header comment for what it does and does
; not lower yet.
; `clang -print-target-triple` prints `darwin`, but the triple clang
; actually links against is the one in its own IR (`macosx` on this
; host). Ask clang to emit a one-line module and read that line.
; Spawn being unavailable (the test host) leaves the triple empty, and
; clang will warn when it supplies its own.
(defn triple-marker -> Str "target triple = \"")

(defn bytes-match-at (s: Str) (i: Int) (pat: Str) (j: Int) -> Bool
  (if (>= j (str-byte-length pat)) true
    (if (>= (+ i j) (str-byte-length s)) false
      (if (= (str-byte s (+ i j)) (str-byte pat j))
        (bytes-match-at s i pat (+ j 1))
        false))))

(defn find-bytes (s: Str) (pat: Str) (i: Int) -> Int
  (if (> (+ i (str-byte-length pat)) (str-byte-length s)) (- 0 1)
    (if (bytes-match-at s i pat 0) i
      (find-bytes s pat (+ i 1)))))

(defn copy-until (s: Str) (i: Int) (stop: Int) (acc: Str) -> Str
  (if (>= i (str-byte-length s)) acc
    (if (= (str-byte s i) stop) acc
      (copy-until s (+ i 1) stop (str-concat acc (str-slice s i 1))))))

(defn triple-from-text (text: Str) -> Str
  (do
    (let mark (triple-marker))
    (let at (find-bytes text mark 0))
    (if (< at 0) ""
      (copy-until text (+ at (str-byte-length mark)) 34 ""))))

(defn triple-from-ll (path: Str) -> Str
  (match (read-file path)
    (Err _) (do (write-line 2 (str-concat "error: cannot read " path)) (exit 1) "")
    (Ok text)
      (do
        (let triple (triple-from-text text))
        (if (= (str-byte-length triple) 0)
          (do (write-line 2 "error: clang IR has no target triple") (exit 1) "")
          triple))))

(defn clang-target-triple (cc: Str) (out: Str) -> Str
  (do
    (let c-path (str-concat out ".probe.c"))
    (let ll-path (str-concat out ".probe.ll"))
    (match (write-file c-path "int x;")
      (Err _) ""
      (Ok _)
        (match (spawn [cc "-S" "-emit-llvm" "-o" ll-path c-path])
          (Err _) ""
          (Ok st)
            (if (= (status-exit-code st) 0) (triple-from-ll ll-path) "")))))

(defn write-module (out: Str) (forms: (List Ast)) -> Unit
  (match (emit-program-bc forms (clang-target-triple (chosen-cc "") out))
    (Ok bytes) (write-module-bytes out bytes)
    (Err msg) (fail-emit msg)))

(defn write-module-bytes (out: Str) (bytes: Str) -> Unit
  (match (write-file out bytes)
    (Ok _) (exit 0)
    (Err _) (fail-cannot-write out)))

(defn accept-emit (path: Str) (has-out: Bool) (out: Str) (forms: (List Ast)) -> Unit
  (write-module (output-path path has-out out) forms))

(defn run-emit (path: Str) (has-out: Bool) (out: Str) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) -> Unit
  (with-source path dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive (fn (forms) (accept-emit path has-out out forms))))

; ---------------------------------------------------------------------------
; Driver. `cc` and the runtime directory are recorded paths (or flags),
; never a PATH search inside `spawn`. `find-on-path` is the visible
; search a caller can opt into. `status-exit-code` folds `Signalled n`
; to `128 + n` here, not in the primitive.

(defn recorded-cc -> Str "/usr/bin/clang")

(defn recorded-runtime -> Str "runtime")

(defn chosen-cc-menard -> Str
  (match (getenv "MENARD_CC")
    (Some s) (if (> (str-byte-length s) 0) s (recorded-cc))
    (None) (recorded-cc)))

(defn chosen-cc (flag: Str) -> Str
  (if (> (str-byte-length flag) 0) flag
    (match (getenv "CC")
      (Some s) (if (> (str-byte-length s) 0) s (chosen-cc-menard))
      (None) (chosen-cc-menard))))

(defn chosen-runtime (flag: Str) -> Str
  (if (> (str-byte-length flag) 0) flag (recorded-runtime)))

(defn status-exit-code (st: SpawnStatus) -> Int
  (match st
    (Exited n) n
    (Signalled n) (+ 128 n)))

(defn flag-value-from (name: Str) (i: Int) (n: Int) -> Str
  (if (>= i n) ""
    (if (= (arg i) "--") ""
      (if (= (arg i) name)
        (if (< (+ i 1) n) (arg (+ i 1)) "")
        (flag-value-from name (+ i 1) n)))))

(defn flag-value (name: Str) -> Str
  (flag-value-from name 0 (arg-count)))

(defn collect-args (i: Int) (n: Int) -> (List Str)
  (if (>= i n) []
    (Cons (arg i) (collect-args (+ i 1) n))))

(defn prog-args-from (i: Int) (n: Int) -> (List Str)
  (if (>= i n) []
    (if (= (arg i) "--")
      (collect-args (+ i 1) n)
      (prog-args-from (+ i 1) n))))

(defn prog-args -> (List Str)
  (prog-args-from 0 (arg-count)))

(defn last-slash-from (s: Str) (i: Int) (last: Int) (n: Int) -> Int
  (if (>= i n) last
    (if (= (str-byte s i) 47)
      (last-slash-from s (+ i 1) (+ i 1) n)
      (last-slash-from s (+ i 1) last n))))

(defn basename (s: Str) -> Str
  (do
    (let n (str-byte-length s))
    (let i (last-slash-from s 0 0 n))
    (str-slice s i (- n i))))

(defn stem-of (file: Str) -> Str
  (do
    (let b (basename file))
    (if (ends-with b ".mnd")
      (str-slice b 0 (- (str-byte-length b) 4))
      b)))

(defn default-bin (file: Str) -> Str
  (str-concat "build/" (stem-of file)))

(defn rt-src (runtime: Str) (name: Str) -> Str
  (str-concat runtime (str-concat "/src/" name)))

(defn clang-argv (cc: Str) (runtime: Str) (bc: Str) (link-out: Str) -> (List Str)
  [
  cc
  "-std=c11"
  "-D_DEFAULT_SOURCE"
  "-Wall"
  "-Wextra"
  "-O1"
  (str-concat "-I" (str-concat runtime "/include"))
  bc
  (rt-src runtime "alloc.c")
  (rt-src runtime "gc.c")
  (rt-src runtime "panic.c")
  (rt-src runtime "print.c")
  (rt-src runtime "shadow.c")
  (rt-src runtime "variants.c")
  (rt-src runtime "str.c")
  (rt-src runtime "map.c")
  (rt-src runtime "closure.c")
  (rt-src runtime "io.c")
  (rt-src runtime "equal.c")
  "-lm"
  "-o"
  link-out])

(defn fail-spawn (what: Str) -> Unit
  (do
    (write-line 2 (str-concat "error: cannot spawn " what))
    (exit 2)))

(defn link-rename (cc: Str) (runtime: Str) (bc: Str) (link-out: Str) (bin: Str) -> Unit
  (match (spawn (clang-argv cc runtime bc link-out))
    (Err _) (fail-spawn cc)
    (Ok st)
      (do
        (let code (status-exit-code st))
        (if (= code 0)
          (match (rename link-out bin)
            (Ok _) ()
            (Err _) (do (write-line 2 (str-concat "error: cannot rename " bin)) (exit 2)))
          (exit code)))))

(defn run-built (bin: Str) -> Unit
  (match (spawn (Cons bin (prog-args)))
    (Err _) (fail-spawn bin)
    (Ok st) (exit (status-exit-code st))))

(defn accept-build (cc: Str) (runtime: Str) (bin: Str) (and-run: Bool) (forms: (List Ast)) -> Unit
  (do
    (let bc (str-concat bin ".bc"))
    (let link-out (str-concat bin ".tmp"))
    (match (emit-program-bc forms (clang-target-triple cc bin))
      (Err msg) (fail-emit msg)
      (Ok bytes)
        (match (write-file bc bytes)
          (Err _) (fail-cannot-write bc)
          (Ok _)
            (do
              (link-rename cc runtime bc link-out bin)
              (if and-run
                (run-built bin)
                (do (write-line 2 (str-concat "wrote " bin)) (exit 0))))))))

(defn run-build (file: Str) (cc: Str) (runtime: Str) (bin: Str) (and-run: Bool) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) -> Unit
  (with-source file dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive (fn (forms) (accept-build cc runtime bin and-run forms))))

; Visible PATH search. The driver does not call this for `cc`.
(defn path-dir-end (s: Str) (i: Int) (n: Int) -> Int
  (if (>= i n) n
    (if (= (str-byte s i) 58) i
      (path-dir-end s (+ i 1) n))))

(defn probe-dir (dir: Str) (name: Str) -> (Maybe Str)
  (do
    (let candidate
      (if (= (str-byte-length dir) 0) name
        (str-concat dir (str-concat "/" name))))
    (if (exists candidate) (Some candidate) (None))))

(defn search-path (path: Str) (name: Str) (i: Int) -> (Maybe Str)
  (do
    (let n (str-byte-length path))
    (if (> i n) (None)
      (do
        (let end (path-dir-end path i n))
        (let dir (str-slice path i (- end i)))
        (match (probe-dir dir name)
          (Some c) (Some c)
          (None)
            (if (>= end n) (None)
              (search-path path name (+ end 1))))))))

(defn find-on-path (name: Str) -> (Maybe Str)
  (match (getenv "PATH")
    (None) (None)
    (Some path) (search-path path name 0)))

; ---------------------------------------------------------------------------
; `inter` is the reference interpreter. The host stays TypeScript; this
; only spawns it.

(defn bun-on-path -> Str
  (match (find-on-path "bun")
    (Some b) b
    (None) ""))

(defn chosen-bun -> Str
  (match (getenv "MENARD_BUN")
    (Some s) (if (> (str-byte-length s) 0) s (bun-on-path))
    (None) (bun-on-path)))

(defn append-strs (a: (List Str)) (b: (List Str)) -> (List Str)
  (match a
    [] b
    (Cons h t) (Cons h (append-strs t b))))

(defn inter-tail (file: Str) (show: Bool) (args: (List Str)) -> (List Str)
  (do
    (let head
      (if show
        ["--show-result" file]
        [file]))
    (match args
      [] head
      _ (append-strs head (Cons "--" args)))))

(defn inter-argv (bun: Str) (file: Str) (show: Bool) (args: (List Str)) -> (List Str)
  (Cons bun
    (Cons "run"
      (Cons "host/src/cli/menard.ts"
        (Cons "run" (inter-tail file show args))))))

(defn run-inter (file: Str) -> Unit
  (if (exists file)
    (do
      (let bun (chosen-bun))
      (if (= (str-byte-length bun) 0)
        (fail-spawn "bun")
        (match (spawn (inter-argv bun file (has-show-result) (prog-args)))
          (Err _) (fail-spawn bun)
          (Ok st) (exit (status-exit-code st)))))
    (fail-cannot-read file)))

; ---------------------------------------------------------------------------
; Dispatch

(defn dispatch (mode: Str) (file: Str) (has-out: Bool) (out: Str) (bin: Str) (dump-after-reader: Bool) (dump-after-desugar: Bool) (dump-after-type: Bool) (dump-after-close: Bool) (dump-after-root: Bool) (dump-after-derive: Bool) -> Unit
  (if (= mode "check")
    (run-check file dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive)
    (if (= mode "emit")
      (run-emit file has-out out dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive)
      (if (or (= mode "build") (= mode "run"))
        (run-build file (chosen-cc (flag-value "--cc")) (chosen-runtime (flag-value "--runtime")) bin (= mode "run") dump-after-reader dump-after-desugar dump-after-type dump-after-close dump-after-root dump-after-derive)
        (if (= mode "inter")
          (run-inter file)
          (usage))))))

(defn main -> Unit
  (do
    (let n (positional-count))
    (if (< n 2)
      (usage)
      (do
        (let mode (positional-arg 0))
        (let file (positional-arg 1))
        (let o-flag (flag-value "-o"))
        (let bin (if (> (str-byte-length o-flag) 0) o-flag (default-bin file)))
        (dispatch
          mode
          file
          (>= n 3)
          (if (>= n 3) (positional-arg 2) "")
          bin
          (has-dump-after-reader)
          (has-dump-after-desugar)
          (has-dump-after-type)
          (has-dump-after-close)
          (has-dump-after-root)
          (has-dump-after-derive))))))

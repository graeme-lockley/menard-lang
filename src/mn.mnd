; Menard driver. `make` compiles this file to the `./mn` binary.
;
; Bootstrap (stage0, before `./mn` exists):
;   bun run host/src/cli/menard.ts run src/mn.mnd -- <check|emit|build|run|inter> <file.mnd> [out.bc] [-o bin] [--cc path] [--runtime dir]
;
; `check` runs the full front end through derive planning (see below).
; `emit` does the same, then writes a bitcode module to `out.bc`, or to
; `<file>.bc` (replacing a trailing `.mnd`, or appending `.bc`) when no
; output path is given. `emit` spawns nothing.
; `build` emits bitcode beside `-o`, spawns the recorded `cc` with an
; argv list, and renames the linker output into place. `run` builds,
; then spawns the binary.
;
; `--dump-after=reader`, `--dump-after=desugar`, `--dump-after=type`,
; `--dump-after=close`, `--dump-after=root`, and `--dump-after=derive`
; may appear anywhere in the argument list; each prints the forms produced
; by that pipeline stage to stderr (via `dump`) — `reader` right after
; reading, before casing; `desugar` right after desugaring, once casing
; has passed; `type` right after typechecking, once the typer has passed;
; `close` after closure conversion; `root` after rooting analysis; `derive`
; after derive planning. None of these count as a positional argument.
; `--dump-after=derive` additionally prints `derive/plan.mnd`'s
; `describe-derives` — which types the program's `show`/`=`/`compare`/
; `dump` use sites need derived (slice 2F) — right after the forms dump.
; The plan is taken from the forms *before* `plan-derives` rewrites
; `(show (Red))` into `(show_Color ...)`, so the line still names the
; declared type.

import "./reader/ast.mnd"
import "./reader/read.mnd"
import "./reader/casing.mnd"
import "./desugar/desugar.mnd"
import "./type/check.mnd"
import "./close/close.mnd"
import "./root/root.mnd"
import "./derive/derive.mnd"
import "./derive/plan.mnd"
import "./emit/bitcode.mnd"
import "./modules/graph.mnd"
import "./diag/report.mnd"
import "./cache/cache.mnd"
import "./cache/sep.mnd"
import "./test/run.mnd"
import std/cli
import std/fs
import std/io
import std/list
import std/proc
import std/string as String
import std/sys

; Flags the driver understands. A valued flag consumes the next word.
let mn-flags() -> List Flag =
  [Flag("--dump-after=reader", false), Flag("--dump-after=desugar", false), Flag("--dump-after=type", false), Flag("--dump-after=close", false), Flag("--dump-after=root", false), Flag("--dump-after=derive", false), Flag("--show-result", false), Flag("--clean", false), Flag("--verbose", false), Flag("--show-output", false), Flag("--quiet", false), Flag("-o", true), Flag("--cc", true), Flag("--runtime", true)]

let argv-onto(i: Int, n: Int, acc: List Str) -> List Str =
  if (i >= n) -> reverse(acc) | argv-onto(i + 1, n, arg(i) :: acc)

let argv() -> List Str =
  argv-onto(0, arg-count(), [])

let has-dump-after-reader() -> Bool =
  has-flag(argv(), "--dump-after=reader")

let has-dump-after-desugar() -> Bool =
  has-flag(argv(), "--dump-after=desugar")

let has-dump-after-type() -> Bool =
  has-flag(argv(), "--dump-after=type")

let has-dump-after-close() -> Bool =
  has-flag(argv(), "--dump-after=close")

let has-dump-after-root() -> Bool =
  has-flag(argv(), "--dump-after=root")

let has-dump-after-derive() -> Bool =
  has-flag(argv(), "--dump-after=derive")

let has-show-result() -> Bool =
  has-flag(argv(), "--show-result")

let has-clean() -> Bool =
  has-flag(argv(), "--clean")

let has-verbose() -> Bool =
  has-flag(argv(), "--verbose")

let has-show-output() -> Bool =
  has-flag(argv(), "--show-output")

let has-quiet() -> Bool =
  has-flag(argv(), "--quiet")

let opt(name: Str) -> Str =
  flag-value(argv(), name)

; Progress is for a person watching a terminal. A captured stderr stays
; empty unless something failed. `--quiet` suppresses it even on a tty.
let note-compiling(path: Str, ms: Int) -> Unit =
  cond
    | has-quiet() -> ()
    | isatty(2) ->
      {
        write(stderr, progress-line("Compiling", display-path(canonical-path(path)), ms))
        ()
      }

let explicit-out() -> Bool =
  String.length(opt("-o")) > 0

let positional-arg(want: Int) -> Str =
  positional(argv(), mn-flags(), want)

let positional-count() -> Int =
  length(positionals(argv(), mn-flags()))

; Every path after `test`. None means the current directory.
let test-paths() -> List Str =
  match (positionals(argv(), mn-flags()))
    | [] -> []
    | _ :: rest -> rest

let prog-args() -> List Str =
  args-after(argv())

; ---------------------------------------------------------------------------
; Diagnostics. Line and column come from the source bytes. `origin` on a
; span selects the file in the path list, so an error in an import names
; that file.

let parse-code(msg: Str) -> Str =
  cond
    | String.contains("unclosed", msg) -> "E_PARSE_UNCLOSED"
    | String.contains("'!'", msg) -> "E_PARSE_BANG"
    | String.contains("unterminated", msg) -> "E_PARSE_STRING"
    | else -> "E_PARSE"

let report-parse-error(path: Str, src: Str, e: ParseError) -> Unit =
  match (e)
    | ParseError(sp, msg) -> report-span(path, src, sp, "error", parse-code(msg), msg)

let report-casing-error(path: Str, src: Str, e: CasingError) -> Unit =
  match (e)
    | CasingError(sp, msg) -> report-span(path, src, sp, "error", "E_CASING", msg)

let report-desugar-error(path: Str, src: Str, e: DesugarError) -> Unit =
  match (e)
    | DesugarError(sp, code, msg) -> report-span(path, src, sp, "error", code, msg)

let report-desugar-errors(path: Str, src: Str, es: List DesugarError) -> Unit =
  match (es)
    | [] -> ()
    | e :: rest ->
      {
        report-desugar-error(path, src, e)
        report-desugar-errors(path, src, rest)
      }

let nth-path(paths: List Str, i: Int, fallback: Str) -> Str =
  nth(i, paths) ? fallback

let report-type-errors(paths: List Str, es: List TypeError) -> Unit =
  match (es)
    | [] -> ()
    | TypeError(sp, code, msg) :: rest ->
      {
        let fallback =
          match (paths)
            | p :: _ -> p
            | [] -> ""
        let p = nth-path(paths, span-origin(sp), fallback)
        let src =
          match (read-file(p))
            | Ok(s) -> s
            | Err(_) -> ""
        report-span(p, src, sp, "error", code, msg)
        report-type-errors(paths, rest)
      }

let fail-cannot-read(path: Str) -> Unit {
  write-line(2, String.concat("error: cannot read ", path))
  exit(2)
}

let usage() -> Unit {
  write-line(2, "usage: mn <check|emit|build|run|test|inter> <file.mnd> [out.bc] [-o bin] [--cc path] [--runtime dir] [--clean] [--quiet] [--verbose] [--show-output] [--show-result] [--dump-after=reader|desugar|type|close|root|derive]")
  exit(2)
}

; ---------------------------------------------------------------------------
; Shared front end: read-all → (dump reader) → casing → desugar → (dump
; desugar) → flatten imports when the entry has any → typecheck → …

let maybe-dump(forms: List Ast, dump-after: Bool) -> Unit =
  if (dump-after) -> dump(forms)

let fail-load(msg: Str) -> Unit {
  write-line(2, String.concat("error: ", msg))
  exit(1)
}

let form-is-import(form: Ast) -> Bool =
  match (form)
    | ParenNode(head :: _, _) ->
      match (head)
        | SymNode(n, _) -> n == "import"
        | _ -> false
    | _ -> false

let has-import(forms: List Ast) -> Bool =
  any(form-is-import, forms)

let front-end(path: Str, src: Str, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit =
  match (read-all(src))
    | Ok(forms) -> front-end-checked(path, src, forms, dump-after-reader, dump-after-desugar, dump-after-type, dump-after-close, dump-after-root, dump-after-derive, on-ok)
    | Err(e) ->
      {
        report-parse-error(path, src, e)
        exit(1)
      }

let front-end-checked(path: Str, src: Str, forms: List Ast, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit {
  maybe-dump(forms, dump-after-reader)
  match (check-casing-all(forms))
    | Ok(_) -> front-end-desugared(path, src, forms, dump-after-desugar, dump-after-type, dump-after-close, dump-after-root, dump-after-derive, on-ok)
    | Err(e) ->
      {
        report-casing-error(path, src, e)
        exit(1)
      }
}

let front-end-desugared(path: Str, src: Str, forms: List Ast, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit =
  match (desugar-all(forms))
    | Ok(desugared) ->
      {
        maybe-dump(desugared, dump-after-desugar)
        front-end-loaded(path, src, desugared, dump-after-type, dump-after-close, dump-after-root, dump-after-derive, on-ok)
      }
    | Err(es) ->
      {
        report-desugar-errors(path, src, es)
        exit(1)
      }

; A single file keeps the names the reader saw. An import graph is flattened
; and its private bindings renamed before typechecking.
let front-end-loaded(path: Str, src: Str, desugared: List Ast, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit =
  cond
    | has-import(desugared) ->
      match (flatten-module-graph(path, src))
        | Ok(Flat(flat, paths)) -> front-end-typechecked(path, flat, paths, dump-after-type, dump-after-close, dump-after-root, dump-after-derive, on-ok)
        | Err(msg) -> fail-load(msg)
    | else ->
      {
        let stamped = stamp-spans(desugared, src, 0)
        match (runtime-misplaced(path, stamped))
          | Some(msg) -> fail-load(msg)
          | None ->
            {
              let prepared = prepare-runtime-forms(path, stamped)
              front-end-typechecked(path, prepared, [path], dump-after-type, dump-after-close, dump-after-root, dump-after-derive, on-ok)
            }
      }

let front-end-typechecked(path: Str, forms: List Ast, paths: List Str, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit =
  match (typecheck-forms(forms))
    | Ok(checked) ->
      {
        maybe-dump(checked, dump-after-type)
        let lowered = lower-runtime-forms(checked)
        front-end-closed(path, lowered, paths, dump-after-close, dump-after-root, dump-after-derive, on-ok)
      }
    | Err(es) ->
      {
        report-type-errors(paths, es)
        exit(1)
      }

let front-end-closed(path: Str, forms: List Ast, paths: List Str, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit {
  let closed = closure-convert(forms)
  maybe-dump(closed, dump-after-close)
  front-end-rooted(path, closed, paths, dump-after-root, dump-after-derive, on-ok)
}

let front-end-rooted(path: Str, forms: List Ast, paths: List Str, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit {
  let rooted = rooting-analyze(forms)
  maybe-dump(rooted, dump-after-root)
  front-end-derived(path, rooted, paths, dump-after-derive, on-ok)
}

let maybe-dump-derive-plan(forms: List Ast, dump-after-derive: Bool) -> Unit =
  if (dump-after-derive) ->
    {
      write-line(2, describe-derives(forms))
      ()
    }

let front-end-derived(path: Str, forms: List Ast, paths: List Str, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit {
  let derived = plan-derives(forms)
  maybe-dump(derived, dump-after-derive)
  maybe-dump-derive-plan(forms, dump-after-derive)
  on-ok(derived, paths)
}

let with-source(path: Str, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool, on-ok: (List Ast, List Str) -> Unit) -> Unit =
  match (read-file(path))
    | Ok(src) -> front-end(path, src, dump-after-reader, dump-after-desugar, dump-after-type, dump-after-close, dump-after-root, dump-after-derive, on-ok)
    | Err(_) -> fail-cannot-read(path)

; ---------------------------------------------------------------------------
; check

let accept-check(forms: List Ast, paths: List Str) -> Unit =
  exit(0)

let run-check(path: Str, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool) -> Unit {
  let started = now-ms()
  with-source(
    path,
    dump-after-reader,
    dump-after-desugar,
    dump-after-type,
    dump-after-close,
    dump-after-root,
    dump-after-derive,
    fn (forms, paths) {
      note-compiling(path, now-ms() - started)
      accept-check(forms, paths)
    }
  )
}

; ---------------------------------------------------------------------------
; emit

let default-output-path(path: Str) -> Str =
  if (String.ends-with(".mnd", path)) -> String.concat(String.slice(0, String.length(path) - 4, path), ".bc") | String.concat(path, ".bc")

let output-path(path: Str, has-out: Bool, out: Str) -> Str =
  if (has-out) -> out | default-output-path(path)

let fail-cannot-write(out: Str) -> Unit {
  write-line(2, String.concat("error: cannot write ", out))
  exit(2)
}

let fail-emit(msg: Str) -> Unit {
  write-line(2, String.concat("error: ", msg))
  exit(1)
}

; `emit-program-bc` (src/emit/bitcode.mnd) lowers `forms` to a bitcode
; module, or fails with a message if the program has no top-level
; `defn main -> Int …` its real instruction lowerer (src/emit/lower.mnd)
; can lower — see that module's header comment for what it does and does
; not lower yet.
; `clang -print-target-triple` prints `darwin`, but the triple clang
; actually links against is the one in its own IR (`macosx` on this
; host). Capture that IR on stdout. Spawn being unavailable (the test
; host) leaves the triple empty, and clang will warn when it supplies
; its own.
let triple-marker() -> Str =
  "target triple = \""

let bytes-match-at(s: Str, i: Int, pat: Str, j: Int) -> Bool =
  cond
    | j >= String.length(pat) -> true
    | i + j >= String.length(s) -> false
    | String.byte(i + j, s) == String.byte(j, pat) -> bytes-match-at(s, i, pat, j + 1)
    | else -> false

let find-bytes(s: Str, pat: Str, i: Int) -> Int =
  cond
    | i + String.length(pat) > String.length(s) -> -1
    | bytes-match-at(s, i, pat, 0) -> i
    | else -> find-bytes(s, pat, i + 1)

let copy-until(s: Str, i: Int, stop: Int, acc: Str) -> Str =
  cond
    | i >= String.length(s) -> acc
    | String.byte(i, s) == stop -> acc
    | else -> copy-until(s, i + 1, stop, String.concat(acc, String.slice(i, 1, s)))

let triple-from-text(text: Str) -> Str {
  let mark = triple-marker()
  let at = find-bytes(text, mark, 0)
  if (at < 0) -> "" | copy-until(text, at + String.length(mark), 34, "")
}

let triple-or-fail(text: Str) -> Str {
  let triple = triple-from-text(text)
  cond
    | String.length(triple) == 0 ->
      {
        write-line(2, "error: clang IR has no target triple")
        exit(1)
        ""
      }
    | else -> triple
}

let clang-target-triple(cc: Str) -> Str =
  match (spawn-capture([cc, "-S", "-emit-llvm", "-o", "-", "-x", "c", "-"], "int x;"))
    | Err(_) -> ""
    | Ok(SpawnOutput(st, text, _)) ->
      if (status-exit-code(st) == 0) -> triple-or-fail(text) | ""

let write-module(out: Str, forms: List Ast, paths: List Str) -> Unit =
  match (emit-program-bc(forms, clang-target-triple(chosen-cc("")), paths))
    | Ok(bytes) -> write-module-bytes(out, bytes)
    | Err(msg) -> fail-emit(msg)

let write-module-bytes(out: Str, bytes: Str) -> Unit =
  match (write-file(out, bytes))
    | Ok(_) -> exit(0)
    | Err(_) -> fail-cannot-write(out)

let accept-emit(path: Str, has-out: Bool, out: Str, forms: List Ast, paths: List Str) -> Unit =
  write-module(output-path(path, has-out, out), forms, paths)

let run-emit(path: Str, has-out: Bool, out: Str, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool) -> Unit {
  let started = now-ms()
  with-source(
    path,
    dump-after-reader,
    dump-after-desugar,
    dump-after-type,
    dump-after-close,
    dump-after-root,
    dump-after-derive,
    fn (forms, paths) {
      note-compiling(path, now-ms() - started)
      accept-emit(path, has-out, out, forms, paths)
    }
  )
}

; ---------------------------------------------------------------------------
; Driver. `cc` and the runtime directory are recorded paths (or flags),
; never a PATH search inside `spawn`. `find-on-path` is the visible
; search a caller can opt into. `status->exit-code` folds `Signalled n`
; to `128 + n` here, not in the primitive.

let recorded-cc() -> Str =
  "/usr/bin/clang"

let recorded-runtime() -> Str =
  "runtime"

let chosen-cc-menard() -> Str =
  match (getenv("MENARD_CC"))
    | Some(s) ->
      if (String.length(s) > 0) -> s | recorded-cc()
    | None -> recorded-cc()

let chosen-cc(flag: Str) -> Str =
  cond
    | String.length(flag) > 0 -> flag
    | else ->
      match (getenv("CC"))
        | Some(s) ->
          if (String.length(s) > 0) -> s | chosen-cc-menard()
        | None -> chosen-cc-menard()

let chosen-runtime(flag: Str) -> Str =
  if (String.length(flag) > 0) -> flag | recorded-runtime()

let last-slash-from(s: Str, i: Int, last: Int, n: Int) -> Int =
  cond
    | i >= n -> last
    | String.byte(i, s) == 47 -> last-slash-from(s, i + 1, i + 1, n)
    | else -> last-slash-from(s, i + 1, last, n)

let basename(s: Str) -> Str {
  let n = String.length(s)
  let i = last-slash-from(s, 0, 0, n)
  String.slice(i, n - i, s)
}

let stem-of(file: Str) -> Str {
  let b = basename(file)
  if (String.ends-with(".mnd", b)) -> String.slice(0, String.length(b) - 4, b) | b
}

let default-bin(file: Str) -> Str =
  String.concat("build/", stem-of(file))

let rt-src(runtime: Str, name: Str) -> Str =
  String.concat(runtime, "/src/", name)

let clang-argv(cc: Str, runtime: Str, bc: Str, link-out: Str) -> List Str =
  [cc, "-std=c11", "-D_DEFAULT_SOURCE", "-Wall", "-Wextra", "-O2", String.concat("-I", runtime, "/include"), bc, rt-src(runtime, "alloc.c"), rt-src(runtime, "gc.c"), rt-src(runtime, "panic.c"), rt-src(runtime, "print.c"), rt-src(runtime, "shadow.c"), rt-src(runtime, "variants.c"), rt-src(runtime, "str.c"), rt-src(runtime, "map.c"), rt-src(runtime, "closure.c"), rt-src(runtime, "io.c"), rt-src(runtime, "equal.c"), "-lm", "-o", link-out]

let fail-spawn(what: Str) -> Unit {
  write-line(2, String.concat("error: cannot spawn ", what))
  exit(2)
}

let link-rename(cc: Str, runtime: Str, bc: Str, link-out: Str, bin: Str) -> Unit =
  match (spawn(clang-argv(cc, runtime, bc, link-out)))
    | Err(_) -> fail-spawn(cc)
    | Ok(st) ->
      {
        let code = status-exit-code(st)
        cond
          | code == 0 ->
            match (rename(link-out, bin))
              | Ok(_) -> ()
              | Err(_) ->
                {
                  write-line(2, String.concat("error: cannot rename ", bin))
                  exit(2)
                }
          | else -> exit(code)
      }

let run-built(bin: Str) -> Unit =
  match (spawn(bin :: prog-args()))
    | Err(_) -> fail-spawn(bin)
    | Ok(st) -> exit(status-exit-code(st))

let accept-build(cc: Str, runtime: Str, bin: Str, and-run: Bool, forms: List Ast, paths: List Str) -> Unit {
  let bc = String.concat(bin, ".bc")
  let link-out = String.concat(bin, ".tmp")
  match (emit-program-bc(forms, clang-target-triple(cc), paths))
    | Err(msg) -> fail-emit(msg)
    | Ok(bytes) ->
      match (write-file(bc, bytes))
        | Err(_) -> fail-cannot-write(bc)
        | Ok(_) ->
          {
            link-rename(cc, runtime, bc, link-out, bin)
            cond
              | and-run -> run-built(bin)
              | else ->
                {
                  write-line(2, String.concat("wrote ", bin))
                  exit(0)
                }
          }
}

let run-build(file: Str, cc: Str, runtime: Str, bin: Str, and-run: Bool, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool) -> Unit =
  with-source(file, dump-after-reader, dump-after-desugar, dump-after-type, dump-after-close, dump-after-root, dump-after-derive, fn (forms, paths) = accept-build(cc, runtime, bin, and-run, forms, paths))

; Visible PATH search. The driver does not call this for `cc`.
let path-dir-end(s: Str, i: Int, n: Int) -> Int =
  cond
    | i >= n -> n
    | String.byte(i, s) == 58 -> i
    | else -> path-dir-end(s, i + 1, n)

let probe-dir(dir: Str, name: Str) -> Maybe Str {
  let candidate =
    if (String.length(dir) == 0) -> name | String.concat(dir, "/", name)
  if (exists(candidate)) -> Some(candidate) | None()
}

let search-path(path: Str, name: Str, i: Int) -> Maybe Str {
  let n = String.length(path)
  cond
    | i > n -> None()
    | else ->
      {
        let end = path-dir-end(path, i, n)
        let dir = String.slice(i, end - i, path)
        match (probe-dir(dir, name))
          | Some(c) -> Some(c)
          | None ->
            if (end >= n) -> None() | search-path(path, name, end + 1)
      }
}

let find-on-path(name: Str) -> Maybe Str =
  match (getenv("PATH"))
    | None -> None()
    | Some(path) -> search-path(path, name, 0)

; ---------------------------------------------------------------------------
; `inter` is the reference interpreter. The host stays TypeScript; this
; only spawns it.

let bun-on-path() -> Str =
  match (find-on-path("bun"))
    | Some(b) -> b
    | None -> ""

let chosen-bun() -> Str =
  match (getenv("MENARD_BUN"))
    | Some(s) ->
      if (String.length(s) > 0) -> s | bun-on-path()
    | None -> bun-on-path()

let append-strs(a: List Str, b: List Str) -> List Str =
  match (a)
    | [] -> b
    | h :: t -> h :: append-strs(t, b)

let inter-tail(file: Str, show: Bool, args: List Str) -> List Str {
  let head =
    if (show) -> ["--show-result", file] | [file]
  match (args)
    | [] -> head
    | _ -> append-strs(head, "--" :: args)
}

let inter-argv(bun: Str, file: Str, show: Bool, args: List Str) -> List Str =
  bun :: "run" :: "host/src/cli/menard.ts" :: "run" :: inter-tail(file, show, args)

let run-inter(file: Str) -> Unit =
  cond
    | exists(file) ->
      {
        let bun = chosen-bun()
        cond
          | String.length(bun) == 0 -> fail-spawn("bun")
          | else ->
            match (spawn(inter-argv(bun, file, has-show-result(), prog-args())))
              | Err(_) -> fail-spawn(bun)
              | Ok(st) -> exit(status-exit-code(st))
      }
    | else -> fail-cannot-read(file)

; ---------------------------------------------------------------------------
; Dispatch

; `check`, `build`, and `run` compile each module into `~/.menard` and
; reuse a fresh interface instead of parsing it again. `emit` stays a
; single flat bitcode file so the fixed-point gate can compare bytes.
let run-cached(file: Str, bin: Str, do-link: Bool, and-run: Bool) -> Unit =
  if (exists(file)) -> run-cached-existing(file, bin, do-link, and-run) | fail-cannot-read(file)

let run-cached-existing(file: Str, bin: Str, do-link: Bool, and-run: Bool) -> Unit {
  let cc = chosen-cc(opt("--cc"))
  let runtime = chosen-runtime(opt("--runtime"))
  match (build-program(file, has-clean(), false, cc, runtime, bin, do-link, has-quiet()))
    | Ok(out) ->
      cond
        | and-run -> run-built(out)
        | do-link ->
          {
            write-line(2, String.concat("wrote ", out))
            exit(0)
          }
        | else -> exit(0)
    | Err(msg) ->
      {
        if (String.length(msg) > 0) ->
          {
            write-line(2, String.concat("error: ", msg))
            ()
          }
        exit(1)
      }
}

let dispatch(mode: Str, file: Str, has-out: Bool, out: Str, bin: Str, dump-after-reader: Bool, dump-after-desugar: Bool, dump-after-type: Bool, dump-after-close: Bool, dump-after-root: Bool, dump-after-derive: Bool) -> Unit =
  cond
    | mode == "check" ->
      if (dump-after-reader || dump-after-desugar || dump-after-type || dump-after-close || dump-after-root || dump-after-derive) -> run-check(file, dump-after-reader, dump-after-desugar, dump-after-type, dump-after-close, dump-after-root, dump-after-derive) | run-cached(file, "", false, false)
    | mode == "emit" -> run-emit(file, has-out, out, dump-after-reader, dump-after-desugar, dump-after-type, dump-after-close, dump-after-root, dump-after-derive)
    | mode == "build" -> run-cached(file, bin, true, false)
    | mode == "run" ->
      run-cached(
        file,
        if (explicit-out()) -> bin | cache-bin(canonical-path(file)),
        true,
        true
      )
    | mode == "test" ->
      exit(
        run-suite(
          test-paths(),
          has-clean(),
          has-verbose(),
          has-show-output(),
          has-quiet(),
          chosen-cc(opt("--cc")),
          chosen-runtime(opt("--runtime"))
        )
      )
    | mode == "inter" -> run-inter(file)
    | else -> usage()

let main() -> Unit {
  let n = positional-count()
  let mode0 = positional-arg(0)
  cond
    | n >= 2 || n == 1 && mode0 == "test" ->
      {
        let mode = mode0
        let file =
          if (n >= 2) -> positional-arg(1) | ""
        let o-flag = opt("-o")
        let bin =
          if (String.length(o-flag) > 0) -> o-flag | default-bin(file)
        dispatch(
          mode,
          file,
          n >= 3,
          if (n >= 3) -> positional-arg(2) | "",
          bin,
          has-dump-after-reader(),
          has-dump-after-desugar(),
          has-dump-after-type(),
          has-dump-after-close(),
          has-dump-after-root(),
          has-dump-after-derive()
        )
      }
    | else -> usage()
}

; `mn test`. Discovers `*.test.mnd` beside source, and generates a
; module for every other `.mnd` that carries `@test`. Status lines are
; cwd-relative and sorted together. The runner binary is linked under
; `~/.menard`, never in the working tree.
;
; One line per file, then `N passed (…ms)` or `M failed, N passed (…ms)`.
; The suite is one binary and one process. A `file <path>` line on its
; stdout starts that file's pass/fail lines.
; Green and red only when stdout is a terminal and `NO_COLOR` is unset.

import "../diag/report.mnd"
import "../reader/ast.mnd"
import "../reader/read.mnd"
import "../cache/cache.mnd"
import "../cache/sep.mnd"
import "./doctest.mnd"
import std/console
import std/fs
import std/io
import std/list
import std/map as Map
import std/proc
import std/string as String
import std/test

let print-verbose(lines: List Str, on: Bool, show-output: Bool) -> Unit =
  match (lines)
    | [] -> ()
    | line :: rest ->
      {
        cond
          | String.starts-with("pass ", line) || String.starts-with("fail ", line) ->
            {
              write(stdout, "  ")
              write(
                stdout,
                if (String.starts-with("pass ", line)) -> paint(on, "[32m", line) | paint(on, "[31m", line)
              )
              write(stdout, "\n")
              ()
            }
          | show-output ->
            {
              write(stdout, "    ")
              write(stdout, line)
              write(stdout, "\n")
              ()
            }
        print-verbose(rest, on, show-output)
      }

; A passing file stays a single status line. A failure points at the
; assertion expression, the same way a compile error points at its span.
let fail-name(line: Str) -> Maybe Str =
  if (String.starts-with("fail ", line)) -> Some(String.slice(5, String.length(line) - 5, line)) | None()

let sym-text(a: Ast) -> Maybe Str =
  match (a)
    | SymNode(s, _) -> Some(s)
    | _ -> None()

let str-text(a: Ast) -> Maybe Str =
  match (a)
    | StrNode(s, _) -> Some(s)
    | _ -> None()

let list-head(xs: List Ast) -> Maybe Ast =
  match (xs)
    | h :: _ -> Some(h)
    | [] -> None()

let list-second(xs: List Ast) -> Maybe Ast =
  match (xs)
    | _ :: n :: _ -> Some(n)
    | _ -> None()

let third(xs: List Ast) -> Maybe Ast =
  match (xs)
    | _ :: _ :: e :: _ -> Some(e)
    | _ -> None()

let test-named(form: Ast, name: Str) -> Maybe Ast =
  match (form)
    | ParenNode(elems, _) ->
      match (list-head(elems))
        | Some(h) ->
          match (sym-text(h))
            | Some(s) ->
              cond
                | s == "test" ->
                  match (list-second(elems))
                    | Some(n) ->
                      match (str-text(n))
                        | Some(text) ->
                          if (text == name) -> third(elems) | None()
                        | None -> None()
                    | None -> None()
                | else -> None()
            | None -> None()
        | None -> None()
    | _ -> None()

let find-named(forms: List Ast, name: Str) -> Maybe Ast =
  match (forms)
    | [] -> None()
    | f :: rest ->
      match (test-named(f, name))
        | Some(expr) -> Some(expr)
        | None -> find-named(rest, name)

; The suite marker for a generated module is the generated path. The
; status line names it beside the source (`examples/sc.doctest.mnd`).
; Diagnostics still read the source the annotation was copied from.
let source-path(path: Str, originals: Map Str Str) -> Str =
  match (Map.lookup(path, originals))
    | Some(orig) -> orig
    | None -> path

let shown-path(path: Str, originals: Map Str Str) -> Str =
  match (Map.lookup(path, originals))
    | Some(orig) -> doctest-label(orig)
    | None -> path

let explain-one(path: Str, src: Str, shown: Str, original: Str, forms: List Ast, name: Str) -> Unit =
  match (find-named(forms, name))
    | Some(expr) ->
      {
        let sp = ast-span(expr)
        if (span-origin(sp) != 0) -> report-span(shown, original, sp, "error", "E_TEST", String.concat("assertion failed: ", name)) | report-span(path, src, sp, "error", "E_TEST", String.concat("assertion failed: ", name))
      }
    | None -> report-plain(String.concat("assertion failed: ", name))

let explain-fails(path: Str, src: Str, shown: Str, original: Str, forms: List Ast, lines: List Str) -> Unit =
  match (lines)
    | [] -> ()
    | line :: rest ->
      {
        match (fail-name(line))
          | Some(name) -> explain-one(path, src, shown, original, forms, name)
          | None -> ()
        explain-fails(path, src, shown, original, forms, rest)
      }

let explain-parsed(path: Str, src: Str, shown: Str, forms: List Ast, lines: List Str) -> Unit =
  if (shown == path) -> explain-fails(path, src, shown, src, forms, lines) | match (read-file(shown))
    | Ok(original) -> explain-fails(path, src, shown, original, forms, lines)
    | Err(_) -> explain-fails(path, src, path, src, forms, lines)

let explain-file(path: Str, lines: List Str, originals: Map Str Str) -> Unit =
  match (read-file(path))
    | Err(_) -> ()
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> ()
        | Ok(forms) -> explain-parsed(path, src, source-path(path, originals), forms, lines)

let file-line(path: Str, ok: Bool, on: Bool) -> Unit {
  write(stdout, path)
  write(stdout, " ... ")
  write(
    stdout,
    if (ok) -> paint(on, "[32m", "ok") | paint(on, "[31m", "FAILED")
  )
  write(stdout, "\n")
  ()
}

let rev-strs(xs: List Str, acc: List Str) -> List Str =
  match (xs)
    | [] -> acc
    | x :: rest -> rev-strs(rest, x :: acc)

; `file <path>` is printed by the suite bootstrap before that file's tests.
let file-path(line: Str) -> Maybe Str =
  if (String.starts-with("file ", line)) -> Some(String.slice(5, String.length(line) - 5, line)) | None()

record RunAcc {
  path: Str
  lines: List Str
  passed: Int
  failed: Int
}

; `exit-bad` is the process status, applied only to the file that was
; running when the process stopped. A panic aborts the rest of the suite.
let flush-file(path: Str, lines: List Str, verbose: Bool, show-output: Bool, on: Bool, exit-bad: Bool, originals: Map Str Str) -> Counts =
  cond
    | String.length(path) == 0 ->
      if (exit-bad) -> Counts(0, 1) | Counts(0, 0)
    | else ->
      {
        let ordered = rev-strs(lines, [])
        if (verbose || show-output) -> print-verbose(ordered, on, show-output)
        match (count-lines(ordered))
          | Counts(p, f) ->
            {
              let bad = f > 0 || exit-bad
              file-line(shown-path(path, originals), not(bad), on)
              if (f > 0) -> explain-file(path, ordered, originals)
              if (bad && f == 0) -> Counts(p, 1) | Counts(p, f)
            }
      }

let take-lines(lines: List Str, acc: RunAcc, verbose: Bool, show-output: Bool, on: Bool, originals: Map Str Str) -> RunAcc =
  match (lines)
    | [] -> acc
    | line :: rest ->
      match (acc)
        | RunAcc(path, buf, passed, failed) ->
          match (file-path(line))
            | Some(next) ->
              match (flush-file(path, buf, verbose, show-output, on, false, originals))
                | Counts(p, f) -> take-lines(rest, RunAcc(next, [], passed + p, failed + f), verbose, show-output, on, originals)
            | None -> take-lines(rest, RunAcc(path, line :: buf, passed, failed), verbose, show-output, on, originals)

let finish-acc(acc: RunAcc, verbose: Bool, show-output: Bool, on: Bool, exit-bad: Bool, err: Str, originals: Map Str Str) -> Counts =
  match (acc)
    | RunAcc(path, buf, passed, failed) ->
      {
        match (flush-file(path, buf, verbose, show-output, on, exit-bad, originals))
          | Counts(p, f) ->
            {
              cond
                | exit-bad && String.length(err) > 0 ->
                  {
                    write(stderr, err)
                    write(stderr, "\n")
                    ()
                  }
              Counts(passed + p, failed + f)
            }
      }

let report-suite-error(msg: Str, started: Int, on: Bool) -> Int {
  if (String.length(msg) > 0) -> report-plain(msg)
  summary(Counts(0, 1), now-ms() - started, on)
  1
}

let cat(xs: List Str, ys: List Str) -> List Str =
  match (xs)
    | [] -> ys
    | h :: t -> h :: cat(t, ys)

let case-files(cases: List DocCase) -> List Str =
  match (cases)
    | [] -> []
    | DocCase(gen, _) :: rest -> gen :: case-files(rest)

; A source that produced a generated module is run as that module.
let is-origin(p: Str, cases: List DocCase) -> Bool =
  match (cases)
    | [] -> false
    | DocCase(_, orig) :: rest -> same-path(p, orig) || is-origin(p, rest)

let without-origins(xs: List Str, cases: List DocCase) -> List Str =
  match (xs)
    | [] -> []
    | h :: t ->
      if (is-origin(h, cases)) -> without-origins(t, cases) | h :: without-origins(t, cases)

let originals-of(cases: List DocCase, acc: Map Str Str) -> Map Str Str =
  match (cases)
    | [] -> acc
    | DocCase(gen, orig) :: rest -> originals-of(rest, Map.set(gen, orig, acc))

record Gathered {
  files: List Str
  originals: Map Str Str
}

let same-path(a: Str, b: Str) -> Bool =
  canonical-path(a) == canonical-path(b)

let has-path(p: Str, xs: List Str) -> Bool =
  match (xs)
    | [] -> false
    | h :: t -> same-path(p, h) || has-path(p, t)

let cat-new(xs: List Str, ys: List Str) -> List Str =
  match (ys)
    | [] -> xs
    | h :: t ->
      if (has-path(h, xs)) -> cat-new(xs, t) | cat-new(snoc-str(xs, h), t)

let snoc-str(xs: List Str, x: Str) -> List Str =
  match (xs)
    | [] -> [x]
    | h :: t -> h :: snoc-str(t, x)

let join-sp(xs: List Str) -> Str =
  match (xs)
    | [] -> ""
    | h :: [] -> h
    | h :: t -> String.concat(h, String.concat(" ", join-sp(t)))

; The path as it should be printed: relative to the working directory,
; without a leading `./`.
let present(path: Str) -> Str =
  display-path(canonical-path(path))

let present-list(xs: List Str) -> List Str =
  match (xs)
    | [] -> []
    | h :: t -> present(h) :: present-list(t)

let gather(paths: List Str, got: Gathered) -> Result Gathered Str =
  match (paths)
    | [] -> Ok(got)
    | p :: rest ->
      match (prepare-doctests(p))
        | Err(_) -> Err("")
        | Ok(cases) ->
          match (got)
            | Gathered(files, originals) ->
              gather(rest, Gathered(cat-new(files, cat(without-origins(present-list(discover(p)), cases), case-files(cases))), originals-of(cases, originals)))

let run-files(path: Str, files: List Str, originals: Map Str Str, clean: Bool, verbose: Bool, show-output: Bool, quiet: Bool, cc: Str, runtime: Str) -> Int {
  let on = tty-color(1)
  let started = now-ms()
  match (build-suite(files, path, clean, cc, runtime, quiet))
    | Err(msg) -> report-suite-error(msg, started, on)
    | Ok(bin) ->
      match (spawn-capture([bin], ""))
        | Err(_) -> report-suite-error(String.concat("cannot spawn ", bin), started, on)
        | Ok(SpawnOutput(st, text, err)) ->
          {
            let exit-bad = status-exit-code(st) != 0
            let acc = take-lines(split-lines(text), RunAcc("", [], 0, 0), verbose, show-output, on, originals)
            let totals = finish-acc(acc, verbose, show-output, on, exit-bad, err, originals)
            summary(totals, now-ms() - started, on)
            match (totals)
              | Counts(_, f) ->
                if (f > 0) -> 1 | 0
          }
}

pub let run-suite(paths: List Str, clean: Bool, verbose: Bool, show-output: Bool, quiet: Bool, cc: Str, runtime: Str) -> Int {
  let roots =
    match (paths)
      | [] -> ["."]
      | _ -> paths
  match (gather(roots, Gathered([], Map.empty())))
    | Err(_) -> 1
    | Ok(got) ->
      match (got)
        | Gathered(files, originals) ->
          match (files)
            | [] ->
              {
                report-plain(String.concat("no tests found in ", join-sp(roots)))
                1
              }
            | _ :: _ ->
              run-files(
                join-sp(roots),
                sort-by(fn (p) = shown-path(p, originals), files),
                originals,
                clean,
                verbose,
                show-output,
                quiet,
                cc,
                runtime
              )
}

; `mn test`. Discovers `*.test.mnd` beside source, and any other
; `*.mnd` that contains a `(test …)` form. The runner binary is linked
; under `~/.menard`, never in the working tree.
;
; One line per file, then `N passed (…ms)` or `M failed, N passed (…ms)`.
; Green and red only when stdout is a terminal and `NO_COLOR` is unset.

(import "../diag/report.mnd")
(import "../reader/ast.mnd")
(import "../reader/read.mnd")
(import "../cache/cache.mnd")
(import "../cache/sep.mnd")
(import std/console)
(import std/fs)
(import std/io)
(import std/proc)
(import std/string)
(import std/test)

(defn nl -> Str
  (do
    (let sb (sb-new))
    (sb-append-byte! sb 10)
    (sb-take-str! sb)))

(defn print-verbose (lines: (List Str)) (on: Bool) -> Unit
  (match lines
    [] ()
    (Cons line rest)
      (do
        (if (or (starts-with line "pass ") (starts-with line "fail "))
          (do
            (write stdout "  ")
            (write stdout
              (if (starts-with line "pass ")
                (paint on "[32m" line)
                (paint on "[31m" line)))
            (write stdout (nl))
            ())
          ())
        (print-verbose rest on))))

; A passing file stays a single status line. A failure points at the
; assertion expression, the same way a compile error points at its span.
(defn fail-name (line: Str) -> (Maybe Str)
  (if (starts-with line "fail ")
    (Some (str-slice line 5 (- (str-byte-length line) 5)))
    (None)))

(defn sym-text (a: Ast) -> (Maybe Str)
  (match a (SymNode s _) (Some s) _ (None)))

(defn str-text (a: Ast) -> (Maybe Str)
  (match a (StrNode s _) (Some s) _ (None)))

(defn list-head (xs: (List Ast)) -> (Maybe Ast)
  (match xs (Cons h _) (Some h) [] (None)))

(defn list-second (xs: (List Ast)) -> (Maybe Ast)
  (match xs (Cons _ (Cons n _)) (Some n) _ (None)))

(defn third (xs: (List Ast)) -> (Maybe Ast)
  (match xs (Cons _ (Cons _ (Cons e _))) (Some e) _ (None)))

(defn test-named (form: Ast) (name: Str) -> (Maybe Ast)
  (match form
    (ParenNode elems _)
      (match (list-head elems)
        (Some h)
          (match (sym-text h)
            (Some s)
              (if (= s "test")
                (match (list-second elems)
                  (Some n)
                    (match (str-text n)
                      (Some text) (if (= text name) (third elems) (None))
                      (None) (None))
                  (None) (None))
                (None))
            (None) (None))
        (None) (None))
    _ (None)))

(defn find-named (forms: (List Ast)) (name: Str) -> (Maybe Ast)
  (match forms
    [] (None)
    (Cons f rest)
      (match (test-named f name)
        (Some expr) (Some expr)
        (None) (find-named rest name))))

(defn explain-one (path: Str) (src: Str) (forms: (List Ast)) (name: Str) -> Unit
  (match (find-named forms name)
    (Some expr)
      (report-span path src (ast-span expr) "error" "E_TEST"
        (str-concat "assertion failed: " name))
    (None) (report-plain (str-concat "assertion failed: " name))))

(defn explain-fails (path: Str) (src: Str) (forms: (List Ast)) (lines: (List Str)) -> Unit
  (match lines
    [] ()
    (Cons line rest)
      (do
        (match (fail-name line)
          (Some name) (explain-one path src forms name)
          (None) ())
        (explain-fails path src forms rest))))

(defn explain-file (path: Str) (lines: (List Str)) -> Unit
  (match (read-file path)
    (Err _) ()
    (Ok src)
      (match (read-all src)
        (Err _) ()
        (Ok forms) (explain-fails path src forms lines))))

(defn file-line (path: Str) (ok: Bool) (on: Bool) -> Unit
  (do
    (write stdout path)
    (write stdout " ... ")
    (write stdout (if ok (paint on "[32m" "ok") (paint on "[31m" "FAILED")))
    (write stdout (nl))
    ()))

(defn run-file (path: Str) (clean: Bool) (verbose: Bool) (quiet: Bool) (cc: Str) (runtime: Str) (on: Bool) -> Counts
  (do
    (let abs (canonical-path path))
    (let bin (cache-bin (str-concat abs "#test")))
    (match (build-program path clean true cc runtime bin true quiet)
      (Err msg)
        (do
          (if (> (str-byte-length msg) 0) (report-plain msg) ())
          (file-line path false on)
          (Counts 0 1))
      (Ok _)
        (match (spawn-capture [bin] "")
          (Err _)
            (do
              (file-line path false on)
              (Counts 0 1))
          (Ok (SpawnOutput st text err))
            (do
              (let lines (split-lines text))
              (if verbose (print-verbose lines on) ())
              (let counted (count-lines lines))
              (match counted
                (Counts p f)
                  (do
                    (let bad (or (> f 0) (not (= (status->exit-code st) 0))))
                    (file-line path (not bad) on)
                    (if (> f 0) (explain-file path lines) ())
                    (if (and bad (> (str-byte-length err) 0))
                      (do (write stderr err) (write stderr (nl)) ())
                      ())
                    (if (and bad (= f 0)) (Counts p 1) counted))))))))

(defn run-files (files: (List Str)) (clean: Bool) (verbose: Bool) (quiet: Bool) (cc: Str) (runtime: Str) (on: Bool) (acc: Counts) -> Counts
  (match files
    [] acc
    (Cons f rest)
      (match (run-file f clean verbose quiet cc runtime on)
        (Counts p fai)
          (match acc
            (Counts ap af) (run-files rest clean verbose quiet cc runtime on (Counts (+ ap p) (+ af fai)))))))

(pub defn run-suite (path: Str) (clean: Bool) (verbose: Bool) (quiet: Bool) (cc: Str) (runtime: Str) -> Int
  (do
    (let files (discover path))
    (match files
      []
        (do
          (report-plain (str-concat "no tests found in " path))
          1)
      (Cons _ _)
        (do
          (let on (tty-color 1))
          (let started (now-ms))
          (let totals (run-files files clean verbose quiet cc runtime on (Counts 0 0)))
          (summary totals (- (now-ms) started) on)
          (match totals (Counts _ f) (if (> f 0) 1 0))))))

; A repo-root path, found from the working directory or a parent.
; `./mn test` from `src/` still opens `tests/…` and `hello.mnd`.
import std/fs
import std/path as Path
import std/string as String

let find-up(rel: Str, dir: Str) -> Str {
  let candidate = Path.join(rel, dir)
  if (exists(candidate)) -> candidate |
  if (dir == "/") -> rel |
  {
    let up = Path.dirname(dir)
    if (up == dir) -> rel | find-up(rel, up)
  }
}

pub let project-file(path: Str) -> Str =
  if (Path.is-absolute(path)) -> path | if (exists(path)) -> path | find-up(path, Path.dirname(cwd()))

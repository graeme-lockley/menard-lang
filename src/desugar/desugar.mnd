; Desugar — expands `and`/`or`/`cond`/`when`/`while` into `if`/`do`/`loop`/
; `recur`, `[e1 e2 …]` / `[]` into a `Cons`/`Nil` chain, and open-arity
; calls of `+` `*` `f+` `f*` `-` `f-` `/` `f/` `<` `>` `<=`
; `>=` `=` into the binary intrinsics (see the sections below). A bracket
; list in a `defn`/`defrec`/`variant`/`runtime` name form is a type-parameter list
; and is left alone. Mirrors host/src/desugar/desugar.ts.
;
; The host threads a single mutable `Diagnostic[]` accumulator through every
; recursive call so a form can keep producing *some* output even after an
; error (e.g. an empty `(cond)` still desugars its (non-existent) clauses
; and reports one diagnostic, rather than aborting the whole pass). The
; idiomatic Menard substitute for that shared mutable array is a
; `(Ref (List DesugarError))` accumulator, threaded the same way `read.mnd`
; threads `(Ref Int)` for the reader's scan position: every helper appends
; to it with `set!` instead of returning a growing `Result` chain.
;
; Diagnostics are pushed most-recent-first (an ordinary `Cons` prepend), so
; the two entry points below reverse the final list once to restore the
; host's chronological (first-error-first) order.

import "../reader/ast.mnd"
import std/string as String

pub record DesugarError {
  span: Span
  code: Str
  message: Str
}

; ---------------------------------------------------------------------------
; Diagnostic accumulator

let push-diag!(diags: Ref (List DesugarError), sp: Span, code: Str, message: Str) -> Unit =
  set!(diags, DesugarError(sp, code, message) :: deref(diags))

let reverse-onto(xs: List DesugarError, acc: List DesugarError) -> List DesugarError =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-onto(rest, x :: acc)

let reverse-diags(xs: List DesugarError) -> List DesugarError =
  reverse-onto(xs, [])

; ---------------------------------------------------------------------------
; Small Ast builders

let mk-sym(name: Str, sp: Span) -> Ast =
  SymNode(name, sp)

let is-sym(ast: Ast, name: Str) -> Bool =
  match (ast)
    | SymNode(n, _) -> n == name
    | _ -> false

let elems-tail(elems: List Ast) -> List Ast =
  match (elems)
    | [] -> []
    | _ :: rest -> rest

let append-list(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-list(rest, ys)

; `(do body…)` when there is more than one body form, `body[0]` when there
; is exactly one, or Unit `()` when there is none. Shared by cond/when.
let wrap-do(body: List Ast, sp: Span) -> Ast =
  match (body)
    | [] -> ParenNode([], sp)
    | [b] -> b
    | _ -> ParenNode(mk-sym("do", sp) :: body, sp)

; ---------------------------------------------------------------------------
; Recursive descent

let map-desugar(elems: List Ast, diags: Ref (List DesugarError)) -> List Ast =
  match (elems)
    | [] -> []
    | x :: rest -> desugar-node(x, diags) :: map-desugar(rest, diags)

; `[e …]` → `(Cons e … (Nil))`. `[]` → `(Nil)`.
let cons-chain(elems: List Ast, sp: Span) -> Ast =
  match (elems)
    | [] -> ParenNode([mk-sym("Nil", sp)], sp)
    | e :: rest -> ParenNode([mk-sym("Cons", sp), e, cons-chain(rest, sp)], sp)

let is-decl-keyword(ast: Ast) -> Bool =
  match (ast)
    | SymNode(n, _) -> n == "defn" || n == "defrec" || n == "variant" || n == "runtime"
    | _ -> false

; `(name [params…])` — the bracket list is type parameters.
let desugar-name-form(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | name :: BracketNode(ps, psp) :: rest -> ParenNode(desugar-node(name, diags) :: BracketNode(map-desugar(ps, diags), psp) :: map-desugar(rest, diags), sp)
    | _ -> ParenNode(map-desugar(elems, diags), sp)

let desugar-maybe-name(name: Ast, diags: Ref (List DesugarError)) -> Ast =
  match (name)
    | ParenNode(elems, sp) -> desugar-name-form(elems, sp, diags)
    | _ -> desugar-node(name, diags)

let desugar-decl(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | kw :: name :: rest -> ParenNode(desugar-node(kw, diags) :: desugar-maybe-name(name, diags) :: map-desugar(rest, diags), sp)
    | _ -> ParenNode(map-desugar(elems, diags), sp)

; A top-level `defn`'s `(param pat ty)` parameters can't reach the typer
; or lowerer as-is (nothing downstream destructures a param list entry),
; so each becomes a synthetic `__p{i}` name and the body is wrapped in a
; `match __p{i} pat …` for it — the desugar-time counterpart to
; `read.mnd`'s `local-fn-let`, which does the same thing at parse time
; for a *nested* local `let f(...)=…` (mirrors host's `desugarDefn`).
record ParamWrap {
  pname: Ast
  pat: Ast
}

record ArrowSplit {
  params: List Ast
  after: List Ast
}

let split-defn-at-arrow(elems: List Ast) -> ArrowSplit =
  match (elems)
    | [] -> ArrowSplit([], [])
    | e :: rest ->
      if (is-sym(e, "->")) -> ArrowSplit([], e :: rest) | split-defn-at-arrow-cons(e, rest)

let split-defn-at-arrow-cons(e: Ast, rest: List Ast) -> ArrowSplit =
  match (split-defn-at-arrow(rest))
    | ArrowSplit(params, after) -> ArrowSplit(e :: params, after)

record ParamSplit {
  params: List Ast
  wraps: List ParamWrap
}

let split-defn-params(params: List Ast, i: Int) -> ParamSplit =
  match (params)
    | [] -> ParamSplit([], [])
    | p :: rest -> split-defn-param-one(p, i, rest)

let split-defn-param-one(p: Ast, i: Int, rest: List Ast) -> ParamSplit =
  match (p)
    | ParenNode([SymNode("param", psp), pat, ty], _) -> split-defn-param-wrap(psp, pat, ty, i, rest)
    | _ -> split-defn-param-plain(p, i, rest)

let split-defn-param-wrap(psp: Span, pat: Ast, ty: Ast, i: Int, rest: List Ast) -> ParamSplit =
  match (split-defn-params(rest, i + 1))
    | ParamSplit(ps, ws) -> ParamSplit(ParenNode([SymNode(String.concat("__p", show(i), ":"), psp), ty], psp) :: ps, ParamWrap(SymNode(String.concat("__p", show(i)), psp), pat) :: ws)

let split-defn-param-plain(p: Ast, i: Int, rest: List Ast) -> ParamSplit =
  match (split-defn-params(rest, i + 1))
    | ParamSplit(ps, ws) -> ParamSplit(p :: ps, ws)

let wrap-defn-body-with(wraps: List ParamWrap, body: Ast, sp: Span) -> Ast =
  match (wraps)
    | [] -> body
    | ParamWrap(pname, pat) :: rest -> ParenNode([mk-sym("match", sp), pname, pat, wrap-defn-body-with(rest, body, sp)], sp)

let desugar-defn-wraps(defn-sym: Ast, name-ast: Ast, new-params: List Ast, wraps: List ParamWrap, arrow-sym: Ast, ret: Ast, body-forms: List Ast, sp: Span) -> Ast =
  match (wraps)
    | [] -> ParenNode(append-list(defn-sym :: name-ast :: new-params, arrow-sym :: ret :: body-forms), sp)
    | _ -> ParenNode(append-list(defn-sym :: name-ast :: new-params, [arrow-sym, ret, wrap-defn-body-with(wraps, wrap-do(body-forms, sp), sp)]), sp)

let desugar-defn-after(defn-sym: Ast, name-ast: Ast, params: List Ast, after: List Ast, sp: Span) -> Ast =
  match (after)
    | arrow-sym :: ret :: body-forms -> desugar-defn-split-params(defn-sym, name-ast, params, arrow-sym, ret, body-forms, sp)
    | _ -> ParenNode(append-list(defn-sym :: name-ast :: params, after), sp)

let desugar-defn-split-params(defn-sym: Ast, name-ast: Ast, params: List Ast, arrow-sym: Ast, ret: Ast, body-forms: List Ast, sp: Span) -> Ast =
  match (split-defn-params(params, 0))
    | ParamSplit(new-params, wraps) -> desugar-defn-wraps(defn-sym, name-ast, new-params, wraps, arrow-sym, ret, body-forms, sp)

let desugar-defn-body(defn-sym: Ast, name-ast: Ast, rest: List Ast, sp: Span) -> Ast =
  match (split-defn-at-arrow(rest))
    | ArrowSplit(params, after) -> desugar-defn-after(defn-sym, name-ast, params, after, sp)

; `desugar-decl` already runs the usual recursive desugar over the name
; and every param/body form; the param-pattern rewrite above only needs
; to happen afterwards, on its already-desugared result.
let desugar-defn(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-defn-maybe-wrap(desugar-decl(elems, sp, diags))

; A bare `_` (not a named catch-all) is what the exhaustiveness checker
; recognizes as covering the rest of the `Ast` variant — `d` is still
; reachable here via the outer parameter, not the match pattern.
let desugar-defn-maybe-wrap(d: Ast) -> Ast =
  match (d)
    | ParenNode(defn-sym :: name-ast :: rest, bsp) -> desugar-defn-body(defn-sym, name-ast, rest, bsp)
    | _ -> d

; `(fn (param PAT T | tuple … | name) …)` — same synthetic `__p{i}` + match
; wrap as `desugar-defn`, so close/eval only see bare or typed names.
record FnParamSplit {
  params: List Ast
  wraps: List ParamWrap
}

let split-fn-params(params: List Ast, i: Int) -> FnParamSplit =
  match (params)
    | [] -> FnParamSplit([], [])
    | p :: rest -> split-fn-param-one(p, i, rest)

let split-fn-param-one(p: Ast, i: Int, rest: List Ast) -> FnParamSplit =
  match (p)
    | ParenNode([SymNode("param", psp), pat, ty], _) -> split-fn-param-ann(psp, pat, ty, i, rest)
    | ParenNode(SymNode("tuple", _) :: _, psp) -> split-fn-param-tuple(p, psp, i, rest)
    | _ -> split-fn-param-plain(p, i, rest)

let split-fn-param-ann(psp: Span, pat: Ast, ty: Ast, i: Int, rest: List Ast) -> FnParamSplit =
  match (split-fn-params(rest, i + 1))
    | FnParamSplit(ps, ws) ->
      FnParamSplit(
        ParenNode([SymNode(String.concat("__p", show(i), ":"), psp), ty], psp) :: ps,
        ParamWrap(SymNode(String.concat("__p", show(i)), psp), pat) :: ws
      )

let split-fn-param-tuple(pat: Ast, psp: Span, i: Int, rest: List Ast) -> FnParamSplit =
  match (split-fn-params(rest, i + 1))
    | FnParamSplit(ps, ws) ->
      FnParamSplit(
        SymNode(String.concat("__p", show(i)), psp) :: ps,
        ParamWrap(SymNode(String.concat("__p", show(i)), psp), pat) :: ws
      )

let split-fn-param-plain(p: Ast, i: Int, rest: List Ast) -> FnParamSplit =
  match (split-fn-params(rest, i + 1))
    | FnParamSplit(ps, ws) -> FnParamSplit(p :: ps, ws)

let desugar-fn-build(fn-sym: Ast, params-sp: Span, new-params: List Ast, wraps: List ParamWrap, ret: Maybe Ast, body: Ast, sp: Span) -> Ast =
  match (ret)
    | Some(r) ->
      ParenNode([fn-sym, ParenNode(new-params, params-sp), mk-sym("->", sp), r, wrap-defn-body-with(wraps, body, sp)], sp)
    | None ->
      ParenNode([fn-sym, ParenNode(new-params, params-sp), wrap-defn-body-with(wraps, body, sp)], sp)

let desugar-fn-with(fn-sym: Ast, params-ast: Ast, ret: Maybe Ast, body: Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (params-ast)
    | ParenNode(pelems, psp) ->
      match (split-fn-params(map-desugar(pelems, diags), 0))
        | FnParamSplit(new-params, wraps) -> desugar-fn-build(fn-sym, psp, new-params, wraps, ret, body, sp)
    | _ -> ParenNode([fn-sym, desugar-node(params-ast, diags), body], sp)

let desugar-fn(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | fn-sym :: params-ast :: SymNode("->", _) :: ret :: [body] ->
      desugar-fn-with(desugar-node(fn-sym, diags), params-ast, Some(desugar-node(ret, diags)), desugar-node(body, diags), sp, diags)
    | fn-sym :: params-ast :: [body] ->
      desugar-fn-with(desugar-node(fn-sym, diags), params-ast, None(), desugar-node(body, diags), sp, diags)
    | _ -> ParenNode(map-desugar(elems, diags), sp)

let desugar-pub(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | pub-kw :: kw :: name :: rest ->
      cond
        | is-sym(kw, "defn") -> desugar-pub-defn(pub-kw, kw, name, rest, sp, diags)
        | is-decl-keyword(kw) -> ParenNode(desugar-node(pub-kw, diags) :: desugar-node(kw, diags) :: desugar-maybe-name(name, diags) :: map-desugar(rest, diags), sp)
        | else -> ParenNode(map-desugar(elems, diags), sp)
    | _ -> ParenNode(map-desugar(elems, diags), sp)

let desugar-pub-defn(pub-kw: Ast, kw: Ast, name: Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-pub-defn-wrap(pub-kw, desugar-defn(kw :: name :: rest, sp, diags), diags, sp)

let desugar-pub-defn-wrap(pub-kw: Ast, d: Ast, diags: Ref (List DesugarError), sp: Span) -> Ast =
  match (d)
    | ParenNode(delems, _) -> ParenNode(desugar-node(pub-kw, diags) :: delems, sp)
    | _ -> d

let desugar-node(ast: Ast, diags: Ref (List DesugarError)) -> Ast =
  match (ast)
    | ParenNode(elems, sp) -> desugar-paren(elems, sp, diags)
    | BracketNode(elems, sp) -> cons-chain(map-desugar(elems, diags), sp)
    | _ -> ast

let desugar-paren(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | [] -> ParenNode([], sp)
    | head :: _ -> desugar-paren-head(head, elems, sp, diags)

let desugar-paren-head(head: Ast, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (head)
    | SymNode(name, _) -> desugar-paren-named(name, elems, sp, diags)
    | _ -> ParenNode(map-desugar(elems, diags), sp)

let desugar-paren-named(name: Str, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  cond
    | name == "defn" -> desugar-defn(elems, sp, diags)
    | name == "fn" || name == "lambda" -> desugar-fn(elems, sp, diags)
    | name == "defrec" || name == "variant" || name == "runtime" -> desugar-decl(elems, sp, diags)
    | name == "pub" -> desugar-pub(elems, sp, diags)
    | name == "and" -> desugar-and(elems, sp, diags)
    | name == "or" -> desugar-or(elems, sp, diags)
    | name == "cond" -> desugar-cond(elems, sp, diags)
    | name == "when" -> desugar-when(elems, sp, diags)
    | name == "while" -> desugar-while(elems, sp, diags)
    | name == "|>" -> desugar-pipe(elems, sp, diags)
    | name == "?" -> desugar-ques(elems, sp, diags)
    | name == "map-lit" -> desugar-map-lit(elems, sp, diags)
    | name == "mmatch" -> desugar-mmatch(elems, sp, diags)
    | else -> desugar-operator(name, elems, sp, diags)

; ---------------------------------------------------------------------------
; `(|> x f(a))` → `f(a, x)`. The right-hand side must be a call.

let snoc-ast(xs: List Ast, x: Ast) -> List Ast =
  match (xs)
    | [] -> [x]
    | h :: t -> h :: snoc-ast(t, x)

let pipe-blocked(n: Str) -> Bool =
  n == "project" || n == "if" || n == "do" || n == "cond" || n == "when" || n == "match" || n == "mmatch" || n == "fn" || n == "let" || n == "loop" || n == "while" || n == "and" || n == "or" || n == "quote" || n == "char" || n == "Cons" || n == "Nil" || n == "tuple" || n == "+" || n == "-" || n == "*" || n == "/" || n == "%" || n == "<" || n == ">" || n == "<=" || n == ">=" || n == "=" || n == "|>" || n == "f+" || n == "f-" || n == "f*" || n == "f/" || n == "::"

let pipe-callee-ok(head: Ast) -> Bool =
  match (head)
    | SymNode(n, _) -> not(pipe-blocked(n))
    | ParenNode(_, _) -> true
    | _ -> false

let pipe-call(ast: Ast) -> Bool =
  match (ast)
    | ParenNode(h :: _, _) -> pipe-callee-ok(h)
    | _ -> false

let is-map-lit(ast: Ast) -> Bool =
  match (ast)
    | ParenNode(h :: _, _) -> is-sym(h, "map-lit")
    | _ -> false

let desugar-pipe(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | _ :: lhs :: rhs :: [] ->
      if (is-map-lit(rhs)) -> {
        push-diag!(diags, sp, "E_DESUGAR_PIPE", "pipe expects a call")
        ParenNode([mk-sym("|>", sp), desugar-node(lhs, diags), desugar-node(rhs, diags)], sp)
      } | {
        let left = desugar-node(lhs, diags)
        let right = desugar-node(rhs, diags)
        if (pipe-call(right)) -> pipe-append(right, left) | {
          push-diag!(diags, sp, "E_DESUGAR_PIPE", "pipe expects a call")
          ParenNode([mk-sym("|>", sp), left, right], sp)
        }
      }
    | _ ->
      {
        push-diag!(diags, sp, "E_DESUGAR_ARITY", "|> expects a value and a call")
        ParenNode(map-desugar(elems, diags), sp)
      }

let pipe-append(call: Ast, arg: Ast) -> Ast =
  match (call)
    | ParenNode(elems, sp) -> ParenNode(snoc-ast(elems, arg), sp)
    | _ -> call

; Keep `(? lhs rhs)`; the typer rewrites Maybe/Result to a short-circuiting match.

let desugar-ques(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | _ :: lhs :: rhs :: [] ->
      ParenNode([mk-sym("?", sp), desugar-node(lhs, diags), desugar-node(rhs, diags)], sp)
    | _ ->
      {
        push-diag!(diags, sp, "E_DESUGAR_ARITY", "? expects a Maybe or Result and a default")
        ParenNode(map-desugar(elems, diags), sp)
      }

; `(map-lit entry…)` folds onto `(map-new)`. A pair is `map-set`. A spread merges once.

let desugar-map-lit(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-map-entries(elems-tail(elems), ParenNode([mk-sym("map-new", sp)], sp), sp, diags)

let desugar-map-entries(entries: List Ast, acc: Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (entries)
    | [] -> acc
    | e :: rest -> desugar-map-entries(rest, desugar-map-entry(e, acc, sp, diags), sp, diags)

let desugar-map-entry(entry: Ast, acc: Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (entry)
    | ParenNode(head :: k :: v :: [], _) ->
      if (is-sym(head, "=>")) -> ParenNode([mk-sym("map-set", sp), acc, desugar-node(k, diags), desugar-node(v, diags)], sp) | desugar-map-bad(entry, acc, diags)
    | ParenNode(head :: expr :: [], _) ->
      if (is-sym(head, "...")) -> desugar-map-spread(acc, desugar-node(expr, diags), sp) | desugar-map-bad(entry, acc, diags)
    | _ -> desugar-map-bad(entry, acc, diags)

let desugar-map-bad(entry: Ast, acc: Ast, diags: Ref (List DesugarError)) -> Ast {
  push-diag!(diags, ast-span(entry), "E_DESUGAR_MAP", "map entry must be a pair or a spread")
  acc
}

; The base and the spread are bound before the loop, so neither expression sees the loop names.

let desugar-map-spread(base: Ast, src: Ast, sp: Span) -> Ast {
  let base-name = mk-sym("mn-map-base", sp)
  let src-name = mk-sym("mn-map-src", sp)
  let acc-name = mk-sym("mn-map-acc", sp)
  let ks-name = mk-sym("mn-map-ks", sp)
  let key-name = mk-sym("mn-map-k", sp)
  let rest-name = mk-sym("mn-map-rest", sp)
  let val-name = mk-sym("mn-map-v", sp)
  let recur-some = ParenNode([mk-sym("recur", sp), ParenNode([mk-sym("map-set", sp), acc-name, key-name, val-name], sp), rest-name], sp)
  let recur-none = ParenNode([mk-sym("recur", sp), acc-name, rest-name], sp)
  let inner = ParenNode([mk-sym("match", sp), ParenNode([mk-sym("map-get", sp), src-name, key-name], sp), ParenNode([mk-sym("Some", sp), val-name], sp), recur-some, ParenNode([mk-sym("None", sp)], sp), recur-none], sp)
  let outer = ParenNode([mk-sym("match", sp), ks-name, ParenNode([mk-sym("Nil", sp)], sp), acc-name, ParenNode([mk-sym("Cons", sp), key-name, rest-name], sp), inner], sp)
  let loop-form = ParenNode([mk-sym("loop", sp), ParenNode([ParenNode([acc-name, base-name], sp), ParenNode([ks-name, ParenNode([mk-sym("map-keys", sp), src-name], sp)], sp)], sp), outer], sp)
  let inner-let = ParenNode([mk-sym("let", sp), src-name, src, loop-form], sp)
  ParenNode([mk-sym("let", sp), base-name, base, inner-let], sp)
}

; ---------------------------------------------------------------------------
; (and) → true; (and x) → x; (and x y …) → (if x (and y …) false)

let desugar-and(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-and-args(elems-tail(elems), sp, diags)

let desugar-and-args(args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | [] -> BoolNode(true, sp)
    | [x] -> desugar-node(x, diags)
    | x :: rest -> desugar-and-rest(x, rest, sp, diags)

let desugar-and-rest(x: Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  let rest-form = ParenNode(mk-sym("and", sp) :: rest, sp)
  desugar-node(ParenNode([mk-sym("if", sp), x, rest-form, BoolNode(false, sp)], sp), diags)
}

; ---------------------------------------------------------------------------
; (or) → false; (or x) → x; (or x y …) → (if x x (or y …))

let desugar-or(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-or-args(elems-tail(elems), sp, diags)

let desugar-or-args(args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | [] -> BoolNode(false, sp)
    | [x] -> desugar-node(x, diags)
    | x :: rest -> desugar-or-rest(x, rest, sp, diags)

let desugar-or-rest(x: Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  let dx = desugar-node(x, diags)
  let drest = desugar-node(ParenNode(mk-sym("or", sp) :: rest, sp), diags)
  ParenNode([mk-sym("if", sp), dx, dx, drest], sp)
}

; ---------------------------------------------------------------------------
; Open-arity calls. Two arguments stay the binary intrinsic. More than two
; left-fold into that intrinsic (`/` and the comparisons require two).
; One argument of `+`/`*`/`f+`/`f*` is the argument itself.
; One argument of `-`/`f-` is negation. A chain `(< a b c)` is
; `(and (< a b) (< b c))`, so each middle operand is evaluated twice.

let is-fold-op(name: Str) -> Bool =
  name == "+" || name == "*" || name == "f+" || name == "f*"

let is-sub-op(name: Str) -> Bool =
  name == "-" || name == "f-"

let is-div-op(name: Str) -> Bool =
  name == "/" || name == "f/"

let is-cmp-op(name: Str) -> Bool =
  name == "<" || name == ">" || name == "<=" || name == ">=" || name == "="

let desugar-operator(name: Str, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  cond
    | is-fold-op(name) -> desugar-fold(name, elems, sp, diags)
    | is-sub-op(name) -> desugar-sub(name, elems, sp, diags)
    | is-div-op(name) -> desugar-div(name, elems, sp, diags)
    | is-cmp-op(name) -> desugar-cmp(name, elems, sp, diags)
    | else -> ParenNode(map-desugar(elems, diags), sp)

let desugar-arity-fail(name: Str, how: Str, fallback: Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  push-diag!(diags, sp, "E_DESUGAR_ARITY", String.concat(name, " expects ", how))
  fallback
}

let binary-call(name: Str, a: Ast, b: Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  ParenNode([mk-sym(name, sp), desugar-node(a, diags), desugar-node(b, diags)], sp)

let fold-bin(name: Str, acc: Ast, rest: List Ast, sp: Span) -> Ast =
  match (rest)
    | [] -> acc
    | b :: more -> fold-bin(name, ParenNode([mk-sym(name, sp), acc, b], sp), more, sp)

let desugar-folded(name: Str, args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | a :: rest -> desugar-node(fold-bin(name, a, rest, sp), diags)
    | [] -> ParenNode([mk-sym(name, sp)], sp)

let desugar-fold(name: Str, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-fold-args(name, elems-tail(elems), sp, diags)

let desugar-fold-args(name: Str, args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | [] -> desugar-arity-fail(name, "at least 1 argument", ParenNode([mk-sym(name, sp)], sp), sp, diags)
    | [a] -> desugar-node(a, diags)
    | [a, b] -> binary-call(name, a, b, sp, diags)
    | _ -> desugar-folded(name, args, sp, diags)

let sub-zero(name: Str, sp: Span) -> Ast =
  if (name == "f-") -> FloatNode("0.0", sp) | IntNode(0, sp)

let desugar-sub(name: Str, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-sub-args(name, elems-tail(elems), sp, diags)

let desugar-sub-args(name: Str, args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | [] -> desugar-arity-fail(name, "at least 1 argument", ParenNode([mk-sym(name, sp)], sp), sp, diags)
    | [a] -> desugar-node(ParenNode([mk-sym(name, sp), sub-zero(name, sp), a], sp), diags)
    | [a, b] -> binary-call(name, a, b, sp, diags)
    | _ -> desugar-folded(name, args, sp, diags)

let desugar-div(name: Str, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-div-args(name, elems-tail(elems), sp, diags)

let desugar-div-args(name: Str, args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | [] -> desugar-arity-fail(name, "at least 2 arguments", ParenNode([mk-sym(name, sp)], sp), sp, diags)
    | [a] -> desugar-arity-fail(name, "at least 2 arguments", ParenNode([mk-sym(name, sp), a], sp), sp, diags)
    | [a, b] -> binary-call(name, a, b, sp, diags)
    | _ -> desugar-folded(name, args, sp, diags)

let cmp-pairs(name: Str, args: List Ast, sp: Span) -> List Ast =
  match (args)
    | a :: b :: rest -> ParenNode([mk-sym(name, sp), a, b], sp) :: cmp-pairs(name, b :: rest, sp)
    | _ -> []

let desugar-cmp(name: Str, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-cmp-args(name, elems-tail(elems), sp, diags)

let desugar-cmp-args(name: Str, args: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (args)
    | [] -> desugar-arity-fail(name, "at least 2 arguments", ParenNode([mk-sym(name, sp)], sp), sp, diags)
    | [a] -> desugar-arity-fail(name, "at least 2 arguments", ParenNode([mk-sym(name, sp), a], sp), sp, diags)
    | [a, b] -> binary-call(name, a, b, sp, diags)
    | _ -> desugar-node(ParenNode(mk-sym("and", sp) :: cmp-pairs(name, args, sp), sp), diags)

; ---------------------------------------------------------------------------
; (cond (test e…) … (else e…)) → nested (if test (do e…) …)

let cond-no-match(sp: Span) -> Ast =
  ParenNode([mk-sym("panic", sp), StrNode("cond: no match", sp)], sp)

let desugar-cond(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  desugar-cond-dispatch(elems-tail(elems), elems, sp, diags)

let desugar-cond-dispatch(clauses: List Ast, elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (clauses)
    | [] ->
      {
        push-diag!(diags, sp, "E_DESUGAR_COND_EMPTY", "cond requires at least one clause")
        ParenNode(elems, sp)
      }
    | _ -> desugar-cond-clauses(clauses, sp, diags)

let desugar-cond-clauses(clauses: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (clauses)
    | [] -> cond-no-match(sp)
    | first :: rest -> desugar-cond-clause(first, rest, sp, diags)

let desugar-cond-clause(first: Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (first)
    | ParenNode(felems, fsp) -> desugar-cond-clause-elems(first, felems, fsp, rest, sp, diags)
    | _ ->
      {
        push-diag!(diags, ast-span(first), "E_DESUGAR_COND_CLAUSE", "cond clause must be a list (test exprs...)")
        first
      }

let desugar-cond-clause-elems(first: Ast, felems: List Ast, fsp: Span, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (felems)
    | [] ->
      {
        push-diag!(diags, fsp, "E_DESUGAR_COND_CLAUSE", "cond clause must be a list (test exprs...)")
        first
      }
    | test :: body -> desugar-cond-test(test, body, rest, sp, diags)

let desugar-cond-test(test: Ast, body: List Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  if (is-sym(test, "else")) -> desugar-cond-else(test, body, rest, sp, diags) | desugar-cond-if(test, body, rest, sp, diags)

let desugar-cond-else(test: Ast, body: List Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  match (rest)
    | [] -> ()
    | _ :: _ -> push-diag!(diags, ast-span(test), "E_DESUGAR_COND_ELSE", "else must be the last cond clause")
  desugar-cond-else-body(body, sp, diags)
}

let desugar-cond-else-body(body: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (body)
    | [] -> ParenNode([], sp)
    | [b] -> desugar-node(b, diags)
    | _ -> desugar-node(ParenNode(mk-sym("do", sp) :: body, sp), diags)

let desugar-cond-if(test: Ast, body: List Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  let then-expr = wrap-do(body, sp)
  let else-expr = desugar-cond-clauses(rest, sp, diags)
  desugar-node(ParenNode([mk-sym("if", sp), test, then-expr, else-expr], sp), diags)
}

; ---------------------------------------------------------------------------
; (when test body…) → (if test (do body…) ())

let desugar-when(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | _ :: test :: body -> desugar-when-body(test, body, sp, diags)
    | _ ->
      {
        push-diag!(diags, sp, "E_DESUGAR_WHEN", "when requires a test and optional body")
        ParenNode(elems, sp)
      }

let desugar-when-body(test: Ast, body: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  let then-expr = wrap-do(body, sp)
  desugar-node(ParenNode([mk-sym("if", sp), test, then-expr, ParenNode(Nil(), sp)], sp), diags)
}

; ---------------------------------------------------------------------------
; (while test body…) → (loop () (if test (do body… (recur)) ()))

let desugar-while(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | _ :: test :: body -> desugar-while-body(test, body, sp, diags)
    | _ ->
      {
        push-diag!(diags, sp, "E_DESUGAR_WHILE", "while requires a test")
        ParenNode(elems, sp)
      }

let while-body-do(body: List Ast, recur-form: Ast, sp: Span) -> Ast =
  match (body)
    | [] -> recur-form
    | _ -> ParenNode(mk-sym("do", sp) :: append-list(body, [recur-form]), sp)

let desugar-while-body(test: Ast, body: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast {
  let recur-form = ParenNode([mk-sym("recur", sp)], sp)
  let body-do = while-body-do(body, recur-form, sp)
  let if-form = ParenNode([mk-sym("if", sp), test, body-do, ParenNode(Nil(), sp)], sp)
  desugar-node(ParenNode([mk-sym("loop", sp), ParenNode(Nil(), sp), if-form], sp), diags)
}

; ---------------------------------------------------------------------------
; Match on several values. No tuple is built: each scrutinee becomes a
; nested match, grouped by constructor so a later arm of the same
; constructor stays reachable. Mirrors host/src/desugar/desugar.ts.

record MArm {
  pats: List Ast
  body: Ast
  guard: Maybe Ast
}

record Arm1 {
  pat: Ast
  body: Ast
  guard: Maybe Ast
}

record BoundArm {
  body: Ast
  guard: Maybe Ast
}

type PatKind =
  | AnyPat
  | CtorPat(Str, List Ast, Ast)

record Sample {
  name: Str
  count: Int
  pattern: Ast
}

record Classed {
  arm: MArm
  kind: PatKind
}

let desugar-mmatch(elems: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (elems)
    | _ :: scrut-list :: rest -> desugar-mmatch-scruts(scrut-list, rest, sp, diags)
    | _ ->
      {
        push-diag!(diags, sp, "E_DESUGAR_MATCH", "match requires scrutinees")
        ParenNode(elems, sp)
      }

let desugar-mmatch-scruts(scrut-list: Ast, rest: List Ast, sp: Span, diags: Ref (List DesugarError)) -> Ast =
  match (scrut-list)
    | ParenNode(ss, _) ->
      {
        let scruts = map-desugar(ss, diags)
        let arms = take-m-arms(rest, ast-count(scruts), diags)
        compile-multi(scruts, arms, ref(0), ref(0), sp)
      }
    | _ ->
      {
        push-diag!(diags, sp, "E_DESUGAR_MATCH", "match requires scrutinees")
        ParenNode([mk-sym("mmatch", sp), scrut-list], sp)
      }

let ast-count(xs: List Ast) -> Int =
  match (xs)
    | [] -> 0
    | _ :: rest -> ast-count(rest) + 1

let take-m-arms(xs: List Ast, n: Int, diags: Ref (List DesugarError)) -> List MArm =
  match (xs)
    | node :: body :: rest -> take-m-arm(node, desugar-node(body, diags), rest, n, diags)
    | _ -> []

let take-m-arm-len(pats: List Ast, body: Ast, rest: List Ast, n: Int, guard: Maybe Ast, diags: Ref (List DesugarError)) -> List MArm =
  if (ast-count(pats) != n) -> take-m-arm-bad(pats, rest, n, diags) | MArm(map-desugar(pats, diags), body, guard) :: take-m-arms(rest, n, diags)

let take-m-arm-bad(pats: List Ast, rest: List Ast, n: Int, diags: Ref (List DesugarError)) -> List MArm {
  push-diag!(diags, ast-span(first-or-unit(pats)), "E_DESUGAR_MATCH", String.concat("pattern has ", show(ast-count(pats)), " parts, match has ", show(n)))
  take-m-arms(rest, n, diags)
}

let first-or-unit(xs: List Ast) -> Ast =
  match (xs)
    | [] -> ParenNode([], Span(0, 0, 0, 0))
    | h :: _ -> h

let open-mpat(node: Ast, diags: Ref (List DesugarError)) -> Maybe (List Ast) =
  match (node)
    | ParenNode(head :: pats, _) ->
      if (is-sym(head, "mpat")) -> Some(pats) | {
        push-diag!(diags, ast-span(node), "E_DESUGAR_MATCH", "match arm requires a pattern for each scrutinee")
        None()
      }
    | _ ->
      {
        push-diag!(diags, ast-span(node), "E_DESUGAR_MATCH", "match arm requires a pattern for each scrutinee")
        None()
      }

let m-guard-of(node: Ast, diags: Ref (List DesugarError)) -> Maybe Ast =
  match (node)
    | ParenNode(head :: _ :: g :: _, _) ->
      if (is-sym(head, "mguard")) -> Some(desugar-node(g, diags)) | None()
    | _ -> None()

let take-m-arm(node: Ast, body: Ast, rest: List Ast, n: Int, diags: Ref (List DesugarError)) -> List MArm =
  match (open-mpat(m-node(node), diags))
    | None -> take-m-arms(rest, n, diags)
    | Some(pats) -> take-m-arm-len(pats, body, rest, n, m-guard-of(node, diags), diags)

let m-node(node: Ast) -> Ast =
  match (node)
    | ParenNode(head :: inner :: _, _) ->
      if (is-sym(head, "mguard")) -> inner | node
    | _ -> node

let fresh-sym(n: Ref Int, sp: Span) -> Ast {
  let i = deref(n)
  set!(n, i + 1)
  mk-sym(String.concat("__mm", show(i)), sp)
}

let is-lower-start(name: Str) -> Bool {
  let b = String.byte(0, name)
  b >= 97 && b <= 122
}

let sym-text(a: Ast) -> Str =
  match (a)
    | SymNode(n, _) -> n
    | _ -> ""

let classify-pat(pat: Ast, rec-id: Ref Int) -> PatKind =
  match (pat)
    | SymNode(n, sp) ->
      if (n == "_" || is-lower-start(n)) -> AnyPat() | CtorPat(n, [], ParenNode([pat], sp))
    | IntNode(v, _) -> CtorPat(String.concat("int:", show(v)), [], pat)
    | StrNode(s, _) -> CtorPat(String.concat("str:", s), [], pat)
    | BoolNode(v, _) -> CtorPat(String.concat("bool:", if (v) -> "true" | "false"), [], pat)
    | ParenNode(head :: rest, _) -> classify-paren(head, rest, pat, rec-id)
    | _ -> AnyPat()

let classify-paren(head: Ast, rest: List Ast, pat: Ast, rec-id: Ref Int) -> PatKind {
  let n = sym-text(head)
  cond
    | n == "recpat" -> classify-recpat(rest, pat, rec-id)
    | n == "guard" || n == "_" || n == "" || is-lower-start(n) -> AnyPat()
    | else -> CtorPat(n, rest, pat)
}

let classify-recpat(rest: List Ast, pat: Ast, rec-id: Ref Int) -> PatKind =
  match (rest)
    | name :: _ ->
      {
        let id = deref(rec-id)
        set!(rec-id, id + 1)
        CtorPat(String.concat("rec:", sym-text(name), ":", show(id)), [], pat)
      }
    | [] -> AnyPat()

let arm-first(arm: MArm) -> Ast =
  match (arm)
    | MArm(pats, _, _) ->
      match (pats)
        | p :: _ -> p
        | [] -> mk-sym("_", Span(0, 0, 0, 0))

let class-arms(arms: List MArm, rec-id: Ref Int) -> List Classed =
  match (arms)
    | [] -> []
    | arm :: rest -> Classed(arm, classify-pat(arm-first(arm), rec-id)) :: class-arms(rest, rec-id)

let all-any(xs: List Classed) -> Bool =
  match (xs)
    | [] -> true
    | Classed(_, kind) :: rest ->
      match (kind)
        | AnyPat -> all-any(rest)
        | CtorPat(_, _, _) -> false

let bind-scrut(sp: Span, scrut: Ast, v: Ast, body: Ast) -> Ast =
  ParenNode([mk-sym("do", sp), ParenNode([mk-sym("let", sp), v, scrut], sp), body], sp)

let wrap-let(name: Str, sp: Span, v: Ast, body: Ast) -> Ast =
  ParenNode([mk-sym("let", sp), mk-sym(name, sp), v, body], sp)

let bind-any(pat: Ast, v: Ast, body: Ast, guard: Maybe Ast) -> BoundArm =
  match (pat)
    | SymNode(n, sp) ->
      if (n != "_" && is-lower-start(n)) -> BoundArm(wrap-let(n, sp, v, body), bind-guard(n, sp, v, guard)) | BoundArm(body, guard)
    | _ -> BoundArm(body, guard)

let bind-guard(name: Str, sp: Span, v: Ast, guard: Maybe Ast) -> Maybe Ast =
  match (guard)
    | None -> None()
    | Some(g) -> Some(wrap-let(name, sp, v, g))

let arm-pat(pat: Ast, guard: Maybe Ast) -> Ast =
  match (guard)
    | None -> pat
    | Some(g) -> ParenNode([mk-sym("guard", ast-span(pat)), pat, g], ast-span(pat))

let flatten-arms(arms: List Arm1) -> List Ast =
  match (arms)
    | [] -> []
    | Arm1(pat, body, guard) :: rest -> arm-pat(pat, guard) :: body :: flatten-arms(rest)

let emit-match(sp: Span, scrut: Ast, arms: List Arm1) -> Ast =
  ParenNode(mk-sym("match", sp) :: scrut :: flatten-arms(arms), sp)

let pats-tail(pats: List Ast) -> List Ast =
  match (pats)
    | [] -> []
    | _ :: rest -> rest

let peel-any(arms: List MArm, v: Ast) -> List MArm =
  match (arms)
    | [] -> []
    | MArm(pats, body, guard) :: rest ->
      match (pats)
        | p :: more ->
          match (bind-any(p, v, body, guard))
            | BoundArm(b, g) -> MArm(more, b, g) :: peel-any(rest, v)
        | [] -> peel-any(rest, v)

let arms-as-one(arms: List MArm) -> List Arm1 =
  match (arms)
    | [] -> []
    | MArm(pats, body, guard) :: rest ->
      match (pats)
        | p :: _ -> Arm1(p, body, guard) :: arms-as-one(rest)
        | [] -> arms-as-one(rest)

let finish-one(arms: List MArm, sp: Span) -> List Arm1 =
  match (arms)
    | [] -> []
    | MArm(_, body, guard) :: rest -> Arm1(mk-sym("_", sp), body, guard) :: finish-one(rest, sp)

let finish-arms(arms: List MArm, sp: Span) -> Ast =
  match (arms)
    | MArm(_, body, None()) :: [] -> body
    | _ -> emit-match(sp, ParenNode([], sp), finish-one(arms, sp))

let compile-multi(scruts: List Ast, arms: List MArm, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> Ast =
  match (arms)
    | [] -> ParenNode([], sp)
    | _ -> compile-multi-some(scruts, arms, fresh, rec-id, sp)

let compile-multi-some(scruts: List Ast, arms: List MArm, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> Ast =
  match (scruts)
    | [] -> finish-arms(arms, sp)
    | scrut :: rest -> compile-scrut(scrut, rest, class-arms(arms, rec-id), fresh, rec-id, sp)

let compile-scrut(scrut: Ast, rest: List Ast, classed: List Classed, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> Ast =
  if (all-any(classed)) -> compile-any(scrut, rest, classed, fresh, rec-id, sp) | compile-ctors(scrut, rest, classed, fresh, rec-id, sp)

let classed-arms(xs: List Classed) -> List MArm =
  match (xs)
    | [] -> []
    | Classed(arm, _) :: rest -> arm :: classed-arms(rest)

let compile-any(scrut: Ast, rest: List Ast, classed: List Classed, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> Ast {
  let arms = classed-arms(classed)
  let v = fresh-sym(fresh, ast-span(scrut))
  let peeled = peel-any(arms, v)
  let cont =
    match (rest)
      | [] -> finish-arms(peeled, sp)
      | _ -> compile-multi(rest, peeled, fresh, rec-id, sp)
  bind-scrut(sp, scrut, v, cont)
}

let sample-has(xs: List Sample, name: Str) -> Bool =
  match (xs)
    | [] -> false
    | Sample(n, _, _) :: rest ->
      if (n == name) -> true | sample-has(rest, name)

let payload-count(xs: List Ast) -> Int =
  ast-count(xs)

let collect-samples(xs: List Classed, acc: List Sample) -> List Sample =
  match (xs)
    | [] -> reverse-samples(acc, [])
    | Classed(_, kind) :: rest -> collect-sample(kind, rest, acc)

let collect-sample(kind: PatKind, rest: List Classed, acc: List Sample) -> List Sample =
  match (kind)
    | AnyPat -> collect-samples(rest, acc)
    | CtorPat(name, payloads, pattern) ->
      if (sample-has(acc, name)) -> collect-samples(rest, acc) | collect-samples(rest, Sample(name, payload-count(payloads), pattern) :: acc)

let reverse-samples(xs: List Sample, acc: List Sample) -> List Sample =
  match (xs)
    | [] -> acc
    | h :: t -> reverse-samples(t, h :: acc)

let fresh-vars(n: Int, fresh: Ref Int, sp: Span) -> List Ast =
  if (n <= 0) -> [] | fresh-sym(fresh, sp) :: fresh-vars(n - 1, fresh, sp)

let ctor-head(pattern: Ast, name: Str, sp: Span) -> Ast =
  match (pattern)
    | ParenNode(h :: _, _) -> h
    | _ -> mk-sym(name, sp)

let outer-pat(sample: Sample, vars: List Ast, sp: Span) -> Ast =
  match (sample)
    | Sample(name, count, pattern) ->
      if (count == 0) -> pattern | ParenNode(ctor-head(pattern, name, sp) :: vars, sp)

let wilds-for(vars: List Ast) -> List Ast =
  match (vars)
    | [] -> []
    | v :: rest -> mk-sym("_", ast-span(v)) :: wilds-for(rest)

let inner-of(xs: List Classed, name: Str, vars: List Ast, v: Ast) -> List MArm =
  match (xs)
    | [] -> []
    | Classed(arm, kind) :: rest -> inner-cons(arm, kind, rest, name, vars, v)

let inner-cons(arm: MArm, kind: PatKind, rest: List Classed, name: Str, vars: List Ast, v: Ast) -> List MArm =
  match (kind)
    | AnyPat -> inner-any(arm, rest, name, vars, v)
    | CtorPat(n, payloads, _) ->
      if (n != name) -> inner-of(rest, name, vars, v) | inner-ctor(arm, payloads, rest, name, vars, v)

let inner-any(arm: MArm, rest: List Classed, name: Str, vars: List Ast, v: Ast) -> List MArm =
  match (arm)
    | MArm(pats, body, guard) ->
      match (bind-any(arm-first(arm), v, body, guard))
        | BoundArm(b, g) -> MArm(append-list(wilds-for(vars), pats-tail(pats)), b, g) :: inner-of(rest, name, vars, v)

let inner-ctor(arm: MArm, payloads: List Ast, rest: List Classed, name: Str, vars: List Ast, v: Ast) -> List MArm =
  match (arm)
    | MArm(pats, body, guard) -> MArm(append-list(payloads, pats-tail(pats)), body, guard) :: inner-of(rest, name, vars, v)

let group-covered(xs: List Classed, name: Str) -> Bool =
  match (xs)
    | [] -> false
    | Classed(arm, kind) :: rest ->
      match (arm)
        | MArm(_, _, Some(_)) -> group-covered(rest, name)
        | MArm(_, _, None()) -> group-covered-kind(kind, rest, name)

let group-covered-kind(kind: PatKind, rest: List Classed, name: Str) -> Bool =
  match (kind)
    | AnyPat -> true
    | CtorPat(n, _, _) ->
      if (n == name) -> true | group-covered(rest, name)

let ctor-branches(samples: List Sample, classed: List Classed, rest: List Ast, v: Ast, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> List Arm1 =
  match (samples)
    | [] -> []
    | sample :: more -> ctor-branch(sample, more, classed, rest, v, fresh, rec-id, sp)

let ctor-branch(sample: Sample, more: List Sample, classed: List Classed, rest: List Ast, v: Ast, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> List Arm1 =
  match (sample)
    | Sample(name, count, _) ->
      {
        let vars = fresh-vars(count, fresh, sp)
        let inner = inner-of(classed, name, vars, v)
        let body = compile-multi(append-list(vars, rest), inner, fresh, rec-id, sp)
        let guard = if (group-covered(classed, name)) -> None() | Some(BoolNode(true, sp))
        Arm1(outer-pat(sample, vars, sp), body, guard) :: ctor-branches(more, classed, rest, v, fresh, rec-id, sp)
      }

let any-classed(xs: List Classed) -> List Classed =
  match (xs)
    | [] -> []
    | Classed(arm, kind) :: rest ->
      match (kind)
        | AnyPat -> Classed(arm, kind) :: any-classed(rest)
        | CtorPat(_, _, _) -> any-classed(rest)

let any-covered(xs: List Classed) -> Bool =
  match (xs)
    | [] -> false
    | Classed(arm, _) :: rest ->
      match (arm)
        | MArm(_, _, None()) -> true
        | MArm(_, _, Some(_)) -> any-covered(rest)

let append-arm1(xs: List Arm1, x: Arm1) -> List Arm1 =
  match (xs)
    | [] -> [x]
    | h :: t -> h :: append-arm1(t, x)

let arm-rest-any(arm: MArm) -> Bool =
  match (arm)
    | MArm(pats, _, guard) ->
      match (guard)
        | Some(_) -> false
        | None() -> pats-after-any(pats)

let pats-after-any(pats: List Ast) -> Bool =
  match (pats)
    | [] -> true
    | _ :: more -> more-all-any(more)

let more-all-any(pats: List Ast) -> Bool =
  match (pats)
    | [] -> true
    | p :: more ->
      match (classify-pat(p, ref(0)))
        | AnyPat -> more-all-any(more)
        | CtorPat(_, _, _) -> false

let anys-cover-rest(xs: List Classed) -> Bool =
  match (xs)
    | [] -> false
    | Classed(arm, _) :: rest ->
      if (arm-rest-any(arm)) -> true | anys-cover-rest(rest)

let any-branch(classed: List Classed, rest: List Ast, v: Ast, fresh: Ref Int, rec-id: Ref Int, sp: Span, branches: List Arm1) -> List Arm1 {
  let anys = any-classed(classed)
  match (anys)
    | [] -> branches
    | _ ->
      if (anys-cover-rest(anys)) -> any-branch-arm(anys, rest, v, fresh, rec-id, sp, branches) | branches
}

let any-branch-arm(anys: List Classed, rest: List Ast, v: Ast, fresh: Ref Int, rec-id: Ref Int, sp: Span, branches: List Arm1) -> List Arm1 {
  let next = peel-any(classed-arms(anys), v)
  let body =
    match (rest)
      | [] -> finish-arms(next, sp)
      | _ -> compile-multi(rest, next, fresh, rec-id, sp)
  let guard = if (any-covered(anys)) -> None() | Some(BoolNode(true, sp))
  append-arm1(branches, Arm1(mk-sym("_", sp), body, guard))
}

let compile-ctors(scrut: Ast, rest: List Ast, classed: List Classed, fresh: Ref Int, rec-id: Ref Int, sp: Span) -> Ast {
  let v = fresh-sym(fresh, ast-span(scrut))
  let branches = ctor-branches(collect-samples(classed, []), classed, rest, v, fresh, rec-id, sp)
  let with-any = any-branch(classed, rest, v, fresh, rec-id, sp, branches)
  bind-scrut(sp, scrut, v, emit-match(sp, v, with-any))
}


let finish-desugar(forms: List Ast, diags: Ref (List DesugarError)) -> Result (List Ast) (List DesugarError) {
  let ds = deref(diags)
  match (ds)
    | [] -> Ok(forms)
    | _ :: _ -> Err(reverse-diags(ds))
}

; Desugar one form; recursively desugars children. Returns a one-element
; list on success, mirroring the host's `{ ok: true; forms: [out] }`.
pub let desugar-form(form: Ast) -> Result (List Ast) (List DesugarError) {
  let diags = ref([])
  let out = desugar-node(form, diags)
  finish-desugar([out], diags)
}

pub let desugar-all(forms: List Ast) -> Result (List Ast) (List DesugarError) {
  let diags = ref([])
  let out = map-desugar(forms, diags)
  finish-desugar(out, diags)
}

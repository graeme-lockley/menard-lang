; Desugar — expands `and`/`or`/`cond`/`when`/`while` into `if`/`do`/`loop`/
; `recur`, and `[e1 e2 …]` / `[]` into a `Cons`/`Nil` chain (expressions and
; `match` patterns). A bracket list in a `defn`/`defrec`/`variant` name form
; is a type-parameter list and is left alone. Mirrors host/src/desugar/desugar.ts.
;
; The host threads a single mutable `Diagnostic[]` accumulator through every
; recursive call so a form can keep producing *some* output even after an
; error (e.g. an empty `(cond)` still desugars its (non-existent) clauses
; and reports one diagnostic, rather than aborting the whole pass). The
; idiomatic Menard substitute for that shared mutable array is a
; `(Ref (List DesugarError))` accumulator, threaded the same way `read.mnd`
; threads `(Ref Int)` for the reader's scan position: every helper appends
; to it with `set!` instead of returning a growing `Result` chain.
;
; Diagnostics are pushed most-recent-first (an ordinary `Cons` prepend), so
; the two entry points below reverse the final list once to restore the
; host's chronological (first-error-first) order.

(import "../reader/ast.mnd")

; Re-export shim: see reader/casing.mnd for why this is needed — a `pub`
; signature here (desugar-form/desugar-all, DesugarError's own fields) may
; only mention a nominal type this module's own export set contains.
(pub alias Ast Ast)
(pub alias Span Span)

(pub defrec DesugarError (span: Span) (code: Str) (message: Str))

; ---------------------------------------------------------------------------
; Diagnostic accumulator

(defn push-diag! (diags: (Ref (List DesugarError))) (sp: Span) (code: Str) (message: Str) -> Unit
  (set! diags (Cons (DesugarError sp code message) (deref diags))))

(defn reverse-onto (xs: (List DesugarError)) (acc: (List DesugarError)) -> (List DesugarError)
  (match xs
    [] acc
    (Cons x rest) (reverse-onto rest (Cons x acc))))

(defn reverse-diags (xs: (List DesugarError)) -> (List DesugarError)
  (reverse-onto xs []))

; ---------------------------------------------------------------------------
; Small Ast builders

(defn mk-sym (name: Str) (sp: Span) -> Ast
  (SymNode name sp))

(defn is-sym (ast: Ast) (name: Str) -> Bool
  (match ast
    (SymNode n _) (= n name)
    _ false))

(defn elems-tail (elems: (List Ast)) -> (List Ast)
  (match elems
    [] []
    (Cons _ rest) rest))

(defn append-list (xs: (List Ast)) (ys: (List Ast)) -> (List Ast)
  (match xs
    [] ys
    (Cons x rest) (Cons x (append-list rest ys))))

; `(do body…)` when there is more than one body form, `body[0]` when there
; is exactly one, or Unit `()` when there is none. Shared by cond/when.
(defn wrap-do (body: (List Ast)) (sp: Span) -> Ast
  (match body
    [] (ParenNode [] sp)
    [b] b
    _ (ParenNode (Cons (mk-sym "do" sp) body) sp)))

; ---------------------------------------------------------------------------
; Recursive descent

(defn map-desugar (elems: (List Ast)) (diags: (Ref (List DesugarError))) -> (List Ast)
  (match elems
    [] []
    (Cons x rest) (Cons (desugar-node x diags) (map-desugar rest diags))))

; `[e …]` → `(Cons e … (Nil))`. `[]` → `(Nil)`.
(defn cons-chain (elems: (List Ast)) (sp: Span) -> Ast
  (match elems
    [] (ParenNode [(mk-sym "Nil" sp)] sp)
    (Cons e rest)
      (ParenNode
        [(mk-sym "Cons" sp) e (cons-chain rest sp)]
        sp)))

(defn is-decl-keyword (ast: Ast) -> Bool
  (match ast
    (SymNode n _) (or (= n "defn") (or (= n "defrec") (= n "variant")))
    _ false))

; `(name [params…])` — the bracket list is type parameters.
(defn desugar-name-form (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match elems
    (Cons name (Cons (BracketNode ps psp) rest))
      (ParenNode
        (Cons (desugar-node name diags)
          (Cons (BracketNode (map-desugar ps diags) psp) (map-desugar rest diags)))
        sp)
    _ (ParenNode (map-desugar elems diags) sp)))

(defn desugar-maybe-name (name: Ast) (diags: (Ref (List DesugarError))) -> Ast
  (match name
    (ParenNode elems sp) (desugar-name-form elems sp diags)
    _ (desugar-node name diags)))

(defn desugar-decl (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match elems
    (Cons kw (Cons name rest))
      (ParenNode
        (Cons (desugar-node kw diags)
          (Cons (desugar-maybe-name name diags) (map-desugar rest diags)))
        sp)
    _ (ParenNode (map-desugar elems diags) sp)))

(defn desugar-pub (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match elems
    (Cons pub-kw (Cons kw (Cons name rest)))
      (if (is-decl-keyword kw)
        (ParenNode
          (Cons (desugar-node pub-kw diags)
            (Cons (desugar-node kw diags)
              (Cons (desugar-maybe-name name diags) (map-desugar rest diags))))
          sp)
        (ParenNode (map-desugar elems diags) sp))
    _ (ParenNode (map-desugar elems diags) sp)))

(defn desugar-node (ast: Ast) (diags: (Ref (List DesugarError))) -> Ast
  (match ast
    (ParenNode elems sp) (desugar-paren elems sp diags)
    (BracketNode elems sp) (cons-chain (map-desugar elems diags) sp)
    _ ast))

(defn desugar-paren (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match elems
    [] (ParenNode [] sp)
    (Cons head _) (desugar-paren-head head elems sp diags)))

(defn desugar-paren-head (head: Ast) (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match head
    (SymNode name _) (desugar-paren-named name elems sp diags)
    _ (ParenNode (map-desugar elems diags) sp)))

(defn desugar-paren-named (name: Str) (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (if (or (= name "defn") (or (= name "defrec") (= name "variant")))
    (desugar-decl elems sp diags)
    (if (= name "pub")
      (desugar-pub elems sp diags)
      (if (= name "and")
        (desugar-and elems sp diags)
        (if (= name "or")
          (desugar-or elems sp diags)
          (if (= name "cond")
            (desugar-cond elems sp diags)
            (if (= name "when")
              (desugar-when elems sp diags)
              (if (= name "while")
                (desugar-while elems sp diags)
                (ParenNode (map-desugar elems diags) sp)))))))))

; ---------------------------------------------------------------------------
; (and) → true; (and x) → x; (and x y …) → (if x (and y …) false)

(defn desugar-and (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (desugar-and-args (elems-tail elems) sp diags))

(defn desugar-and-args (args: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match args
    [] (BoolNode true sp)
    [x] (desugar-node x diags)
    (Cons x rest) (desugar-and-rest x rest sp diags)))

(defn desugar-and-rest (x: Ast) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (let rest-form (ParenNode (Cons (mk-sym "and" sp) rest) sp))
  (desugar-node
    (ParenNode [(mk-sym "if" sp) x rest-form (BoolNode false sp)] sp)
    diags))

; ---------------------------------------------------------------------------
; (or) → false; (or x) → x; (or x y …) → (if x x (or y …))

(defn desugar-or (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (desugar-or-args (elems-tail elems) sp diags))

(defn desugar-or-args (args: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match args
    [] (BoolNode false sp)
    [x] (desugar-node x diags)
    (Cons x rest) (desugar-or-rest x rest sp diags)))

(defn desugar-or-rest (x: Ast) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (let rest-form (ParenNode (Cons (mk-sym "or" sp) rest) sp))
  (desugar-node
    (ParenNode [(mk-sym "if" sp) x x rest-form] sp)
    diags))

; ---------------------------------------------------------------------------
; (cond (test e…) … (else e…)) → nested (if test (do e…) …)

(defn cond-no-match (sp: Span) -> Ast
  (ParenNode [(mk-sym "panic" sp) (StrNode "cond: no match" sp)] sp))

(defn desugar-cond (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (desugar-cond-dispatch (elems-tail elems) elems sp diags))

(defn desugar-cond-dispatch (clauses: (List Ast)) (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match clauses
    []
      (do
        (push-diag! diags sp "E_DESUGAR_COND_EMPTY" "cond requires at least one clause")
        (ParenNode elems sp))
    _ (desugar-cond-clauses clauses sp diags)))

(defn desugar-cond-clauses (clauses: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match clauses
    [] (cond-no-match sp)
    (Cons first rest) (desugar-cond-clause first rest sp diags)))

(defn desugar-cond-clause (first: Ast) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match first
    (ParenNode felems fsp) (desugar-cond-clause-elems first felems fsp rest sp diags)
    _
      (do
        (push-diag! diags (ast-span first) "E_DESUGAR_COND_CLAUSE" "cond clause must be a list (test exprs...)")
        first)))

(defn desugar-cond-clause-elems (first: Ast) (felems: (List Ast)) (fsp: Span) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match felems
    []
      (do
        (push-diag! diags fsp "E_DESUGAR_COND_CLAUSE" "cond clause must be a list (test exprs...)")
        first)
    (Cons test body) (desugar-cond-test test body rest sp diags)))

(defn desugar-cond-test (test: Ast) (body: (List Ast)) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (if (is-sym test "else")
    (desugar-cond-else test body rest sp diags)
    (desugar-cond-if test body rest sp diags)))

(defn desugar-cond-else (test: Ast) (body: (List Ast)) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (do
    (match rest
      [] ()
      (Cons _ _) (push-diag! diags (ast-span test) "E_DESUGAR_COND_ELSE" "else must be the last cond clause"))
    (desugar-cond-else-body body sp diags)))

(defn desugar-cond-else-body (body: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match body
    [] (ParenNode [] sp)
    [b] (desugar-node b diags)
    _ (desugar-node (ParenNode (Cons (mk-sym "do" sp) body) sp) diags)))

(defn desugar-cond-if (test: Ast) (body: (List Ast)) (rest: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (let then-expr (wrap-do body sp))
  (let else-expr (desugar-cond-clauses rest sp diags))
  (desugar-node
    (ParenNode [(mk-sym "if" sp) test then-expr else-expr] sp)
    diags))

; ---------------------------------------------------------------------------
; (when test body…) → (if test (do body…) ())

(defn desugar-when (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match elems
    (Cons _ (Cons test body)) (desugar-when-body test body sp diags)
    _
      (do
        (push-diag! diags sp "E_DESUGAR_WHEN" "when requires a test and optional body")
        (ParenNode elems sp))))

(defn desugar-when-body (test: Ast) (body: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (let then-expr (wrap-do body sp))
  (desugar-node
    (ParenNode [(mk-sym "if" sp) test then-expr (ParenNode (Nil) sp)] sp)
    diags))

; ---------------------------------------------------------------------------
; (while test body…) → (loop () (if test (do body… (recur)) ()))

(defn desugar-while (elems: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (match elems
    (Cons _ (Cons test body)) (desugar-while-body test body sp diags)
    _
      (do
        (push-diag! diags sp "E_DESUGAR_WHILE" "while requires a test")
        (ParenNode elems sp))))

(defn while-body-do (body: (List Ast)) (recur-form: Ast) (sp: Span) -> Ast
  (match body
    [] recur-form
    _ (ParenNode (Cons (mk-sym "do" sp) (append-list body [recur-form])) sp)))

(defn desugar-while-body (test: Ast) (body: (List Ast)) (sp: Span) (diags: (Ref (List DesugarError))) -> Ast
  (let recur-form (ParenNode [(mk-sym "recur" sp)] sp))
  (let body-do (while-body-do body recur-form sp))
  (let if-form (ParenNode [(mk-sym "if" sp) test body-do (ParenNode (Nil) sp)] sp))
  (desugar-node
    (ParenNode [(mk-sym "loop" sp) (ParenNode (Nil) sp) if-form] sp)
    diags))

; ---------------------------------------------------------------------------
; Entry points

(defn finish-desugar (forms: (List Ast)) (diags: (Ref (List DesugarError))) -> (Result (List Ast) (List DesugarError))
  (let ds (deref diags))
  (match ds
    [] (Ok forms)
    (Cons _ _) (Err (reverse-diags ds))))

; Desugar one form; recursively desugars children. Returns a one-element
; list on success, mirroring the host's `{ ok: true; forms: [out] }`.
(pub defn desugar-form (form: Ast) -> (Result (List Ast) (List DesugarError))
  (do
    (let diags (ref []))
    (let out (desugar-node form diags))
    (finish-desugar [out] diags)))

(pub defn desugar-all (forms: (List Ast)) -> (Result (List Ast) (List DesugarError))
  (do
    (let diags (ref []))
    (let out (map-desugar forms diags))
    (finish-desugar out diags)))

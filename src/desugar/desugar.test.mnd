; Desugar pass. Paths are relative to the process cwd, which `./mn test`
; leaves as the repo root. CLI dump flags stay in tests/phase2/desugar.test.ts.

import "../reader/read.mnd"
import "../reader/print.mnd"
import "./desugar.mnd"
import std/io
import std/string

let has-head(text: Str, name: Str) -> Bool =
  has(concat("(", name, " "), text) || has(concat("(", name, ")"), text)

let read-forms(path: Str) -> Maybe (List Ast) =
  match (read-file(path))
    | Err(_) -> None()
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> None()
        | Ok(forms) -> Some(forms)

let desugared-text(path: Str) -> Maybe Str =
  match (read-forms(path))
    | None -> None()
    | Some(forms) ->
      match (desugar-all(forms))
        | Err(_) -> None()
        | Ok(out) -> Some(print-form-all(out))

let no-sugar(text: Str) -> Bool =
  not(has-head(text, "and")) && not(has-head(text, "or")) && not(has-head(text, "cond")) && not(has-head(text, "when")) && not(has-head(text, "while"))

let codes-have(es: List DesugarError, code: Str) -> Bool =
  match (es)
    | [] -> false
    | DesugarError(_, c, _) :: rest ->
      if (c == code) -> true | codes-have(rest, code)

let is-none-forms(path: Str) -> Bool =
  match (read-forms(path))
    | None -> true
    | Some(_) -> false

let desugar-has-code(path: Str, code: Str) -> Bool =
  match (read-forms(path))
    | None -> false
    | Some(forms) ->
      match (desugar-all(forms))
        | Ok(_) -> false
        | Err(es) -> codes-have(es, code)

test "and/or/while expand to if and loop" =
  match (desugared-text("tests/phase2/fixtures/desugar-ok.mnd"))
    | None -> false
    | Some(text) -> has("if ", text) && has("loop (", text) && not(has("while", text)) && not(has("&&", text)) && not(has("||", text))

test "while expands to loop" =
  match (desugared-text("tests/phase2/fixtures/desugar-while.mnd"))
    | None -> false
    | Some(text) -> has("loop (", text) && not(has("while", text))

test "bracket lists become cons and a type-parameter list stays" =
  match (desugared-text("tests/phase2/fixtures/list-sugar.mnd"))
    | None -> false
    | Some(text) -> has("[a]", text) && has("::", text) && has("Nil", text) && not(has("Cons", text)) && not(has("[h", text)) && not(has("[10", text))

let desugars-to(src: Str, want: Str) -> Bool =
  match (read(src))
    | Err(_) -> false
    | Ok(a) ->
      match (desugar-all([a]))
        | Err(_) -> false
        | Ok(forms) ->
          match (forms)
            | h :: [] -> print-form(h) == want
            | _ -> false

let pipe-rejected(src: Str) -> Bool =
  match (read(src))
    | Err(_) -> false
    | Ok(a) ->
      match (desugar-all([a]))
        | Ok(_) -> false
        | Err(es) -> codes-have(es, "E_DESUGAR_PIPE")

test "pipe appends the left value as the last argument" =
  desugars-to("tokens |> List.map(I.parse) |> List.filter(fn (n) = n <= 1000)", "(List.filter)(fn (n) = n <= 1000, (List.map)(I.parse, tokens))") && desugars-to("input |> String.drop(idx + 1) |> String.split-using(separators)", "(String.split-using)(separators, (String.drop)(idx + 1, input))") && desugars-to("numbers |> List.filter(is-negative) |> Err()", "Err((List.filter)(is-negative, numbers))") && desugars-to("numbers |> List.fold(fn (a, n) = a + n, 0)", "(List.fold)(fn (a, n) = a + n, 0, numbers)") && desugars-to("s |> String.drop(n)", "(String.drop)(n, s)") && desugars-to("s |> String.index-of-from(sep, i)", "(String.index-of-from)(sep, i, s)")

test "a map literal becomes nested map-set" = desugars-to("{\"a\" => 1, \"b\" => 2}", "map-set(map-set(map-new(), \"a\", 1), \"b\", 2)")

let occurs-once(needle: Str, s: Str) -> Bool =
  match (index-of(needle, s))
    | None -> false
    | Some(i) ->
      match (index-of-from(needle, i + 1, s))
        | None -> true
        | Some(_) -> false

test "a spread mentions map-keys once" = {
  match (read("{...x}"))
    | Err(_) -> false
    | Ok(a) ->
      match (desugar-all([a]))
        | Err(_) -> false
        | Ok(forms) ->
          match (forms)
            | h :: [] -> occurs-once("map-keys", print-form(h))
            | _ -> false
}

test "question lowers to a match and keeps the default in the None arm" = {
  match (read("Some(1) ? panic(\"no\")"))
    | Err(_) -> false
    | Ok(a) ->
      match (desugar-all([a]))
        | Err(_) -> false
        | Ok(forms) ->
          match (forms)
            | h :: [] ->
              {
                let text = print-form(h)
                has("match (Some(1))", text) && has("None -> panic(\"no\")", text) && has("Some(mn-ques) -> mn-ques", text)
              }
            | _ -> false
}

test "a bare name is not a pipe target" = pipe-rejected("xs |> List.map")

test "an unclosed declaration does not parse" = is-none-forms("tests/negative/bad-parse.mnd")

test "a bar at the wrong column does not parse" = is-none-forms("tests/negative/bad-desugar-cond-else.mnd")

test "an operator without whitespace does not parse" = is-none-forms("tests/negative/bad-desugar-arity.mnd")

test "a nested parameter-list let parses" = not(is-none-forms("tests/phase2/fixtures/nested-let.mnd"))

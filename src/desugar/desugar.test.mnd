; Desugar pass. Paths are relative to the process cwd, which `./mn test`
; leaves as the repo root. CLI dump flags stay in tests/phase2/desugar.test.ts.

import "../reader/read.mnd"

import "../reader/print.mnd"

import "./desugar.mnd"

import std/io

import std/string

let has-head(text: Str, name: Str) -> Bool =
  has(text, str-concat("(", name, " ")) || has(text, str-concat("(", name, ")"))

let read-forms(path: Str) -> Maybe (List Ast) =
  match (read-file(path))
    | Err(_) -> None()
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> None()
        | Ok(forms) -> Some(forms)

let desugared-text(path: Str) -> Maybe Str =
  match (read-forms(path))
    | None -> None()
    | Some(forms) ->
      match (desugar-all(forms))
        | Err(_) -> None()
        | Ok(out) -> Some(print-form-all(out))

let no-sugar(text: Str) -> Bool =
  not(has-head(text, "and")) && not(has-head(text, "or")) && not(has-head(text, "cond")) && not(has-head(text, "when")) && not(has-head(text, "while"))

let codes-have(es: List DesugarError, code: Str) -> Bool =
  match (es)
    | [] -> false
    | Cons(DesugarError(_, c, _), rest) ->
      if c == code -> true
       | else -> codes-have(rest, code)

let is-none-forms(path: Str) -> Bool =
  match (read-forms(path))
    | None -> true
    | Some(_) -> false

let desugar-has-code(path: Str, code: Str) -> Bool =
  match (read-forms(path))
    | None -> false
    | Some(forms) ->
      match (desugar-all(forms))
        | Ok(_) -> false
        | Err(es) -> codes-have(es, code)

test "and/or/while expand to if and loop" =
  match (desugared-text("tests/phase2/fixtures/desugar-ok.mnd"))
    | None -> false
    | Some(text) -> has(text, "if ") && has(text, "loop (") && not(has(text, "while")) && not(has(text, "&&")) && not(has(text, "||"))

test "while expands to loop" =
  match (desugared-text("tests/phase2/fixtures/desugar-while.mnd"))
    | None -> false
    | Some(text) -> has(text, "loop (") && not(has(text, "while"))

test "bracket lists become Cons/Nil and a type-parameter list stays" =
  match (desugared-text("tests/phase2/fixtures/list-sugar.mnd"))
    | None -> false
    | Some(text) -> has(text, "[a]") && has(text, "Cons") && has(text, "Nil") && not(has(text, "[h")) && not(has(text, "[10"))

test "an unclosed declaration does not parse" = is-none-forms("tests/negative/bad-parse.mnd")

test "a bar at the wrong column does not parse" = is-none-forms("tests/negative/bad-desugar-cond-else.mnd")

test "an operator without whitespace does not parse" = is-none-forms("tests/negative/bad-desugar-arity.mnd")

test "a nested parameter-list let does not parse" = is-none-forms("tests/negative/bad-desugar-while.mnd")

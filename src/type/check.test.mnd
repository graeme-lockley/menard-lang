; Typer. Fixture paths are from the repo root, and are also found when
; `./mn test` is run from a subdirectory. Forms are desugared first,
; matching the pipeline contract in src/type/check.mnd. CLI dump flags
; stay in tests/phase2/typecheck.test.ts.

import "../reader/read.mnd"
import "../desugar/desugar.mnd"
import "../test/paths.mnd"
import "./check.mnd"
import "./types.mnd"
import std/io

let read-forms(path: Str) -> Maybe (List Ast) =
  match (read-file(project-file(path)))
    | Err(_) -> None()
    | Ok(src) ->
      match (read-all(src))
        | Err(_) -> None()
        | Ok(forms) -> Some(forms)

let desugared(path: Str) -> Maybe (List Ast) =
  match (read-forms(path))
    | None -> None()
    | Some(forms) ->
      match (desugar-all(forms))
        | Err(_) -> None()
        | Ok(out) -> Some(out)

let type-codes-have(es: List TypeError, code: Str) -> Bool =
  match (es)
    | [] -> false
    | TypeError(_, c, _) :: rest ->
      if (c == code) -> true | type-codes-have(rest, code)

let type-has-code(path: Str, code: Str) -> Bool =
  match (desugared(path))
    | None -> false
    | Some(forms) ->
      match (typecheck-forms(forms))
        | Ok(_) -> false
        | Err(es) -> type-codes-have(es, code)

let is-defn(form: Ast) -> Bool =
  match (form)
    | ParenNode(h :: _, _) ->
      match (h)
        | SymNode(n, _) -> n == "defn"
        | _ -> false
    | _ -> false

let count-defns(forms: List Ast) -> Int =
  match (forms)
    | [] -> 0
    | f :: rest ->
      if (is-defn(f)) -> 1 + count-defns(rest) | count-defns(rest)

test "a well-typed defn typechecks" =
  match (desugared("tests/phase2/fixtures/type-ok.mnd"))
    | None -> false
    | Some(forms) ->
      match (typecheck-forms(forms))
        | Ok(_) -> true
        | Err(_) -> false

test "an unbound variable is E_TYPE_UNBOUND" = type-has-code("tests/negative/bad-type-unbound.mnd", "E_TYPE_UNBOUND")

test "a non-Bool if test is E_TYPE_MISMATCH" = type-has-code("tests/negative/bad-type-if-nonbool.mnd", "E_TYPE_MISMATCH")

test "question on an Int is a type error" = type-has-code("tests/negative/bad-ques-type.mnd", "E_TYPE_MISMATCH") || type-has-code("tests/negative/bad-ques-type.mnd", "E_TYPE_EXHAUSTIVE")

test "a rest parameter is packed to a list before typing" =
  match (desugared("tests/phase2/fixtures/rest-ok.mnd"))
    | None -> false
    | Some(forms) ->
      match (typecheck-forms(forms))
        | Ok(out) -> count-defns(out) == 3
        | Err(_) -> false

test "nominal identity compares the canonical id, not the display name" = {
  let a = TNominal("module-a::T", "T", [], "variant")
  let b = TNominal("module-b::T", "T", [], "variant")
  let c = TNominal("module-a::T", "Alias.T", [], "variant")
  type-equal(a, b) == false && type-equal(a, c) && type-show(c) == "Alias.T"
}

test "TypeDef and constructor ownership use the canonical id" = {
  let a = CtorInfo("module-a::T", "T", [], [])
  let b = CtorInfo("module-b::T", "T", [], [])
  let c = CtorInfo("module-a::T", "Alias.T", [], [])
  ctor-owner-id(a) == ctor-owner-id(c) &&
    ctor-owner-id(a) != ctor-owner-id(b) &&
    ctor-owner-name(c) == "Alias.T" &&
    type-def-id(RecordDef("module-a::T", "T", [], [])) == type-def-id(RecordDef("module-a::T", "Alias.T", [], [])) &&
    type-def-id(RecordDef("module-a::T", "T", [], [])) != type-def-id(RecordDef("module-b::T", "T", [], []))
}

test "visible type spellings bind to one canonical id" = {
  let env = empty-env()
  type-bind!(env, "A", "module-a::T")
  type-bind!(env, "B", "module-a::T")
  type-bind!(env, "C", "module-b::T")
  let a = TNominal(type-resolve(env, "A"), "A", [], "variant")
  let b = TNominal(type-resolve(env, "B"), "B", [], "variant")
  let c = TNominal(type-resolve(env, "C"), "C", [], "variant")
  type-equal(a, b) && (type-equal(a, c) == false)
}

test "own declarations adopt the bound canonical id" = {
  let env = empty-env()
  type-bind!(env, "Pid", "std/actor#Pid")
  type-set(env, RecordDef("Pid", "Pid", [], []))
  match (type-get(env, "Pid"))
    | Some(td) -> type-def-id(td) == "std/actor#Pid" && type-def-name(td) == "Pid"
    | None -> false
}

test "a constructor spelling resolves through its canonical binding" = {
  let env = empty-env()
  ctor-bind!(env, "A", "module-a#A")
  ctor-set(env, "module-a#A", CtorInfo("module-a#T", "T", [], []))
  match (ctor-get(env, "A"))
    | Some(c) -> ctor-owner-id(c) == "module-a#T" && ctor-owner-name(c) == "T"
    | None -> false
}

test "a canonical type id keeps its source display name" = {
  let env = empty-env()
  type-bind!(env, "Pid", "__m7_Pid")
  type-set(env, RecordDef("__m7_Pid", "__m7_Pid", [], []))
  match (type-get(env, "Pid"))
    | Some(td) ->
      type-def-id(td) == "__m7_Pid" &&
        type-def-name(td) == "Pid" &&
        type-show(t-nominal-id("__m7_Pid", "Pid", [], "record")) == "Pid"
    | None -> false
}

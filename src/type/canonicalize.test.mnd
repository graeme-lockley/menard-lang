import "../reader/ast.mnd"
import "../reader/read.mnd"
import "../reader/print.mnd"
import "./canonicalize.mnd"
import std/map as Map
import std/string as String

let blank() -> Span =
  Span(0, 0, 0, 1)

let forms-of(src: Str) -> List Ast =
  match (read-all(src))
    | Ok(fs) -> fs
    | Err(_) -> []

let printed(forms: List Ast) -> Str =
  match (forms)
    | [] -> ""
    | f :: rest -> String.concat(print-form(f), String.concat("\n", printed(rest)))

let has(haystack: Str, needle: Str) -> Bool =
  String.contains(needle, haystack)

let type-bindings() -> Map Str Str =
  Map.set("Bar", "__m8_Bar", Map.set("Foo", "__m8_Foo", Map.empty()))

let ctor-bindings() -> Map Str Str =
  Map.set("B", "__c7_B", Map.set("A", "__c7_A", Map.empty()))

let append-asts(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | x :: rest -> x :: append-asts(rest, ys)

let typed() -> List Ast =
  append-asts(
    forms-of("let f(x: Foo, y: List (Maybe Foo)) -> Map Foo Bar = x

record R {
  a: Foo
  b: (Foo) -> Bar
}

type V =
  | A(Foo)
  | B(List Bar)

alias X = Foo * Bar
"),
    forms-of("extern e(x: Foo) -> Bar

runtime r(x: Foo) -> Bar
")
  )

test "type positions are canonicalized" = {
  let out = printed(canonicalize-types(typed(), type-bindings()))
  has(out, "x: __m8_Foo") &&
    has(out, "List (Maybe __m8_Foo)") &&
    has(out, "Map __m8_Foo __m8_Bar") &&
    has(out, "a: __m8_Foo") &&
    has(out, "(__m8_Foo) -> __m8_Bar") &&
    has(out, "A(__m8_Foo)") &&
    has(out, "B(List __m8_Bar)") &&
    has(out, "alias X = __m8_Foo * __m8_Bar") &&
    has(out, "extern e(x: __m8_Foo) -> __m8_Bar") &&
    has(out, "runtime r(x: __m8_Foo) -> __m8_Bar")
}

let ctor-source() -> List Ast =
  forms-of("let f(x: Foo) -> Foo =
  match (x)
    | A(y) -> B(y)
    | C -> x
")

test "constructor uses and patterns are canonicalized" = {
  let out = printed(canonicalize-ctors(ctor-source(), ctor-bindings()))
  has(out, "| __c7_A(y) -> __c7_B(y)") && has(out, "| C -> x") && has(out, "f(x: Foo)")
}

test "non-constructor symbols are left alone" = {
  let out = printed(canonicalize-ctors(ctor-source(), ctor-bindings()))
  has(out, "x") && has(out, "y")
}

test "qualified projections are left for import rewriting" = {
  let proj = ParenNode([SymNode("project", blank()), SymNode("Q", blank()), SymNode("A", blank())], blank())
  let form = ParenNode([SymNode("let", blank()), SymNode("v", blank()), SymNode("=", blank()), proj], blank())
  let out = canonicalize-ctors([form], ctor-bindings())
  match (out)
    | ParenNode(_ :: _ :: _ :: ParenNode([_, SymNode("Q", _), SymNode("A", _)], _) :: [], _) :: [] -> true
    | _ -> false
}

test "binding forms are untouched" = {
  let tb = ParenNode([SymNode("type-binding", blank()), StrNode("Foo", blank()), StrNode("__m8_Foo", blank())], blank())
  let cb = ParenNode([SymNode("ctor-binding", blank()), StrNode("A", blank()), StrNode("__c7_A", blank())], blank())
  let ts = printed(canonicalize-types([tb], type-bindings()))
  let cs = printed(canonicalize-ctors([cb], ctor-bindings()))
  has(ts, "type-binding(\"Foo\", \"__m8_Foo\")") && has(cs, "ctor-binding(\"A\", \"__c7_A\")")
}


let declaration-source() -> List Ast =
  forms-of("record R {
  a: Foo
}

type V =
  | A(Foo)
  | B

alias X = Foo

let f(v: Foo) -> Foo = A(v)
")

let declaration-types() -> Map Str Str =
  Map.set("X", "__m7_X", Map.set("V", "__m7_V", Map.set("R", "__m7_R", Map.set("Foo", "__m8_Foo", Map.empty()))))

let declaration-ctors() -> Map Str Str =
  Map.set("B", "__c7_B", Map.set("A", "__c7_A", Map.set("R", "__c7_R", Map.empty())))

test "declarations and constructors are canonicalized" = {
  let decls = canonicalize-declarations(declaration-source(), declaration-types(), declaration-ctors())
  let out = printed(canonicalize-ctors(canonicalize-types(decls, declaration-types()), declaration-ctors()))
  has(out, "type-binding(\"R\", \"__m7_R\")") &&
    has(out, "ctor-binding(\"R\", \"__c7_R\")") &&
    has(out, "type-binding(\"V\", \"__m7_V\")") &&
    has(out, "ctor-binding(\"A\", \"__c7_A\")") &&
    has(out, "record __m7_R") &&
    has(out, "| __c7_A(__m8_Foo)") &&
    has(out, "| __c7_B") &&
    has(out, "alias __m7_X = __m8_Foo") &&
    has(out, "f(v: __m8_Foo) -> __m8_Foo") &&
    has(out, "__c7_A(v)")
}

test "public record keeps the type id" = {
  let forms = forms-of("pub record Box[a] {\n  value: a\n}\n")
  let out = printed(canonicalize-declarations(forms, Map.set("Box", "__m7_Box", Map.empty()), Map.set("Box", "__c7_Box", Map.empty())))
  has(out, "record __m7_Box")
}

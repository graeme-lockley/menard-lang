; Types — the typechecker's type representation. Mirrors
; host/src/type/types.ts. Split out from check.mnd the same way the host
; splits types.ts from check.ts: this module is the closed set of shapes a
; type can take, plus structural equality and the diagnostic spelling of a
; type. check.mnd owns everything that reasons about *why* a type was
; produced (unification, instantiation, the environment).
;
; TODO(this slice): `Arr` and the "ctor" pattern-value tag from the host's
; `Type` union are not ported — `Arr` is unused by the Phase 2 critical
; subset (§2.8.2), and "ctor" is dead code in host/src/type/check.ts (never
; constructed). Revisit if a later slice needs fixed-size arrays.

import std/string as String

pub type Type =
  | TInt
  | TFloat
  | TBool
  | TChar
  | TStr
  | TSym
  | TUnit
  | TStringBuffer
  | TVar(Int, Str)
  | TParam(Str)
  | TList(Type)
  | TMap(Type, Type)
  | TMaybe(Type)
  | TResult(Type, Type)
  | TRef(Type)
  | TFn(List Type, Type)
  | TNominal(Str, Str, List Type, Str)
  | TProduct(List Type)

 ; canonical id, display name, type args, kind ("record" | "variant")

; A declared name's own scheme: how many type parameters it binds, plus the
; (possibly parameter-mentioning) type itself. Instantiated with fresh
; unification variables at each use site (§2.8.4).
pub record Scheme {
  params: List Str
  type: Type
}

pub record RecordField {
  name: Str
  type: Type
}

pub record VariantCtor {
  name: Str
  payloads: List Type
}

pub type TypeDef =
  | RecordDef(Str, Str, List Str, List RecordField)
  | VariantDef(Str, Str, List Str, List VariantCtor)

; A constructor's own signature, independent of which TypeDef it belongs
; to: the canonical type id and display name it builds, its payload types
; (may mention that type's own parameters) and the parameter list itself
; (for instantiating a pattern's payload types against fresh variables).
pub record CtorInfo {
  type-id: Str
  type-name: Str
  payloads: List Type
  params: List Str
}

pub let type-def-id(td: TypeDef) -> Str =
  match (td)
    | RecordDef(id, _, _, _) -> id
    | VariantDef(id, _, _, _) -> id

pub let type-def-name(td: TypeDef) -> Str =
  match (td)
    | RecordDef(_, name, _, _) -> name
    | VariantDef(_, name, _, _) -> name

pub let ctor-owner-id(c: CtorInfo) -> Str =
  match (c)
    | CtorInfo(type-id, _, _, _) -> type-id

pub let ctor-owner-name(c: CtorInfo) -> Str =
  match (c)
    | CtorInfo(_, type-name, _, _) -> type-name

; ---------------------------------------------------------------------------
; Constructors — small wrappers so callers read as "the List type of T"
; rather than a bare variant application.

pub let t-int() -> Type =
  TInt()

pub let t-float() -> Type =
  TFloat()

pub let t-bool() -> Type =
  TBool()

pub let t-char() -> Type =
  TChar()

pub let t-str() -> Type =
  TStr()

pub let t-sym() -> Type =
  TSym()

pub let t-unit() -> Type =
  TUnit()

pub let t-string-buffer() -> Type =
  TStringBuffer()

pub let t-list(elem: Type) -> Type =
  TList(elem)

pub let t-map(key: Type, val: Type) -> Type =
  TMap(key, val)

pub let t-maybe(elem: Type) -> Type =
  TMaybe(elem)

pub let t-result(ok: Type, err: Type) -> Type =
  TResult(ok, err)

pub let t-ref(elem: Type) -> Type =
  TRef(elem)

pub let t-fn(params: List Type, ret: Type) -> Type =
  TFn(params, ret)

pub let t-nominal(name: Str, args: List Type, kind: Str) -> Type =
  TNominal(name, name, args, kind)

; Explicit canonical identity; `display` is only for diagnostics.
pub let t-nominal-id(id: Str, display: Str, args: List Type, kind: Str) -> Type =
  TNominal(id, display, args, kind)

; Caml-style n-tuple (n>=2), structural like `TList`/`TMap` — no declared
; name, so it is unified elementwise rather than looked up by name.
pub let t-product(elems: List Type) -> Type =
  TProduct(elems)

; ---------------------------------------------------------------------------
; Structural equality (ignores display names on TVar, exactly as host's
; typeEqual does — a variable's spelling is not part of its identity).

pub let type-equal(a: Type, b: Type) -> Bool =
  match (a, b)
    | (TInt, TInt) -> true
    | (TFloat, TFloat) -> true
    | (TBool, TBool) -> true
    | (TChar, TChar) -> true
    | (TStr, TStr) -> true
    | (TSym, TSym) -> true
    | (TUnit, TUnit) -> true
    | (TStringBuffer, TStringBuffer) -> true
    | (TVar(ida, _), TVar(idb, _)) -> ida == idb
    | (TParam(na), TParam(nb)) -> na == nb
    | (TList(ea), TList(eb)) -> type-equal(ea, eb)
    | (TMap(ka, va), TMap(kb, vb)) -> type-equal(ka, kb) && type-equal(va, vb)
    | (TMaybe(ea), TMaybe(eb)) -> type-equal(ea, eb)
    | (TResult(oa, ea), TResult(ob, eb)) -> type-equal(oa, ob) && type-equal(ea, eb)
    | (TRef(ea), TRef(eb)) -> type-equal(ea, eb)
    | (TFn(pa, ra), TFn(pb, rb)) -> type-list-equal(pa, pb) && type-equal(ra, rb)
    | (TNominal(ia, _, aa, ka), TNominal(ib, _, ab, kb)) -> ia == ib && ka == kb && type-list-equal(aa, ab)
    | (TProduct(xs), TProduct(ys)) -> type-list-equal(xs, ys)
    | (_, _) -> false

pub let type-list-equal(xs: List Type, ys: List Type) -> Bool =
  match (xs, ys)
    | ([], []) -> true
    | (x :: xrest, y :: yrest) -> type-equal(x, y) && type-list-equal(xrest, yrest)
    | (_, _) -> false

; ---------------------------------------------------------------------------
; Diagnostic spelling — not a pretty-printer, "canonical enough to read in
; an error message". Mirrors host's typeShow.

pub let type-show(t: Type) -> Str =
  match (t)
    | TInt -> "Int"
    | TFloat -> "Float"
    | TBool -> "Bool"
    | TChar -> "Char"
    | TStr -> "Str"
    | TSym -> "Sym"
    | TUnit -> "Unit"
    | TStringBuffer -> "StringBuffer"
    | TVar(id, name) ->
      if (name == "") -> String.concat("a", show(id)) | name
    | TParam(name) -> name
    | TList(elem) -> String.concat("(List ", type-show(elem), ")")
    | TMap(k, v) -> String.concat("(Map ", type-show(k), " ", type-show(v), ")")
    | TMaybe(elem) -> String.concat("(Maybe ", type-show(elem), ")")
    | TResult(ok, err) -> String.concat("(Result ", type-show(ok), " ", type-show(err), ")")
    | TRef(elem) -> String.concat("(Ref ", type-show(elem), ")")
    | TFn(params, ret) -> String.concat("(Fn ", type-show-list(params), " -> ", type-show(ret), ")")
    | TNominal(_, display, args, _) -> type-show-nominal(display, args)
    | TProduct(elems) -> type-show-product(elems)

let type-show-nominal(name: Str, args: List Type) -> Str =
  match (args)
    | [] -> name
    | _ -> String.concat("(", name, " ", type-show-list(args), ")")

let type-show-product(xs: List Type) -> Str =
  match (xs)
    | [] -> ""
    | [x] -> type-show(x)
    | x :: rest -> String.concat(type-show(x), " * ", type-show-product(rest))

let type-show-list(xs: List Type) -> Str =
  match (xs)
    | [] -> ""
    | [x] -> type-show(x)
    | x :: rest -> String.concat(type-show(x), " ", type-show-list(rest))

; ---------------------------------------------------------------------------
; Showable / orderable (§2.12), evaluated on expanded types. `Ref`,
; `StringBuffer` and `Fn` are neither; `Float` is showable but not
; orderable (§2.12's deliberate exclusion). Equatable(T) is not needed by
; this slice — every builtin and user type this typer ever unifies against
; is equatable, so no caller needs to ask.
;
; TODO(this slice): does not yet special-case the built-in Maybe/Result/List
; nominal wrappers when they appear inside a user nominal's own fields —
; they are only ever produced as TMaybe/TList/TResult directly, never
; re-wrapped as TNominal, so this is complete for every type this typer can
; itself construct.

pub let is-showable(t: Type) -> Bool =
  match (t)
    | TStringBuffer -> false
    | TRef(_) -> false
    | TFn(_, _) -> false
    | TList(elem) -> is-showable(elem)
    | TMaybe(elem) -> is-showable(elem)
    | TMap(k, v) -> is-showable(k) && is-showable(v)
    | TResult(ok, err) -> is-showable(ok) && is-showable(err)
    | TNominal(_, _, args, _) -> type-list-all-showable(args)
    | TProduct(elems) -> type-list-all-showable(elems)
    | _ -> true

let type-list-all-showable(xs: List Type) -> Bool =
  match (xs)
    | [] -> true
    | x :: rest -> is-showable(x) && type-list-all-showable(rest)

pub let is-orderable(t: Type) -> Bool =
  match (t)
    | TInt -> true
    | TBool -> true
    | TChar -> true
    | TStr -> true
    | TSym -> true
    | TUnit -> true
    | TFloat -> false
    | TStringBuffer -> false
    | TRef(_) -> false
    | TFn(_, _) -> false
    | TVar(_, _) -> true
    | TParam(_) -> true
    | TList(elem) -> is-orderable(elem)
    | TMaybe(elem) -> is-orderable(elem)
    | TMap(k, v) -> is-orderable(k) && is-orderable(v)
    | TResult(ok, err) -> is-orderable(ok) && is-orderable(err)
    | TNominal(_, _, args, _) -> type-list-all-orderable(args)
    | TProduct(elems) -> type-list-all-orderable(elems)

let type-list-all-orderable(xs: List Type) -> Bool =
  match (xs)
    | [] -> true
    | x :: rest -> is-orderable(x) && type-list-all-orderable(rest)

; Typechecker — a port of the Phase 2 critical subset of
; host/src/type/check.ts into Menard, so the compiler can typecheck its own
; source when it runs as stage0.
;
; Covers: top-level `defn` with signatures and mutual recursion (two-pass
; scheme collection, exactly like collectDefnScheme/typecheckDefn in the
; host); sequential `let` in bodies and at top level; `do`; `if`; `match` on
; variants, records and lists (with exhaustiveness); `loop`/`recur`;
; `fn`/`lambda`; `set!`/`ref`/`deref`; `quote`; the built-in Int/Bool/Str
; ops the compiler itself uses (+ - * / % < > <= >=, `=`, `show`,
; `compare`, `dump`, `print`/`println`, the Str/Char/Map/StringBuffer
; runtime built-ins, and the Maybe/Result/List/IoError nominal types); and
; simple polymorphic `defn`s via declared `[a]` type parameters.
;
; `spawn` / `spawn-capture` and SpawnStatus are registered
; (`install-spawn-status`). Import graphs are flattened before this typer
; runs (`src/modules/graph.mnd`). `extern` forms register the same scheme
; a `defn` header would, with no body. Still open:
;   - `=` is generic in `a`, matching the host typer. There is no separate
;     equatable predicate.
;   - `and`/`or`/`cond`/`when`/`while` are not special-cased here because
;     `src/mn.mnd`'s pipeline runs desugar before typecheck (spec §2.5:
;     "expanded during desugaring, before typing"), so this typer never
;     sees them on a real pipeline run. A caller that typechecks
;     un-desugared forms directly will see `E_TYPE_UNBOUND` on those heads.

import "../reader/ast.mnd"
import "../desugar/rest.mnd"
import "./types.mnd"
import std/list
import std/string as String
import std/map as Map

pub record TypeError {
  span: Span
  code: Str
  message: Str
}

; ---------------------------------------------------------------------------
; Environment. Every field below is a `Ref` for the same reason
; desugar.mnd's `diags` accumulator is: it is shared, mutable state
; threaded through the whole pass, and `Ref` is the idiomatic Menard
; substitute for the host's mutable `Map`/`number`/array fields (spec
; §2.3's note on mutable scope chains "behind a Ref").
;
; `subst` is one substitution shared by the entire typecheck pass rather
; than one per `defn` (as the host's `typecheckDefn` allocates): every
; unification variable's id is unique for the life of the pass (`next-var`
; only ever increments), so entries from an earlier `defn` are simply never
; looked up again once that `defn`'s check is done — behaviourally
; identical to discarding a fresh `Subst` per body, at the cost of the map
; growing monotonically instead of being reclaimed.

pub record TypeEnv {
  values: Ref (Map Str Scheme)
  types: Ref (Map Str TypeDef)
  ctors: Ref (Map Str CtorInfo)
  aliases: Ref (Map Str Type)
  type-bindings: Ref (Map Str Str)
  ctor-bindings: Ref (Map Str Str)
  next-var: Ref Int
  diags: Ref (List TypeError)
  subst: Ref (Map Int Type)
  loop-bindings: Ref (Maybe (List Type))
}

; `?` kind remembered while inferring, consumed when rewriting to match.
; kind: 0 = Maybe, 1 = Result.
record QuesNote {
  start: Int
  end: Int
  origin: Int
  kind: Int
}

let ques-notes = ref([])

let note-ques!(sp: Span, kind: Int) -> Unit =
  set!(ques-notes, QuesNote(sp.start, sp.end, sp.origin, kind) :: deref(ques-notes))

let find-ques-note(sp: Span, notes: List QuesNote) -> Maybe QuesNote =
  match (notes)
    | [] -> None()
    | QuesNote(s, e, o, k) :: rest ->
      if (s == sp.start && e == sp.end && o == sp.origin) -> Some(QuesNote(s, e, o, k)) | find-ques-note(sp, rest)

; Field indexes chosen while inferring `(project obj field)`, consumed when
; the checked forms are rewritten to `(slot obj index)` for the lowerer.
record ProjNote {
  start: Int
  end: Int
  origin: Int
  index: Int
}

; Indexes of record projections, filled during inference.
let proj-notes = ref([])

record PrintNote {
  span: Span
  types: List Type
}

let print-notes = ref([])
let print-functions = ref([])
let print-names = ref(Map.empty())

; Types of `show` arguments, so the rewrite can route composites through the
; type-directed printer instead of the runtime's scalar-only `mn_show`.
record ShowNote {
  start: Int
  end: Int
  origin: Int
  type: Type
}

let show-notes = ref([])

let note-show!(sp: Span, t: Type) -> Unit =
  set!(show-notes, ShowNote(sp.start, sp.end, sp.origin, t) :: deref(show-notes))

let find-show-note(sp: Span, notes: List ShowNote) -> Maybe Type =
  match (notes)
    | [] -> None()
    | ShowNote(start, end, origin, t) :: rest ->
      if (start == sp.start && end == sp.end && origin == sp.origin) -> Some(t) | find-show-note(sp, rest)

; Remember which slot a project form selected.
let note-project!(sp: Span, index: Int) -> Unit =
  set!(proj-notes, ProjNote(sp.start, sp.end, sp.origin, index) :: deref(proj-notes))

; True when the note was recorded for this span.
let proj-note-matches(sp: Span, note: ProjNote) -> Bool =
  match (note)
    | ProjNote(start, end, origin, _) ->
      sp.start == start && sp.end == end && sp.origin == origin

; The note for this span, if inference selected a field.
let find-proj-note(sp: Span, notes: List ProjNote) -> Maybe ProjNote =
  match (notes)
    | [] -> None()
    | note :: rest ->
      if (proj-note-matches(sp, note)) -> Some(note) | find-proj-note(sp, rest)

let value-get(env: TypeEnv, name: Str) -> Maybe Scheme =
  Map.lookup(name, deref(env.values))

let value-set(env: TypeEnv, name: Str, s: Scheme) -> Unit =
  set!(env.values, Map.set(name, s, deref(env.values)))

pub let type-bind!(env: TypeEnv, spelling: Str, id: Str) -> Unit =
  set!(env.type-bindings, Map.set(spelling, id, deref(env.type-bindings)))

pub let type-resolve(env: TypeEnv, spelling: Str) -> Str =
  match (Map.lookup(spelling, deref(env.type-bindings)))
    | Some(id) -> id
    | None -> spelling

pub let ctor-bind!(env: TypeEnv, spelling: Str, id: Str) -> Unit =
  set!(env.ctor-bindings, Map.set(spelling, id, deref(env.ctor-bindings)))

pub let ctor-resolve(env: TypeEnv, spelling: Str) -> Str =
  match (Map.lookup(spelling, deref(env.ctor-bindings)))
    | Some(id) -> id
    | None -> spelling

pub let type-get(env: TypeEnv, spelling: Str) -> Maybe TypeDef =
  Map.lookup(type-resolve(env, spelling), deref(env.types))

pub let type-set(env: TypeEnv, td: TypeDef) -> Unit {
  let name = type-def-name(td)
  let id = type-resolve(env, name)
  type-bind!(env, name, id)
  set!(env.types, Map.set(id, type-def-with-id(td, id), deref(env.types)))
}

pub let ctor-get(env: TypeEnv, name: Str) -> Maybe CtorInfo =
  Map.lookup(ctor-resolve(env, name), deref(env.ctors))

pub let ctor-set(env: TypeEnv, name: Str, c: CtorInfo) -> Unit =
  set!(env.ctors, Map.set(name, c, deref(env.ctors)))

let alias-get(env: TypeEnv, name: Str) -> Maybe Type =
  Map.lookup(name, deref(env.aliases))

let alias-set(env: TypeEnv, name: Str, t: Type) -> Unit =
  set!(env.aliases, Map.set(name, t, deref(env.aliases)))

; The one true mutating primitive in this file, named the way
; desugar.mnd's `push-diag!` is: it is the diagnostic accumulator.
let diag-exists(diags: List TypeError, code: Str, message: Str, span: Span) -> Bool =
  match (diags)
    | [] -> false
    | TypeError(s, c, m) :: rest ->
      if (s.start == span.start && s.end == span.end && s.origin == span.origin && c == code && m == message) -> true | diag-exists(rest, code, message, span)

let err!(env: TypeEnv, code: Str, message: Str, span: Span) -> Unit =
  if (diag-exists(deref(env.diags), code, message, span)) -> () | set!(env.diags, TypeError(span, code, message) :: deref(env.diags))

let fresh-var(env: TypeEnv, name: Str) -> Type {
  let id = deref(env.next-var)
  set!(env.next-var, id + 1)
  TVar(id, name)
}

let fresh-var-anon(env: TypeEnv) -> Type =
  fresh-var(env, "")

; ---------------------------------------------------------------------------
; Small Ast helpers, restated locally per src/'s "no prelude import" rule.

let sym-str(ast: Ast) -> Maybe Str =
  match (ast)
    | SymNode(n, _) -> Some(n)
    | _ -> None()

let is-sym(ast: Ast, name: Str) -> Bool =
  match (sym-str(ast))
    | Some(n) -> n == name
    | None -> false

let strip-trailing-colon(raw: Str) -> Str {
  let n = String.length(raw)
  if (n > 0 && String.byte(n - 1, raw) == 58) -> String.slice(0, n - 1, raw) | raw
}

let field-name(ast: Ast) -> Maybe Str =
  match (sym-str(ast))
    | None -> None()
    | Some(s) -> Some(strip-trailing-colon(s))

; ---------------------------------------------------------------------------
; Builtins (§2.8.1/§2.8.2): the Int/Bool/Str ops, intrinsics, Map,
; StringBuffer, Maybe/Result/List and the Tier-0 host seam that the
; compiler's own source (and any Phase 2 program) needs.

let install-arith(env: TypeEnv) -> Unit {
  value-set(env, "+", Scheme([], t-fn([t-int(), t-int()], t-int())))
  value-set(env, "-", Scheme([], t-fn([t-int(), t-int()], t-int())))
  value-set(env, "*", Scheme([], t-fn([t-int(), t-int()], t-int())))
  value-set(env, "/", Scheme([], t-fn([t-int(), t-int()], t-int())))
  value-set(env, "%", Scheme([], t-fn([t-int(), t-int()], t-int())))
  value-set(env, "f+", Scheme([], t-fn([t-float(), t-float()], t-float())))
  value-set(env, "f-", Scheme([], t-fn([t-float(), t-float()], t-float())))
  value-set(env, "f*", Scheme([], t-fn([t-float(), t-float()], t-float())))
  value-set(env, "f/", Scheme([], t-fn([t-float(), t-float()], t-float())))
  value-set(env, "<", Scheme([], t-fn([t-int(), t-int()], t-bool())))
  value-set(env, ">", Scheme([], t-fn([t-int(), t-int()], t-bool())))
  value-set(env, "<=", Scheme([], t-fn([t-int(), t-int()], t-bool())))
  value-set(env, ">=", Scheme([], t-fn([t-int(), t-int()], t-bool())))
}

let install-intrinsics(env: TypeEnv) -> Unit {
  value-set(env, "show", Scheme(["a"], t-fn([TParam("a")], t-str())))
  value-set(env, "print", Scheme([], t-fn([], t-unit())))
  value-set(env, "println", Scheme([], t-fn([], t-unit())))
  value-set(env, "=", Scheme(["a"], t-fn([TParam("a"), TParam("a")], t-bool())))
  value-set(env, "compare", Scheme(["a"], t-fn([TParam("a"), TParam("a")], t-int())))
  value-set(env, "dump", Scheme(["a"], t-fn([TParam("a")], t-unit())))
}

let install-ref-ops(env: TypeEnv) -> Unit {
  value-set(env, "ref", Scheme(["a"], t-fn([TParam("a")], t-ref(TParam("a")))))
  value-set(env, "deref", Scheme(["a"], t-fn([t-ref(TParam("a"))], TParam("a"))))
}

let install-map-ops(env: TypeEnv) -> Unit {
  let k = TParam("k")
  let v = TParam("v")
  let m = t-map(k, v)
  value-set(env, "map-new", Scheme(["k", "v"], t-fn([], m)))
  value-set(env, "map-set", Scheme(["k", "v"], t-fn([m, k, v], m)))
  value-set(env, "map-get", Scheme(["k", "v"], t-fn([m, k], t-maybe(v))))
  value-set(env, "map-has", Scheme(["k", "v"], t-fn([m, k], t-bool())))
  value-set(env, "map-keys", Scheme(["k", "v"], t-fn([m], t-list(k))))
}

let install-maybe(env: TypeEnv) -> Unit {
  type-set(env, VariantDef("Maybe", "Maybe", ["a"], [VariantCtor("None", Nil()), VariantCtor("Some", TParam("a") :: Nil())]))
  ctor-set(env, "None", CtorInfo("Maybe", "Maybe", [], ["a"]))
  ctor-set(env, "Some", CtorInfo("Maybe", "Maybe", [TParam("a")], ["a"]))
  value-set(env, "None", Scheme(["a"], t-fn([], t-maybe(TParam("a")))))
  value-set(env, "Some", Scheme(["a"], t-fn([TParam("a")], t-maybe(TParam("a")))))
}

let install-result(env: TypeEnv) -> Unit {
  type-set(env, VariantDef("Result", "Result", ["t", "e"], [VariantCtor("Ok", TParam("t") :: Nil()), VariantCtor("Err", TParam("e") :: Nil())]))
  ctor-set(env, "Ok", CtorInfo("Result", "Result", [TParam("t")], ["t", "e"]))
  ctor-set(env, "Err", CtorInfo("Result", "Result", [TParam("e")], ["t", "e"]))
  value-set(env, "Ok", Scheme(["t", "e"], t-fn([TParam("t")], t-result(TParam("t"), TParam("e")))))
  value-set(env, "Err", Scheme(["t", "e"], t-fn([TParam("e")], t-result(TParam("t"), TParam("e")))))
}

let install-list-type(env: TypeEnv) -> Unit {
  type-set(env, VariantDef("List", "List", ["a"], [VariantCtor("Nil", Nil()), VariantCtor("Cons", TParam("a") :: t-list(TParam("a")) :: Nil())]))
  ctor-set(env, "Nil", CtorInfo("List", "List", [], ["a"]))
  ctor-set(env, "Cons", CtorInfo("List", "List", [TParam("a"), t-list(TParam("a"))], ["a"]))
  value-set(env, "Nil", Scheme(["a"], t-fn([], t-list(TParam("a")))))
  value-set(env, "Cons", Scheme(["a"], t-fn([TParam("a"), t-list(TParam("a"))], t-list(TParam("a")))))
}

let install-builtins(env: TypeEnv) -> Unit {
  install-arith(env)
  install-intrinsics(env)
  install-ref-ops(env)
  install-map-ops(env)
  install-maybe(env)
  install-result(env)
  install-list-type(env)
}

pub let empty-env() -> TypeEnv {
  let env = TypeEnv(ref(Map.empty()), ref(Map.empty()), ref(Map.empty()), ref(Map.empty()), ref(Map.empty()), ref(Map.empty()), ref(0), ref([]), ref(Map.empty()), ref(None()))
  install-builtins(env)
  env
}

; ---------------------------------------------------------------------------
; Substitution: apply, occurs-check, unify. `subst` lives on `env` (a Ref),
; so every function below that needs it just takes `env`.

let apply-subst(env: TypeEnv, t: Type) -> Type =
  match (t)
    | TVar(id, _) -> apply-subst-var(env, t, id)
    | TList(e) -> t-list(apply-subst(env, e))
    | TMap(k, v) -> t-map(apply-subst(env, k), apply-subst(env, v))
    | TMaybe(e) -> t-maybe(apply-subst(env, e))
    | TResult(o, e) -> t-result(apply-subst(env, o), apply-subst(env, e))
    | TRef(e) -> t-ref(apply-subst(env, e))
    | TFn(ps, r) -> t-fn(apply-subst-list(env, ps), apply-subst(env, r))
    | TNominal(id, n, a, k) -> TNominal(id, n, apply-subst-list(env, a), k)
    | TProduct(elems) -> t-product(apply-subst-list(env, elems))
    | _ -> t

let apply-subst-var(env: TypeEnv, t: Type, id: Int) -> Type =
  match (Map.lookup(id, deref(env.subst)))
    | Some(bound) -> apply-subst(env, bound)
    | None -> t

let apply-subst-list(env: TypeEnv, xs: List Type) -> List Type =
  match (xs)
    | [] -> []
    | x :: rest -> apply-subst(env, x) :: apply-subst-list(env, rest)

let occurs(env: TypeEnv, id: Int, t: Type) -> Bool =
  occurs-in(env, id, apply-subst(env, t))

let occurs-in(env: TypeEnv, id: Int, t: Type) -> Bool =
  match (t)
    | TVar(tid, _) -> tid == id
    | TList(e) -> occurs(env, id, e)
    | TMaybe(e) -> occurs(env, id, e)
    | TRef(e) -> occurs(env, id, e)
    | TMap(k, v) -> occurs(env, id, k) || occurs(env, id, v)
    | TResult(o, e) -> occurs(env, id, o) || occurs(env, id, e)
    | TFn(ps, r) -> occurs-list(env, id, ps) || occurs(env, id, r)
    | TNominal(_, _, a, _) -> occurs-list(env, id, a)
    | TProduct(elems) -> occurs-list(env, id, elems)
    | _ -> false

let occurs-list(env: TypeEnv, id: Int, xs: List Type) -> Bool =
  match (xs)
    | [] -> false
    | x :: rest -> occurs(env, id, x) || occurs-list(env, id, rest)

let unify(env: TypeEnv, a: Type, b: Type, span: Span) -> Bool {
  let ta = apply-subst(env, a)
  let tb = apply-subst(env, b)
  if (type-equal(ta, tb)) -> true | unify-dispatch(env, ta, tb, span)
}

let unify-dispatch(env: TypeEnv, ta: Type, tb: Type, span: Span) -> Bool =
  match (ta)
    | TVar(id, _) -> unify-var(env, id, tb, span)
    | _ -> unify-nonvar(env, ta, tb, span)

let unify-var(env: TypeEnv, id: Int, tb: Type, span: Span) -> Bool =
  cond
    | occurs(env, id, tb) ->
      {
        err!(env, "E_TYPE_OCCURS", "infinite type", span)
        false
      }
    | else ->
      {
        set!(env.subst, Map.set(id, tb, deref(env.subst)))
        true
      }

let unify-nonvar(env: TypeEnv, ta: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TVar(id, _) -> unify-var(env, id, ta, span)
    | _ -> unify-structural(env, ta, tb, span)

let unify-structural(env: TypeEnv, ta: Type, tb: Type, span: Span) -> Bool =
  match (ta)
    | TParam(na) -> unify-param(env, na, tb, span)
    | TList(ea) -> unify-list(env, ea, tb, span)
    | TMaybe(ea) -> unify-maybe(env, ea, tb, span)
    | TRef(ea) -> unify-ref(env, ea, tb, span)
    | TMap(ka, va) -> unify-map(env, ka, va, tb, span)
    | TResult(oa, ea) -> unify-result(env, oa, ea, tb, span)
    | TFn(pa, ra) -> unify-fn(env, pa, ra, tb, span)
    | TNominal(ia, na, aa, ka) -> unify-nominal(env, ia, na, aa, ka, tb, span)
    | TProduct(ea) -> unify-product(env, ea, tb, span)
    | _ -> unify-mismatch(env, ta, tb, span)

let unify-param(env: TypeEnv, na: Str, tb: Type, span: Span) -> Bool =
  match (tb)
    | TParam(nb) ->
      if (na == nb) -> true | unify-mismatch(env, TParam(na), tb, span)
    | _ -> unify-mismatch(env, TParam(na), tb, span)

let unify-list(env: TypeEnv, ea: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TList(eb) -> unify(env, ea, eb, span)
    | _ -> unify-mismatch(env, t-list(ea), tb, span)

let unify-maybe(env: TypeEnv, ea: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TMaybe(eb) -> unify(env, ea, eb, span)
    | _ -> unify-mismatch(env, t-maybe(ea), tb, span)

let unify-ref(env: TypeEnv, ea: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TRef(eb) -> unify(env, ea, eb, span)
    | _ -> unify-mismatch(env, t-ref(ea), tb, span)

let unify-map(env: TypeEnv, ka: Type, va: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TMap(kb, vb) ->
      if (unify(env, ka, kb, span)) -> unify(env, va, vb, span) | false
    | _ -> unify-mismatch(env, t-map(ka, va), tb, span)

let unify-result(env: TypeEnv, oa: Type, ea: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TResult(ob, eb) ->
      if (unify(env, oa, ob, span)) -> unify(env, ea, eb, span) | false
    | _ -> unify-mismatch(env, t-result(oa, ea), tb, span)

let unify-fn(env: TypeEnv, pa: List Type, ra: Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TFn(pb, rb) -> unify-fn-params(env, pa, pb, ra, rb, span)
    | _ -> unify-mismatch(env, t-fn(pa, ra), tb, span)

let unify-fn-params(env: TypeEnv, pa: List Type, pb: List Type, ra: Type, rb: Type, span: Span) -> Bool =
  cond
    | length(pa) == length(pb) ->
      if (unify-list-pairwise(env, pa, pb, span)) -> unify(env, ra, rb, span) | false
    | else ->
      {
        err!(env, "E_TYPE_ARITY", String.concat("function arity mismatch: expected ", show(length(pa)), ", found ", show(length(pb))), span)
        false
      }

let unify-list-pairwise(env: TypeEnv, xs: List Type, ys: List Type, span: Span) -> Bool =
  match (xs)
    | [] -> true
    | x :: xrest ->
      match (ys)
        | [] -> true
        | y :: yrest ->
          if (unify(env, x, y, span)) -> unify-list-pairwise(env, xrest, yrest, span) | false

let unify-nominal(env: TypeEnv, ia: Str, na: Str, aa: List Type, ka: Str, tb: Type, span: Span) -> Bool =
  match (tb)
    | TNominal(ib, nb, ab, kb) -> unify-nominal-same(env, ia, na, aa, ka, ib, nb, ab, kb, span)
    | _ -> unify-mismatch(env, TNominal(ia, na, aa, ka), tb, span)

let unify-nominal-same(env: TypeEnv, ia: Str, na: Str, aa: List Type, ka: Str, ib: Str, nb: Str, ab: List Type, kb: Str, span: Span) -> Bool =
  cond
    | ia == ib ->
      cond
        | length(aa) == length(ab) -> unify-list-pairwise(env, aa, ab, span)
        | else ->
          {
            err!(env, "E_TYPE_MISMATCH", String.concat("type argument count mismatch for ", na), span)
            false
          }
    | else -> unify-mismatch(env, TNominal(ia, na, aa, ka), TNominal(ib, nb, ab, kb), span)

; Structural, elementwise — tuples have no declared name to compare, unlike
; `unify-nominal-same`.
let unify-product(env: TypeEnv, ea: List Type, tb: Type, span: Span) -> Bool =
  match (tb)
    | TProduct(eb) -> unify-product-same(env, ea, eb, span)
    | _ -> unify-mismatch(env, t-product(ea), tb, span)

let unify-product-same(env: TypeEnv, ea: List Type, eb: List Type, span: Span) -> Bool =
  cond
    | length(ea) == length(eb) -> unify-list-pairwise(env, ea, eb, span)
    | else ->
      {
        err!(env, "E_TYPE_ARITY", String.concat("tuple arity mismatch: expected ", show(length(ea)), ", found ", show(length(eb))), span)
        false
      }

let unify-mismatch(env: TypeEnv, ta: Type, tb: Type, span: Span) -> Bool {
  err!(env, "E_TYPE_MISMATCH", String.concat("expected ", type-show(ta), ", found ", type-show(tb)), span)
  false
}

let expect-type(env: TypeEnv, got: Type, expected: Type, span: Span) -> Type {
  unify(env, got, expected, span)
  apply-subst(env, expected)
}

; ---------------------------------------------------------------------------
; Instantiation: fresh unification variables for a scheme's own parameters.

let fresh-param-map(env: TypeEnv, params: List Str) -> Map Str Type =
  match (params)
    | [] -> Map.empty()
    | p :: rest -> Map.set(p, fresh-var(env, p), fresh-param-map(env, rest))

let replace-params(t: Type, m: Map Str Type) -> Type =
  match (t)
    | TParam(name) -> replace-param-lookup(t, name, m)
    | TList(e) -> t-list(replace-params(e, m))
    | TMap(k, v) -> t-map(replace-params(k, m), replace-params(v, m))
    | TMaybe(e) -> t-maybe(replace-params(e, m))
    | TResult(o, e) -> t-result(replace-params(o, m), replace-params(e, m))
    | TRef(e) -> t-ref(replace-params(e, m))
    | TFn(ps, r) -> t-fn(replace-params-list(ps, m), replace-params(r, m))
    | TNominal(id, n, a, k) -> TNominal(id, n, replace-params-list(a, m), k)
    | TProduct(elems) -> t-product(replace-params-list(elems, m))
    | _ -> t

let replace-param-lookup(t: Type, name: Str, m: Map Str Type) -> Type =
  match (Map.lookup(name, m))
    | Some(t2) -> t2
    | None -> t

let replace-params-list(xs: List Type, m: Map Str Type) -> List Type =
  match (xs)
    | [] -> []
    | x :: rest -> replace-params(x, m) :: replace-params-list(rest, m)

let instantiate-with(env: TypeEnv, params: List Str, ty: Type) -> Type =
  match (params)
    | [] -> ty
    | _ -> replace-params(ty, fresh-param-map(env, params))

let instantiate(env: TypeEnv, scheme: Scheme) -> Type =
  match (scheme)
    | Scheme(params, ty) -> instantiate-with(env, params, ty)

; ---------------------------------------------------------------------------
; Type-expression parsing: `(List T)`, `(Map K V)`, `(Maybe T)`,
; `(Result T E)`, `(Ref T)`, `(Fn T1 T2 -> R)`, primitives, declared type
; parameters, aliases, and nominal (record/variant) type names.

record ArrowSplit {
  before: List Ast
  after: List Ast
}

let arrow-split-before(s: ArrowSplit) -> List Ast =
  match (s)
    | ArrowSplit(b, _) -> b

let arrow-split-after(s: ArrowSplit) -> List Ast =
  match (s)
    | ArrowSplit(_, a) -> a

let find-arrow(elems: List Ast) -> Maybe ArrowSplit =
  match (elems)
    | [] -> None()
    | e :: rest -> find-arrow-cons(e, rest)

let find-arrow-cons(e: Ast, rest: List Ast) -> Maybe ArrowSplit =
  if (is-sym(e, "->")) -> Some(ArrowSplit([], rest)) | find-arrow-cons-recurse(e, rest)

let find-arrow-cons-recurse(e: Ast, rest: List Ast) -> Maybe ArrowSplit =
  match (find-arrow(rest))
    | None -> None()
    | Some(split) -> Some(ArrowSplit(e :: arrow-split-before(split), arrow-split-after(split)))

let type-def-kind(td: TypeDef) -> Str =
  match (td)
    | RecordDef(_, _, _, _) -> "record"
    | VariantDef(_, _, _, _) -> "variant"

let parse-type-exprs(env: TypeEnv, asts: List Ast, params: List Str) -> List Type =
  match (asts)
    | [] -> []
    | a :: rest -> parse-type-expr(env, a, params) :: parse-type-exprs(env, rest, params)

let parse-type-expr(env: TypeEnv, ast: Ast, params: List Str) -> Type =
  match (ast)
    | SymNode(name, sp) -> parse-type-expr-sym(env, name, sp, params)
    | ParenNode(elems, sp) -> parse-type-expr-paren(env, elems, sp, params)
    | _ ->
      {
        err!(env, "E_TYPE_EXPR", "invalid type expression", ast-span(ast))
        fresh-var-anon(env)
      }

let parse-type-expr-sym(env: TypeEnv, name: Str, sp: Span, params: List Str) -> Type =
  if (member(name, params)) -> TParam(name) | parse-type-expr-sym-prim(env, name, sp)

let parse-type-expr-sym-prim(env: TypeEnv, name: Str, sp: Span) -> Type =
  match (name)
    | "Int" -> t-int()
    | "Float" -> t-float()
    | "Bool" -> t-bool()
    | "Char" -> t-char()
    | "Str" -> t-str()
    | "Sym" -> t-sym()
    | "Unit" -> t-unit()
    | "StringBuffer" -> t-string-buffer()
    | _ -> parse-type-expr-sym-named(env, name, sp)

let parse-type-expr-sym-named(env: TypeEnv, name: Str, sp: Span) -> Type =
  match (alias-get(env, name))
    | Some(t) -> t
    | None -> parse-type-expr-sym-nominal(env, name, sp)

let parse-type-expr-sym-nominal(env: TypeEnv, name: Str, sp: Span) -> Type =
  match (type-get(env, name))
    | Some(td) -> t-nominal-id(type-def-id(td), type-def-name(td), [], type-def-kind(td))
    | None ->
      {
        err!(env, "E_TYPE_UNKNOWN", String.concat("unknown type ", name), sp)
        fresh-var-anon(env)
      }

let parse-type-expr-paren(env: TypeEnv, elems: List Ast, sp: Span, params: List Str) -> Type =
  match (elems)
    | [] -> t-unit()
    | head :: args -> parse-type-expr-app(env, head, args, sp, params)

let parse-type-expr-app(env: TypeEnv, head: Ast, args: List Ast, sp: Span, params: List Str) -> Type =
  match (sym-str(head))
    | None ->
      {
        err!(env, "E_TYPE_EXPR", "invalid type expression", sp)
        fresh-var-anon(env)
      }
    | Some(hn) -> parse-type-expr-app-named(env, hn, args, sp, params)

let t-list-of(elem: Type) -> Type =
  t-list(elem)

let t-maybe-of(elem: Type) -> Type =
  t-maybe(elem)

let t-ref-of(elem: Type) -> Type =
  t-ref(elem)

let parse-type-expr-app-named(env: TypeEnv, hn: Str, args: List Ast, sp: Span, params: List Str) -> Type =
  match (hn)
    | "List" -> parse-type-expr-one(env, "List", args, sp, params, t-list-of)
    | "Maybe" -> parse-type-expr-one(env, "Maybe", args, sp, params, t-maybe-of)
    | "Ref" -> parse-type-expr-one(env, "Ref", args, sp, params, t-ref-of)
    | "Map" -> parse-type-expr-two(env, "Map", args, sp, params, t-map)
    | "Result" -> parse-type-expr-two(env, "Result", args, sp, params, t-result)
    | "Fn" -> parse-type-expr-fn(env, args, sp, params)
    | "product" -> parse-type-expr-product(env, args, sp, params)
    | _ -> parse-type-expr-nominal(env, hn, args, sp, params)

; `T1 * T2 * …` (≥2 factors) from `parse-type-product` in the reader.
let parse-type-expr-product(env: TypeEnv, args: List Ast, sp: Span, params: List Str) -> Type =
  cond
    | length(args) < 2 ->
      {
        err!(env, "E_TYPE_EXPR", "product type requires at least two factors", sp)
        fresh-var-anon(env)
      }
    | else -> t-product(parse-type-exprs(env, args, params))

let parse-type-expr-one(env: TypeEnv, name: Str, args: List Ast, sp: Span, params: List Str, mk: (Type) -> Type) -> Type =
  match (args)
    | [a] -> mk(parse-type-expr(env, a, params))
    | _ ->
      {
        err!(env, "E_TYPE_EXPR", String.concat(name, " requires exactly one type argument"), sp)
        fresh-var-anon(env)
      }

let parse-type-expr-two(env: TypeEnv, name: Str, args: List Ast, sp: Span, params: List Str, mk: (Type, Type) -> Type) -> Type =
  match (args)
    | [a, b] -> mk(parse-type-expr(env, a, params), parse-type-expr(env, b, params))
    | _ ->
      {
        err!(env, "E_TYPE_EXPR", String.concat(name, " requires exactly two type arguments"), sp)
        fresh-var-anon(env)
      }

let parse-type-expr-fn(env: TypeEnv, args: List Ast, sp: Span, params: List Str) -> Type =
  match (find-arrow(args))
    | None ->
      {
        err!(env, "E_TYPE_FN", "Fn type requires ->", sp)
        fresh-var-anon(env)
      }
    | Some(split) -> t-fn(parse-type-exprs(env, arrow-split-before(split), params), parse-type-expr-first(env, arrow-split-after(split), sp, params))

let parse-type-expr-first(env: TypeEnv, after: List Ast, sp: Span, params: List Str) -> Type =
  match (after)
    | r :: _ -> parse-type-expr(env, r, params)
    | [] ->
      {
        err!(env, "E_TYPE_FN", "Fn type requires a return type after ->", sp)
        fresh-var-anon(env)
      }

let parse-type-expr-nominal(env: TypeEnv, hn: Str, args: List Ast, sp: Span, params: List Str) -> Type =
  match (type-get(env, hn))
    | Some(td) -> t-nominal-id(type-def-id(td), type-def-name(td), parse-type-exprs(env, args, params), type-def-kind(td))
    | None ->
      {
        err!(env, "E_TYPE_EXPR", "invalid type expression", sp)
        fresh-var-anon(env)
      }

; ---------------------------------------------------------------------------
; `Name` or `(Name [params…])`, shared by defn/defrec/variant headers.

record NameParams {
  name: Str
  params: List Str
}

let name-params-name(np: NameParams) -> Str =
  match (np)
    | NameParams(n, _) -> n

let name-params-params(np: NameParams) -> List Str =
  match (np)
    | NameParams(_, p) -> p

let syms-of(elems: List Ast) -> List Str =
  match (elems)
    | [] -> []
    | e :: rest -> syms-of-cons(e, rest)

let syms-of-cons(e: Ast, rest: List Ast) -> List Str =
  match (sym-str(e))
    | None -> syms-of(rest)
    | Some(n) -> n :: syms-of(rest)

let parse-bracket-syms(ast: Ast) -> List Str =
  match (ast)
    | BracketNode(elems, _) -> syms-of(elems)
    | _ -> []

let parse-type-name-params(more: List Ast) -> List Str =
  match (more)
    | tp-ast :: _ -> parse-bracket-syms(tp-ast)
    | [] -> []

let parse-type-name-paren-named(name-ast: Ast, more: List Ast) -> Maybe NameParams =
  match (sym-str(name-ast))
    | None -> None()
    | Some(name) -> Some(NameParams(name, parse-type-name-params(more)))

let parse-type-name-paren(elems: List Ast) -> Maybe NameParams =
  match (elems)
    | name-ast :: more -> parse-type-name-paren-named(name-ast, more)
    | [] -> None()

let parse-type-name(ast: Ast) -> Maybe NameParams =
  match (ast)
    | SymNode(name, _) -> Some(NameParams(name, []))
    | ParenNode(elems, _) -> parse-type-name-paren(elems)
    | _ -> None()

let params-to-types(params: List Str) -> List Type =
  match (params)
    | [] -> []
    | p :: rest -> TParam(p) :: params-to-types(rest)

; Declaration collection. Names are registered before fields and payloads
; (`register-stubs`), then each declaration is checked.

let collect-def(env: TypeEnv, ast: Ast) -> Unit =
  match (ast)
    | ParenNode(elems, sp) -> collect-def-elems(env, elems, sp)
    | _ -> ()

let collect-def-elems(env: TypeEnv, elems: List Ast, sp: Span) -> Unit =
  match (elems)
    | [] -> ()
    | head :: rest -> collect-def-head(env, head, rest, sp)

let collect-def-head(env: TypeEnv, head: Ast, rest: List Ast, sp: Span) -> Unit =
  match (sym-str(head))
    | None -> ()
    | Some(hn) -> collect-def-named(env, hn, rest, sp)

let collect-def-named(env: TypeEnv, hn: Str, rest: List Ast, sp: Span) -> Unit =
  match (hn)
    | "pub" -> collect-def-elems(env, rest, sp)
    | "alias" -> collect-alias(env, rest, sp)
    | "defrec" -> collect-defrec(env, rest, sp)
    | "variant" -> collect-variant(env, rest, sp)
    | _ -> ()

; alias

let collect-alias(env: TypeEnv, rest: List Ast, sp: Span) -> Unit =
  match (rest)
    | name-part :: type-part :: _ -> collect-alias-named(env, name-part, type-part)
    | _ -> ()

let collect-alias-named(env: TypeEnv, name-part: Ast, type-part: Ast) -> Unit =
  match (sym-str(name-part))
    | None -> ()
    | Some(name) -> alias-set(env, name, parse-type-expr(env, type-part, []))

; defrec

let record-field-type(f: RecordField) -> Type =
  match (f)
    | RecordField(_, t) -> t

let record-field-types(fields: List RecordField) -> List Type =
  match (fields)
    | [] -> []
    | f :: rest -> record-field-type(f) :: record-field-types(rest)

let parse-record-field-named(env: TypeEnv, name-ast: Ast, type-ast: Ast, params: List Str) -> Maybe RecordField =
  match (field-name(name-ast))
    | None -> None()
    | Some(name) -> Some(RecordField(name, parse-type-expr(env, type-ast, params)))

let parse-record-field-elems(env: TypeEnv, felems: List Ast, params: List Str) -> Maybe RecordField =
  match (felems)
    | name-ast :: type-ast :: _ -> parse-record-field-named(env, name-ast, type-ast, params)
    | _ -> None()

let parse-record-field(env: TypeEnv, f: Ast, params: List Str) -> Maybe RecordField =
  match (f)
    | ParenNode(felems, _) -> parse-record-field-elems(env, felems, params)
    | _ -> None()

let parse-record-fields(env: TypeEnv, fields: List Ast, params: List Str) -> List RecordField =
  match (fields)
    | [] -> []
    | f :: rest -> parse-record-fields-cons(env, f, rest, params)

let parse-record-fields-cons(env: TypeEnv, f: Ast, rest: List Ast, params: List Str) -> List RecordField =
  match (parse-record-field(env, f, params))
    | None -> parse-record-fields(env, rest, params)
    | Some(rf) -> rf :: parse-record-fields(env, rest, params)

let collect-defrec-fields(env: TypeEnv, np: NameParams, fields: List Ast) -> Unit {
  let name = name-params-name(np)
  let params = name-params-params(np)
  let id = type-resolve(env, name)
  let rfields = parse-record-fields(env, fields, params)
  let ftypes = record-field-types(rfields)
  type-set(env, RecordDef(name, name, params, rfields))
  let canonical = ctor-resolve(env, name)
  ctor-bind!(env, name, canonical)
  ctor-set(env, canonical, CtorInfo(id, name, ftypes, params))
  value-set(env, canonical, Scheme(params, t-fn(ftypes, t-nominal-id(id, name, params-to-types(params), "record"))))
}

let collect-defrec-named(env: TypeEnv, name-part: Ast, fields: List Ast) -> Unit =
  match (parse-type-name(name-part))
    | None -> ()
    | Some(np) -> collect-defrec-fields(env, np, fields)

let collect-defrec(env: TypeEnv, rest: List Ast, sp: Span) -> Unit =
  match (rest)
    | name-part :: fields -> collect-defrec-named(env, name-part, fields)
    | [] -> ()

; variant

let ctor-owner(c: CtorInfo) -> Str =
  ctor-owner-name(c)

; A constructor already owned by another variant stays there. SpawnError
; lists the IoError singletons NotFound and Permission for exhaustiveness
; without taking them away from IoError.
let register-variant-ctor-set(env: TypeEnv, type-id: Str, type-name: Str, params: List Str, cname: Str, payloads: List Type) -> Unit {
  let canonical = ctor-resolve(env, cname)
  ctor-bind!(env, cname, canonical)
  ctor-set(env, canonical, CtorInfo(type-id, type-name, payloads, params))
  value-set(env, canonical, Scheme(params, t-fn(payloads, t-nominal-id(type-id, type-name, params-to-types(params), "variant"))))
}

let register-variant-ctor-checked(env: TypeEnv, type-id: Str, type-name: Str, params: List Str, cname: Str, payloads: List Type) -> Unit =
  match (ctor-get(env, cname))
    | Some(info) ->
      if (ctor-owner-id(info) == type-id) -> register-variant-ctor-set(env, type-id, type-name, params, cname, payloads)
    | None -> register-variant-ctor-set(env, type-id, type-name, params, cname, payloads)

let register-variant-ctor(env: TypeEnv, type-id: Str, type-name: Str, params: List Str, vc: VariantCtor) -> Unit =
  match (vc)
    | VariantCtor(cname, payloads) -> register-variant-ctor-checked(env, type-id, type-name, params, cname, payloads)

let parse-variant-ctor-named(env: TypeEnv, cname-ast: Ast, payload-asts: List Ast, params: List Str) -> Maybe VariantCtor =
  match (sym-str(cname-ast))
    | None -> None()
    | Some(cname) -> Some(VariantCtor(cname, parse-type-exprs(env, payload-asts, params)))

let parse-variant-ctor-elems(env: TypeEnv, celems: List Ast, params: List Str) -> Maybe VariantCtor =
  match (celems)
    | cname-ast :: payload-asts -> parse-variant-ctor-named(env, cname-ast, payload-asts, params)
    | [] -> None()

let parse-variant-ctor(env: TypeEnv, c: Ast, params: List Str) -> Maybe VariantCtor =
  match (c)
    | ParenNode(celems, _) -> parse-variant-ctor-elems(env, celems, params)
    | _ -> None()

let collect-variant-ctor-list(env: TypeEnv, type-id: Str, type-name: Str, params: List Str, ctor-asts: List Ast) -> List VariantCtor =
  match (ctor-asts)
    | [] -> []
    | c :: rest -> collect-variant-ctor-cons(env, type-id, type-name, params, c, rest)

let collect-variant-ctor-cons(env: TypeEnv, type-id: Str, type-name: Str, params: List Str, c: Ast, rest: List Ast) -> List VariantCtor =
  match (parse-variant-ctor(env, c, params))
    | None -> collect-variant-ctor-list(env, type-id, type-name, params, rest)
    | Some(vc) ->
      {
        register-variant-ctor(env, type-id, type-name, params, vc)
        vc :: collect-variant-ctor-list(env, type-id, type-name, params, rest)
      }

let collect-variant-ctors(env: TypeEnv, np: NameParams, ctor-asts: List Ast) -> Unit {
  let name = name-params-name(np)
  let params = name-params-params(np)
  let id = type-resolve(env, name)
  type-set(env, VariantDef(name, name, params, []))
  let vctors = collect-variant-ctor-list(env, id, name, params, ctor-asts)
  type-set(env, VariantDef(name, name, params, vctors))
}

let collect-variant-named(env: TypeEnv, name-part: Ast, ctors: List Ast) -> Unit =
  match (parse-type-name(name-part))
    | None -> ()
    | Some(np) -> collect-variant-ctors(env, np, ctors)

let collect-variant(env: TypeEnv, rest: List Ast, sp: Span) -> Unit =
  match (rest)
    | name-part :: ctors -> collect-variant-named(env, name-part, ctors)
    | [] -> ()

; ---------------------------------------------------------------------------
; defn header parsing, shared by scheme-collection (pass 1) and body
; checking (pass 2).

record ParamsSplit {
  names: List Str
  types: List Type
  rest: List Ast
}

let parse-params-field(env: TypeEnv, name-ast: Ast, type-ast: Ast, rest: List Ast, param-set: List Str) -> ParamsSplit =
  match (field-name(name-ast))
    | None -> parse-params(env, rest, param-set)
    | Some(pn) ->
      {
        let pt = parse-type-expr(env, type-ast, param-set)
        parse-params-cons(pn, pt, parse-params(env, rest, param-set))
      }

let parse-params-cons(name: Str, t: Type, tail: ParamsSplit) -> ParamsSplit =
  match (tail)
    | ParamsSplit(ns, ts, rs) -> ParamsSplit(name :: ns, t :: ts, rs)

let parse-params-elem(env: TypeEnv, e: Ast, rest: List Ast, param-set: List Str) -> ParamsSplit =
  if (is-sym(e, "->")) -> ParamsSplit([], [], rest) | parse-params-elem-field(env, e, rest, param-set)

let parse-params-elem-field(env: TypeEnv, e: Ast, rest: List Ast, param-set: List Str) -> ParamsSplit =
  match (e)
    | ParenNode(name-ast :: type-ast :: _, _) -> parse-params-field(env, name-ast, type-ast, rest, param-set)
    | _ -> ParamsSplit([], [], e :: rest)

let parse-params(env: TypeEnv, elems: List Ast, param-set: List Str) -> ParamsSplit =
  match (elems)
    | [] -> ParamsSplit([], [], [])
    | e :: rest -> parse-params-elem(env, e, rest, param-set)

record ParsedDefn {
  name: Str
  type-params: List Str
  param-names: List Str
  param-types: List Type
  ret-type: Type
  body: List Ast
}

let parse-defn-return(env: TypeEnv, name: Str, type-params: List Str, split: ParamsSplit, whole-span: Span, report: Bool) -> Maybe ParsedDefn =
  match (split)
    | ParamsSplit(pnames, ptypes, rest2) -> parse-defn-return-rest(env, name, type-params, pnames, ptypes, rest2, whole-span, report)

let parse-defn-return-rest(env: TypeEnv, name: Str, type-params: List Str, pnames: List Str, ptypes: List Type, rest2: List Ast, whole-span: Span, report: Bool) -> Maybe ParsedDefn =
  match (rest2)
    | ret-ast :: body -> Some(ParsedDefn(name, type-params, pnames, ptypes, parse-type-expr(env, ret-ast, type-params), body))
    | [] ->
      {
        if (report) -> err!(env, "E_TYPE_DEFN", "defn missing return type", whole-span)
        None()
      }

let parse-defn-header(env: TypeEnv, name: Str, type-params: List Str, rest: List Ast, whole-span: Span, report: Bool) -> Maybe ParsedDefn =
  parse-defn-return(env, name, type-params, parse-params(env, rest, type-params), whole-span, report)

let parse-defn-name(env: TypeEnv, name-part: Ast, rest: List Ast, whole-span: Span, report: Bool) -> Maybe ParsedDefn =
  match (parse-type-name(name-part))
    | None ->
      {
        if (report) -> err!(env, "E_TYPE_DEFN", "malformed defn name", ast-span(name-part))
        None()
      }
    | Some(np) -> parse-defn-header(env, name-params-name(np), name-params-params(np), rest, whole-span, report)

let parse-defn(env: TypeEnv, elems: List Ast, whole-span: Span, report: Bool) -> Maybe ParsedDefn =
  match (elems)
    | _ :: name-part :: rest -> parse-defn-name(env, name-part, rest, whole-span, report)
    | _ ->
      {
        if (report) -> err!(env, "E_TYPE_DEFN", "malformed defn", whole-span)
        None()
      }

; ---------------------------------------------------------------------------
; Pass 1: register every defn's scheme (mutual recursion — spec §2.6's
; "forward reference to later defn" and "mutual recursion" typecheck
; because both defns' *signatures* are known before either *body* is
; checked, exactly like host/src/type/check.ts's collectDefnScheme).

let register-parsed-scheme(env: TypeEnv, p: ParsedDefn) -> Unit =
  match (p)
    | ParsedDefn(name, tparams, _, ptypes, ret, _) -> value-set(env, name, Scheme(tparams, t-fn(ptypes, ret)))

let register-defn-scheme(env: TypeEnv, elems: List Ast, sp: Span) -> Unit =
  match (parse-defn(env, elems, sp, false))
    | None -> ()
    | Some(p) -> register-parsed-scheme(env, p)

let collect-defn-scheme-named(env: TypeEnv, hn: Str, rest: List Ast, elems: List Ast, sp: Span) -> Unit =
  match (hn)
    | "pub" -> collect-defn-scheme-elems(env, rest, sp)
    | "defn" -> register-defn-scheme(env, elems, sp)
    | "extern" -> register-defn-scheme(env, elems, sp)
    | "runtime" -> register-defn-scheme(env, elems, sp)
    | _ -> ()

let collect-defn-scheme-head(env: TypeEnv, head: Ast, rest: List Ast, elems: List Ast, sp: Span) -> Unit =
  match (sym-str(head))
    | None -> ()
    | Some(hn) -> collect-defn-scheme-named(env, hn, rest, elems, sp)

let collect-defn-scheme-elems(env: TypeEnv, elems: List Ast, sp: Span) -> Unit =
  match (elems)
    | [] -> ()
    | head :: rest -> collect-defn-scheme-head(env, head, rest, elems, sp)

let collect-defn-scheme(env: TypeEnv, ast: Ast) -> Unit =
  match (ast)
    | ParenNode(elems, sp) -> collect-defn-scheme-elems(env, elems, sp)
    | _ -> ()

; ---------------------------------------------------------------------------
; Pass 2, body checking: `infer` and all its special forms.

let build-param-local(names: List Str, types: List Type) -> Map Str Type =
  match (names)
    | [] -> Map.empty()
    | n :: nrest ->
      match (types)
        | [] -> Map.empty()
        | t :: trest -> Map.set(n, t, build-param-local(nrest, trest))

let last-of(xs: List Ast) -> Maybe Ast =
  match (xs)
    | [] -> None()
    | [x] -> Some(x)
    | _ :: rest -> last-of(rest)

let defn-body-span(body: List Ast, fallback: Span) -> Span =
  match (last-of(body))
    | Some(a) -> ast-span(a)
    | None -> fallback

let typecheck-defn-body-type(env: TypeEnv, body: List Ast, local: Map Str Type) -> Type =
  match (body)
    | [] -> t-unit()
    | _ -> infer-sequence(env, body, local)

let typecheck-defn-body(env: TypeEnv, p: ParsedDefn, sp: Span) -> Unit =
  match (p)
    | ParsedDefn(_, _, pnames, ptypes, ret, body) ->
      {
        let local = build-param-local(pnames, ptypes)
        let bt = typecheck-defn-body-type(env, body, local)
        expect-type(env, bt, ret, defn-body-span(body, sp))
        ()
      }

let typecheck-defn(env: TypeEnv, elems: List Ast, sp: Span) -> Unit =
  match (parse-defn(env, elems, sp, true))
    | None -> ()
    | Some(p) -> typecheck-defn-body(env, p, sp)

; -- expressions --

let infer(env: TypeEnv, ast: Ast, local: Map Str Type) -> Type =
  match (ast)
    | IntNode(_, _) -> t-int()
    | FloatNode(_, _) -> t-float()
    | BoolNode(_, _) -> t-bool()
    | StrNode(_, _) -> t-str()
    | SymNode(name, sp) -> infer-sym(env, name, sp, local)
    | BracketNode(elems, sp) -> infer-bracket(env, elems, sp, local)
    | ParenNode(elems, sp) -> infer-paren(env, elems, sp, local)

let infer-sym-global(env: TypeEnv, name: Str, sp: Span) -> Type =
  match (value-get(env, ctor-resolve(env, name)))
    | Some(s) -> instantiate(env, s)
    | None ->
      {
        err!(env, "E_TYPE_UNBOUND", String.concat("unbound variable ", name), sp)
        fresh-var-anon(env)
      }

let infer-sym(env: TypeEnv, name: Str, sp: Span, local: Map Str Type) -> Type =
  if (name == "_") -> fresh-var-anon(env) | infer-sym-lookup(env, name, sp, local)

let infer-sym-lookup(env: TypeEnv, name: Str, sp: Span, local: Map Str Type) -> Type =
  match (Map.lookup(name, local))
    | Some(t) -> apply-subst(env, t)
    | None -> infer-sym-global(env, name, sp)

let check-bracket-rest(env: TypeEnv, rest: List Ast, et: Type, local: Map Str Type) -> Unit =
  match (rest)
    | [] -> ()
    | e :: more ->
      {
        expect-type(env, infer(env, e, local), et, ast-span(e))
        check-bracket-rest(env, more, et, local)
      }

let infer-bracket-nonempty(env: TypeEnv, first: Ast, rest: List Ast, local: Map Str Type) -> Type {
  let et = infer(env, first, local)
  check-bracket-rest(env, rest, et, local)
  t-list(apply-subst(env, et))
}

let infer-bracket(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | [] -> t-list(fresh-var-anon(env))
    | first :: rest -> infer-bracket-nonempty(env, first, rest, local)

; -- if --

let infer-if(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | [_, test, then, els] -> infer-if-checked(env, test, then, els, local)
    | _ ->
      {
        err!(env, "E_TYPE_ARITY", "if expects test, then, else", sp)
        fresh-var-anon(env)
      }

let infer-if-checked(env: TypeEnv, test: Ast, then: Ast, els: Ast, local: Map Str Type) -> Type {
  expect-type(env, infer(env, test, local), t-bool(), ast-span(test))
  let th = infer(env, then, local)
  let el = infer(env, els, local)
  ; A missing else is lowered to (). () is Unit, so a missing else
  ; typechecks only when every arm is Unit.
  expect-type(env, el, th, ast-span(els))
  apply-subst(env, th)
}

; -- let / do / sequences --

let infer-let-body(env: TypeEnv, body: List Ast, bound-type: Type, next: Map Str Type) -> Type =
  match (body)
    | [] -> bound-type
    | _ -> infer-sequence(env, body, next)

let infer-let-named(env: TypeEnv, name-ast: Ast, expr-ast: Ast, body: List Ast, local: Map Str Type) -> Type =
  match (sym-str(name-ast))
    | None -> infer-let-pattern(env, name-ast, expr-ast, body, local)
    | Some(name) ->
      {
        let t = infer-named-expr(env, name, expr-ast, local)
        infer-let-body(env, body, t, Map.set(name, t, local))
      }

; `let (p1, p2) = e` — the binder is a destructuring pattern, not a name.
let infer-let-pattern(env: TypeEnv, pat: Ast, expr-ast: Ast, body: List Ast, local: Map Str Type) -> Type {
  let t = infer(env, expr-ast, local)
  let loc = ref(local)
  bind-pattern(env, pat, t, loc, ref([]))
  infer-let-body(env, body, t, deref(loc))
}

let infer-let(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | _ :: name-ast :: expr-ast :: body -> infer-let-named(env, name-ast, expr-ast, body, local)
    | _ ->
      {
        err!(env, "E_TYPE_LET", "let requires name and expression", sp)
        fresh-var-anon(env)
      }

; `pat` is either a plain name (`SymNode`) or a destructuring pattern
; (e.g. a `(tuple …)` form) — `infer-sequence-let` dispatches on that.
record SimpleLet {
  pat: Ast
  expr: Ast
}

let as-simple-let-named(head: Ast, name-ast: Ast, expr-ast: Ast) -> Maybe SimpleLet =
  if (is-sym(head, "let")) -> Some(SimpleLet(name-ast, expr-ast)) | None()

let as-simple-let(f: Ast) -> Maybe SimpleLet =
  match (f)
    | ParenNode([head, name-ast, expr-ast], _) -> as-simple-let-named(head, name-ast, expr-ast)
    | _ -> None()

let infer-named-expr(env: TypeEnv, name: Str, expr: Ast, local: Map Str Type) -> Type =
  if (is-fn-expr(expr)) -> infer-recursive-fn(env, name, expr, local) | infer(env, expr, local)

let is-fn-expr(ast: Ast) -> Bool =
  match (ast)
    | ParenNode(h :: _, _) -> is-sym(h, "fn") || is-sym(h, "lambda")
    | _ -> false

let infer-recursive-fn(env: TypeEnv, name: Str, expr: Ast, local: Map Str Type) -> Type {
  let tv = fresh-var(env, name)
  let t = infer(env, expr, Map.set(name, tv, local))
  unify(env, tv, t, ast-span(expr))
  apply-subst(env, t)
}

let infer-sequence-rest(env: TypeEnv, rest: List Ast, local: Map Str Type, fallback: Type) -> Type =
  match (rest)
    | [] -> fallback
    | _ -> infer-sequence(env, rest, local)

let infer-sequence-let(env: TypeEnv, sl: SimpleLet, rest: List Ast, local: Map Str Type) -> Type =
  match (sl)
    | SimpleLet(pat, expr-ast) -> infer-sequence-let-pat(env, pat, expr-ast, rest, local)

let infer-sequence-let-pat(env: TypeEnv, pat: Ast, expr-ast: Ast, rest: List Ast, local: Map Str Type) -> Type =
  match (sym-str(pat))
    | Some(name) ->
      {
        let t = infer-named-expr(env, name, expr-ast, local)
        infer-sequence-rest(env, rest, Map.set(name, t, local), t)
      }
    | None -> infer-sequence-let-destructure(env, pat, expr-ast, rest, local)

; `let (p1, p2) = e` mid-sequence: the destructured names must stay
; visible to the forms after it, same as a plain `let name = e`.
let infer-sequence-let-destructure(env: TypeEnv, pat: Ast, expr-ast: Ast, rest: List Ast, local: Map Str Type) -> Type {
  let t = infer(env, expr-ast, local)
  let loc = ref(local)
  bind-pattern(env, pat, t, loc, ref([]))
  infer-sequence-rest(env, rest, deref(loc), t)
}

let infer-sequence-plain(env: TypeEnv, f: Ast, rest: List Ast, local: Map Str Type) -> Type {
  let t = infer(env, f, local)
  infer-sequence-rest(env, rest, local, t)
}

let infer-sequence-step(env: TypeEnv, f: Ast, rest: List Ast, local: Map Str Type) -> Type =
  match (as-simple-let(f))
    | Some(sl) -> infer-sequence-let(env, sl, rest, local)
    | None -> infer-sequence-plain(env, f, rest, local)

let infer-sequence(env: TypeEnv, forms: List Ast, local: Map Str Type) -> Type =
  match (forms)
    | [] -> t-unit()
    | f :: rest -> infer-sequence-step(env, f, rest, local)

let infer-do(env: TypeEnv, rest: List Ast, local: Map Str Type) -> Type =
  infer-sequence(env, rest, local)

; -- loop / recur --

record LoopAcc {
  local: Map Str Type
  types: List Type
}

let loop-acc-extend(m: Map Str Type, name-ast: Ast, t: Type) -> Map Str Type =
  match (sym-str(name-ast))
    | Some(n) -> Map.set(n, t, m)
    | None -> m

let loop-binding-pairs(env: TypeEnv, belems: List Ast, outer: Map Str Type) -> LoopAcc =
  match (belems)
    | [] -> LoopAcc(outer, [])
    | b :: rest -> loop-binding-pairs-cons(env, b, rest, outer)

let loop-binding-one(env: TypeEnv, name-ast: Ast, init-ast: Ast, rest: List Ast, outer: Map Str Type) -> LoopAcc {
  let t = infer(env, init-ast, outer)
  loop-binding-combine(env, name-ast, t, loop-binding-pairs(env, rest, outer))
}

let loop-binding-combine(env: TypeEnv, name-ast: Ast, t: Type, tail: LoopAcc) -> LoopAcc =
  match (tail)
    | LoopAcc(tl, tt) -> LoopAcc(loop-acc-extend(tl, name-ast, t), t :: tt)

let loop-binding-pairs-cons(env: TypeEnv, b: Ast, rest: List Ast, outer: Map Str Type) -> LoopAcc =
  match (b)
    | ParenNode(name-ast :: init-ast :: _, _) -> loop-binding-one(env, name-ast, init-ast, rest, outer)
    | _ -> loop-binding-pairs(env, rest, outer)

let infer-loop-run(env: TypeEnv, acc: LoopAcc, body-ast: Ast) -> Type =
  match (acc)
    | LoopAcc(loc-map, binding-types) -> infer-loop-run-with(env, loc-map, binding-types, body-ast)

let infer-loop-run-with(env: TypeEnv, loc-map: Map Str Type, binding-types: List Type, body-ast: Ast) -> Type {
  let prev = deref(env.loop-bindings)
  set!(env.loop-bindings, Some(binding-types))
  let body-type = infer(env, body-ast, loc-map)
  set!(env.loop-bindings, prev)
  body-type
}

let infer-loop-bindings-of(env: TypeEnv, bindings-ast: Ast, body-ast: Ast, local: Map Str Type) -> Type =
  match (bindings-ast)
    | ParenNode(belems, _) -> infer-loop-run(env, loop-binding-pairs(env, belems, local), body-ast)
    | _ -> infer-loop-run(env, LoopAcc(local, []), body-ast)

let infer-loop(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | _ :: bindings-ast :: body-ast :: _ -> infer-loop-bindings-of(env, bindings-ast, body-ast, local)
    | _ ->
      {
        err!(env, "E_TYPE_LOOP", "loop requires bindings and body", sp)
        fresh-var-anon(env)
      }

let check-recur-args(env: TypeEnv, args: List Ast, expected: List Type, local: Map Str Type) -> Unit =
  match (args)
    | [] -> ()
    | a :: arest ->
      match (expected)
        | [] -> ()
        | e :: erest ->
          {
            expect-type(env, infer(env, a, local), e, ast-span(a))
            check-recur-args(env, arest, erest, local)
          }

let check-recur-arity(env: TypeEnv, args: List Ast, expected: List Type, sp: Span) -> Unit =
  if (length(args) == length(expected)) -> () | err!(env, "E_TYPE_ARITY", String.concat("recur expects ", show(length(expected)), " argument(s), got ", show(length(args))), sp)

let infer-recur-with(env: TypeEnv, args: List Ast, expected: List Type, sp: Span, local: Map Str Type) -> Type {
  check-recur-arity(env, args, expected, sp)
  check-recur-args(env, args, expected, local)
  fresh-var-anon(env)
}

let infer-recur-args(env: TypeEnv, args: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (deref(env.loop-bindings))
    | None ->
      {
        err!(env, "E_TYPE_RECUR", "recur outside loop", sp)
        fresh-var-anon(env)
      }
    | Some(expected) -> infer-recur-with(env, args, expected, sp, local)

let infer-recur(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | _ :: args -> infer-recur-args(env, args, sp, local)
    | [] ->
      {
        err!(env, "E_TYPE_RECUR", "recur outside loop", sp)
        fresh-var-anon(env)
      }

; -- panic / return --

let infer-panic-arg(env: TypeEnv, rest: List Ast, local: Map Str Type) -> Unit =
  match (rest)
    | [] -> ()
    | a :: _ ->
      {
        infer(env, a, local)
        ()
      }

let infer-panic(env: TypeEnv, rest: List Ast, local: Map Str Type) -> Type {
  infer-panic-arg(env, rest, local)
  fresh-var-anon(env)
}

let infer-return(env: TypeEnv, rest: List Ast, local: Map Str Type) -> Type =
  match (rest)
    | [] -> t-unit()
    | a :: _ -> infer(env, a, local)

let infer-defer(env: TypeEnv, rest: List Ast, local: Map Str Type) -> Type {
  match (rest)
    | a :: _ -> {
        let _ = infer(env, a, local)
        t-unit()
      }
    | [] -> t-unit()
}

; -- quote --

let infer-quote(ast: Ast) -> Type =
  match (ast)
    | IntNode(_, _) -> t-int()
    | FloatNode(_, _) -> t-float()
    | BoolNode(_, _) -> t-bool()
    | StrNode(_, _) -> t-str()
    | SymNode(_, _) -> t-sym()
    | ParenNode(_, _) -> t-list(t-sym())
    | BracketNode(_, _) -> t-list(t-sym())

let infer-quote-form(rest: List Ast) -> Type =
  match (rest)
    | a :: _ -> infer-quote(a)
    | [] -> t-unit()

; -- set! --

let infer-set-bang-checked(env: TypeEnv, r-ast: Ast, v-ast: Ast, local: Map Str Type) -> Type {
  let rt = infer(env, r-ast, local)
  let vt = infer(env, v-ast, local)
  let elem = fresh-var-anon(env)
  expect-type(env, rt, t-ref(elem), ast-span(r-ast))
  expect-type(env, vt, elem, ast-span(v-ast))
  t-unit()
}

let infer-set-bang(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | [_, r-ast, v-ast] -> infer-set-bang-checked(env, r-ast, v-ast, local)
    | _ ->
      {
        err!(env, "E_TYPE_ARITY", "set! expects 2 arguments", sp)
        t-unit()
      }

; -- fn / lambda --
; `(fn params body)` or `(fn params -> ret body)`.

record LambdaParts {
  params: Ast
  body: Ast
  ret: Maybe Ast
}

let lambda-parts(elems: List Ast) -> Maybe LambdaParts =
  match (elems)
    | _ :: params :: SymNode("->", _) :: ret :: body :: _ -> Some(LambdaParts(params, body, Some(ret)))
    | _ :: params :: body :: _ -> Some(LambdaParts(params, body, None()))
    | _ -> None()

let lambda-param-elems(params: Ast) -> List Ast =
  match (params)
    | ParenNode(xs, _) -> xs
    | _ -> []

; Bind one fn param against an optional expected type; return the param type.
let bind-lambda-param(env: TypeEnv, p: Ast, loc: Ref (Map Str Type), expected: Maybe Type) -> Type =
  match (p)
    | SymNode(n, _) ->
      {
        let v =
          match (expected)
            | Some(e) -> e
            | None -> fresh-var(env, n)
        set!(loc, Map.set(n, apply-subst(env, v), deref(loc)))
        apply-subst(env, v)
      }
    | ParenNode(SymNode("param", _) :: pat :: ty-ast :: _, _) ->
      {
        let ty = parse-type-expr(env, ty-ast, [])
        let _chk =
          match (expected)
            | Some(e) -> expect-type(env, ty, e, ast-span(p))
            | None -> ty
        bind-pattern(env, pat, apply-subst(env, ty), loc, ref([]))
        apply-subst(env, ty)
      }
    | ParenNode(SymNode(raw, _) :: ty-ast :: _, _) ->
      cond
        | String.length(raw) > 0 && String.byte(String.length(raw) - 1, raw) == 58 ->
          {
            let bare = String.slice(0, String.length(raw) - 1, raw)
            let ty = parse-type-expr(env, ty-ast, [])
            let _chk =
              match (expected)
                | Some(e) -> expect-type(env, ty, e, ast-span(p))
                | None -> ty
            set!(loc, Map.set(bare, apply-subst(env, ty), deref(loc)))
            apply-subst(env, ty)
          }
        | raw == "tuple" ->
          {
            let factors =
              match (p)
                | ParenNode(_ :: rest, _) -> rest
                | _ -> []
            let v =
              match (expected)
                | Some(e) -> e
                | None -> t-product(map-fresh-n(env, length(factors)))
            bind-pattern(env, p, apply-subst(env, v), loc, ref([]))
            apply-subst(env, v)
          }
        | else -> bind-lambda-param-bad(env, p)
    | _ -> bind-lambda-param-bad(env, p)

let map-fresh-n(env: TypeEnv, n: Int) -> List Type =
  if (n <= 0) -> [] | fresh-var-anon(env) :: map-fresh-n(env, n - 1)

let bind-lambda-param-bad(env: TypeEnv, p: Ast) -> Type {
  err!(env, "E_TYPE_FN", "invalid fn parameter", ast-span(p))
  fresh-var-anon(env)
}

let bind-lambda-params(env: TypeEnv, pelems: List Ast, expected: List Type, loc: Ref (Map Str Type), acc: List Type) -> List Type =
  match (pelems)
    | [] -> rev-types(acc, [])
    | p :: rest ->
      match (expected)
        | e :: erest ->
          bind-lambda-params(env, rest, erest, loc, bind-lambda-param(env, p, loc, Some(e)) :: acc)
        | [] ->
          bind-lambda-params(env, rest, [], loc, bind-lambda-param(env, p, loc, None()) :: acc)

let rev-types(xs: List Type, acc: List Type) -> List Type =
  match (xs)
    | [] -> acc
    | h :: t -> rev-types(t, h :: acc)

let infer-lambda-with(env: TypeEnv, parts: LambdaParts, local: Map Str Type, expected-params: List Type, expected-ret: Maybe Type) -> Type {
  let loc = ref(local)
  let pelems = lambda-param-elems(parts.params)
  let pts = bind-lambda-params(env, pelems, expected-params, loc, [])
  match (parts)
    | LambdaParts(_, body, Some(ret-ast)) ->
      {
        let ret-ty = parse-type-expr(env, ret-ast, [])
        let _chk =
          match (expected-ret)
            | Some(er) -> expect-type(env, ret-ty, er, ast-span(ret-ast))
            | None -> ret-ty
        expect-type(env, infer(env, body, deref(loc)), ret-ty, ast-span(body))
        t-fn(apply-subst-list(env, pts), apply-subst(env, ret-ty))
      }
    | LambdaParts(_, body, None) ->
      {
        let body-ty = infer(env, body, deref(loc))
        match (expected-ret)
          | Some(er) ->
            {
              expect-type(env, body-ty, er, ast-span(body))
              t-fn(apply-subst-list(env, pts), apply-subst(env, er))
            }
          | None -> t-fn(apply-subst-list(env, pts), apply-subst(env, body-ty))
      }
}

let infer-lambda(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (lambda-parts(elems))
    | Some(parts) -> infer-lambda-with(env, parts, local, [], None())
    | None ->
      {
        err!(env, "E_TYPE_FN", "fn requires params and body", sp)
        fresh-var-anon(env)
      }

let check-lambda-against(env: TypeEnv, elems: List Ast, sp: Span, expected: Type, local: Map Str Type) -> Type =
  match (apply-subst(env, expected))
    | TFn(ps, ret) ->
      match (lambda-parts(elems))
        | Some(parts) ->
          {
            let pelems = lambda-param-elems(parts.params)
            if (length(pelems) != length(ps)) ->
              err!(env, "E_TYPE_ARITY", String.concat("function arity mismatch: expected ", show(length(ps)), ", found ", show(length(pelems))), sp)
            infer-lambda-with(env, parts, local, ps, Some(ret))
          }
        | None -> infer-lambda(env, elems, sp, local)
    | _ -> infer-lambda(env, elems, sp, local)

; -- match --

let nominal-kind-of(env: TypeEnv, type-id: Str) -> Str =
  match (type-get(env, type-id))
    | Some(td) -> type-def-kind(td)
    | None -> "variant"

let nth-or-fresh(xs: List Type, i: Int, env: TypeEnv) -> Type =
  match (xs)
    | [] -> fresh-var-anon(env)
    | x :: rest ->
      if (i == 0) -> x | nth-or-fresh(rest, i - 1, env)

let bind-ctor-scrut-specific(env: TypeEnv, type-id: Str, type-name: Str, arg-vars: List Type, scrut: Type, sp: Span) -> Unit =
  match (type-name)
    | "Maybe" ->
      {
        unify(env, scrut, t-maybe(nth-or-fresh(arg-vars, 0, env)), sp)
        ()
      }
    | "List" ->
      {
        unify(env, scrut, t-list(nth-or-fresh(arg-vars, 0, env)), sp)
        ()
      }
    | "Result" ->
      {
        unify(env, scrut, t-result(nth-or-fresh(arg-vars, 0, env), nth-or-fresh(arg-vars, 1, env)), sp)
        ()
      }
    | _ ->
      {
        unify(env, scrut, t-nominal-id(type-id, type-name, arg-vars, nominal-kind-of(env, type-id)), sp)
        ()
      }

let zip-param-map(params: List Str, vars: List Type) -> Map Str Type =
  match (params)
    | [] -> Map.empty()
    | p :: prest ->
      match (vars)
        | [] -> Map.empty()
        | v :: vrest -> Map.set(p, v, zip-param-map(prest, vrest))

let fresh-vars-for(params: List Str, env: TypeEnv) -> List Type =
  match (params)
    | [] -> []
    | _ :: rest -> fresh-var-anon(env) :: fresh-vars-for(rest, env)

; Forward declaration: `bind-pattern` and `bind-pattern-args` recurse into
; each other (a ctor pattern's own arguments are themselves patterns).
let bind-pattern(env: TypeEnv, pat: Ast, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (pat)
    | SymNode(name, sp) -> bind-pattern-sym(env, name, sp, scrut, loc, covered)
    | IntNode(_, sp) ->
      {
        unify(env, scrut, t-int(), sp)
        ()
      }
    | StrNode(_, sp) ->
      {
        unify(env, scrut, t-str(), sp)
        ()
      }
    | BoolNode(_, sp) ->
      {
        unify(env, scrut, t-bool(), sp)
        ()
      }
    | ParenNode(pelems, psp) -> bind-pattern-ctor(env, pelems, psp, scrut, loc, covered)
    | _ -> ()

let bind-nullary-ctor(env: TypeEnv, name: Str, ctor: CtorInfo, scrut: Type, covered: Ref (List Str), sp: Span) -> Unit {
  set!(covered, name :: deref(covered))
  bind-ctor-scrut(env, ctor, scrut, sp)
}

let bind-ctor-scrut(env: TypeEnv, ctor: CtorInfo, scrut: Type, sp: Span) -> Unit =
  match (ctor)
    | CtorInfo(type-id, type-name, _, params) -> bind-ctor-scrut-specific(env, type-id, type-name, fresh-vars-for(params, env), scrut, sp)

let is-product-type(t: Type) -> Bool =
  match (t)
    | TProduct(_) -> true
    | _ -> false

; A wildcard/plain-var bind against a tuple-typed scrutinee needs no
; further decomposition, so it covers the whole product (there is no
; declared ctor name to add to `covered` otherwise).
let mark-product-covered(env: TypeEnv, scrut: Type, covered: Ref (List Str)) -> Unit =
  if (is-product-type(apply-subst(env, scrut))) -> set!(covered, "__product__" :: deref(covered)) | ()

let bind-pattern-sym(env: TypeEnv, name: Str, sp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  if (name == "_") -> mark-product-covered(env, scrut, covered) | bind-pattern-sym-lookup(env, name, sp, scrut, loc, covered)

let bind-pattern-sym-lookup(env: TypeEnv, name: Str, sp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (ctor-get(env, name))
    | Some(ctor) -> bind-nullary-ctor(env, name, ctor, scrut, covered, sp)
    | None -> bind-pattern-sym-var(env, name, scrut, loc, covered)

let bind-pattern-sym-var(env: TypeEnv, name: Str, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit {
  mark-product-covered(env, scrut, covered)
  set!(loc, Map.set(name, apply-subst(env, scrut), deref(loc)))
}

let bind-pattern-args(env: TypeEnv, arg-pats: List Ast, payloads: List Type, loc: Ref (Map Str Type)) -> Unit =
  match (payloads)
    | [] -> ()
    | pt :: prest ->
      match (arg-pats)
        | [] -> ()
        | pa :: parest ->
          {
            bind-pattern(env, pa, pt, loc, ref([]))
            bind-pattern-args(env, parest, prest, loc)
          }

let bind-pattern-ctor-info(env: TypeEnv, cname: Str, ctor: CtorInfo, arg-pats: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (ctor)
    | CtorInfo(type-id, type-name, payload-schema, params) ->
      {
        set!(covered, cname :: deref(covered))
        let arg-vars = fresh-vars-for(params, env)
        let pmap = zip-param-map(params, arg-vars)
        bind-ctor-scrut-specific(env, type-id, type-name, arg-vars, scrut, psp)
        bind-pattern-args(env, arg-pats, replace-params-list(payload-schema, pmap), loc)
      }

let bind-pattern-ctor-named(env: TypeEnv, cname-ast: Ast, arg-pats: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (sym-str(cname-ast))
    | None -> ()
    | Some(cname) -> bind-pattern-ctor-kind(env, cname, arg-pats, psp, scrut, loc, covered)

let bind-pattern-ctor-kind(env: TypeEnv, cname: Str, arg-pats: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  cond
    | cname == "recpat" -> bind-record-pat(env, arg-pats, psp, scrut, loc, covered)
    | cname == "guard" -> bind-guard-pat(env, arg-pats, scrut, loc)
    | cname == "char" ->
      {
        unify(env, scrut, t-char(), psp)
        ()
      }
    | cname == "tuple" -> bind-tuple-pat(env, arg-pats, psp, scrut, loc, covered)
    | else ->
      match (ctor-get(env, cname))
        | None -> ()
        | Some(ctor) -> bind-pattern-ctor-info(env, cname, ctor, arg-pats, psp, scrut, loc, covered)

let fresh-vars-for-asts(xs: List Ast, env: TypeEnv) -> List Type =
  match (xs)
    | [] -> []
    | _ :: rest -> fresh-var-anon(env) :: fresh-vars-for-asts(rest, env)

; `(p1, p2, …)` against a tuple scrutinee: unify elementwise (structural,
; no declared ctor to look up), then bind each sub-pattern against its
; own slot with a fresh `covered` set, as `bind-pattern-args` already
; does for a user ctor's payloads.
let bind-tuple-pat(env: TypeEnv, arg-pats: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit {
  let vars = fresh-vars-for-asts(arg-pats, env)
  unify(env, scrut, t-product(vars), psp)
  set!(covered, "__product__" :: deref(covered))
  bind-tuple-pat-arity(env, arg-pats, apply-subst-list(env, vars), psp, loc)
}

let bind-tuple-pat-arity(env: TypeEnv, arg-pats: List Ast, elem-types: List Type, psp: Span, loc: Ref (Map Str Type)) -> Unit =
  cond
    | length(arg-pats) == length(elem-types) -> bind-pattern-args(env, arg-pats, elem-types, loc)
    | else -> err!(env, "E_TYPE_ARITY", String.concat("tuple pattern arity mismatch: expected ", show(length(elem-types)), ", found ", show(length(arg-pats))), psp)

let bind-guard-pat(env: TypeEnv, arg-pats: List Ast, scrut: Type, loc: Ref (Map Str Type)) -> Unit =
  match (arg-pats)
    | inner :: test :: _ ->
      {
        bind-pattern(env, inner, scrut, loc, ref([]))
        let gt = infer(env, test, deref(loc))
        unify(env, gt, t-bool(), ast-span(test))
        ()
      }
    | _ -> ()

let bind-record-pat(env: TypeEnv, arg-pats: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (arg-pats)
    | name-ast :: fields -> bind-record-named(env, name-ast, fields, psp, scrut, loc, covered)
    | [] -> err!(env, "E_TYPE_MISMATCH", "expected a record", psp)

let bind-record-named(env: TypeEnv, name-ast: Ast, fields: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (sym-str(name-ast))
    | None -> err!(env, "E_TYPE_MISMATCH", "expected a record", psp)
    | Some(name) ->
      match (type-get(env, name))
        | Some(RecordDef(_, _, _, rfields)) -> bind-record-fields(env, name-ast, fields, rfields, psp, scrut, loc, covered)
        | _ -> err!(env, "E_TYPE_MISMATCH", String.concat("expected a record, found ", name), psp)

let bind-record-fields(env: TypeEnv, name-ast: Ast, fields: List Ast, rfields: List RecordField, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (wanted-fields(env, fields, rfields, []))
    | None -> ()
    | Some(wanted) ->
      bind-pattern(env, ParenNode(name-ast :: positional-fields(rfields, wanted, psp), psp), scrut, loc, covered)

let wanted-fields(env: TypeEnv, fields: List Ast, rfields: List RecordField, acc: List Str) -> Maybe (List Str) =
  match (fields)
    | [] -> Some(acc)
    | f :: rest -> wanted-field(env, f, rest, rfields, acc)

let wanted-field(env: TypeEnv, f: Ast, rest: List Ast, rfields: List RecordField, acc: List Str) -> Maybe (List Str) =
  match (sym-str(f))
    | None -> wanted-fields(env, rest, rfields, acc)
    | Some(n) ->
      cond
        | member(n, acc) ->
          {
            err!(env, "E_TYPE_MISMATCH", String.concat("duplicate field ", n), ast-span(f))
            wanted-fields(env, rest, rfields, acc)
          }
        | not(record-has-field(rfields, n)) ->
          {
            err!(env, "E_TYPE_UNBOUND", String.concat("unknown field ", n), ast-span(f))
            wanted-fields(env, rest, rfields, acc)
          }
        | else -> wanted-fields(env, rest, rfields, n :: acc)

let record-has-field(fields: List RecordField, name: Str) -> Bool =
  match (fields)
    | [] -> false
    | RecordField(n, _) :: rest ->
      if (n == name) -> true | record-has-field(rest, name)

let positional-fields(fields: List RecordField, wanted: List Str, sp: Span) -> List Ast =
  match (fields)
    | [] -> []
    | RecordField(n, _) :: rest ->
      {
        let text = if (member(n, wanted)) -> n | "_"
        SymNode(text, sp) :: positional-fields(rest, wanted, sp)
      }


let bind-pattern-ctor(env: TypeEnv, pelems: List Ast, psp: Span, scrut: Type, loc: Ref (Map Str Type), covered: Ref (List Str)) -> Unit =
  match (pelems)
    | cname-ast :: arg-pats -> bind-pattern-ctor-named(env, cname-ast, arg-pats, psp, scrut, loc, covered)
    | [] -> ()

let nominal-type-name-of(t: Type) -> Maybe Str =
  match (t)
    | TNominal(_, n, _, _) -> Some(n)
    | TMaybe(_) -> Some("Maybe")
    | TResult(_, _) -> Some("Result")
    | TList(_) -> Some("List")
    | _ -> None()

let check-ctor-covered(env: TypeEnv, c: VariantCtor, covered: List Str, sp: Span) -> Unit =
  match (c)
    | VariantCtor(name, _) ->
      if (member(name, covered)) -> () | err!(env, "E_TYPE_EXHAUSTIVE", String.concat("non-exhaustive match: missing ", name), sp)

let check-ctors-covered(env: TypeEnv, ctors: List VariantCtor, covered: List Str, sp: Span) -> Unit =
  match (ctors)
    | [] -> ()
    | c :: rest ->
      {
        check-ctor-covered(env, c, covered, sp)
        check-ctors-covered(env, rest, covered, sp)
      }

let check-match-exhaustive-def(env: TypeEnv, td: TypeDef, covered: List Str, has-wild: Bool, sp: Span) -> Unit =
  match (td)
    | RecordDef(_, _, _, _) -> ()
    | VariantDef(_, _, _, ctors) ->
      if (has-wild) -> () | check-ctors-covered(env, ctors, covered, sp)

let check-match-exhaustive-named(env: TypeEnv, type-name: Str, covered: List Str, has-wild: Bool, sp: Span) -> Unit =
  match (type-get(env, type-name))
    | None -> ()
    | Some(td) -> check-match-exhaustive-def(env, td, covered, has-wild, sp)

let check-match-exhaustive(env: TypeEnv, scrut: Type, covered: List Str, has-wild: Bool, sp: Span) -> Unit =
  match (nominal-type-name-of(scrut))
    | None -> ()
    | Some(tn) -> check-match-exhaustive-named(env, tn, covered, has-wild, sp)

; A tuple has no declared ctor, so `nominal-type-name-of` above skips it
; entirely — check it separately. `apply-subst` first since `scrut` may
; still be an unresolved unification variable at the call site.
let check-match-exhaustive-product(env: TypeEnv, scrut: Type, covered: List Str, has-wild: Bool, sp: Span) -> Unit =
  cond
    | has-wild || member("__product__", covered) -> ()
    | is-product-type(apply-subst(env, scrut)) -> err!(env, "E_TYPE_EXHAUSTIVE", "non-exhaustive match: missing product", sp)
    | else -> ()

let combine-match-result(env: TypeEnv, bt: Type, result: Maybe Type, sp: Span) -> Maybe Type =
  match (result)
    | None -> Some(bt)
    | Some(r) ->
      {
        expect-type(env, bt, r, sp)
        Some(r)
      }

let run-match-clauses(env: TypeEnv, clauses: List Ast, scrut: Type, local: Map Str Type, covered: Ref (List Str), has-wild: Ref Bool, result: Maybe Type) -> Maybe Type =
  match (clauses)
    | pat :: body :: more -> run-match-clause(env, pat, body, more, scrut, local, covered, has-wild, result)
    | _ -> result

let run-match-clause(env: TypeEnv, pat: Ast, body: Ast, more: List Ast, scrut: Type, local: Map Str Type, covered: Ref (List Str), has-wild: Ref Bool, result: Maybe Type) -> Maybe Type {
  let loc = ref(local)
  bind-pattern(env, pat, scrut, loc, covered)
  if (is-sym(pat, "_")) -> set!(has-wild, true)
  let bt = infer(env, body, deref(loc))
  run-match-clauses(env, more, scrut, local, covered, has-wild, combine-match-result(env, bt, result, ast-span(body)))
}

let list-odd-length(xs: List Ast) -> Bool =
  match (xs)
    | [] -> false
    | [_] -> true
    | _ :: _ :: rest -> list-odd-length(rest)

let infer-match-scrut(env: TypeEnv, scrut-ast: Ast, clauses: List Ast, sp: Span, local: Map Str Type) -> Type {
  let scrut = infer(env, scrut-ast, local)
  if (list-odd-length(clauses)) -> err!(env, "E_TYPE_MATCH", "match clauses must be pattern/body pairs", sp)
  let covered = ref([])
  let has-wild = ref(false)
  let result = run-match-clauses(env, clauses, scrut, local, covered, has-wild, None())
  check-match-exhaustive(env, scrut, deref(covered), deref(has-wild), sp)
  check-match-exhaustive-product(env, scrut, deref(covered), deref(has-wild), sp)
  match (result)
    | Some(t) -> apply-subst(env, t)
    | None -> fresh-var-anon(env)
}

let infer-match(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | _ :: scrut-ast :: clauses -> infer-match-scrut(env, scrut-ast, clauses, sp, local)
    | _ ->
      {
        err!(env, "E_TYPE_MATCH", "match requires scrutinee and clauses", sp)
        fresh-var-anon(env)
      }

; -- application, incl. print/println/show/compare special typing --

let type-is-str(t: Type) -> Bool =
  match (t)
    | TStr -> true
    | _ -> false

let check-print-arg(env: TypeEnv, a: Ast, local: Map Str Type) -> Type {
  let t = apply-subst(env, infer(env, a, local))
  if (type-is-str(t) || is-showable(t)) -> () | err!(env, "E_TYPE_SHOWABLE", String.concat("type ", type-show(t), " is not showable"), ast-span(a))
  t
}

let check-print-args(env: TypeEnv, args: List Ast, local: Map Str Type) -> List Type =
  match (args)
    | [] -> []
    | a :: rest -> check-print-arg(env, a, local) :: check-print-args(env, rest, local)

let infer-print-args(env: TypeEnv, args: List Ast, local: Map Str Type, sp: Span) -> Type {
  let types = check-print-args(env, args, local)
  set!(print-notes, PrintNote(sp, types) :: deref(print-notes))
  t-unit()
}

let infer-args(env: TypeEnv, args: List Ast, local: Map Str Type) -> List Type =
  match (args)
    | [] -> []
    | a :: rest -> infer(env, a, local) :: infer-args(env, rest, local)

let first-type-or-fresh(xs: List Type, env: TypeEnv) -> Type =
  match (xs)
    | x :: _ -> x
    | [] -> fresh-var-anon(env)

let first-span-or(args: List Ast, fallback: Span) -> Span =
  match (args)
    | a :: _ -> ast-span(a)
    | [] -> fallback

let check-predicate-arg(env: TypeEnv, arg-types: List Type, args: List Ast, sp: Span, pred: (Type) -> Bool, code: Str, label: Str) -> Unit {
  let t = apply-subst(env, first-type-or-fresh(arg-types, env))
  if (pred(t)) -> () | err!(env, code, String.concat("type ", type-show(t), " is ", label), first-span-or(args, sp))
}

let check-show-compare(env: TypeEnv, head: Ast, arg-types: List Type, args: List Ast, sp: Span) -> Unit =
  cond
    | is-sym(head, "show") ->
      {
        note-show!(sp, first-type-or-fresh(arg-types, env))
        check-predicate-arg(env, arg-types, args, sp, is-showable, "E_TYPE_SHOWABLE", "not showable")
      }
    | is-sym(head, "compare") -> check-predicate-arg(env, arg-types, args, sp, is-orderable, "E_TYPE_ORDERABLE", "not orderable")

let is-lambda-ast(a: Ast) -> Bool =
  match (a)
    | ParenNode(h :: _, _) -> is-sym(h, "fn") || is-sym(h, "lambda")
    | _ -> false

let infer-app-arg(env: TypeEnv, a: Ast, expected: Maybe Type, local: Map Str Type) -> Type =
  match (expected)
    | Some(e) ->
      cond
        | is-lambda-ast(a) ->
          match (a)
            | ParenNode(elems, sp) -> check-lambda-against(env, elems, sp, e, local)
            | _ -> infer(env, a, local)
        | else -> expect-type(env, infer(env, a, local), e, ast-span(a))
    | None -> infer(env, a, local)

let infer-app-args-against(env: TypeEnv, args: List Ast, params: List Type, local: Map Str Type, acc: List Type) -> List Type =
  match (args)
    | [] -> rev-types(acc, [])
    | a :: rest ->
      match (params)
        | p :: prest ->
          infer-app-args-against(env, rest, prest, local, infer-app-arg(env, a, Some(p), local) :: acc)
        | [] ->
          infer-app-args-against(env, rest, [], local, infer-app-arg(env, a, None(), local) :: acc)

let infer-app-core(env: TypeEnv, head: Ast, args: List Ast, sp: Span, local: Map Str Type) -> Type {
  let callee = apply-subst(env, infer(env, head, local))
  match (callee)
    | TFn(ps, ret) ->
      {
        if (length(args) != length(ps)) ->
          err!(env, "E_TYPE_ARITY", String.concat("function arity mismatch: expected ", show(length(ps)), ", found ", show(length(args))), sp)
        let arg-types = infer-app-args-against(env, args, ps, local, [])
        check-show-compare(env, head, arg-types, args, sp)
        apply-subst(env, ret)
      }
    | _ ->
      {
        let arg-types = infer-args(env, args, local)
        let ret = fresh-var-anon(env)
        unify(env, callee, t-fn(arg-types, ret), sp)
        check-show-compare(env, head, arg-types, args, sp)
        apply-subst(env, ret)
      }
}

let infer-app-dispatch(env: TypeEnv, head: Ast, args: List Ast, sp: Span, local: Map Str Type) -> Type =
  if (is-sym(head, "print") || is-sym(head, "println")) -> infer-print-args(env, args, local, sp) | infer-app-core(env, head, args, sp, local)

let infer-app(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | [] -> t-unit()
    | head :: args -> infer-app-dispatch(env, head, args, sp, local)

; -- paren dispatch --

; Declaration order of a record field.
let record-field-at(fields: List RecordField, name: Str, i: Int) -> Maybe Int =
  match (fields)
    | [] -> None()
    | RecordField(n, _) :: rest ->
      if (n == name) -> Some(i) | record-field-at(rest, name, i + 1)

; The declared type of a record field.
let record-field-type-of(fields: List RecordField, name: Str) -> Maybe Type =
  match (fields)
    | [] -> None()
    | RecordField(n, t) :: rest ->
      if (n == name) -> Some(t) | record-field-type-of(rest, name)

; Map a record's type parameters onto the arguments at the use.
let bind-type-params(params: List Str, args: List Type, m: Map Str Type) -> Map Str Type =
  match (params)
    | [] -> m
    | p :: rest ->
      match (args)
        | [] -> bind-type-params(rest, [], Map.set(p, TParam(p), m))
        | a :: more -> bind-type-params(rest, more, Map.set(p, a, m))

; Type of one field, and the slot index to lower later.
let infer-record-field(env: TypeEnv, def: TypeDef, args: List Type, field: Str, field-ast: Ast, sp: Span) -> Type =
  match (def)
    | RecordDef(_, _, params, fields) ->
      match (record-field-at(fields, field, 0))
        | None ->
          {
            err!(env, "E_TYPE_UNBOUND", String.concat("unknown field ", field), ast-span(field-ast))
            fresh-var-anon(env)
          }
        | Some(index) ->
          match (record-field-type-of(fields, field))
            | None -> fresh-var-anon(env)
            | Some(ft) ->
              {
                note-project!(sp, index)
                replace-params(ft, bind-type-params(params, args, Map.empty()))
              }
    | _ ->
      {
        err!(env, "E_TYPE_MISMATCH", "expected a record", ast-span(field-ast))
        fresh-var-anon(env)
      }

; Projection is only defined on records.
let infer-project-not-record(env: TypeEnv, field-ast: Ast) -> Type {
  err!(env, "E_TYPE_MISMATCH", "expected a record", ast-span(field-ast))
  fresh-var-anon(env)
}

; Look the field up on the named record.
let infer-project-record(env: TypeEnv, name: Str, args: List Type, field: Str, field-ast: Ast, sp: Span) -> Type =
  match (type-get(env, name))
    | None ->
      {
        err!(env, "E_TYPE_UNBOUND", String.concat("unknown record ", name), ast-span(field-ast))
        fresh-var-anon(env)
      }
    | Some(def) -> infer-record-field(env, def, args, field, field-ast, sp)

; Records project; other nominals do not.
let infer-project-nominal(env: TypeEnv, name: Str, args: List Type, kind: Str, field: Str, field-ast: Ast, sp: Span) -> Type =
  if (kind == "record") -> infer-project-record(env, name, args, field, field-ast, sp) | infer-project-not-record(env, field-ast)

; Select a field once the receiver's type is known.
let infer-project-typed(env: TypeEnv, obj-ty: Type, field: Str, field-ast: Ast, sp: Span) -> Type =
  match (obj-ty)
    | TNominal(_, name, args, kind) -> infer-project-nominal(env, name, args, kind, field, field-ast, sp)
    | _ ->
      {
        err!(env, "E_TYPE_MISMATCH", String.concat("expected a record, found ", type-show(obj-ty)), ast-span(field-ast))
        fresh-var-anon(env)
      }

; Infer the receiver, then its field.
let infer-project-named(env: TypeEnv, obj: Ast, field: Str, field-ast: Ast, sp: Span, local: Map Str Type) -> Type {
  let obj-ty = apply-subst(env, infer(env, obj, local))
  infer-project-typed(env, obj-ty, field, field-ast, sp)
}

; `pair.fst` is a field of the record, chosen by declaration order;
; `pair.1`…`pair.N` (1-based) is a tuple projection.
let infer-project(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | _ :: obj :: field-ast :: _ -> infer-project-field-ast(env, obj, field-ast, sp, local)
    | _ ->
      {
        err!(env, "E_TYPE_ARITY", "project expects a value and a field", sp)
        fresh-var-anon(env)
      }

let infer-project-field-ast(env: TypeEnv, obj: Ast, field-ast: Ast, sp: Span, local: Map Str Type) -> Type =
  match (field-ast)
    | IntNode(n, fsp) -> infer-project-index(env, obj, n, fsp, local)
    | _ -> infer-project-field-sym(env, obj, field-ast, sp, local)

let infer-project-field-sym(env: TypeEnv, obj: Ast, field-ast: Ast, sp: Span, local: Map Str Type) -> Type =
  match (sym-str(field-ast))
    | None ->
      {
        err!(env, "E_TYPE_ARITY", "project expects a value and a field", sp)
        fresh-var-anon(env)
      }
    | Some(field) -> infer-project-named(env, obj, field, field-ast, sp, local)

; `(project obj N)` with the index already a positive, parser-validated
; `IntNode`; the `n < 1` branch below is defensive (mirrors host), since
; `read.mnd`'s `parse-project-index` already rejects `n <= 0` at parse
; time.
let infer-project-index(env: TypeEnv, obj: Ast, n: Int, fsp: Span, local: Map Str Type) -> Type =
  if (n < 1) -> infer-project-index-bad(env, fsp) | infer-project-index-ok(env, obj, n, fsp, local)

let infer-project-index-bad(env: TypeEnv, fsp: Span) -> Type {
  err!(env, "E_TYPE_UNBOUND", "tuple projection must be a positive index", fsp)
  fresh-var-anon(env)
}

let infer-project-index-ok(env: TypeEnv, obj: Ast, n: Int, fsp: Span, local: Map Str Type) -> Type {
  let obj-ty = apply-subst(env, infer(env, obj, local))
  infer-project-index-typed(env, obj, obj-ty, n, fsp)
}

let infer-project-index-typed(env: TypeEnv, obj: Ast, obj-ty: Type, n: Int, fsp: Span) -> Type =
  match (obj-ty)
    | TProduct(elems) -> infer-project-index-elem(env, elems, n, fsp)
    | _ ->
      {
        err!(env, "E_TYPE_MISMATCH", String.concat("expected a product, found ", type-show(obj-ty)), ast-span(obj))
        fresh-var-anon(env)
      }

let infer-project-index-elem(env: TypeEnv, elems: List Type, n: Int, fsp: Span) -> Type =
  if (n > length(elems)) -> infer-project-index-oor(env, elems, n, fsp) | nth-or-fresh(elems, n - 1, env)

let infer-project-index-oor(env: TypeEnv, elems: List Type, n: Int, fsp: Span) -> Type {
  err!(env, "E_TYPE_UNBOUND", String.concat("tuple index ", show(n), " out of range for product of ", show(length(elems))), fsp)
  fresh-var-anon(env)
}

; `(e1, e2, …)` (≥2 elems, enforced by the reader already, but checked
; again here to mirror host).
let infer-tuple(env: TypeEnv, rest: List Ast, sp: Span, local: Map Str Type) -> Type =
  cond
    | length(rest) < 2 ->
      {
        err!(env, "E_TYPE_ARITY", "tuple requires at least two elements", sp)
        fresh-var-anon(env)
      }
    | else -> t-product(infer-args(env, rest, local))

; `(? lhs rhs)` — unwrap Maybe/Result; `rhs` runs only on None/Err.
let infer-ques(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | [_, lhs, rhs] -> infer-ques-ok(env, lhs, rhs, sp, local)
    | _ ->
      {
        err!(env, "E_TYPE_ARITY", "? expects a Maybe or Result and a default", sp)
        fresh-var-anon(env)
      }

let infer-ques-ok(env: TypeEnv, lhs: Ast, rhs: Ast, sp: Span, local: Map Str Type) -> Type {
  let left = apply-subst(env, infer(env, lhs, local))
  match (left)
    | TMaybe(elem) ->
      {
        note-ques!(sp, 0)
        expect-type(env, infer(env, rhs, local), elem, ast-span(rhs))
        apply-subst(env, elem)
      }
    | TResult(ok, _) ->
      {
        note-ques!(sp, 1)
        expect-type(env, infer(env, rhs, local), ok, ast-span(rhs))
        apply-subst(env, ok)
      }
    | TVar(_, _) ->
      {
        let payload = fresh-var-anon(env)
        note-ques!(sp, 0)
        expect-type(env, left, t-maybe(payload), ast-span(lhs))
        expect-type(env, infer(env, rhs, local), payload, ast-span(rhs))
        apply-subst(env, payload)
      }
    | _ ->
      {
        err!(env, "E_TYPE_MISMATCH", String.concat("expected a Maybe or Result, found ", type-show(left)), ast-span(lhs))
        fresh-var-anon(env)
      }
}

let infer-paren-named(env: TypeEnv, hn: Str, elems: List Ast, rest: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (hn)
    | "project" -> infer-project(env, elems, sp, local)
    | "tuple" -> infer-tuple(env, rest, sp, local)
    | "?" -> infer-ques(env, elems, sp, local)
    | "if" -> infer-if(env, elems, sp, local)
    | "let" -> infer-let(env, elems, sp, local)
    | "do" -> infer-do(env, rest, local)
    | "loop" -> infer-loop(env, elems, sp, local)
    | "recur" -> infer-recur(env, elems, sp, local)
    | "panic" -> infer-panic(env, rest, local)
    | "return" -> infer-return(env, rest, local)
    | "defer" -> infer-defer(env, rest, local)
    | "match" -> infer-match(env, elems, sp, local)
    | "fn" -> infer-lambda(env, elems, sp, local)
    | "lambda" -> infer-lambda(env, elems, sp, local)
    | "quote" -> infer-quote-form(rest)
    | "char" -> t-char()
    | "set!" -> infer-set-bang(env, elems, sp, local)
    | _ -> infer-app(env, elems, sp, local)

let infer-paren-head(env: TypeEnv, head: Ast, rest: List Ast, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (sym-str(head))
    | None -> infer-app(env, elems, sp, local)
    | Some(hn) -> infer-paren-named(env, hn, elems, rest, sp, local)

let infer-paren(env: TypeEnv, elems: List Ast, sp: Span, local: Map Str Type) -> Type =
  match (elems)
    | [] -> t-unit()
    | head :: rest -> infer-paren-head(env, head, rest, elems, sp, local)

; ---------------------------------------------------------------------------
; Top-level driver: dispatches each form to declaration collection (already
; done in pass 1) or to body checking, threading a mutable `top-local` for
; sequential top-level `let` (spec §2.4's `let*`-like sequencing, at the
; top level exactly as within a `defn` body).

let bind-top-let(env: TypeEnv, n: Str, t: Type, top-local: Ref (Map Str Type)) -> Unit {
  set!(top-local, Map.set(n, t, deref(top-local)))
  value-set(env, n, Scheme([], t))
}

let typecheck-top-let-named(env: TypeEnv, name-ast: Ast, expr-ast: Ast, top-local: Ref (Map Str Type)) -> Unit {
  let t = infer(env, expr-ast, deref(top-local))
  match (sym-str(name-ast))
    | Some(n) -> bind-top-let(env, n, t, top-local)
    | None -> bind-top-let-pattern(env, name-ast, t, top-local)
}

; Top-level `let (p1, p2) = e` — bind into `top-local` only (not
; `env.values`), matching host: a destructured top-level binding is
; visible to later top-level forms in this file but is not exported.
let bind-top-let-pattern(env: TypeEnv, pat: Ast, t: Type, top-local: Ref (Map Str Type)) -> Unit {
  let loc = ref(deref(top-local))
  bind-pattern(env, pat, t, loc, ref([]))
  set!(top-local, deref(loc))
}

let typecheck-top-let(env: TypeEnv, elems: List Ast, sp: Span, ast: Ast, top-local: Ref (Map Str Type)) -> Unit =
  match (elems)
    | [_, name-ast, expr-ast] -> typecheck-top-let-named(env, name-ast, expr-ast, top-local)
    | _ ->
      {
        infer(env, ast, deref(top-local))
        ()
      }

let typecheck-top-named(env: TypeEnv, hn: Str, rest: List Ast, elems: List Ast, sp: Span, ast: Ast, top-local: Ref (Map Str Type)) -> Unit =
  match (hn)
    | "pub" -> typecheck-top(env, ParenNode(rest, sp), top-local)
    | "alias" -> ()
    | "defrec" -> ()
    | "variant" -> ()
    | "extern" -> ()
    | "runtime" -> ()
    | "import" -> ()
    | "defn" -> typecheck-defn(env, elems, sp)
    | "let" -> typecheck-top-let(env, elems, sp, ast, top-local)
    | _ ->
      {
        infer(env, ast, deref(top-local))
        ()
      }

let typecheck-top-dispatch(env: TypeEnv, head: Ast, rest: List Ast, elems: List Ast, sp: Span, ast: Ast, top-local: Ref (Map Str Type)) -> Unit =
  match (sym-str(head))
    | None ->
      {
        infer(env, ast, deref(top-local))
        ()
      }
    | Some(hn) -> typecheck-top-named(env, hn, rest, elems, sp, ast, top-local)

let typecheck-top-paren(env: TypeEnv, elems: List Ast, sp: Span, ast: Ast, top-local: Ref (Map Str Type)) -> Unit =
  match (elems)
    | head :: rest -> typecheck-top-dispatch(env, head, rest, elems, sp, ast, top-local)
    | [] ->
      {
        infer(env, ast, deref(top-local))
        ()
      }

let typecheck-top(env: TypeEnv, ast: Ast, top-local: Ref (Map Str Type)) -> Unit =
  match (ast)
    | ParenNode(elems, sp) -> typecheck-top-paren(env, elems, sp, ast, top-local)
    | _ ->
      {
        infer(env, ast, deref(top-local))
        ()
      }

; ---------------------------------------------------------------------------
; Entry point.

; Every record and variant name is bound before fields and payloads are
; checked, so a record may mention itself and two declarations in one file
; may mention each other. A second definition of the same name is an error.

let span-same(a: Span, b: Span) -> Bool =
  match (a)
    | Span(s1, e1, o1, _) ->
      match (b)
        | Span(s2, e2, o2, _) -> s1 == s2 && e1 == e2 && o1 == o2

let span-skipped(sp: Span, xs: List Span) -> Bool =
  match (xs)
    | [] -> false
    | h :: t ->
      if (span-same(sp, h)) -> true | span-skipped(sp, t)

let unwrap-pub-ast(ast: Ast) -> Ast =
  match (ast)
    | ParenNode(head :: rest, sp) ->
      match (sym-str(head))
        | Some(n) ->
          if (n == "pub") -> ParenNode(rest, sp) | ast
        | None -> ast
    | _ -> ast

let register-stubs(env: TypeEnv, forms: List Ast, seen: Ref (List Str), skip: Ref (List Span)) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        register-stub(env, f, seen, skip)
        register-stubs(env, rest, seen, skip)
      }

let register-stub(env: TypeEnv, form: Ast, seen: Ref (List Str), skip: Ref (List Span)) -> Unit =
  match (unwrap-pub-ast(form))
    | ParenNode(head :: name-part :: _, sp) -> register-stub-head(env, head, name-part, sp, seen, skip)
    | _ -> ()

let register-stub-head(env: TypeEnv, head: Ast, name-part: Ast, sp: Span, seen: Ref (List Str), skip: Ref (List Span)) -> Unit =
  match (sym-str(head))
    | Some(n) ->
      if (n == "defrec" || n == "variant") -> register-stub-named(env, n, name-part, sp, seen, skip)
    | _ -> ()

let register-stub-named(env: TypeEnv, kind: Str, name-part: Ast, sp: Span, seen: Ref (List Str), skip: Ref (List Span)) -> Unit =
  match (parse-type-name(name-part))
    | None -> ()
    | Some(np) -> register-stub-np(env, kind, np, sp, seen, skip)

let register-stub-np(env: TypeEnv, kind: Str, np: NameParams, sp: Span, seen: Ref (List Str), skip: Ref (List Span)) -> Unit {
  let name = name-params-name(np)
  let params = name-params-params(np)
  if (member(name, deref(seen))) -> note-duplicate-type(env, name, sp, skip) | note-fresh-type(env, kind, name, params, seen)
}

let note-duplicate-type(env: TypeEnv, name: Str, sp: Span, skip: Ref (List Span)) -> Unit {
  err!(env, "E_TYPE_DUPLICATE", String.concat("type ", name, " is already defined"), sp)
  set!(skip, sp :: deref(skip))
}

let note-fresh-type(env: TypeEnv, kind: Str, name: Str, params: List Str, seen: Ref (List Str)) -> Unit {
  set!(seen, name :: deref(seen))
  if (kind == "defrec") -> type-set(env, RecordDef(name, name, params, [])) | type-set(env, VariantDef(name, name, params, []))
}

let collect-defs(env: TypeEnv, forms: List Ast) -> Unit =
  collect-defs-skip(env, forms, [])

let collect-defs-skip(env: TypeEnv, forms: List Ast, skip: List Span) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        if (span-skipped(ast-span(f), skip)) -> () | collect-def(env, f)
        collect-defs-skip(env, rest, skip)
      }


let collect-defn-schemes(env: TypeEnv, forms: List Ast) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        collect-defn-scheme(env, f)
        collect-defn-schemes(env, rest)
      }

let run-typecheck-top(env: TypeEnv, forms: List Ast, top-local: Ref (Map Str Type)) -> Unit =
  match (forms)
    | [] -> ()
    | f :: rest ->
      {
        typecheck-top(env, f, top-local)
        run-typecheck-top(env, rest, top-local)
      }

let reverse-errs-onto(xs: List TypeError, acc: List TypeError) -> List TypeError =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-errs-onto(rest, x :: acc)

let reverse-errs(xs: List TypeError) -> List TypeError =
  reverse-errs-onto(xs, [])

; The slot chosen for a project form.
let proj-index-of(note: ProjNote) -> Int =
  match (note)
    | ProjNote(_, _, _, index) -> index

; Preserve print argument types before lowering erases Bool/Unit/Int distinctions.
let print-sym(s: Str) -> Ast =
  SymNode(s, Span(0, 0, 0, 1))

let print-str(s: Str) -> Ast =
  StrNode(s, Span(0, 0, 0, 1))

let print-call(name: Str, args: List Ast) -> Ast =
  ParenNode(print-sym(name) :: args, Span(0, 0, 0, 1))

let print-type-ast(t: Type) -> Ast =
  match (t)
    | TList(e) -> print-call("List", [print-type-ast(e)])
    | TMaybe(e) -> print-call("Maybe", [print-type-ast(e)])
    | TResult(a, b) -> print-call("Result", [print-type-ast(a), print-type-ast(b)])
    | TMap(a, b) -> print-call("Map", [print-type-ast(a), print-type-ast(b)])
    | TProduct(ts) -> print-call("product", map(print-type-ast, ts))
    | TNominal(_, n, args, _) ->
      if (args == []) -> print-sym(n) | print-call(n, map(print-type-ast, args))
    | _ -> print-sym(type-show(t))

let print-def(name: Str, t: Type, body: Ast) -> Ast =
  print-call("defn", [print-sym(name), print-call("v:", [print-type-ast(t)]), print-sym("->"), print-sym("Str"), body])

let print-concat(a: Ast, b: Ast) -> Ast =
  print-call("str-concat", [a, b])

let print-error(message: Str) -> Ast =
  print-call("do", [print-call("write", [IntNode(2, Span(0, 0, 0, 1)), print-str(String.concat(message, "\n"))]), print-call("exit", [IntNode(1, Span(0, 0, 0, 1))]), print-str("")])

let print-format(env: TypeEnv, t: Type, value: Ast) -> Ast {
  let resolved = apply-subst(env, t)
  let key = type-show(resolved)
  let name =
    match (Map.lookup(key, deref(print-names)))
      | Some(n) -> n
      | None ->
        {
          let n = String.concat("__print-value", show(Map.size(deref(print-names))))
          set!(print-names, Map.set(key, n, deref(print-names)))
          let body = print-format-body(env, resolved)
          set!(print-functions, print-def(n, resolved, body) :: deref(print-functions))
          n
        }
  print-call(name, [value])
}

let print-payloads(env: TypeEnv, ts: List Type, i: Int) -> Ast =
  match (ts)
    | [] -> print-str("")
    | t :: rest ->
      print-concat(print-str(" "), print-concat(print-format(env, t, print-sym(String.concat("p", show(i)))), print-payloads(env, rest, i + 1)))

let print-pattern(name: Str, ts: List Type, i: Int) -> List Ast =
  match (ts)
    | [] -> []
    | _ :: rest -> print-sym(String.concat("p", show(i))) :: print-pattern(name, rest, i + 1)

; A private constructor is renamed to __mN_Name by module flattening. The
; derived show strips that prefix; the type-directed printer must too.
let source-name-digits(n: Str, i: Int, len: Int) -> Str =
  cond
    | i >= len -> n
    | else ->
      {
        let b = String.byte(i, n)
        cond
          | b >= 48 && b <= 57 -> source-name-digits(n, i + 1, len)
          | b == 95 -> String.slice(i + 1, len - (i + 1), n)
          | else -> n
      }

let source-ctor-name(n: Str) -> Str {
  let len = String.length(n)
  if (len >= 4 && String.byte(0, n) == 95 && String.byte(1, n) == 95 && String.byte(2, n) == 109) -> source-name-digits(n, 3, len) | n
}

let print-ctor-body(env: TypeEnv, name: Str, ts: List Type) -> Ast =
  print-concat(print-str(String.concat("(", source-ctor-name(name))), print-concat(print-payloads(env, ts, 0), print-str(")")))

let print-ctor-arms(env: TypeEnv, cs: List VariantCtor, params: Map Str Type) -> List Ast =
  match (cs)
    | [] -> []
    | VariantCtor(name, ts) :: rest ->
      {
        let concrete = replace-params-list(ts, params)
        let pat = print-call(name, print-pattern(name, concrete, 0))
        pat :: print-ctor-body(env, name, concrete) :: print-ctor-arms(env, rest, params)
      }

let print-field-types(fs: List RecordField) -> List Type =
  match (fs)
    | [] -> []
    | RecordField(_, t) :: rest -> t :: print-field-types(rest)

let print-nominal-body(env: TypeEnv, name: Str, args: List Type) -> Ast =
  match (type-get(env, name))
    | None -> print-error(String.concat("print: missing type ", name))
    | Some(td) ->
      match (td)
        | RecordDef(_, _, ps, fs) ->
          print-call("match", print-sym("v") :: print-ctor-arms(env, [VariantCtor(name, print-field-types(fs))], bind-type-params(ps, args, Map.empty())))
        | VariantDef(_, _, ps, cs) ->
          print-call("match", print-sym("v") :: print-ctor-arms(env, cs, bind-type-params(ps, args, Map.empty())))

let print-map-body(env: TypeEnv, t: Type, k: Type, value: Type) -> Ast {
  let name = String.concat("__print-map", show(Map.size(deref(print-names))))
  let found = print-call("match", [print-call("map-get", [print-sym("v"), print-sym("key")]), print-call("Some", [print-sym("item")]), print-format(env, value, print-sym("item")), print-call("None", []), print-error("print: map key disappeared")])
  let entry = print-concat(print-format(env, k, print-sym("key")), print-concat(print-str(" => "), found))
  let tail = print-call("if", [print-call("=", [print-sym("rest"), print-call("Nil", [])]), print-str(""), print-concat(print-str(", "), print-call(name, [print-sym("v"), print-sym("rest")]))])
  let body = print-call("match", [print-sym("keys"), print-call("Nil", []), print-str(""), print-call("Cons", [print-sym("key"), print-sym("rest")]), print-concat(entry, tail)])
  let def = print-call("defn", [print-sym(name), print-call("v:", [print-type-ast(t)]), print-call("keys:", [print-type-ast(TList(k))]), print-sym("->"), print-sym("Str"), body])
  set!(print-functions, def :: deref(print-functions))
  print-concat(print-str("{"), print-concat(print-call(name, [print-sym("v"), print-call("map-keys", [print-sym("v")])]), print-str("}")))
}

let print-list-body(env: TypeEnv, t: Type, elem: Type) -> Ast {
  let name = String.concat("__print-list", show(Map.size(deref(print-names))))
  let item = print-format(env, elem, print-sym("item"))
  let tail = print-call("if", [print-call("=", [print-sym("rest"), print-call("Nil", [])]), print-str(""), print-concat(print-str(", "), print-call(name, [print-sym("rest")]))])
  let body = print-call("match", [print-sym("v"), print-call("Nil", []), print-str(""), print-call("Cons", [print-sym("item"), print-sym("rest")]), print-concat(item, tail)])
  set!(print-functions, print-def(name, t, body) :: deref(print-functions))
  print-concat(print-str("["), print-concat(print-call(name, [print-sym("v")]), print-str("]")))
}

let print-int(n: Int) -> Ast =
  IntNode(n, Span(0, 0, 0, 1))

let print-product-part(env: TypeEnv, t: Type, i: Int) -> Ast =
  print-format(env, t, print-call("slot", [print-sym("v"), print-int(i)]))

let print-product-parts(env: TypeEnv, ts: List Type, i: Int) -> Ast =
  match (ts)
    | [] -> print-str("")
    | [t] -> print-product-part(env, t, i)
    | t :: rest ->
      print-concat(print-product-part(env, t, i), print-concat(print-str(", "), print-product-parts(env, rest, i + 1)))

let print-product-body(env: TypeEnv, ts: List Type) -> Ast =
  print-concat(print-str("("), print-concat(print-product-parts(env, ts, 0), print-str(")")))

let print-format-body(env: TypeEnv, t: Type) -> Ast =
  match (t)
    | TBool -> print-call("if", [print-sym("v"), print-str("true"), print-str("false")])
    | TUnit -> print-str("()")
    | TList(e) -> print-list-body(env, t, e)
    | TMaybe(e) ->
      print-call("match", print-sym("v") :: print-ctor-arms(env, [VariantCtor("None", []), VariantCtor("Some", [e])], Map.empty()))
    | TResult(a, b) ->
      print-call("match", print-sym("v") :: print-ctor-arms(env, [VariantCtor("Ok", [a]), VariantCtor("Err", [b])], Map.empty()))
    | TNominal(_, n, args, _) -> print-nominal-body(env, n, args)
    | TMap(k, v) -> print-map-body(env, t, k, v)
    | TProduct(ts) -> print-product-body(env, ts)
    | TParam(_) | TVar(_, _) ->
      print-error("print: cannot format an unresolved type parameter")
    | TInt | TFloat | TChar | TStr -> print-call("show", [print-sym("v")])
    | _ -> print-error(String.concat("print: type ", type-show(t), " is not supported"))

let find-print-note(sp: Span, notes: List PrintNote) -> Maybe (List Type) =
  match (notes)
    | [] -> None()
    | PrintNote(saved, ts) :: rest ->
      if (sp.start == saved.start && sp.end == saved.end && sp.origin == saved.origin) -> Some(ts) | find-print-note(sp, rest)

let print-write(value: Ast) -> Ast =
  print-call("print-text", [value])

let rewrite-print-args(args: List Ast, ts: List Type, notes: List ProjNote, env: TypeEnv) -> List Ast =
  match (args)
    | [] -> []
    | a :: rest ->
      match (ts)
        | [] -> [print-error("print: missing argument type")]
        | t :: tail ->
          {
            let value = rewrite-project-ast(a, notes, env)
            let formatted = if (type-is-str(apply-subst(env, t))) -> value | print-format(env, t, value)
            print-write(formatted) :: rewrite-print-args(rest, tail, notes, env)
          }

let rewrite-print(elems: List Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (elems)
    | head :: args ->
      match (find-print-note(sp, deref(print-notes)))
        | None -> ParenNode(elems, sp)
        | Some(ts) ->
          {
            let writes = rewrite-print-args(args, ts, notes, env)
            let unit = ParenNode([], sp)
            let suffix = if (is-sym(head, "println")) -> [print-write(print-str("\n")), unit] | [unit]
            ParenNode(print-sym("do") :: append(suffix, writes), sp)
          }
    | [] -> ParenNode([], sp)

; Rewrite projections and typed print calls together so nested expressions agree.
let rewrite-project-list(elems: List Ast, notes: List ProjNote, env: TypeEnv) -> List Ast =
  match (elems)
    | [] -> []
    | e :: rest -> rewrite-project-ast(e, notes, env) :: rewrite-project-list(rest, notes, env)

; A project node becomes a slot read when its index is known.
let is-print-formattable(t: Type) -> Bool =
  match (t)
    | TBool -> true
    | TUnit -> true
    | TList(_) -> true
    | TMaybe(_) -> true
    | TResult(_, _) -> true
    | TNominal(_, _, _, _) -> true
    | TMap(_, _) -> true
    | TProduct(_) -> true
    | _ -> false

let rewrite-show(elems: List Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (elems)
    | _ :: arg :: _ ->
      match (find-show-note(sp, deref(show-notes)))
        | None -> ParenNode(elems, sp)
        | Some(t) ->
          {
            let resolved = apply-subst(env, t)
            if (is-print-formattable(resolved)) ->
              print-format(env, resolved, rewrite-project-ast(arg, notes, env)) |
              ParenNode(elems, sp)
          }
    | _ -> ParenNode(elems, sp)

let rewrite-project-node(elems: List Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (elems)
    | head :: obj :: _ ->
      cond
        | is-sym(head, "project") -> rewrite-project-field(elems, obj, sp, notes, env)
        | is-sym(head, "?") -> rewrite-ques(elems, sp, notes, env)
        | is-sym(head, "show") -> rewrite-show(elems, sp, notes, env)
        | is-sym(head, "print") || is-sym(head, "println") -> rewrite-print(elems, sp, notes, env)
        | else -> ParenNode(rewrite-project-list(elems, notes, env), sp)
    | [head] ->
      if (is-sym(head, "print") || is-sym(head, "println")) -> rewrite-print(elems, sp, notes, env) | ParenNode(elems, sp)
    | _ -> ParenNode(rewrite-project-list(elems, notes, env), sp)

; Expand `(? lhs rhs)` to a Maybe or Result match using the inferred kind.
let rewrite-ques(elems: List Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (elems)
    | _ :: lhs :: rhs :: [] ->
      {
        let left = rewrite-project-ast(lhs, notes, env)
        let right = rewrite-project-ast(rhs, notes, env)
        let binder = SymNode("mn-ques", sp)
        match (find-ques-note(sp, deref(ques-notes)))
          | Some(QuesNote(_, _, _, 1)) ->
            ParenNode(
              [
                SymNode("match", sp),
                left,
                ParenNode([SymNode("Ok", sp), binder], sp),
                binder,
                ParenNode([SymNode("Err", sp), SymNode("_", sp)], sp),
                right
              ],
              sp
            )
          | _ ->
            ParenNode(
              [
                SymNode("match", sp),
                left,
                ParenNode([SymNode("Some", sp), binder], sp),
                binder,
                ParenNode([SymNode("None", sp)], sp),
                right
              ],
              sp
            )
      }
    | _ -> ParenNode(rewrite-project-list(elems, notes, env), sp)

; Re-match to pick out the field (kept out of the `head :: obj :: _`
; pattern above so that doesn't require 3 elements — `print`/`println`
; above only ever have 2).
let rewrite-project-field(elems: List Ast, obj: Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (elems)
    | _ :: _ :: field :: _ -> rewrite-noted-project(obj, field, sp, notes, env)
    | _ -> ParenNode([SymNode("project", sp), rewrite-project-ast(obj, notes, env)], sp)

; `(slot obj index)` is what the lowerer reads. A tuple's field is
; already a positive, 1-based `IntNode` straight from the reader — no
; `ProjNote` is ever recorded for it (that mechanism only tracks named
; record fields), so it is handled directly rather than falling through
; to `find-proj-note`.
let rewrite-noted-project(obj: Ast, field: Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (field)
    | IntNode(n, _) -> ParenNode([SymNode("slot", sp), rewrite-project-ast(obj, notes, env), IntNode(n - 1, sp)], sp)
    | _ -> rewrite-noted-project-named(obj, sp, notes, env)

let rewrite-noted-project-named(obj: Ast, sp: Span, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (find-proj-note(sp, notes))
    | None -> ParenNode([SymNode("project", sp), rewrite-project-ast(obj, notes, env)], sp)
    | Some(note) ->
      ParenNode([SymNode("slot", sp), rewrite-project-ast(obj, notes, env), IntNode(proj-index-of(note), sp)], sp)

; Walk one form, replacing record projections with slot reads.
let rewrite-project-ast(ast: Ast, notes: List ProjNote, env: TypeEnv) -> Ast =
  match (ast)
    | ParenNode(elems, sp) -> rewrite-project-node(elems, sp, notes, env)
    | BracketNode(elems, sp) -> BracketNode(rewrite-project-list(elems, notes, env), sp)
    | _ -> ast

; Rewrite every top-level form after a successful check.
let rewrite-project-forms(forms: List Ast, notes: List ProjNote, env: TypeEnv) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> rewrite-project-ast(f, notes, env) :: rewrite-project-forms(rest, notes, env)

let rewrite-recpat-forms(forms: List Ast, env: TypeEnv) -> List Ast =
  match (forms)
    | [] -> []
    | f :: rest -> rewrite-recpat-ast(f, env) :: rewrite-recpat-forms(rest, env)

let rewrite-recpat-list(xs: List Ast, env: TypeEnv) -> List Ast =
  match (xs)
    | [] -> []
    | h :: t -> rewrite-recpat-ast(h, env) :: rewrite-recpat-list(t, env)

let rewrite-recpat-ast(ast: Ast, env: TypeEnv) -> Ast =
  match (ast)
    | ParenNode(elems, sp) -> rewrite-recpat-paren(elems, sp, env)
    | BracketNode(elems, sp) -> BracketNode(rewrite-recpat-list(elems, env), sp)
    | _ -> ast

let rewrite-recpat-paren(elems: List Ast, sp: Span, env: TypeEnv) -> Ast =
  match (elems)
    | head :: rest ->
      match (sym-str(head))
        | Some(n) ->
          if (n == "recpat") -> expand-recpat(rest, sp, env) | ParenNode(rewrite-recpat-list(elems, env), sp)
        | None -> ParenNode(rewrite-recpat-list(elems, env), sp)
    | [] -> ParenNode([], sp)

let expand-recpat(args: List Ast, sp: Span, env: TypeEnv) -> Ast =
  match (args)
    | name-ast :: fields ->
      match (sym-str(name-ast))
        | Some(name) -> expand-recpat-named(name-ast, name, fields, sp, env)
        | None -> ParenNode(mk-recpat(args, sp), sp)
    | [] -> ParenNode(mk-recpat(args, sp), sp)

let expand-recpat-named(name-ast: Ast, name: Str, fields: List Ast, sp: Span, env: TypeEnv) -> Ast =
  match (type-get(env, name))
    | Some(RecordDef(_, _, _, rfields)) -> ParenNode(name-ast :: positional-fields(rfields, sym-names(fields, []), sp), sp)
    | _ -> ParenNode(mk-recpat(name-ast :: fields, sp), sp)

let mk-recpat(args: List Ast, sp: Span) -> List Ast =
  SymNode("recpat", sp) :: args

let sym-names(fields: List Ast, acc: List Str) -> List Str =
  match (fields)
    | [] -> acc
    | f :: rest ->
      match (sym-str(f))
        | Some(n) -> sym-names(rest, n :: acc)
        | None -> sym-names(rest, acc)

let finish-typecheck(forms: List Ast, errs: List TypeError, env: TypeEnv) -> Result (List Ast) (List TypeError) =
  match (errs)
    | [] ->
      {
        let rewritten = rewrite-recpat-forms(rewrite-project-forms(forms, deref(proj-notes), env), env)
        Ok(append(reverse(deref(print-functions)), rewritten))
      }
    | _ -> Err(reverse-errs(errs))

let rest-to-type(es: List RestError) -> List TypeError =
  match (es)
    | [] -> []
    | RestError(sp, code, msg) :: rest -> TypeError(sp, code, msg) :: rest-to-type(rest)

; Typecheck a single-file program's top-level forms (post-desugar, post
; rest-pack). Two passes: collect every declared type and defn scheme
; first (so mutual recursion and forward references between defns
; typecheck), then check every body/expression. Rest parameters are
; packed first, so the typer sees an ordinary list parameter.
let is-type-binding(form: Ast) -> Bool =
  match (form)
    | ParenNode(head :: _ :: _ :: [], _) ->
      is-sym(head, "type-binding") || is-sym(head, "ctor-binding")
    | _ -> false

let collect-type-bindings(env: TypeEnv, forms: List Ast) -> Unit =
  match (forms)
    | [] -> ()
    | form :: rest ->
      {
        match (form)
          | ParenNode(head :: visible :: canonical :: [], _) ->
            match (visible)
              | StrNode(v, _) ->
                match (canonical)
                  | StrNode(id, _) ->
                    cond
                      | is-sym(head, "type-binding") -> type-bind!(env, v, id)
                      | is-sym(head, "ctor-binding") -> ctor-bind!(env, v, id)
                      | else -> ()
                  | _ -> ()
              | _ -> ()
          | _ -> ()
        collect-type-bindings(env, rest)
      }

let strip-type-bindings(forms: List Ast, acc: List Ast) -> List Ast =
  match (forms)
    | [] -> reverse-asts(acc, [])
    | form :: rest ->
      if (is-type-binding(form)) -> strip-type-bindings(rest, acc) | strip-type-bindings(rest, form :: acc)

let reverse-asts(xs: List Ast, acc: List Ast) -> List Ast =
  match (xs)
    | [] -> acc
    | x :: rest -> reverse-asts(rest, x :: acc)

let typecheck-collected(forms: List Ast) -> Result (List Ast) (List TypeError) {
  set!(proj-notes, [])
  set!(ques-notes, [])
  set!(print-notes, [])
  set!(print-functions, [])
  set!(print-names, Map.empty())
  set!(show-notes, [])
  let env = empty-env()
  collect-type-bindings(env, forms)
  let forms2 = strip-type-bindings(forms, [])
  let skip = ref([])
  register-stubs(env, forms2, ref([]), skip)
  collect-defs-skip(env, forms2, deref(skip))
  collect-defn-schemes(env, forms2)
  push-type-errs(env, check-pub-private-forms(forms2))
  let top-local = ref(Map.empty())
  run-typecheck-top(env, forms2, top-local)
  finish-typecheck(forms2, deref(env.diags), env)
}

let push-type-errs(env: TypeEnv, xs: List TypeError) -> Unit =
  match (xs)
    | [] -> ()
    | TypeError(sp, code, msg) :: rest ->
      {
        err!(env, code, msg, sp)
        push-type-errs(env, rest)
      }

; A public signature may name a builtin or an imported type. It may not
; name a nominal this module declares and does not publish.
pub let check-pub-private-forms(forms: List Ast) -> List TypeError {
  let declared = declared-type-names(forms, [])
  let pubs = published-names(forms, [])
  let aliases = alias-targets(forms, Map.empty())
  walk-pub-sigs(forms, declared, pubs, aliases, [])
}

let declared-type-names(forms: List Ast, acc: List Str) -> List Str =
  match (forms)
    | [] -> acc
    | f :: rest -> declared-type-names(rest, declared-type-one(unwrap-pub-ast(f), acc))

let declared-type-one(form: Ast, acc: List Str) -> List Str =
  match (form)
    | ParenNode(head :: name-part :: _, _) ->
      match (sym-str(head))
        | Some(n) ->
          if (n == "defrec" || n == "variant") -> declared-type-add(name-part, acc) | acc
        | None -> acc
    | _ -> acc

let declared-type-add(name-part: Ast, acc: List Str) -> List Str =
  match (parse-type-name(name-part))
    | Some(np) -> name-params-name(np) :: acc
    | None -> acc

let published-names(forms: List Ast, acc: List Str) -> List Str =
  match (forms)
    | [] -> acc
    | f :: rest -> published-names(rest, published-one(f, acc))

let published-one(form: Ast, acc: List Str) -> List Str =
  match (form)
    | ParenNode(head :: rest, sp) ->
      if (is-sym-name(head, "pub")) -> form-bound-names(ParenNode(rest, sp), acc) | acc
    | _ -> acc

let is-sym-name(ast: Ast, name: Str) -> Bool =
  match (sym-str(ast))
    | Some(n) -> n == name
    | None -> false

let form-bound-names(form: Ast, acc: List Str) -> List Str =
  match (form)
    | ParenNode(head :: rest, _) ->
      match (sym-str(head))
        | Some(n) -> bound-names-of(n, rest, acc)
        | None -> acc
    | _ -> acc

let bound-names-of(head: Str, rest: List Ast, acc: List Str) -> List Str =
  cond
    | head == "defn" || head == "extern" || head == "runtime" || head == "alias" || head == "defrec" -> declared-type-add(first-ast-or(rest), acc)
    | head == "variant" -> variant-bound-names(rest, acc)
    | else -> acc

let first-ast-or(xs: List Ast) -> Ast =
  match (xs)
    | [] -> SymNode("", Span(0, 0, 0, 0))
    | h :: _ -> h

let variant-bound-names(rest: List Ast, acc: List Str) -> List Str =
  match (rest)
    | name-part :: ctors -> ctor-bound-names(ctors, declared-type-add(name-part, acc))
    | [] -> acc

let ctor-bound-names(ctors: List Ast, acc: List Str) -> List Str =
  match (ctors)
    | [] -> acc
    | c :: rest ->
      match (c)
        | ParenNode(cname :: _, _) ->
          match (sym-str(cname))
            | Some(n) -> ctor-bound-names(rest, n :: acc)
            | None -> ctor-bound-names(rest, acc)
        | _ -> ctor-bound-names(rest, acc)

let alias-targets(forms: List Ast, acc: Map Str Ast) -> Map Str Ast =
  match (forms)
    | [] -> acc
    | f :: rest -> alias-targets(rest, alias-target-one(unwrap-pub-ast(f), acc))

let alias-target-one(form: Ast, acc: Map Str Ast) -> Map Str Ast =
  match (form)
    | ParenNode(head :: name-part :: ty :: _, _) ->
      if (is-sym-name(head, "alias")) -> alias-target-named(name-part, ty, acc) | acc
    | _ -> acc

let alias-target-named(name-part: Ast, ty: Ast, acc: Map Str Ast) -> Map Str Ast =
  match (sym-str(name-part))
    | Some(n) -> Map.set(n, ty, acc)
    | None -> acc

let walk-pub-sigs(forms: List Ast, declared: List Str, pubs: List Str, aliases: Map Str Ast, acc: List TypeError) -> List TypeError =
  match (forms)
    | [] -> acc
    | f :: rest -> walk-pub-sigs(rest, declared, pubs, aliases, walk-pub-sig(f, declared, pubs, aliases, acc))

let walk-pub-sig(form: Ast, declared: List Str, pubs: List Str, aliases: Map Str Ast, acc: List TypeError) -> List TypeError =
  match (form)
    | ParenNode(head :: kind :: _ :: rest, _) ->
      if (is-sym-name(head, "pub") && is-sig-kind(kind)) -> walk-type-list(sig-nodes(rest), declared, pubs, aliases, [], acc) | acc
    | _ -> acc

let is-sig-kind(ast: Ast) -> Bool =
  match (sym-str(ast))
    | Some(n) -> n == "defn" || n == "extern" || n == "runtime"
    | None -> false

let sig-nodes(rest: List Ast) -> List Ast =
  append-asts-local(nodes-before-arrow(rest, []), take-ret(nodes-after-arrow(rest)))

let nodes-before-arrow(xs: List Ast, acc: List Ast) -> List Ast =
  match (xs)
    | [] -> acc
    | h :: t ->
      if (is-sym-name(h, "->")) -> acc | nodes-before-arrow(t, h :: acc)

let nodes-after-arrow(xs: List Ast) -> List Ast =
  match (xs)
    | [] -> []
    | h :: t ->
      if (is-sym-name(h, "->")) -> t | nodes-after-arrow(t)

let take-ret(xs: List Ast) -> List Ast =
  match (xs)
    | [] -> []
    | h :: _ -> [h]

let append-asts-local(xs: List Ast, ys: List Ast) -> List Ast =
  match (xs)
    | [] -> ys
    | h :: t -> h :: append-asts-local(t, ys)

let walk-type-list(xs: List Ast, declared: List Str, pubs: List Str, aliases: Map Str Ast, expanding: List Str, acc: List TypeError) -> List TypeError =
  match (xs)
    | [] -> acc
    | h :: t -> walk-type-list(t, declared, pubs, aliases, expanding, walk-type-ast(h, declared, pubs, aliases, expanding, acc))

let walk-type-ast(ast: Ast, declared: List Str, pubs: List Str, aliases: Map Str Ast, expanding: List Str, acc: List TypeError) -> List TypeError =
  match (ast)
    | SymNode(n, sp) -> consider-type-name(n, sp, declared, pubs, aliases, expanding, acc)
    | ParenNode(xs, _) -> walk-type-list(xs, declared, pubs, aliases, expanding, acc)
    | _ -> acc

let consider-type-name(n: Str, sp: Span, declared: List Str, pubs: List Str, aliases: Map Str Ast, expanding: List Str, acc: List TypeError) -> List TypeError =
  cond
    | is-label(n) || member(n, expanding) -> acc
    | else ->
      match (Map.lookup(n, aliases))
        | Some(target) -> walk-type-ast(target, declared, pubs, aliases, n :: expanding, acc)
        | None ->
          if (member(n, declared) && not(member(n, pubs))) -> TypeError(sp, "E_PUB_PRIVATE_TYPE", String.concat("pub signature mentions private type ", n)) :: acc | acc

let is-label(n: Str) -> Bool {
  let len = String.length(n)
  len > 0 && String.byte(len - 1, n) == 58
}


pub let typecheck-forms(forms: List Ast) -> Result (List Ast) (List TypeError) =
  match (pack-rest(forms))
    | RestPack(packed, errs) ->
      match (errs)
        | [] -> typecheck-collected(packed)
        | _ -> Err(rest-to-type(errs))

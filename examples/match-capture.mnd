; Match binders are in scope for nested `fn`, and the env holds every capture.
; Prints: head 10, rest is non-empty, total 11
; Run with: `./mn run examples/match-capture.mnd`

let first-plus-rest-flag(xs: List Int) -> Int =
  match (xs)
    | [] ->
      {
        println("empty list, total 0")
        0
      }
    | h :: rest ->
      (fn () {
        let flag =
          match (rest)
            | [] -> 0
            | _ -> 1
        let total = h + flag
        print("head ")
        print(h)
        cond
          | flag == 0 ->
            {
              print(", rest is empty")
              0
            }
          | else ->
            {
              print(", rest is non-empty")
              0
            }
        print(", total ")
        println(total)
        total
      })()

let main() -> Int {
  first-plus-rest-flag([10, 1])
  0
}

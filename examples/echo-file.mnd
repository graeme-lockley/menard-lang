; Slice 3G — Tier-0 I/O: `read-file` + `write`.
; Prints a label, then the fixture text.
; Run with: `./mn run examples/echo-file.mnd` (cwd = repo root).

import std/io

let main() -> Int =
  match (read-file("examples/fixtures/echo-input.txt"))
    | Ok(s) ->
      {
        println("read examples/fixtures/echo-input.txt:")
        write(stdout, s)
        println()
        0
      }
    | Err(_) ->
      {
        println("could not read examples/fixtures/echo-input.txt")
        1
      }

; Phase 4 — heap churn for the copying nursery.
; Long list, large Map, StringBuffer growth, nested closures.
; Prints: list 528 map 62 sb 40 clo 16
; Run with: `./mn run examples/heap-churn.mnd`

import std/string as String
import std/map as Map
import std/string-buffer as Buf

let list-sum(xs: List Int) -> Int =
  match (xs)
    | [] -> 0
    | h :: t -> h + list-sum(t)

let build-list(n: Int) -> List Int =
  loop (i = n, acc = [])
    if (i == 0) -> acc | recur(i - 1, i :: acc)

let fill-map(n: Int) -> Int {
  let m =
    loop (i = 0, acc = Map.empty())
      if (i == n) -> acc | recur(i + 1, Map.set(acc, i, i * 2))
  match (Map.lookup(m, n - 1))
    | Some(v) -> v
    | None -> 0
}

let grow(n: Int) -> Int {
  let sb = Buf.new()
  loop (i = 0)
    cond
      | i == n -> String.length(Buf.take-str!(sb))
      | else ->
        {
          Buf.append-byte!(sb, 97)
          recur(i + 1)
        }
}

let adder(n: Int) -> (Int) -> Int =
  fn (m) = n + m

let twice(f: (Int) -> Int) -> (Int) -> Int =
  fn (x) = f(f(x))

let main() -> Int {
  let xs = build-list(32)
  let add = adder(3)
  let bump = twice(add)
  println("list ", list-sum(xs), " map ", fill-map(32), " sb ", grow(40), " clo ", bump(10))
  0
}

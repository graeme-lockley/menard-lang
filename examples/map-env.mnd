; Slice 3F — persistent Map.
; Prints both entries and the size.
; Run with: `./mn run examples/map-env.mnd`

import std/map as Map

let print-got(v: Maybe Int) -> Int =
  match (v)
    | Some(n) ->
      {
        print(n)
        0
      }
    | None ->
      {
        print("none")
        0
      }

let main() -> Int {
  let m0 = Map.empty()
  let m1 = Map.set(1, 10, m0)
  let m2 = Map.set(2, 20, m1)
  print("1 -> ")
  print-got(Map.lookup(1, m2))
  print(", 2 -> ")
  print-got(Map.lookup(2, m2))
  print(", size ")
  println(Map.size(m2))
  0
}

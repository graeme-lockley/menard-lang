; Slice 3C — Result + match.
; Prints the unwrapped Ok and the fallback for Err.
; Run with: `./mn run examples/result-match.mnd`

let unwrap-or-zero(r: Result Int Str) -> Int =
  match (r)
    | Ok(n) -> n
    | Err(_) -> 0

let main() -> Unit {
  println("Ok 7 unwraps to ", unwrap-or-zero(Ok(7)))
  println("Err \"missing\" unwraps to ", unwrap-or-zero(Err("missing")))
}

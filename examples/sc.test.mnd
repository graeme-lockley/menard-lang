import "./sc.mnd"

test "an empty string adds to zero" = add("") == Ok(0)
test "one number adds to itself" = add("1") == Ok(1)
test "two comma-separated numbers are added" = add("1,2") == Ok(3)
test "any number of comma-separated numbers are added" = add("1,2,3,4") == Ok(10)
test "commas and newlines are both delimiters" = add("1\n2,3") == Ok(6)
test "a custom delimiter replaces comma and newline" =
  add("//;\n1;2") == Ok(3)
test "a bracketed multi-character delimiter is supported" =
  add("//[***]\n1***2***3") == Ok(6)
test "multiple bracketed delimiters are supported" =
  add("//[**][%%]\n1**2%%3") == Ok(6)
test "negative values are reported together" = add("-1,2,-3") == Err([-1, -3])
test "values greater than one thousand are ignored" = add("2,1001,3") == Ok(5)
test "one thousand is still included" = add("1000,1") == Ok(1001)

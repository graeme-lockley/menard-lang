; User record and variant. `show` must print the same text on the
; interpreter and on a native binary.
; Run with: `./mn run examples/derive-show.mnd`

record Point {
  x: Int
  y: Int
}

type Color =
  | Red
  | Rgb(Int, Int, Int)

let main() -> Unit {
  println(Point(1, 2))
  println(Red())
  println(Rgb(3, 4, 5))
}

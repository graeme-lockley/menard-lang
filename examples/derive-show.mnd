; User record and variant. `show` must print the same text on the
; interpreter and on a native binary.

(import "../stdlib/io.mnd")

(defrec Point (x: Int) (y: Int))

(variant Color
  (Red)
  (Rgb Int Int Int))

(defn main -> Int
  (do
    (write stdout (show (Point 1 2)))
    (println "")
    (write stdout (show (Red)))
    (println "")
    (write stdout (show (Rgb 3 4 5)))
    (println "")
    0))

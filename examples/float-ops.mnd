; Floats are bytes objects. -0.0 stays distinct from 0.0.

(import std/io)

(defn main -> Int
  (do
    (write stdout (show -0.0))
    (println "")
    (write stdout (show 0.0))
    (println "")
    (write stdout (show (f+ -0.0 0.0)))
    (println "")
    (write stdout (show (f+ 1.5 2.5)))
    (println "")
    (write stdout (show (f- 1.0 2.5)))
    (println "")
    (write stdout (show (f* 1.5 2.0)))
    (println "")
    (write stdout (show (f/ 7.5 2.5)))
    (println "")
    0))

; Slice 3C — List + match.
; Prints: 10 + 20 + 30 = 60
; Run with: `./mn run examples/list-sum.mnd`

let list-sum(xs: List Int) -> Int =
  match (xs)
    | [] -> 0
    | Cons(h, t) -> h + list-sum(t)

let print-summands(xs: List Int) -> Int =
  match (xs)
    | [] -> 0
    | Cons(h, t) ->
      {
        print(h)
        match (t)
          | [] -> 0
          | _ ->
            {
              print(" + ")
              print-summands(t)
            }
      }

let main() -> Int {
  let xs = [10, 20, 30]
  print-summands(xs)
  print(" = ")
  println(list-sum(xs))
  0
}

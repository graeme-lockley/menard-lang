; Slice 3E — heap closures (spec §2.6). Returned `fn` captures `n`,
; then `List.map` applies it to every element of a list.
; Prints the list before and after.
; Run with: `./mn run examples/closure-adder.mnd`

import std/list as List
import std/string as String

let adder(n: Int) -> (Int) -> Int =
  fn (m) = n + m

let print-elems(xs: List Int) -> Unit =
  xs |> List.map(String.from-int) |> String.join(" ") |> print()

let print-list(msg: Str, xs: List Int) -> Unit {
  print(msg, ": (")
  print-elems(xs)
  println(")")
}

let main() -> Unit {
  let before = [1, 2, 3]
  let add40 = adder(40)
  let after = before |> List.map(add40)

  print-list("before", before)
  print-list("after", after)
}

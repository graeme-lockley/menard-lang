; Slice 3D — StringBuffer build + take.
; Prints: built hi! (3 bytes)
; Run with: `./mn run examples/stringbuffer.mnd`

import std/string as String
import std/string-buffer as Buf

let main() -> Unit {
  let sb = Buf.new()
  Buf.append!(sb, "hi")
  Buf.append-byte!(sb, 33)
  let s = Buf.take-str!(sb)
  println("built ", s, " (", String.length(s), " bytes)")
}

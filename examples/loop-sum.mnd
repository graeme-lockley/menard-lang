; Slice 3A — `loop` / `recur` over Int bindings.
; Prints: sum of 0 through 10 is 55
; Run with: `./mn run examples/loop-sum.mnd`

let sum-to(n: Int) -> Int =
  loop (i = 0, acc = 0)
    if (i > n) -> acc | recur(i + 1, acc + i)

let main() -> Int {
  let n = 10
  let s = sum-to(n)
  println("sum of 0 through ", n, " is ", s)
  0
}

import std/int as Int
import std/list as List
import std/string as String

; The sum of the numbers in input. Commas and newlines separate them, or a
; `//` header names the separators. A number above 1000 is left out. A
; negative is not summed: the error is every negative, in encounter order.
;
; @test add("") => Ok(0)
; @test add("1") => Ok(1)
; @test add("1,2") => Ok(3)
; @test add("1,2,3,4") => Ok(10)
; @test add("1\n2,3") => Ok(6)
; @test add("//;\n1;2") => Ok(3)
; @test add("//[***]\n1***2***3") => Ok(6)
; @test add("//[**][%%]\n1**2%%3") => Ok(6)
; @test add("-1,2,-3") => Err([-1, -3])
; @test add("2,1001,3") => Ok(5)
; @test add("1000,1") => Ok(1001)
pub let add(input: Str) -> Result Int (List Int) {
  let starts-with = fn (prefix) = input |> String.starts-with(prefix)
  let tokens =
    if (input == "") -> [] |
    if (starts-with("//[")) ->
      {
        let idx = String.index-of("\n", input) ? 0
        let separators = String.slice(3, idx - 4, input) |> String.split("][")
        input |> String.drop(idx + 1) |> String.split-using(separators)
      } | if (starts-with("//")) -> String.drop(4, input) |> String.split(String.slice(2, 1, input)) | String.split-using([",", "\n"], input)
  let numbers = tokens |> List.map(Int.parse) |> List.filter(fn (n) = n <= 1000)
  if (List.any(is-negative, numbers)) -> numbers |> List.filter(is-negative) |> Err() | numbers |> List.sum() |> Ok()
}

let is-negative(n: Int) -> Bool =
  n < 0

import std/int as Int
import std/list as List
import std/maybe as Maybe
import std/string as String

; Reports all negative values in encounter order; values above 1000 are ignored.
pub let add(input: Str) -> Result Int (List Int) {
  let starts-with(prefix: String) -> Bool =
    input |> String.starts-with(prefix)

  let tokens =
    cond
      | input == "" -> []
      | starts-with("//[") -> {
          let idx = String.index-of("\n", input) |> Maybe.with-default(0)
          let separators = str-slice(input, 3, idx - 4) |> String.split("][")
          
          input |> String.drop(idx + 1) |> String.split-using(separators)
        }
      | starts-with("//") -> String.drop(4, input) |> String.split(str-slice(input, 2, 1))
      | else -> String.split-using([",", "\n"], input)

  let numbers = tokens |> List.map(Int.parse) |> List.filter(fn (n) = n <= 1000)

  cond
    | numbers |> List.any(is-negative) -> numbers |> List.filter(is-negative) |> Err()
    | else -> Ok(sum(numbers))
}

let sum(numbers: List Int) -> Int =
  numbers |> List.fold(fn (a, n) = a + n, 0)

let is-negative(n: Int) -> Bool =
  n < 0

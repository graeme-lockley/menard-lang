import std/int as I
import std/list as List
import std/maybe as Maybe
import std/string as String

; Reports all negative values in encounter order; values above 1000 are ignored.
pub let add(input: Str) -> Result Int (List Int) {
  let tokens =
    cond
      | input == "" -> []
      | String.starts-with(input, "//[") -> {
          let idx = Maybe.with-default(0, String.index-of(input, "\n"))
          let separators = String.split(str-slice(input, 3, idx - 4), "][")

          String.split-using(String.drop(input, idx + 1), separators)
      }
      | String.starts-with(input, "//") -> String.split(String.drop(input, 4), str-slice(input, 2, 1))
      | else -> String.split-using(input, [",", "\n"])

  let numbers = List.filter(fn(n) = n <= 1000, List.map(I.parse, tokens))

  cond
    | List.any(is-negative, numbers) -> Err(List.filter(is-negative, numbers)) 
    | else -> Ok(sum(numbers))
}

let sum(numbers: List Int) -> Int =
  List.fold(fn (a, n) = a + n, 0, numbers)

let is-negative(n: Int) -> Bool =
  n < 0
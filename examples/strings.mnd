; Slice 3D — Str concat + byte-length.
; Prints: "hel" + "lo" = hello (5 bytes)
; Run with: `./mn run examples/strings.mnd`

import std/io
import std/string as String

let main() -> Int {
  let s = String.concat("hel", "lo")
  print("\"hel\" + \"lo\" = ")
  write(stdout, s)
  print(" (")
  print(String.length(s))
  println(" bytes)")
  0
}

; ANSI color for a terminal, and plain text everywhere else.
; @module std/console

import std/fs
import std/sys
import std/string as String
import std/string-buffer as Buf

; The escape sequence for codes, which already includes the leading bracket.
let esc(codes: Str) -> Str {
  let sb = Buf.new()
  Buf.append-byte!(sb, 27)
  Buf.append!(sb, codes)
  Buf.take-str!(sb)
}

; True when fd is a terminal and NO_COLOR is unset.
; @test tty-color(1)
pub let tty-color(fd: Int) -> Bool =
  isatty(fd) && match (getenv("NO_COLOR"))
    | None -> true
    | Some(_) -> false

; s wrapped in an ANSI sequence when on is true, otherwise s unchanged.
; @test paint(false, "[31m", "hi") => "hi"
pub let paint(on: Bool, code: Str, s: Str) -> Str =
  if (on) -> String.concat(esc(code), s, esc("[0m")) | s

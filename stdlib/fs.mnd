; Path predicates. `exists` is allocation-free; `rename` returns IoError,
; which is defined in io.mnd.
; @module std/fs

import std/io

; Re-export the error type so a public signature may name it.
pub alias IoError = IoError

extern mn_exists(path: Str) -> Bool

extern mn_rename(from: Str, to: Str) -> Result Unit IoError

; Whether a file or directory is at path.
; @test exists("no-such-file")
pub let exists(path: Str) -> Bool =
  mn_exists(path)

; Rename from to to, or an IoError.
; @test rename("old", "new")
pub let rename(from: Str, to: Str) -> Result Unit IoError =
  mn_rename(from, to)

extern mn_isatty(fd: Int) -> Bool

extern mn_mtime(path: Str) -> Int

extern mn_cwd() -> Str

extern mn_ensure_dir(path: Str) -> Bool

extern mn_list_dir(path: Str) -> Str

extern mn_realpath(path: Str) -> Str

extern mn_now_ms() -> Int

extern mn_remove(path: Str) -> Bool

extern mn_is_dir(path: Str) -> Bool

; Whether fd is a terminal.
; @test isatty(1)
pub let isatty(fd: Int) -> Bool =
  mn_isatty(fd)

; Modification time of path in milliseconds, or 0 when missing.
; @test mtime("no-such-file")
pub let mtime(path: Str) -> Int =
  mn_mtime(path)

; The process working directory.
; @test cwd()
pub let cwd() -> Str =
  mn_cwd()

; Create path and any missing parents. False when creation fails.
; @test ensure-dir("build")
pub let ensure-dir(path: Str) -> Bool =
  mn_ensure_dir(path)

; The names in path, joined by newlines.
; @test list-dir(".")
pub let list-dir(path: Str) -> Str =
  mn_list_dir(path)

; The absolute path, or empty when it cannot be resolved.
; @test realpath(".")
pub let realpath(path: Str) -> Str =
  mn_realpath(path)

; Milliseconds since the epoch.
; @test now-ms()
pub let now-ms() -> Int =
  mn_now_ms()

; Remove path. False when it is missing or cannot be removed.
; @test remove("no-such-file")
pub let remove(path: Str) -> Bool =
  mn_remove(path)

; Whether path names a directory.
; @test is-dir(".")
pub let is-dir(path: Str) -> Bool =
  mn_is_dir(path)

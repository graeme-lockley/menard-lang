; Helpers over the language Maybe type.
; @module std/maybe

; Apply f to a Some value and leave None in place.
; @test map(fn (n) = n + 1, Some(1)) => Some(2)
; @test map(fn (n) = n + 1, None()) => None()
pub let map[a, b](f: (a) -> b, m: Maybe a) -> Maybe b =
  match (m)
    | Some(v) -> Some(f(v))
    | None -> None()

; Replace a Some value with the Maybe that f returns.
; @test and-then(fn (n) = Some(n + 1), Some(1)) => Some(2)
pub let and-then[a, b](f: (a) -> Maybe b, m: Maybe a) -> Maybe b =
  match (m)
    | Some(v) -> f(v)
    | None -> None()

; The Some value, or default when m is None.
; @test unwrap-or(None(), 0) => 0
pub let unwrap-or[a](m: Maybe a, default: a) -> a =
  match (m)
    | Some(v) -> v
    | None -> default

; Return the Some value, using default when m is None.
; @test with-default(100, Some(42)) => 42
; @test with-default(100, None()) => 100
; @test with-default("unknown", Some("known")) => "known"
; @test with-default("unknown", None()) => "unknown"
pub let with-default[a](default: a, m: Maybe a) -> a =
  unwrap-or(m, default)

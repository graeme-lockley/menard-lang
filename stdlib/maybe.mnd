; Helpers over the language Maybe type.
; A missing value is filled in with `?`, which leaves the fallback unevaluated
; when the value is present.
; @module std/maybe

; Apply f to a Some value and leave None in place.
; @test map(fn (n) = n + 1, Some(1)) => Some(2)
; @test map(fn (n) = n + 1, None()) => None()
pub let map[a, b](f: (a) -> b, m: Maybe a) -> Maybe b =
  match (m)
    | Some(v) -> Some(f(v))
    | None -> None()

; Replace a Some value with the Maybe that f returns.
; @test and-then(fn (n) = Some(n + 1), Some(1)) => Some(2)
; @test and-then(fn (n) = Some(n + 1), None()) => None()
pub let and-then[a, b](f: (a) -> Maybe b, m: Maybe a) -> Maybe b =
  match (m)
    | Some(v) -> f(v)
    | None -> None()

; Apply f when both values are present.
; @test map2(fn (a, b) = a + b, Some(1), Some(2)) => Some(3)
; @test map2(fn (a, b) = a + b, None(), Some(2)) => None()
; @test (Some(2) |> map2(fn (a, b) = a + b, Some(1))) => Some(3)
pub let map2[a, b, c](f: (a, b) -> c, ma: Maybe a, mb: Maybe b) -> Maybe c =
  match (ma)
    | None -> None()
    | Some(a) ->
      match (mb)
        | None -> None()
        | Some(b) -> Some(f(a, b))

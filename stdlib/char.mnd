; Predicates and ASCII case on Char.
; Comparisons use character literals. There is no code-point conversion.
; @module std/char

; Whether c is an ASCII digit.
; @test is-digit('0') => true
; @test is-digit('9') => true
; @test is-digit('a') => false
pub let is-digit(c: Char) -> Bool =
  compare(c, '0') >= 0 && compare(c, '9') <= 0

; Whether c is an ASCII uppercase letter.
; @test is-upper('A') => true
; @test is-upper('Z') => true
; @test is-upper('a') => false
pub let is-upper(c: Char) -> Bool =
  compare(c, 'A') >= 0 && compare(c, 'Z') <= 0

; Whether c is an ASCII lowercase letter.
; @test is-lower('a') => true
; @test is-lower('z') => true
; @test is-lower('A') => false
pub let is-lower(c: Char) -> Bool =
  compare(c, 'a') >= 0 && compare(c, 'z') <= 0

; Whether c is an ASCII letter.
; @test is-alpha('Q') => true
; @test is-alpha('q') => true
; @test is-alpha('7') => false
pub let is-alpha(c: Char) -> Bool =
  is-upper(c) || is-lower(c)

; Whether c is space, tab, newline, or carriage return.
; @test is-whitespace(' ') => true
; @test is-whitespace('\n') => true
; @test is-whitespace('\t') => true
; @test is-whitespace('\r') => true
; @test is-whitespace('a') => false
pub let is-whitespace(c: Char) -> Bool =
  c == ' ' || c == '\n' || c == '\t' || c == '\r'

; ASCII lowercase letters and the uppercase letter each becomes.
let upper-pairs() -> List (Char * Char) =
  [('a', 'A'), ('b', 'B'), ('c', 'C'), ('d', 'D'), ('e', 'E'), ('f', 'F'), ('g', 'G'), ('h', 'H'), ('i', 'I'), ('j', 'J'), ('k', 'K'), ('l', 'L'), ('m', 'M'), ('n', 'N'), ('o', 'O'), ('p', 'P'), ('q', 'Q'), ('r', 'R'), ('s', 'S'), ('t', 'T'), ('u', 'U'), ('v', 'V'), ('w', 'W'), ('x', 'X'), ('y', 'Y'), ('z', 'Z')]

; ASCII uppercase letters and the lowercase letter each becomes.
let lower-pairs() -> List (Char * Char) =
  [('A', 'a'), ('B', 'b'), ('C', 'c'), ('D', 'd'), ('E', 'e'), ('F', 'f'), ('G', 'g'), ('H', 'h'), ('I', 'i'), ('J', 'j'), ('K', 'k'), ('L', 'l'), ('M', 'm'), ('N', 'n'), ('O', 'o'), ('P', 'p'), ('Q', 'q'), ('R', 'r'), ('S', 's'), ('T', 't'), ('U', 'u'), ('V', 'v'), ('W', 'w'), ('X', 'x'), ('Y', 'y'), ('Z', 'z')]

; The image of c in pairs, or c when it is absent.
let fold-case(pairs: List (Char * Char), c: Char) -> Char =
  match (pairs)
    | [] -> c
    | (from, to) :: rest ->
      if (from == c) -> to | fold-case(rest, c)

; c as an ASCII uppercase letter. Other characters stay.
; @test to-upper('a') => 'A'
; @test to-upper('Z') => 'Z'
; @test to-upper('7') => '7'
pub let to-upper(c: Char) -> Char =
  fold-case(upper-pairs(), c)

; c as an ASCII lowercase letter. Other characters stay.
; @test to-lower('A') => 'a'
; @test to-lower('z') => 'z'
; @test to-lower('7') => '7'
pub let to-lower(c: Char) -> Char =
  fold-case(lower-pairs(), c)

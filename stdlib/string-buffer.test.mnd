; StringBuffer helpers.

import std/string-buffer

test "append show writes the spelling" = {
  let sb = new()
  append-show!(sb, 41)
  to-str(sb) == "41"
}

test "append and length track the bytes" = {
  let sb = new()
  append!(sb, "hi")
  append-byte!(sb, 33)
  length(sb) == 3 && to-str(sb) != "hi"
}

test "clear drops the bytes and leaves the buffer usable" = {
  let sb = new()
  append!(sb, "hi")
  clear!(sb)
  append!(sb, "x")
  length(sb) == 1 && to-str(sb) == "x"
}

test "take-str leaves the buffer empty" = {
  let sb = new()
  append!(sb, "hi")
  take-str!(sb) == "hi" && length(sb) == 0
}

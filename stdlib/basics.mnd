; The functions every file has without an import.
; @module std/basics

; Returns its argument unchanged.
; @test id(1) => 1
pub let id[a](x: a) -> a =
  x

; Logical negation.
; @test not(true) => false
pub let not(b: Bool) -> Bool =
  if (b) -> false | true

; The smaller of x and y.
; @test min(2, 5) => 2
pub let min(x: Int, y: Int) -> Int =
  if (x < y) -> x | y

; The larger of x and y.
; @test max(2, 5) => 5
pub let max(x: Int, y: Int) -> Int =
  if (x > y) -> x | y

; Absolute value of n.
; @test abs(-3) => 3
pub let abs(n: Int) -> Int =
  if (n < 0) -> -n | n

; n limited to the inclusive range lo through hi.
; @test clamp(0, 10, 15) => 10
pub let clamp(lo: Int, hi: Int, n: Int) -> Int =
  min(hi, max(lo, n))

; The function that ignores its argument and returns x.
; @test always(1)(2) => 1
; @test always("a")(false) => "a"
pub let always[a, b](x: a) -> (b) -> a =
  fn (_) = x

; Internal cooperative scheduler seam (Build D).
; Not Platform API — do not import from applications. Use std/task.
; @module std/sched

extern mn_task_spawn[a](thunk: () -> a) -> Int

extern mn_task_self() -> Int

extern mn_task_suspend_for_test() -> Unit

extern mn_task_resume(id: Int) -> Unit

extern mn_task_join[a](id: Int) -> Result a Unit

extern mn_task_cancel(id: Int) -> Unit

extern mn_task_yield() -> Unit

extern mn_task_wait_new() -> Int

; Ok(()) when notified; Err(()) when cancelled while waiting (soft resume).
extern mn_task_wait(cell: Int) -> Result Unit Unit

; Ok(()) when notified/closed; Err(0)=cancel, Err(1)=timeout. deadline is mono ms.
extern mn_task_wait_until(cell: Int, deadline: Int) -> Result Unit Int

; Sleep until ms elapses or the sleeper is cancelled. Err(()) = cancelled.
extern mn_task_sleep_ms(ms: Int) -> Result Unit Unit

; Ok(inner) when joined; Err(()) = Timeout (task still running). Inner Err = cancelled.
extern mn_task_join_timeout[a](id: Int, ms: Int) -> Result (Result a Unit) Unit

extern mn_mono_ms() -> Int

extern mn_task_notify(cell: Int) -> Unit

; Close the cell and wake every waiter (Mailbox.close).
extern mn_task_notify_all(cell: Int) -> Unit

; Type-erased process dictionary (Build E registry). Honor-system get typing.
extern mn_task_dict_set[a](key: Str, value: a) -> Unit

extern mn_task_dict_get[a](key: Str) -> Maybe a

; Block-scoped defer (Build F). Prefer the language `defer` form.
extern mn_task_defer_enter() -> Unit

extern mn_task_defer_push(thunk: () -> Unit) -> Unit

extern mn_task_defer_leave() -> Unit

; Spawn a zero-argument thunk as a cooperative task. Returns an opaque id.
; @test join(spawn(fn () = 41)) => Ok(41)
pub let spawn[a](thunk: () -> a) -> Int =
  mn_task_spawn(thunk)

; The id of the task currently running Menard code.
; @test self() >= 1
pub let self() -> Int =
  mn_task_self()

; Park the current task. Another task or join may resume it.
; @test join(spawn(park-then)) => Ok(7)
pub let suspend-for-test() -> Unit =
  mn_task_suspend_for_test()

; Return 7 after one synthetic park (used by suspend-for-test's @test).
; @test join(spawn(park-then)) => Ok(7)
pub let park-then() -> Int {
  mn_task_suspend_for_test()
  7
}

; Enqueue a suspended task so the scheduler can run it again.
; @test resume(self())
pub let resume(id: Int) -> Unit =
  mn_task_resume(id)

; Wait until the task finishes; Ok(result) or Err(()) if cancelled.
; @test join(spawn(fn () = 3)) => Ok(3)
pub let join[a](id: Int) -> Result a Unit =
  mn_task_join(id)

; Mark a task cancelled.
; @test cancel(spawn(fn () = 0))
pub let cancel(id: Int) -> Unit =
  mn_task_cancel(id)

; Cooperative yield — re-enqueue the current task and run others.
; @test yield()
pub let yield() -> Unit =
  mn_task_yield()

; Allocate a wait cell (internal atomic-wait protocol for Build E).
; @test wait-new() >= 1
pub let wait-new() -> Int =
  mn_task_wait_new()

; Park until notified (Ok) or cancelled while waiting (Err).
; Multi-waiter FIFO; notify wakes at most one. Sticky if no waiter yet.
; @test {
;   let c = wait-new()
;   notify(c)
;   wait(c)
; } => Ok(())
pub let wait(cell: Int) -> Result Unit Unit =
  mn_task_wait(cell)

pub type WaitError =
  | WaitCancelled
  | WaitTimeout

; Park until notified, cancelled, or the monotonic deadline.
; @test {
;   let c = wait-new()
;   notify(c)
;   wait-until(c, mono-ms() + 1000)
; } => Ok(())
pub let wait-until(cell: Int, deadline: Int) -> Result Unit WaitError =
  match (mn_task_wait_until(cell, deadline))
    | Ok(u) -> Ok(u)
    | Err(0) -> Err(WaitCancelled())
    | Err(_) -> Err(WaitTimeout())

; True when wait-until failed because the deadline passed.
; @test is-timeout(WaitTimeout()) => true
pub let is-timeout(e: WaitError) -> Bool =
  match (e)
    | WaitTimeout() -> true
    | WaitCancelled() -> false

; Monotonic clock in milliseconds.
; @test mono-ms() >= 0
pub let mono-ms() -> Int =
  mn_mono_ms()

; Sleep for ms milliseconds. Err(()) if cancelled while sleeping.
; @test sleep-ms(0) => Ok(())
pub let sleep-ms(ms: Int) -> Result Unit Unit =
  mn_task_sleep_ms(ms)

; Join with a relative timeout. Outer Err = timed out (task still running).
; @test {
;   let t = spawn(fn () = 1)
;   join-timeout(t, 50)
; } => Ok(Ok(1))
pub let join-timeout[a](id: Int, ms: Int) -> Result (Result a Unit) Unit =
  mn_task_join_timeout(id, ms)

; Notify a wait cell; wakes at most one waiter. Sticky if no waiter yet.
; @test notify(wait-new())
pub let notify(cell: Int) -> Unit =
  mn_task_notify(cell)

; Close a wait cell and wake every waiter. Idempotent. Used by Mailbox.close.
; @test notify-all(wait-new())
pub let notify-all(cell: Int) -> Unit =
  mn_task_notify_all(cell)

; Process dictionary set (last write wins). Used by std/actor registry.
; @test dict-set("docs-dict", 1)
pub let dict-set[a](key: Str, value: a) -> Unit =
  mn_task_dict_set(key, value)

; Process dictionary get. Caller chooses the type parameter (honor system).
; @test {
;   dict-set("docs-dict-get", 3)
;   dict-get("docs-dict-get")
; } => Some(3)
pub let dict-get[a](key: Str) -> Maybe a =
  mn_task_dict_get(key)

; Enter a defer scope (paired with defer-leave). Language `do` blocks do this.
; @test {
;   defer-enter()
;   defer-leave()
; }
pub let defer-enter() -> Unit =
  mn_task_defer_enter()

; Register a cleanup thunk for the current defer scope (LIFO).
; @test {
;   defer-enter()
;   defer-push(fn () = ())
;   defer-leave()
; }
pub let defer-push(thunk: () -> Unit) -> Unit =
  mn_task_defer_push(thunk)

; Run LIFO cleanups for the current scope and pop it.
; @test {
;   defer-enter()
;   defer-push(fn () = ())
;   defer-leave()
; }
pub let defer-leave() -> Unit =
  mn_task_defer_leave()

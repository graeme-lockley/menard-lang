import "./int.mnd" as Int

test "a digit parses without hanging" = Int.parse("1") == 1

test "multiple digits form an integer" = Int.parse("123") == 123

test "parsing stops at the first non-digit" = Int.parse("456abc") == 456

test "a leading minus negates the parsed digits" = Int.parse("-123abc") == -123

test "zero parses as zero" = Int.parse("0") == 0

test "an empty string has no digits" = Int.parse("") == 0

test "a non-digit prefix has no digits" = Int.parse("abc456") == 0

test "a lone minus has no digits" = Int.parse("-") == 0

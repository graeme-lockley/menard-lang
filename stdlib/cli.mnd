; Flag and positional parsing over an argument list.
; A valued flag consumes the following word. `--` ends flag parsing.
; @module std/cli

import std/list

; One known flag. valued is true when the next word is its value.
pub record Flag {
  name: Str
  valued: Bool
}

; The flag named name, if the table has it.
let flag-named(name: Str, flags: List Flag) -> Maybe Flag =
  match (flags)
    | [] -> None()
    | f :: rest ->
      match (f)
        | Flag(n, _) ->
          if (n == name) -> Some(f) | flag-named(name, rest)

; Whether name occurs as its own word before `--`.
; @test has-flag(["run", "--clean", "a.mnd"], "--clean") => true
; @test not(has-flag(["run", "--", "--clean"], "--clean")) => true
pub let has-flag(args: List Str, name: Str) -> Bool =
  match (args)
    | [] -> false
    | a :: rest ->
      cond
        | a == "--" -> false
        | a == name -> true
        | else -> has-flag(rest, name)

; The word after name, or "" when name is absent or has no following word.
; @test flag-value(["-o", "out", "a.mnd"], "-o") => "out"
; @test flag-value(["run"], "-o") => ""
pub let flag-value(args: List Str, name: Str) -> Str =
  match (args)
    | [] -> ""
    | a :: rest ->
      cond
        | a == "--" -> ""
        | a == name ->
          match (rest)
            | [] -> ""
            | v :: _ -> v
        | else -> flag-value(rest, name)

; Positionals accumulated in reverse, stopping at `--`.
let positionals-onto(args: List Str, flags: List Flag, acc: List Str) -> List Str =
  match (args)
    | [] -> reverse(acc)
    | a :: rest ->
      cond
        | a == "--" -> reverse(acc)
        | else ->
          match (flag-named(a, flags))
            | None -> positionals-onto(rest, flags, a :: acc)
            | Some(f) ->
              match (f)
                | Flag(_, valued) ->
                  cond
                    | valued ->
                      match (rest)
                        | [] -> reverse(acc)
                        | _ :: more -> positionals-onto(more, flags, acc)
                    | else -> positionals-onto(rest, flags, acc)

; Words that are not flags in the table and not a valued flag's argument.
; @test positionals(["check", "-o", "out", "a.mnd"], [Flag("-o", true)]) => ["check", "a.mnd"]
; @test positionals(["check", "--clean", "-o", "out", "a.mnd", "--", "x"], [Flag("--clean", false), Flag("-o", true)]) => ["check", "a.mnd"]
pub let positionals(args: List Str, flags: List Flag) -> List Str =
  positionals-onto(args, flags, [])

; The positional at index, or "" when there are fewer.
; @test positional(["check", "a.mnd"], [], 1) => "a.mnd"
pub let positional(args: List Str, flags: List Flag, index: Int) -> Str =
  match (nth(index, positionals(args, flags)))
    | Some(s) -> s
    | None -> ""

; The words after the first `--`.
; @test args-after(["run", "a.mnd", "--", "-n"]) => ["-n"]
; @test args-after(["run", "a.mnd", "--", "-n", "1"]) => ["-n", "1"]
pub let args-after(args: List Str) -> List Str =
  match (args)
    | [] -> []
    | a :: rest ->
      if (a == "--") -> rest | args-after(rest)

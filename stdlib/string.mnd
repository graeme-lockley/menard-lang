; Helpers over Str bytes.
; @module std/string
; @test-import std/string-buffer as Buf

; Byte length of s.
; @test length("hi") => 2
pub runtime length(s: Str) -> Int

; The byte at index i. An index outside s reads as 0.
; @test byte(1, "hi") => 105
pub runtime byte(i: Int, s: Str) -> Int

; len bytes of s starting at start. Bounds outside s are clamped.
; @test slice(1, 3, "hello") => "ell"
pub runtime slice(start: Int, len: Int, s: Str) -> Str

; a and b joined. Further arguments nest to the left.
; @test concat("a", "b") => "ab"
; @test concat("hel", "lo") => "hello"
; @test concat("a", "b", "c") => "abc"
; @test concat("a") => "a"
pub runtime concat(a: Str, b: Str) -> Str

; c encoded as UTF-8. A scalar outside 0..U+10FFFF encodes as U+FFFD.
; @test from-char('A') => "A"
; @test from-char('\n') => "\n"
pub runtime from-char(c: Char) -> Str

; Whether s begins with prefix.
; @test starts-with("he", "hello") => true
pub let starts-with(prefix: Str, s: Str) -> Bool {
  let n = length(prefix)
  length(s) >= n && slice(0, n, s) == prefix
}

; Whether s ends with suffix.
; @test ends-with("lo", "hello") => true
pub let ends-with(suffix: Str, s: Str) -> Bool {
  let sn = length(s)
  let un = length(suffix)
  sn >= un && slice(sn - un, un, s) == suffix
}

; Drop the first n bytes. Non-positive counts keep s; counts past the end return "".
; @test drop(2, "hello") => "llo"
; @test drop(0, "hello") => "hello"
; @test drop(-1, "hello") => "hello"
; @test drop(5, "hello") => ""
; @test drop(10, "hello") => ""
; @test drop(1, "") => ""
; @test {
;   let sb = Buf.new()
;   Buf.append-byte!(sb, 195)
;   Buf.append-byte!(sb, 169)
;   Buf.append-byte!(sb, 120)
;   let remaining = drop(1, Buf.to-str(sb))
;   length(remaining) == 2 && byte(0, remaining) == 169 && byte(1, remaining) == 120
; } => true
pub let drop(n: Int, s: Str) -> Str {
  let l = length(s)

  cond
    | n <= 0 -> s
    | n >= l -> ""
    | else -> slice(n, l - n, s)
}

; Whether needle matches s at byte i. The needle is short, so the walk stays shallow.
let bytes-eq(s: Str, i: Int, pat: Str, j: Int, n: Int) -> Bool =
  cond
    | j >= n -> true
    | byte(i + j, s) == byte(j, pat) -> bytes-eq(s, i, pat, j + 1, n)
    | else -> false

; Whether s contains needle as a byte substring.
; @test contains("ell", "hello") => true
; @test contains("x", "hello") => false
; @test ("hello" |> contains("ell")) => true
pub let contains(needle: Str, s: Str) -> Bool {
  let n = length(needle)
  let sn = length(s)
  loop (i = 0)
    cond
      | i + n > sn -> false
      | bytes-eq(s, i, needle, 0, n) -> true
      | else -> recur(i + 1)
}

; parts joined by sep. An empty list joins to the empty string.
let join-rest(sep: Str, acc: Str, rest: List Str) -> Str =
  match (rest)
    | [] -> acc
    | h :: t -> join-rest(sep, concat(acc, sep, h), t)

; parts joined by sep.
; @test join(",", ["a", "b"]) => "a,b"
; @test join(",", []) => ""
pub let join(sep: Str, parts: List Str) -> Str =
  match (parts)
    | [] -> ""
    | h :: t -> join-rest(sep, h, t)

; Byte index of the first occurrence of sep, or None when it does not occur.
; @test index-of("ell", "hello") => Some(1)
; @test index-of(",", "a,b,c") => Some(1)
; @test index-of("xyz", "hello") => None()
; @test index-of("", "abc") => Some(0)
; @test index-of("", "") => Some(0)
; @test index-of("a", "") => None()
pub let index-of(sep: Str, s: Str) -> Maybe Int =
  index-of-from(sep, 0, s)

; Byte index of sep at or after i, or None when it does not occur.
; Negative starts search from zero; an empty separator matches at the start.
; The string is last so a pipe can fill it: `s |> index-of-from(sep, i)`.
; @test index-of-from(",", 2, "a,b,c") => Some(3)
; @test index-of-from(",", 1, "a,b,c") => Some(1)
; @test index-of-from(",", -1, "a,b") => Some(1)
; @test index-of-from("", 4, "abc") => None()
; @test index-of-from("", 3, "abc") => Some(3)
; @test index-of-from("c", 3, "abc") => None()
pub let index-of-from(sep: Str, i: Int, s: Str) -> Maybe Int {
  let n = length(sep)
  let sn = length(s)
  loop (j = if (i < 0) -> 0 | i)
    cond
      | j > sn || n > sn - j -> None()
      | bytes-eq(s, j, sep, 0, n) -> Some(j)
      | else -> recur(j + 1)
}

; The pieces of s from byte i to the end, split on sep.
let split-from(s: Str, sep: Str, i: Int) -> List Str {
  let n = length(sep)
  let sn = length(s)
  match (index-of-from(sep, i, s))
    | None -> [slice(i, sn - i, s)]
    | Some(at) -> slice(i, at - i, s) :: split-from(s, sep, at + n)
}

; s split on sep. An empty separator is not a split: the whole string is the one piece.
; @test split(",", "a,b,c") => ["a", "b", "c"]
; @test split(",", "abc") => ["abc"]
; @test split(",", "a,") => ["a", ""]
; @test split(",", "a,,b") => ["a", "", "b"]
pub let split(sep: Str, s: Str) -> List Str =
  if (length(sep) == 0) -> [s] | split-from(s, sep, 0)

; s split on any separator. List order breaks ties; empty separators are ignored.
; @test split-using([",", ";"], "a,b;c") => ["a", "b", "c"]
; @test split-using(["::", "--"], "a::b--c") => ["a", "b", "c"]
; @test split-using([",", ";"], ",a,;b;") => ["", "a", "", "b", ""]
; @test split-using([":", "::"], "a::b") => ["a", "", "b"]
; @test split-using(["::", ":"], "a::b") => ["a", "b"]
; @test split-using(["", ",", ""], "a,b") => ["a", "b"]
; @test split-using(["", ""], "a,b") => ["a,b"]
; @test split-using([], "a,b") => ["a,b"]
; @test split-using(["abcd", ";"], "abc") => ["abc"]
; @test split-using([",", ";"], "") => [""]
pub let split-using(seps: List Str, s: Str) -> List Str =
  split-using-from(s, seps, 0)

; Length of the separator in seps that matches s at byte i, or 0 when none does.
let matching-sep-length(s: Str, seps: List Str, i: Int) -> Int =
  match (seps)
    | [] -> 0
    | sep :: rest ->
      {
        let n = length(sep)
        if (n > 0 && i + n <= length(s) && bytes-eq(s, i, sep, 0, n)) ->
          n | matching-sep-length(s, rest, i)
      }

; The pieces of s from byte start to the end, split on any separator in seps.
let split-using-from(s: Str, seps: List Str, start: Int) -> List Str {
  let sn = length(s)
  loop (i = start)
    cond
      | i >= sn -> [slice(start, sn - start, s)]
      | else ->
        {
          let n = matching-sep-length(s, seps, i)
          if (n > 0) ->
            slice(start, i - start, s) :: split-using-from(s, seps, i + n) |
            recur(i + 1)
        }
}

; Drop a final empty piece left by a trailing newline.
let drop-trailing-empty(parts: List Str) -> List Str =
  match (parts)
    | [] -> []
    | h :: [] ->
      if (h == "") -> [] | [h]
    | h :: t -> h :: drop-trailing-empty(t)

; s split into lines. A trailing newline does not add an empty last line. The empty string has no lines.
; @test lines("\n") => [""]
; @test lines("a\nb") => ["a", "b"]
pub let lines(s: Str) -> List Str =
  if (s == "") -> [] | lines-split(s, "\n")

; Split on sep, then drop the empty piece a trailing separator would leave.
let lines-split(s: Str, sep: Str) -> List Str =
  if (ends-with(sep, s)) -> drop-trailing-empty(split(sep, s)) | split(sep, s)

; Whether s has no bytes.
; @test is-empty("") => true
; @test is-empty("a") => false
pub let is-empty(s: Str) -> Bool =
  length(s) == 0

; n copies of s joined. A non-positive count is empty.
; @test repeat(3, "ab") => "ababab"
; @test repeat(0, "ab") => ""
; @test repeat(-1, "ab") => ""
pub let repeat(n: Int, s: Str) -> Str =
  if (n <= 0) -> "" | concat(s, repeat(n - 1, s))

; Every from in s replaced by to. An empty from is not a replacement.
; @test replace("a", "b", "abaca") => "bbbcb"
; @test replace("", "x", "ab") => "ab"
pub let replace(from: Str, to: Str, s: Str) -> Str =
  if (length(from) == 0) -> s | join(to, split(from, s))

; The first n bytes. A non-positive count is empty. A count past the end is s.
; @test left(2, "hello") => "he"
; @test left(0, "hello") => ""
; @test left(9, "hello") => "hello"
pub let left(n: Int, s: Str) -> Str =
  if (n <= 0) -> "" | slice(0, n, s)

; The last n bytes. A non-positive count is empty. A count past the end is s.
; @test right(2, "hello") => "lo"
; @test right(0, "hello") => ""
; @test right(9, "hello") => "hello"
pub let right(n: Int, s: Str) -> Str =
  if (n <= 0) -> "" | drop(length(s) - n, s)

; Drop the last n bytes. Non-positive counts keep s; counts past the end return "".
; @test drop-right(2, "hello") => "hel"
; @test drop-right(0, "hello") => "hello"
; @test drop-right(9, "hello") => ""
pub let drop-right(n: Int, s: Str) -> Str {
  let l = length(s)

  cond
    | n <= 0 -> s
    | n >= l -> ""
    | else -> slice(0, l - n, s)
}

; Whether b is ASCII space, tab, newline, or carriage return.
let is-space(b: Int) -> Bool =
  b == 32 || b == 9 || b == 10 || b == 13

; s without leading ASCII whitespace.
; @test trim-left("  hi") => "hi"
; @test trim-left("hi") => "hi"
pub let trim-left(s: Str) -> Str =
  trim-left-from(s, 0)

; trim-left from byte i.
let trim-left-from(s: Str, i: Int) -> Str =
  if (i >= length(s)) -> "" | trim-left-byte(s, i)

; Drop byte i when it is whitespace.
let trim-left-byte(s: Str, i: Int) -> Str =
  if (is-space(byte(i, s))) -> trim-left-from(s, i + 1) | slice(i, length(s) - i, s)

; s without trailing ASCII whitespace.
; @test trim-right("hi  ") => "hi"
; @test trim-right("hi") => "hi"
pub let trim-right(s: Str) -> Str =
  trim-right-at(s, length(s))

; trim-right keeping the first n bytes.
let trim-right-at(s: Str, n: Int) -> Str =
  if (n <= 0) -> "" | trim-right-byte(s, n)

; Drop the last kept byte when it is whitespace.
let trim-right-byte(s: Str, n: Int) -> Str =
  if (is-space(byte(n - 1, s))) -> trim-right-at(s, n - 1) | slice(0, n, s)

; s without leading or trailing ASCII whitespace.
; @test trim("  hi \n") => "hi"
; @test trim("hi") => "hi"
pub let trim(s: Str) -> Str =
  trim-right(trim-left(s))

; Drop empty pieces.
let drop-empty(parts: List Str) -> List Str =
  match (parts)
    | [] -> []
    | h :: t ->
      if (h == "") -> drop-empty(t) | h :: drop-empty(t)

; s split on ASCII whitespace. Empty pieces are dropped.
; @test words("a  b\nc") => ["a", "b", "c"]
; @test words("  ") => []
; @test words("") => []
pub let words(s: Str) -> List Str =
  drop-empty(split-using([" ", "\n", "\t", "\r"], s))

; The decimal spelling of n.
; @test from-int(42) => "42"
; @test from-int(-3) => "-3"
; @test from-int(0) => "0"
pub let from-int(n: Int) -> Str =
  show(n)

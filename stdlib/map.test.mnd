; Map helpers.

import std/map

import std/pair

test "from-list stores the pair" = lookup(from-list([Pair("a", 1)]), "a") == Some(1)

test "lookup of a missing key is none" = lookup(from-list([Pair("a", 1)]), "z") == None()

test "a later pair overwrites the key" = lookup(from-list([Pair("a", 1), Pair("a", 2)]), "a") == Some(2)

test "to-list keeps the entry" = lookup(from-list(to-list(from-list([Pair("a", 1)]))), "a") == Some(1)

test "remove drops the key" = lookup(remove(from-list([Pair("a", 1), Pair("b", 2)]), "a"), "b") == Some(2)

test "remove of the key is none" = lookup(remove(from-list([Pair("a", 1)]), "a"), "a") == None()

test "merge lets the right map win" = lookup(merge(from-list([Pair("a", 1)]), from-list([Pair("a", 2), Pair("b", 3)])), "a") == Some(2)

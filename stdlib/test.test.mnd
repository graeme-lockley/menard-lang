(import std/list)
(import std/test)

(test "count-lines tallies pass and fail"
  (= (count-lines ["pass a" "fail b" "noise" "pass c"]) (Counts 2 1)))

(test "a clean summary names only the passes"
  (= (summary-text (Counts 2 0) 5) "2 passed (5ms)"))

(test "a failing summary names both totals"
  (= (summary-text (Counts 2 1) 5) "1 failed, 2 passed (5ms)"))

(test "discover finds a test file"
  (contains (discover "stdlib/basics.test.mnd") "stdlib/basics.test.mnd"))

(test "discover finds the library tests"
  (contains (discover "stdlib") "stdlib/basics.test.mnd"))

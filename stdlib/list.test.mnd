; Qualified names stay distinct from the unqualified list operations.
; These do not belong on a list function: they check the import.

import std/list
import std/maybe as Maybe
import std/result as Result

test "qualified Maybe.map does not replace List.map" = {
  let optional = Maybe.map(fn (n) = n + 1, Some(1))
  let items = map(fn (n) = n + 1, [1, 2])
  optional == Some(2) && items == [2, 3]
}

test "qualified maps from two modules stay distinct" = {
  let optional = Maybe.map(fn (n) = n + 1, Some(1))
  let result = Result.map(fn (n) = n + 2, Ok(1))
  optional == Some(2) && result == Ok(3)
}

; Standard streams.

import std/io

test "stdin is 0" = stdin == 0

test "stdout is 1" = stdout == 1

test "stderr is 2" = stderr == 2

test "write returns Ok Unit" = write(stdout, "") == Ok(())

test "write-line returns Ok Unit" = write-line(stdout, "") == Ok(())

test "write on an invalid descriptor returns Err" =
  match (write(-1, ""))
    | Ok(_) -> false
    | Err(_) -> true

test "write-line propagates write errors" =
  match (write-line(-1, "must not appear"))
    | Ok(_) -> false
    | Err(_) -> true

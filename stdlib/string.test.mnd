; String helpers.

import std/string
import std/string-buffer as Buf

test "starts-with matches the prefix" = starts-with("he", "hello") == true

test "ends-with matches the suffix" = ends-with("lo", "hello") == true

test "drop removes the first n bytes" = drop(2, "hello") == "llo"

test "drop keeps the string for zero" = drop(0, "hello") == "hello"

test "drop keeps the string for a negative count" = drop(-1, "hello") == "hello"

test "drop returns empty at the byte length" = drop(5, "hello") == ""

test "drop returns empty past the byte length" = drop(10, "hello") == ""

test "drop handles an empty string" = drop(1, "") == ""

test "drop counts UTF-8 bytes rather than characters" = {
  let sb = Buf.new()
  Buf.append-byte!(sb, 195)
  Buf.append-byte!(sb, 169)
  Buf.append-byte!(sb, 120)
  let remaining = drop(1, Buf.to-str(sb))
  length(remaining) == 2 && byte(0, remaining) == 169 && byte(1, remaining) == 120
}

test "has finds a substring" = has("ell", "hello") == true

test "has rejects a missing needle" = has("x", "hello") == false

test "join inserts the separator" = join(",", ["a", "b"]) == "a,b"

test "join of nothing is empty" = join(",", []) == ""

test "index-of finds the first occurrence" = index-of(",", "a,b,c") == Some(1)

test "index-of finds a multi-byte substring" = index-of("ell", "hello") == Some(1)

test "index-of returns None for a missing substring" = index-of("xyz", "hello") == None()

test "index-of-from searches at or after the supplied byte index" =
  index-of-from(",", 2, "a,b,c") == Some(3)

test "index-of-from includes a match at the start index" =
  index-of-from(",", 1, "a,b,c") == Some(1)

test "index-of-from clamps a negative start to zero" =
  index-of-from(",", -1, "a,b") == Some(1)

test "index-of-from returns None when the start is past the end" =
  index-of-from("", 4, "abc") == None()

test "index-of matches an empty substring at zero" = index-of("", "abc") == Some(0)

test "index-of-from matches an empty substring at the end" =
  index-of-from("", 3, "abc") == Some(3)

test "index-of-from does not find a nonempty substring at the end" =
  index-of-from("c", 3, "abc") == None()

test "index-of matches an empty substring in an empty string" =
  index-of("", "") == Some(0)

test "index-of returns None for a nonempty substring in an empty string" =
  index-of("a", "") == None()

test "split preserves the string when the separator is absent" =
  split(",", "abc") == ["abc"]

test "split preserves a trailing empty piece" = split(",", "a,") == ["a", ""]

test "split breaks on the separator" = split(",", "a,b,c") == ["a", "b", "c"]

test "split keeps an empty piece" = split(",", "a,,b") == ["a", "", "b"]

test "split-using splits on any separator" =
  split-using([",", ";"], "a,b;c") == ["a", "b", "c"]

test "split-using consumes multi-byte separators" =
  split-using(["::", "--"], "a::b--c") == ["a", "b", "c"]

test "split-using keeps leading consecutive and trailing empty pieces" =
  split-using([",", ";"], ",a,;b;") == ["", "a", "", "b", ""]

test "split-using uses the first matching separator in list order" =
  split-using([":", "::"], "a::b") == ["a", "", "b"]

test "split-using respects reversed separator priority" =
  split-using(["::", ":"], "a::b") == ["a", "b"]

test "split-using ignores empty separators" =
  split-using(["", ",", ""], "a,b") == ["a", "b"]

test "split-using leaves the string intact with only empty separators" =
  split-using(["", ""], "a,b") == ["a,b"]

test "split-using leaves the string intact without separators" =
  split-using([], "a,b") == ["a,b"]

test "split-using leaves the string intact when separators do not match" =
  split-using(["abcd", ";"], "abc") == ["abc"]

test "split-using returns one empty piece for an empty string" =
  split-using([",", ";"], "") == [""]

test "lines break on newline" = lines("a\nb") == ["a", "b"]

test "length counts bytes" = length("hi") == 2

test "byte reads an index" = byte(1, "hi") == 105

test "slice takes a span of bytes" = slice(1, 3, "hello") == "ell"

test "concat joins two strings" = concat("hel", "lo") == "hello"

test "concat joins more than two strings" = concat("a", "b", "c") == "abc"

test "concat of one string is that string" = concat("a") == "a"

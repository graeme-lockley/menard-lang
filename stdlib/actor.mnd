; Mailbox + Actor (Build E). Pure Menard on std/task + std/sched wait cells.
; Not an isolation boundary — shared Ref across tasks is allowed.
; @module std/actor

import std/sched as Sched
import std/task as Tsk
pub import std/task (Cancelled)
import std/list as List

pub type ActorError =
  | ActorCancelled
  | ActorDead
  ; Mailbox deadline exceeded (CONC-02). Named ActorTimeout so it does not
  ; collide with IoError.Timeout's ownership of the Timeout nullary.
  | ActorTimeout

; Default bounded capacity (Build F backpressure).
; @test default-capacity() => 1024
pub let default-capacity() -> Int =
  1024

pub record Mailbox[a] {
  front: Ref (List a)
  back: Ref (List a)
  cell: Int
  space: Int
  count: Ref Int
  capacity: Int
  alive: Ref Bool
}

; Empty live mailbox with default capacity.
; @test {
;   let mb = mailbox-new()
;   let _ = send(mb, 1)
;   receive(mb)
; } => Ok(1)
pub let mailbox-new[a]() -> Mailbox a =
  mailbox-new-bounded(default-capacity())

; Empty live mailbox with explicit capacity (block-on-full send).
; @test {
;   let mb = mailbox-new-bounded(1)
;   let _ = send(mb, 7)
;   receive(mb)
; } => Ok(7)
pub let mailbox-new-bounded[a](capacity: Int) -> Mailbox a =
  Mailbox(ref([]), ref([]), Sched.wait-new(), Sched.wait-new(), ref(0), capacity, ref(true))

; Push onto the two-list back spine.
let mb-enqueue[a](mb: Mailbox a, msg: a) -> Unit =
  match (mb)
    | Mailbox(_, back, _, _, count, _, _) -> {
        set!(back, msg :: deref(back))
        set!(count, deref(count) + 1)
      }

; Pop from the front, rotating the back list when needed.
let try-dequeue[a](mb: Mailbox a) -> Maybe a =
  match (mb)
    | Mailbox(front, back, _, space, count, _, _) ->
      match (deref(front))
        | h :: t -> {
            set!(front, t)
            set!(count, deref(count) - 1)
            Sched.notify(space)
            Some(h)
          }
        | [] ->
          match (List.reverse(deref(back)))
            | [] -> {
                set!(back, [])
                None()
              }
            | h :: t -> {
                set!(front, t)
                set!(back, [])
                set!(count, deref(count) - 1)
                Sched.notify(space)
                Some(h)
              }

; Whether the mailbox still accepts messages.
let is-alive[a](mb: Mailbox a) -> Bool =
  match (mb)
    | Mailbox(_, _, _, _, _, _, alive) -> deref(alive)

; Wait-cell id for receivers.
let mb-cell[a](mb: Mailbox a) -> Int =
  match (mb)
    | Mailbox(_, _, cell, _, _, _, _) -> cell

; Wait-cell id for senders blocked on a full mailbox.
let mb-space[a](mb: Mailbox a) -> Int =
  match (mb)
    | Mailbox(_, _, _, space, _, _, _) -> space

; Current number of queued messages.
let mb-count[a](mb: Mailbox a) -> Int =
  match (mb)
    | Mailbox(_, _, _, _, count, _, _) -> deref(count)

; Configured capacity of the mailbox.
let mb-capacity[a](mb: Mailbox a) -> Int =
  match (mb)
    | Mailbox(_, _, _, _, _, capacity, _) -> capacity

; Send with backpressure: park when full until space or cancel/death.
; @test {
;   let mb = mailbox-new()
;   close(mb)
;   send(mb, 1)
; } => Err(ActorDead())
pub let send[a](mb: Mailbox a, msg: a) -> Result Unit ActorError {
  loop ()
    if (not(is-alive(mb))) -> Err(ActorDead()) | {
      if (mb-count(mb) >= mb-capacity(mb)) -> {
        match (Sched.wait(mb-space(mb)))
          | Err(_) -> Err(ActorCancelled())
          | Ok(_) -> recur()
      } | {
        mb-enqueue(mb, msg)
        Sched.notify(mb-cell(mb))
        Ok(())
      }
    }
}

; Suspend until a message arrives, or ActorCancelled / ActorDead.
; Cancel does not dequeue; the message stays in the queue.
; @test {
;   let mb = mailbox-new()
;   let _ = send(mb, 7)
;   receive(mb)
; } => Ok(7)
pub let receive[a](mb: Mailbox a) -> Result a ActorError {
  loop ()
    match (try-dequeue(mb))
      | Some(msg) -> Ok(msg)
      | None ->
        if (not(is-alive(mb))) -> Err(ActorDead()) | {
          match (Sched.wait(mb-cell(mb)))
            | Err(_) -> Err(ActorCancelled())
            | Ok(_) -> recur()
        }
}

; Like receive, but Err(ActorTimeout) after ms; the queue is unchanged on timeout.
; @test {
;   let mb = mailbox-new()
;   receive-timeout(mb, 5)
; } => Err(ActorTimeout())
pub let receive-timeout[a](mb: Mailbox a, ms: Int) -> Result a ActorError {
  let deadline = Sched.mono-ms() + ms
  loop ()
    match (try-dequeue(mb))
      | Some(msg) -> Ok(msg)
      | None ->
        if (not(is-alive(mb))) -> Err(ActorDead()) | {
          match (Sched.wait-until(mb-cell(mb), deadline))
            | Ok(_) -> recur()
            | Err(e) ->
              if (Sched.is-timeout(e)) -> Err(ActorTimeout()) | Err(ActorCancelled())
        }
}

; Like send, but Err(ActorTimeout) after ms waiting for space; nothing is enqueued.
; @test {
;   let mb = mailbox-new-bounded(1)
;   let _ = send(mb, 1)
;   send-timeout(mb, 2, 5)
; } => Err(ActorTimeout())
pub let send-timeout[a](mb: Mailbox a, msg: a, ms: Int) -> Result Unit ActorError {
  let deadline = Sched.mono-ms() + ms
  loop ()
    if (not(is-alive(mb))) -> Err(ActorDead()) | {
      if (mb-count(mb) >= mb-capacity(mb)) -> {
        match (Sched.wait-until(mb-space(mb), deadline))
          | Ok(_) -> recur()
          | Err(e) ->
            if (Sched.is-timeout(e)) -> Err(ActorTimeout()) | Err(ActorCancelled())
      } | {
        mb-enqueue(mb, msg)
        Sched.notify(mb-cell(mb))
        Ok(())
      }
    }
}

; Mark dead and wake every parked receiver and blocked sender.
; Each waiter observes Err(ActorDead) once. Idempotent.
; @test {
;   let mb = mailbox-new()
;   close(mb)
;   receive(mb)
; } => Err(ActorDead())
pub let close[a](mb: Mailbox a) -> Unit =
  match (mb)
    | Mailbox(_, _, cell, space, _, _, alive) -> {
        set!(alive, false)
        Sched.notify-all(cell)
        Sched.notify-all(space)
      }

; task-id is the cooperative task id; scope is the nursery for escalate (or empty).
; pending holds reply-close hooks for in-flight Actor.call (CONC-05).
pub record Pid[a] {
  mb: Mailbox a
  task-id: Int
  scope: Ref (List Int)
  pending: Ref (List (() -> Unit))
}

; Mailbox of a Pid.
let pid-mb[a](pid: Pid a) -> Mailbox a =
  match (pid)
    | Pid(mb, _, _, _) -> mb

; Cooperative task id of a Pid.
let pid-task-id[a](pid: Pid a) -> Int =
  match (pid)
    | Pid(_, tid, _, _) -> tid

; Nursery scope ref held by a Pid.
let pid-scope[a](pid: Pid a) -> Ref (List Int) =
  match (pid)
    | Pid(_, _, s, _) -> s

; Pending reply-close hooks for a Pid.
let pid-pending[a](pid: Pid a) -> Ref (List (() -> Unit)) =
  match (pid)
    | Pid(_, _, _, pending) -> pending

; Cancel every task id registered on a scope (nursery escalate).
; @test escalate(ref([]))
pub let escalate(scope: Ref (List Int)) -> Unit =
  List.for-each(fn (id) = Sched.cancel(id), deref(scope))

; Run and clear pending reply-close hooks (idempotent when already empty).
let run-pending(pending: Ref (List (() -> Unit))) -> Unit {
  let hooks = deref(pending)
  set!(pending, [])
  List.for-each(fn (h) = h(), hooks)
}

; Run pending reply hooks, close the mailbox; escalate the nursery when failed.
let finish-actor[a](mb: Mailbox a, scope: Ref (List Int), pending: Ref (List (() -> Unit)), failed: Bool) -> Unit {
  run-pending(pending)
  close(mb)
  if (failed) -> escalate(scope) | ()
}

; Register a reply-close hook on the actor (same Fn identity to unregister).
let register-pending[a](pid: Pid a, hook: () -> Unit) -> Unit =
  match (pid)
    | Pid(_, _, _, pending) -> set!(pending, hook :: deref(pending))

; Remove a previously registered hook (Fn identity).
let unregister-pending[a](pid: Pid a, hook: () -> Unit) -> Unit =
  match (pid)
    | Pid(_, _, _, pending) ->
      set!(pending, List.filter(fn (h) = h != hook, deref(pending)))

; Spawn a receive-loop body. Serialisation is the body's responsibility.
; @test {
;   let p = spawn(fn (_) = ())
;   join(p)
; } => Ok(())
pub let spawn[a](body: (Mailbox a) -> Unit) -> Pid a {
  let mb = mailbox-new()
  let scope = ref([])
  let pending = ref([])
  let t = Tsk.spawn(fn () = {
    body(mb)
    finish-actor(mb, scope, pending, false)
  })
  Pid(mb, Tsk.id(t), scope, pending)
}

; Spawn into a scope so failure can escalate (cancel siblings).
; @test {
;   let s = ref([])
;   let p = spawn-in(s, fn (_) = ())
;   join(p)
; } => Ok(())
pub let spawn-in[a](scope: Ref (List Int), body: (Mailbox a) -> Unit) -> Pid a {
  let mb = mailbox-new()
  let pending = ref([])
  let t = Tsk.spawn(fn () = {
    body(mb)
    finish-actor(mb, scope, pending, false)
  })
  let tid = Tsk.id(t)
  let tail = deref(scope)
  set!(scope, tid :: tail)
  Pid(mb, tid, scope, pending)
}

; Send to an actor's mailbox.
; @test {
;   let p = spawn(fn (mb) = {
;     let _ = receive(mb)
;     ()
;   })
;   let r = cast(p, 1)
;   let _ = join(p)
;   r
; } => Ok(())
pub let cast[a](pid: Pid a, msg: a) -> Result Unit ActorError =
  send(pid-mb(pid), msg)

; Cancel the actor task; close the mailbox and escalate the nursery.
; @test {
;   let p = spawn(fn (mb) = {
;     let _ = receive(mb)
;     ()
;   })
;   cancel(p)
;   join(p)
; } => Err(Cancelled())
pub let cancel[a](pid: Pid a) -> Unit {
  ; Close pending replies first so a mid-handle body cannot send Ok when
  ; soft-cancel pumps the actor. Then cancel (so join sees Cancelled), then
  ; close the actor mailbox and escalate — do not close the mb before cancel,
  ; or a woken body can finish as done and join returns Ok.
  run-pending(pid-pending(pid))
  Sched.cancel(pid-task-id(pid))
  close(pid-mb(pid))
  escalate(pid-scope(pid))
}

; Wait for the actor task to finish.
; @test {
;   let p = spawn(fn (_) = ())
;   join(p)
; } => Ok(())
pub let join[a](pid: Pid a) -> Result Unit Cancelled =
  match (Sched.join(pid-task-id(pid)))
    | Ok(v) -> Ok(v)
    | Err(_) -> Err(Cancelled())

; Debug task id of a Pid (not a wake handle).
; @test id(spawn(fn (_) = ())) >= 1
pub let id[a](pid: Pid a) -> Int =
  pid-task-id(pid)

pub type Ask[req, res] =
  | Ask(req, Mailbox (Result res ActorError))

; Drop queued Ask messages whose reply mailbox is `reply` (caller cancel).
let drop-ask-for-reply[req, res](mb: Mailbox (Ask req res), reply: Mailbox (Result res ActorError)) -> Unit =
  match (mb)
    | Mailbox(front, back, _, space, count, _, _) -> {
        let keep = fn (msg) =
          match (msg)
            | Ask(_, r) -> r != reply
        let f0 = deref(front)
        let b0 = deref(back)
        let f1 = List.filter(keep, f0)
        let b1 = List.filter(keep, b0)
        let removed =
          (List.length(f0) + List.length(b0)) - (List.length(f1) + List.length(b1))
        set!(front, f1)
        set!(back, b1)
        set!(count, deref(count) - removed)
        if (removed > 0) -> Sched.notify(space) | ()
      }

; Typed request/response; protocols need no reply Pid fields.
; On actor exit/cancel, pending hooks close the reply → Err(ActorDead).
; Caller cancel while waiting → Err(ActorCancelled); Ask is dropped; reply closed.
; @test {
;   let p = serve(fn (n) = n + 1)
;   let r = call(p, 40)
;   cancel(p)
;   let _ = join(p)
;   r
; } => Ok(41)
pub let call[req, res](pid: Pid (Ask req res), req: req) -> Result res ActorError {
  let reply = mailbox-new()
  let hook = fn () = close(reply)
  register-pending(pid, hook)
  match (cast(pid, Ask(req, reply)))
    | Err(e) -> {
        unregister-pending(pid, hook)
        Err(e)
      }
    | Ok(_) ->
      match (receive(reply))
        | Err(e) -> {
            close(reply)
            unregister-pending(pid, hook)
            drop-ask-for-reply(pid-mb(pid), reply)
            Err(e)
          }
        | Ok(r) -> {
            unregister-pending(pid, hook)
            r
          }
}

; Receive loop for a request/response server.
let serve-loop[req, res](mb: Mailbox (Ask req res), scope: Ref (List Int), pending: Ref (List (() -> Unit)), handle: req -> res) -> Unit {
  loop ()
    match (receive(mb))
      | Err(ActorCancelled()) -> finish-actor(mb, scope, pending, true)
      | Err(ActorDead()) -> finish-actor(mb, scope, pending, false)
      | Ok(Ask(req, reply)) -> {
          let hook = fn () = close(reply)
          set!(pending, hook :: deref(pending))
          let out = handle(req)
          let _ = send(reply, Ok(out))
          set!(pending, List.filter(fn (h) = h != hook, deref(pending)))
          recur()
        }
}

; Stateless request/response server.
; @test {
;   let p = serve(fn (n) = n * 2)
;   let r = call(p, 21)
;   cancel(p)
;   let _ = join(p)
;   r
; } => Ok(42)
pub let serve[req, res](handle: req -> res) -> Pid (Ask req res) {
  let mb = mailbox-new()
  let scope = ref([])
  let pending = ref([])
  let t = Tsk.spawn(fn () = serve-loop(mb, scope, pending, handle))
  Pid(mb, Tsk.id(t), scope, pending)
}

; Stateless server registered on a Task scope nursery.
; @test {
;   let s = ref([])
;   let p = serve-in(s, fn (n) = n)
;   let r = call(p, 3)
;   cancel(p)
;   let _ = join(p)
;   r
; } => Ok(3)
pub let serve-in[req, res](scope: Ref (List Int), handle: req -> res) -> Pid (Ask req res) {
  let mb = mailbox-new()
  let pending = ref([])
  let t = Tsk.spawn(fn () = serve-loop(mb, scope, pending, handle))
  let tid = Tsk.id(t)
  let tail = deref(scope)
  set!(scope, tid :: tail)
  Pid(mb, tid, scope, pending)
}

; Stateful receive loop for serve-state.
let serve-state-loop[req, res, s](mb: Mailbox (Ask req res), scope: Ref (List Int), pending: Ref (List (() -> Unit)), init: s, step: (s, req) -> (s * res)) -> Unit {
  loop (st = init)
    match (receive(mb))
      | Err(ActorCancelled()) -> finish-actor(mb, scope, pending, true)
      | Err(ActorDead()) -> finish-actor(mb, scope, pending, false)
      | Ok(Ask(req, reply)) -> {
          let hook = fn () = close(reply)
          set!(pending, hook :: deref(pending))
          let pair = step(st, req)
          match (pair)
            | (st2, out) -> {
                let _ = send(reply, Ok(out))
                set!(pending, List.filter(fn (h) = h != hook, deref(pending)))
                recur(st2)
              }
        }
}

; Stateful request/response server.
; @test {
;   let p = serve-state(0, fn (st, n) = (st + n, st + n))
;   let r = call(p, 5)
;   cancel(p)
;   let _ = join(p)
;   r
; } => Ok(5)
pub let serve-state[req, res, s](init: s, step: (s, req) -> (s * res)) -> Pid (Ask req res) {
  let mb = mailbox-new()
  let scope = ref([])
  let pending = ref([])
  let t = Tsk.spawn(fn () = serve-state-loop(mb, scope, pending, init, step))
  Pid(mb, Tsk.id(t), scope, pending)
}

; Stateful server registered on a Task scope nursery.
; @test {
;   let s = ref([])
;   let p = serve-state-in(s, 0, fn (st, n) = (st + 1, n))
;   let r = call(p, 9)
;   cancel(p)
;   let _ = join(p)
;   r
; } => Ok(9)
pub let serve-state-in[req, res, s](scope: Ref (List Int), init: s, step: (s, req) -> (s * res)) -> Pid (Ask req res) {
  let mb = mailbox-new()
  let pending = ref([])
  let t = Tsk.spawn(fn () = serve-state-loop(mb, scope, pending, init, step))
  let tid = Tsk.id(t)
  let tail = deref(scope)
  set!(scope, tid :: tail)
  Pid(mb, tid, scope, pending)
}

; Bind a name to a Pid in the process dictionary (last write wins).
; @test {
;   let p = spawn(fn (_) = ())
;   register("docs-actor", p)
;   let _ = join(p)
; }
pub let register[a](name: Str, pid: Pid a) -> Unit =
  Sched.dict-set(name, pid)

; Look up a Pid by name (honor-system typing).
; @test {
;   let p = spawn(fn (_) = ())
;   register("docs-whereis", p)
;   let ok =
;     match (whereis("docs-whereis"))
;       | Some(q) -> id(q) == id(p)
;       | None -> false
;   let _ = join(p)
;   ok
; } => true
pub let whereis[a](name: Str) -> Maybe (Pid a) =
  Sched.dict-get(name)

; Discovery and the summary line for `(test …)` files.
; The compiler's runner stays in src/test: this module does not import it.
; @module std/test

import std/console
import std/fs
import std/io
import std/list
import std/string as String

; How many pass and fail lines a test process printed.
pub record Counts {
  passed: Int
  failed: Int
}

; Join dir and name with a slash.
let join-path(dir: Str, name: Str) -> Str =
  cond
    | dir == "" || dir == "." -> name
    | dir == "/" -> str-concat("/", name)
    | else -> str-concat(dir, "/", name)

; Hidden names, dependencies, and build output are not test roots.
let skip-name(name: Str) -> Bool =
  String.starts-with(".", name) || name == "node_modules" || name == "build" || name == "target"

; Split s on newline bytes, dropping empty lines.
let split-acc(s: Str, i: Int, start: Int, n: Int, acc: List Str) -> List Str =
  cond
    | i > n -> acc
    | i == n || str-byte(s, i) == 10 ->
      if (i == start) -> split-acc(s, i + 1, i + 1, n, acc) | split-acc(s, i + 1, i + 1, n, str-slice(s, start, i - start) :: acc)
    | else -> split-acc(s, i + 1, start, n, acc)

; The lines of s.
let lines-of(s: Str) -> List Str =
  reverse(split-acc(s, 0, 0, str-byte-length(s), []))

; Whether the file source contains a test form.
let contains-test(path: Str) -> Bool =
  match (read-file(path))
    | Err(_) -> false
    | Ok(src) -> String.starts-with("test \"", src) || String.has("\ntest \"", src)

; A `*.test.mnd` file, or any other `*.mnd` file that contains `(test …)`.
let is-test-file(path: Str) -> Bool =
  cond
    | String.ends-with(".test.mnd", path) -> true
    | String.ends-with(".mnd", path) -> contains-test(path)
    | else -> false

; Walk dir, collecting test files onto acc.
let walk(dir: Str, acc: List Str) -> List Str =
  walk-names(dir, sort(lines-of(list-dir(dir))), acc)

; One directory listing.
let walk-names(dir: Str, names: List Str, acc: List Str) -> List Str =
  match (names)
    | [] -> acc
    | name :: rest ->
      if (skip-name(name)) -> walk-names(dir, rest, acc) | walk-child(dir, join-path(dir, name), rest, acc)

; A child path: descend into directories, keep test files.
let walk-child(dir: Str, child: Str, rest: List Str, acc: List Str) -> List Str =
  cond
    | is-dir(child) -> walk-names(dir, rest, walk(child, acc))
    | is-test-file(child) -> walk-names(dir, rest, child :: acc)
    | else -> walk-names(dir, rest, acc)

; Test files under path, or a one-element list when path itself is a test file.
; @test contains(discover("stdlib/basics.test.mnd"), "stdlib/basics.test.mnd") => true
pub let discover(path: Str) -> List Str =
  cond
    | is-dir(path) -> reverse(walk(path, []))
    | is-test-file(path) -> [path]
    | else -> []

; Add one output line to the counts.
let count-line(line: Str, c: Counts) -> Counts =
  match (c)
    | Counts(p, f) ->
      cond
        | String.starts-with("pass ", line) -> Counts(p + 1, f)
        | String.starts-with("fail ", line) -> Counts(p, f + 1)
        | else -> c

; Fold count-line over lines.
let count-onto(lines: List Str, c: Counts) -> Counts =
  match (lines)
    | [] -> c
    | line :: rest -> count-onto(rest, count-line(line, c))

; Pass and fail totals from a test process's stdout lines.
; @test count-lines(["pass a", "fail b", "noise"]) => Counts(1, 1)
pub let count-lines(lines: List Str) -> Counts =
  count-onto(lines, Counts(0, 0))

; The summary sentence, without color.
; @test summary-text(Counts(2, 1), 5) => "1 failed, 2 passed (5ms)"
pub let summary-text(c: Counts, ms: Int) -> Str =
  match (c)
    | Counts(p, f) ->
      if (f > 0) -> str-concat(show(f), " failed, ", show(p), " passed (", show(ms), "ms)") | str-concat(show(p), " passed (", show(ms), "ms)")

; Write the summary line. Failures are red and passes green when on is true.
; @test summary(Counts(1, 0), 1, false)
pub let summary(c: Counts, ms: Int, on: Bool) -> Unit =
  match (c)
    | Counts(p, f) ->
      {
        cond
          | f > 0 ->
            {
              write(stdout, paint(on, "[31m", str-concat(show(f), " failed")))
              write(stdout, ", ")
              ()
            }
        write(stdout, paint(on, "[32m", str-concat(show(p), " passed")))
        write(stdout, str-concat(" (", show(ms), "ms)"))
        write(stdout, "\n")
        ()
      }

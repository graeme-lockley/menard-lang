; Discovery and the summary line for `(test …)` files.
; The compiler's runner stays in src/test: this module does not import it.
; @module std/test

(import std/console)
(import std/fs)
(import std/io)
(import std/list)
(import std/string)

; How many pass and fail lines a test process printed.
(pub defrec Counts (passed: Int) (failed: Int))

; Join dir and name with a slash.
(defn join-path (dir: Str) (name: Str) -> Str
  (if (or (= dir "") (= dir ".")) name
    (if (= dir "/") (str-concat "/" name)
      (str-concat dir "/" name))))

; Hidden names, dependencies, and build output are not test roots.
(defn skip-name (name: Str) -> Bool
  (or (starts-with name ".") (= name "node_modules") (= name "build") (= name "target")))

; A newline, as a one-byte string.
(let nl
  (do
    (let sb (sb-new))
    (sb-append-byte! sb 10)
    (sb-take-str! sb)))

; Split s on newline bytes, dropping empty lines.
(defn split-acc (s: Str) (i: Int) (start: Int) (n: Int) (acc: (List Str)) -> (List Str)
  (if (> i n) acc
    (if (or (= i n) (= (str-byte s i) 10))
      (if (= i start)
        (split-acc s (+ i 1) (+ i 1) n acc)
        (split-acc s (+ i 1) (+ i 1) n (Cons (str-slice s start (- i start)) acc)))
      (split-acc s (+ i 1) start n acc))))

; The lines of s.
(defn lines-of (s: Str) -> (List Str)
  (reverse (split-acc s 0 0 (str-byte-length s) [])))

; The `(test "` marker at the start of a line.
(defn test-at-bol -> Str
  (do
    (let sb (sb-new))
    (sb-append-byte! sb 10)
    (sb-append! sb "(test \"")
    (sb-take-str! sb)))

; Whether the file source contains a test form.
(defn contains-test (path: Str) -> Bool
  (match (read-file path)
    (Err _) false
    (Ok src)
      (or (starts-with src "(test \"")
        (has src (test-at-bol)))))

; A `*.test.mnd` file, or any other `*.mnd` file that contains `(test …)`.
(defn is-test-file (path: Str) -> Bool
  (if (ends-with path ".test.mnd") true
    (if (ends-with path ".mnd") (contains-test path) false)))

; Walk dir, collecting test files onto acc.
(defn walk (dir: Str) (acc: (List Str)) -> (List Str)
  (walk-names dir (sort (lines-of (list-dir dir))) acc))

; One directory listing.
(defn walk-names (dir: Str) (names: (List Str)) (acc: (List Str)) -> (List Str)
  (match names
    [] acc
    (Cons name rest)
      (if (skip-name name) (walk-names dir rest acc)
        (walk-child dir (join-path dir name) rest acc))))

; A child path: descend into directories, keep test files.
(defn walk-child (dir: Str) (child: Str) (rest: (List Str)) (acc: (List Str)) -> (List Str)
  (if (is-dir child)
    (walk-names dir rest (walk child acc))
    (if (is-test-file child)
      (walk-names dir rest (Cons child acc))
      (walk-names dir rest acc))))

; Test files under path, or a one-element list when path itself is a test file.
; @test (contains (discover "stdlib/basics.test.mnd") "stdlib/basics.test.mnd") => true
(pub defn discover (path: Str) -> (List Str)
  (if (is-dir path) (reverse (walk path []))
    (if (is-test-file path) [path] [])))

; Add one output line to the counts.
(defn count-line (line: Str) (c: Counts) -> Counts
  (match c
    (Counts p f)
      (if (starts-with line "pass ") (Counts (+ p 1) f)
        (if (starts-with line "fail ") (Counts p (+ f 1))
          c))))

; Fold count-line over lines.
(defn count-onto (lines: (List Str)) (c: Counts) -> Counts
  (match lines
    [] c
    (Cons line rest) (count-onto rest (count-line line c))))

; Pass and fail totals from a test process's stdout lines.
; @test (count-lines ["pass a" "fail b" "noise"]) => (Counts 1 1)
(pub defn count-lines (lines: (List Str)) -> Counts
  (count-onto lines (Counts 0 0)))

; The summary sentence, without color.
; @test (summary-text (Counts 2 1) 5) => "1 failed, 2 passed (5ms)"
(pub defn summary-text (c: Counts) (ms: Int) -> Str
  (match c
    (Counts p f)
      (if (> f 0)
        (str-concat (show f) " failed, " (show p) " passed (" (show ms) "ms)")
        (str-concat (show p) " passed (" (show ms) "ms)"))))

; Write the summary line. Failures are red and passes green when on is true.
; @test (summary (Counts 1 0) 1 false)
(pub defn summary (c: Counts) (ms: Int) (on: Bool) -> Unit
  (match c
    (Counts p f)
      (do
        (if (> f 0)
          (do
            (write stdout (paint on "[31m" (str-concat (show f) " failed")))
            (write stdout ", ")
            ())
          ())
        (write stdout (paint on "[32m" (str-concat (show p) " passed")))
        (write stdout (str-concat " (" (show ms) "ms)"))
        (write stdout nl)
        ())))

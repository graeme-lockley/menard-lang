; Build E: mailbox multi-sender/waiter, Actor.call, death, registry, escalate.
import std/actor as Actor
pub import std/task (Cancelled)
import std/task as Tsk
import std/list as List
import std/map as Map

type UserReq =
  | Put(Str, Str)
  | Get(Str)
  | Search(Str)

type UserRes =
  | OkUser(Str, Str)
  | OkUsers(List Str)
  | NotFound
  | BadRequest(Str)

let step(db: Map Str Str, req: UserReq) -> (Map Str Str * UserRes) =
  match (req)
    | Put(id, name) -> (Map.set(id, name, db), OkUser(id, name))
    | Get(id) ->
      match (Map.lookup(id, db))
        | Some(name) -> (db, OkUser(id, name))
        | None -> (db, NotFound)
    | Search(q) -> {
        let ids =
          List.filter(
            fn (k) = {
              match (Map.lookup(k, db))
                | None -> false
                | Some(name) -> name == q
            },
            Map.keys(db)
          )
        (db, OkUsers(ids))
      }

let unwrap-res(r: Result UserRes Actor.ActorError) -> Int =
  match (r)
    | Ok(OkUser(_, _)) -> 1
    | Ok(OkUsers(xs)) -> List.length(xs)
    | Ok(NotFound) -> 0
    | Ok(BadRequest(_)) -> -2
    | Err(Actor.ActorDead) -> -3
    | Err(Actor.ActorCancelled) -> -4

let main() -> Int {
  ; --- Mailbox: multi-sender, then receive ---
  let mb = Actor.mailbox-new()
  let s1 = Tsk.spawn(fn () = {
    Actor.send(mb, 10)
    1
  })
  let s2 = Tsk.spawn(fn () = {
    Actor.send(mb, 20)
    1
  })
  Tsk.join(s1)
  Tsk.join(s2)
  let a = match (Actor.receive(mb))
    | Ok(n) -> n
    | Err(_) -> 0
  let b = match (Actor.receive(mb))
    | Ok(n) -> n
    | Err(_) -> 0
  println(a + b)

  ; --- Actor.call put/get/search ---
  let um = Actor.serve-state(Map.empty(), step)
  Actor.register("user-manager", um)
  Actor.call(um, Put("1", "ada"))
  println(unwrap-res(Actor.call(um, Get("1"))))
  println(unwrap-res(Actor.call(um, Search("ada"))))
  println(unwrap-res(Actor.call(um, Get("missing"))))

  ; --- Registry ---
  match (Actor.whereis("user-manager"))
    | None -> println(0)
    | Some(p) -> println(unwrap-res(Actor.call(p, Get("1"))))

  ; --- Post-death send ---
  Actor.cancel(um)
  Actor.join(um)
  match (Actor.cast(um, Actor.Ask(Get("1"), Actor.mailbox-new())))
    | Ok(_) -> println(0)
    | Err(Actor.ActorDead) -> println(1)
    | Err(_) -> println(0)

  ; --- Scope escalate: cancel one actor cancels sibling waiter ---
  let saw = ref(0)
  let ready = ref(0)
  Tsk.scope(fn (s) = {
    let slow = Actor.spawn-in(s, fn (mb2) = {
      set!(ready, deref(ready) + 1)
      match (Actor.receive(mb2))
        | Ok(_) -> ()
        | Err(_) -> {
            set!(saw, deref(saw) + 1)
            ()
          }
    })
    let peer = Actor.spawn-in(s, fn (mb3) = {
      set!(ready, deref(ready) + 1)
      match (Actor.receive(mb3))
        | Ok(_) -> ()
        | Err(_) -> {
            set!(saw, deref(saw) + 10)
            ()
          }
    })
    loop ()
      if (deref(ready) < 2) -> {
        Tsk.yield()
        recur()
      } | ()
    Tsk.yield()
    Actor.cancel(slow)
    Actor.join(peer)
    Actor.join(slow)
    ()
  })
  println(deref(saw))
  0
}

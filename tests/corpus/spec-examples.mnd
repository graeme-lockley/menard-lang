; Spec examples — Phase 0 corpus (syntax only)

; A type may mention itself. The name is registered before the payloads
; are read, so one declaration is enough.
type Tree[a] =
  | Leaf(a)
  | Node(Tree a, Tree a)
  | Empty

record Env[v] {
  parent: Maybe (Env v)
  bindings: Map Str v
}

alias Ints = List Int

alias EnvMap = Map Str Str

let sign(n: Int) -> Str =
  cond
    | n < 0 -> "negative"
    | n == 0 -> "zero"
    | else -> "positive"

let sum-to(n: Int) -> Int =
  loop (i = 0, acc = 0)
    if (i > n) -> acc | recur(i + 1, acc + i)

let tree-size[a](t: Tree a) -> Int =
  match (t)
    | Empty -> 0
    | Leaf(_) -> 1
    | Node(l, r) -> 1 + tree-size(l) + tree-size(r)

let count-down(n: Int) -> Unit {
  let i = ref(n)
  while (deref(i) > 0) {
    print(deref(i))
    set!(i, deref(i) - 1)
  }
}

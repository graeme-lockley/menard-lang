; `Tree` refers to itself in `Node`'s payload, so — like `Ast` in
; `src/reader/ast.mnd` — it needs an empty forward declaration before its
; real definition (the typer registers a type's name only once its whole
; `variant`/`defrec` form has been collected, so a single self-referential
; form can't see its own name yet).
type Tree[a] =

type Tree[a] =
  | Leaf(a)
  | Node(Tree a, Tree a)
  | Empty

record Env[v] {

}

record Env[v] {
  parent: Maybe (Env v)
  bindings: Map Str v
}

alias Ints = List Int

alias EnvMap = Map Str Str

let sign(n: Int) -> Str =
  cond
    | n < 0 -> "negative"
    | n == 0 -> "zero"
    | else -> "positive"

let sum-to(n: Int) -> Int =
  loop (i = 0, acc = 0)
    if (i > n) -> acc | recur(i + 1, acc + i)

let tree-size[a](t: Tree a) -> Int =
  match (t)
    | Empty -> 0
    | Leaf(_) -> 1
    | Node(l, r) -> 1 + tree-size(l) + tree-size(r)

let count-down(n: Int) -> Unit {
  let i = ref(n)
  while (deref(i) > 0) {
    print(deref(i))
    set!(i, deref(i) - 1)
  }
}

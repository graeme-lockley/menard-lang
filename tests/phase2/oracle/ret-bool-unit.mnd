; Slice 3B oracle: Bool/Unit values, Bool-returning helper, Unit mid-sequence.
; Expect exit 1.

let is-pos(n: Int) -> Bool =
  n > 0

let as-int(b: Bool) -> Int =
  if b -> 1
   | else -> 0

let touch() -> Unit {
  let _ = 0
  ()
}

let main() -> Int {
  let t = true
  let f = false
  touch()
  if t ->
    if f -> 0
     | else -> as-int(is-pos(5))
   | else -> 0
}

; Slice 2G oracle fixture: `match` on `Nil`/`Cons` for a `(List Int)`
; built from nested constructor literals — under slice 2G's since-
; replaced constant-folding evaluator this folded to `ret i32 60`
; (`10 + 20 + 30 = 60`) at compile time. Slice 2H's real instruction
; selector (`src/emit/lower.mnd`) does not lower `match` (or a `List`
; value) yet (a clean, documented `Err` — see that module's header
; comment's "Scope"): still interpretable (still 60 — see
; `tests/phase2/oracle.test.ts`'s own "unsupported" test), but no
; longer part of the emit-and-run native oracle.

(defn list-sum (xs: (List Int)) -> Int
  (match xs
    (Nil) 0
    (Cons h t) (+ h (list-sum t))))

(defn main -> Int
  (list-sum (Cons 10 (Cons 20 (Cons 30 (Nil))))))

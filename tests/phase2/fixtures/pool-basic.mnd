; Fixture for src/pool/pool.test.mnd: two identical `Str` literals, one
; distinct `Str` literal, and one nullary constructor mention — exercises
; `pool/pool.mnd`'s dedup-by-byte-content rule (the two `"hello"`s must
; collapse to one entry) alongside its constructor-mention collection.

(defn greeting -> Str
  (do
    (let a "hello")
    (let b "hello")
    (let c "world")
    (if (= a b) c a)))

(defn nothing -> (Maybe Int)
  (None))

(defn main -> Int
  0)

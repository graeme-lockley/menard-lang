; CONC-10: Http.request under mn inter yields Err(NetErr(Unsupported)).
import std/http as Http
import std/map as Map

let main() -> Int =
  match (Http.request("127.0.0.1", 9, Http.Request(Http.GET, "/", Map.empty(), "")))
    | Err(Http.NetErr(Http.Unsupported)) ->
      {
        println("Unsupported")
        1
      }
    | Err(_) ->
      {
        println("other-err")
        2
      }
    | Ok(_) ->
      {
        println("ok")
        0
      }

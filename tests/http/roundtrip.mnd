; CONC-04: HTTP server + client on an ephemeral port with wait-cell readiness.
import std/http as Http
pub import std/http (Request, Response, Method, GET)
import std/map as Map
import std/task as Task
import std/net as Net
import std/sched as Sched

let handler(req: Request) -> Response =
  match (req)
    | Request(_, path, _, _) ->
      Response(200, Map.set("Content-Type", "text/plain", Map.empty()), path)

let main() -> Int {
  let ready = Sched.wait-new()
  let port-cell = ref(0)
  let server = Task.spawn(fn () = {
    match (Net.listen(0))
      | Err(_) -> 1
      | Ok(listener) -> {
          defer Net.close(listener)
          match (Net.local-port(listener))
            | Err(_) -> 1
            | Ok(port) -> {
                set!(port-cell, port)
                Sched.notify(ready)
                match (Http.serve-on(listener, 5000, Http.default-limits(), handler))
                  | Ok(_) -> 0
                  | Err(_) -> 1
              }
        }
  })
  let _ = Sched.wait(ready)
  let port = deref(port-cell)
  match (Http.request-timeout("127.0.0.1", port, Request(GET(), "/hi", Map.empty(), ""), 2000))
    | Ok(Response(code, _, body)) -> {
        println(code)
        println(body)
        Task.cancel(server)
        let _ = Task.join(server)
        0
      }
    | Err(_) -> {
        println(0)
        Task.cancel(server)
        let _ = Task.join(server)
        1
      }
}

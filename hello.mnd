; Hello, world

(import "./fred.mnd")

(println "Hello, world!")

123

; The file named on the command line is the entry. Its `main` is the
; process entry. `fred.mnd`'s `main` runs only for `./mn run ./fred.mnd`.
; Top-level forms in both files still run.
(defn main -> Int
  (println "Main: Hello")
  0
)
    

(pub import "../stdlib/sys.mnd")
(pub import "../stdlib/io.mnd")
(pub import "../stdlib/fs.mnd")
(pub import "../stdlib/proc.mnd")

(pub defn (id [a]) (x: a) -> a
  x)

(pub defn not (b: Bool) -> Bool
  (if b false true))

(pub defn (list-length [a]) (xs: (List a)) -> Int
  (match xs
    [] 0
    (Cons _ t) (+ 1 (list-length t))))
